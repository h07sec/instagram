<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/igds_primary_button" />
                    <stroke android:width="2.0dip" android:color="@color/cardview_light_background" />
                </shape>
            </item>
            <item android:left="6.0dip" android:top="6.0dip" android:right="6.0dip" android:bottom="6.0dip">
                <bitmap android:src="@drawable/instagram_check_filled_12" android:tint="@color/cardview_light_background" />
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/igds_prism_black_alpha_40" />
            <stroke android:width="2.0dip" android:color="@color/cardview_light_background" />
        </shape>
    </item>
</selector>
