<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?igds_color_background_secondary" />
            <corners android:bottomLeftRadius="@dimen/abc_select_dialog_padding_start_material" android:bottomRightRadius="@dimen/abc_select_dialog_padding_start_material" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?igds_color_elevated_background" />
            <corners android:bottomLeftRadius="@dimen/abc_select_dialog_padding_start_material" android:bottomRightRadius="@dimen/abc_select_dialog_padding_start_material" />
        </shape>
    </item>
</selector>
