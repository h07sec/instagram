<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="3.0dip" android:color="?igds_color_border_focus" />
                </shape>
            </item>
            <item android:left="3.0dip" android:top="3.0dip" android:right="3.0dip" android:bottom="3.0dip">
                <shape android:shape="oval">
                    <stroke android:width="2.0dip" android:color="?igds_color_background_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
