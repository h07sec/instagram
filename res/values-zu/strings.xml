    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Vala ibhrawuza</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002d">I-Meta AI</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">I-%1$s ifuna ukusebenzisa ikhamera yedivayisi yakho nemakrofoni.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">I-%1$s ifuna ukusebenzisa ikhamera yedivayisi yakho.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">I-%1$s ifuna ukusebenzisa indawo yedivayisi yakho.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130031">I-%1$s ifuna ukusebenzisa imakhrofoni yedivayisi yakho.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">Sicela uvumele yonke imidiya ukusebenzisa isikhethi sefayela</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Vumela</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Vimbela</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">Nciphisa ibhrawuza</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">Emuva</string>
