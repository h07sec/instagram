<resources>
    <string name="APKTOOL_DUMMYVAL_0x7f130003">ከተማ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130004">አድራሻ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">ከማስታወቂያ መለያዎ በካርዱ በራስሙሌት ይሞላ?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">ማሰሺያ ይዝጉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">%1$s የመሳርያዎን ካሜራ እና ማይክሮፎን መጠቀም ይፈልጋል።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">%1$s የመሳርያዎን ካሜራ መጠቀም ይፈልጋል።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">%1$sየመሳሪያዎን መገኛ ቦታ መጠቀም ይፈልጋል።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130031">%1$s የመሳርያዎን ማይክሮፎን መጠቀም ይፈልጋል።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">እባክዎ ሁሉም ሚዲያ ፋይል መራጭን እንዲጠቀሙ ይፍቀዱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">ይፍቀዱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">አግድ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">አሳሽን ያሳንሱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">ተመለስ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130037">አስተላልፍ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">የዚህ ጣቢያ የደህንነት ምስክር ወረቀት ላይ ችግሮች አሉ።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">ወደ ድር ጣቢያ ይቀጥሉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">ወደ ኋላ ይመለሱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">በ%1$s ጥቅም ላይ በሚውለው የደህንነት ምስክር ወረቀት ላይ ችግር አለ። እንደ የይለፍ ቃሎች ወይም የክሬዲት ካርድ ቁጥሮች ያሉ የእርስዎ የግል መረጃ ከዚህ ድር ጣቢያ ጋር ሲጋራ ደህንነቱ የተጠበቀ ላይሆን ይችላል።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">ይህ ድር ጣቢያ ደህንነቱ የተጠበቀ ግንኙነት እየተጠቀመ አይደለም</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">ይመለሱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">የደህንነት ስህተት</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003f">ርዕስ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">ያሰናብቱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009f">ኢሜይል</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">እየተመለከቱት ያሉት ድር ጣቢያ ውጫዊ መተግበሪያ ለመክፈት አየሞከረ ነው። መቀጠል ይፈልጋሉ?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">ይቀጥሉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">ከመተግበሪያችን እየወጡ ነው</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">ይህ ለማስተካከል እየሰራንበት ባለነው ቴክኒካዊ እክል ምክንያት ሊሆን ይችላል። ይህንን ገጽ እንደገና ለመጫን ይሞክሩ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">አድስ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">ገጽ አሁን አይገኝም</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">የአያት ስም</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a8">ገጹ ሊጫን አልቻለም</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">በ … ይክፈቱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">በ%1$s ይክፈቱ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">ተጨማሪ አማራጮች</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">አሁን ሙሉ ስክሪን እየተመለከቱ ነው። ለመውጣት ወደ ግራ በጣትዎ ያዘልሉ ወይም የተመለስ አዝራርን መታ ያድርጉ።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">የአገናኝ ታሪክ። ከዚህ ቀደም ወደጎበኟቸው ድር ጣቢያዎች የሚወስዱ አገናኞች ዝርዝር ለማግኘት ሁለቴ መታ ያድርጉ።</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f5">ይሰርዙ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">ይዝጉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">ካርድ ለማከል መታ ያድርጉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">ዚፕኮድ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13013b">ሂሳብ መክፈያ አድራሻ ከመላኪያ አድራሻ ጋር ተመሳሳይ መሆኑን ያረጋግጡ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130149">[የካርድ ብራንድ ወይም ሰጪ] የካርድ ምስል</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014a">የራስሙሌት መረጃ እና መቆጣጠሪያዎችን ይዘርጉ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014b">ተጨማሪ ይወቁ</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130156">የእርስዎ መነጽሮች ተገናኝተዋል</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1301ce">ሰዓት ያዘጋጁ</string>
</resources>
