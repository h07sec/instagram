<resources>
    <string name="APKTOOL_DUMMYVAL_0x7f130002">Faritany</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130003">Tanàna</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130004">Adiresy</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">"Mameno ho azy amin'ny karatra avy amin'ny kaontin-dokanao?"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Hanakatona mpitety tranonkala</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">"Te hampiasa ny fakantsary sy mikiraon'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">"Te hampiasa ny fakantsarin'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">Te-hampiasa ny toerana misy ny fitaovan-tseraseranao i %1$s.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130031">"Te hampiasa ny mikiraon'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">Mba omeo lalana ny haino vaky jery rehetra hampiasa fisafidianan-drakitra azafady.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Manome lalana</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Manakana</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">Manakely fitety</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">Miverina</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130037">Mandroso</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">"Misy olana ny sertifikà fiarovan'ity tranonkala ity"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">"Manohy mankany amin'ny tranonkala"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">"Misy olana ilay taratasy fanamarinam-piarovana ampiasain'i %1$s. Mety ho tsy voaaro ny fampahalalanao manokana, toy ny tenimiafina na laharan-karatra fisintonam-bola crédit, rehefa zaraina amin'ity tranonkala ity."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">Tsy mampiasa fifandraisana azo antoka ity tranonkala ity.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">"Tsy fetezan'ny fiarovana"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">Andohany</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">Tsy miraharaha</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003f">Manandrana manokatra app ivelany iray ilay tranonkala jerenao. Te hanohy ve ianao?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">Manohy</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">"Miala amin'ny appnay ianao"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">Mety ho noho ny hadisoana ara-tekinika iray izay ezahinay vahana izany. Andramo fahanana indray ity pejy ity.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">Manavao</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">"Tsy vonona ilay Pejy amin'izao"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">Anarana</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">Tsy mety afatratra ilay Pejy</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">"Sokafina amin'i…"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a8">"Sokafina ao amin'i %1$s"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">Safidy bebe kokoa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">"Fanampin'anarana"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">Mijery efijery feno ianao izao. Asosay miankavia na kitiho ilay bokotra miverina hivoahana.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">"Tantaran-drohy. Kitiho indroa hahitana lisi-drohy mankany amin'ireo tranonkala notsidihinao teo aloha."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c3">Manafoana</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">Manakatona</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f5">Kitiho mba hanampiana karatra</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">Kaody Paositaly</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">Manamafy fa iray ihany ny adiresy andefasana sy ny adiresy fandefasan-dazambidy</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">Sarin-karatra [mari-karatra na mpampoaka ny karatra]</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13013b">Mamelabelatra fampahalalana sy fifehezana ny famenoina ho azy</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130149">Mamantatra bebe kokoa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014a">Finday</string>
</resources>
