    <string name="APKTOOL_DUMMYVAL_0x7f130002">Муж улс</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130003">Хот</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130004">Хаяг</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130006">Байр/тоот (заавал биш)</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">Зарын бүртгэлээсээ картыг автоматаар бөглөх үү?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130012">Автоматаар бөглөх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130024">Таны мэдээллийг хэрхэн ашиглаж, удирддаг тухай</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130025">Одоо биш</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Вэб хөтчийг хаах</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">%1$s таны төхөөрөмжийн камер болон микрофоныг ашиглахыг хүсэж байна.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">%1$s таны төхөөрөмжийн камерыг ашиглахыг хүсэж байна.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">%1$s таны төхөөрөмжийн байршлыг ашиглах хүсэлтэй байна.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">Файл сонгогчийг хэрэглэхийн тулд бүх медиаг зөвшөөрнө үү</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Зөвшөөрөх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Хориглох</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">Хөтчийг багасгах</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">Буцах</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130037">Цааш үргэлжлүүлэх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">Энэ сайтын хамгаалалтын сертификат асуудалтай байна</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">Вебсайтад үргэлжлүүлэх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">%1$s ашигладаг аюулгүй байдлын гэрчилгээнд асуудал гарлаа. Таны нууц үг, кредит картын дугаар зэрэг хувийн мэдээллийг энэ вебсайттай хуваалцахад аюултай байж болзошгүй.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">Энэ вэбсайт аюулгүй холболт ашиглахгүй байна.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">Хамгаалалтын алдаа</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">Толгой хэсэг</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">Хадгалсан мэдээллээр автоматаар бөглөх үү?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003f">Ямар нэгэн алдаа гарлаа.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130082">Үл хэрэгсэх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009d">Имэйл</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">Таны үзэж буй вэб сайт гадны апп нээхийг оролдож байна. Та үргэлжлүүлэхийг хүсч байна уу?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009f">Үргэлжлүүлэх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">Та манай аппаас гарч байна</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">Энэ нь бидний залруулахаар ажиллаж буй техникийн алдаанаас үүдсэн байж болно. Хуудсыг дахин ачаална уу.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">Сэргээх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">Хуудас одоогоор боломжгүй байна</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">Овог</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">Хуудсыг ачаалах боломжгүй байна</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">Дараах хэрэглүүрээр нээх …</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a8">\"%1$s\" дээр нээх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">Бусад сонголт</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">Нэр</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">Та одоо бүтэн дэлгэцээр үзэж байна. Гарахын тулд зүүн тийш шудрах эсвэл буцах товчийг товшино уу.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">Бид яг одоо %1$s-д %2$s-г тохируулахад асуудалтай байна. Та дахин оролдож үзэх эсвэл одоогоор %2$s-г Англи (АНУ) хэл дээр ашиглана уу.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c3">%1$s хэлийг тохируулах хүртэл түр хүлээнэ үү...</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">Дахин оролдох</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f1">Англи (АНУ) хэлээр үргэлжлүүлэх</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f2">Холбоосны түүх. Өмнө нь зочилсон вебсайтуудын холбоосын жагсаалтыг харахын тулд хоёр товшино уу.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f3">Цуцлах</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f4">Хаах</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f5">Карт нэмэхийн тулд товшино уу</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">Зип код</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300fd">Төлбөрийн нэхэмжлэх илгээх хаяг хүргэх хаягтай ижил болохыг бататгана уу</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">[картын брэнд эсвэл олгосон байгууллага] картын зураг</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">Автоматаар бөглөх мэдээлэл болон удирдлагыг дэлгэх</string>
