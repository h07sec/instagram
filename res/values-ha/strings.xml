<resources>
    <string name="APKTOOL_DUMMYVAL_0x7f130002">Jiha</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130004">Adireshi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">A cika kai tsaye da kati daga asusun tallanka?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Fufe burauza</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">"%1$s yana so ya yi amfani da kyamarar na'urarka da makirufo."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">"%1$s na son yin amfani da kyamarar na'urarka."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">"%1$s na son yin amfani da wurin na'urarka."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130031">"%1$s yana son yin amfani da makirofo ɗin na'urarka."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">Daure ka ba duk midiya damar yin amfani da mai zaɓa fayil</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Yarda</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Toshe</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">Sauke burauza ƙasa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">Baya</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130037">Tura</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">Akwai matsaloli tattare da takardar shaidar tsaro na wannan shafin yanar gizon</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">Ci gaba zuwa shafin yanar gizo</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">Koma Baya</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">Akwai matsala a tattare da takardar shaida ta tsaro da %1$s ya yi amfani da ita. Bayananka na ƙashin kai, kamar kalmomin sirri ko lambar katin bashi, ƙila ba za a tsare su ba a lokacin da aka yaɗa a wannan shafin yanar gizo.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">Wannan shafin yanar gizon ba ya amfani da haɗin hanyar sadarwa mai tsaro</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">Kuskuren tsaro</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">Kanun sama</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003f">Wata matsala ta faru.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009d">Kora</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">Shafin yanar gizon da kake dubawa yana ƙoƙarin buɗe manhajar waje, Kana son ci gaba?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">Koma baya</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">Ci gaba</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">Kana fita daga maanhajarmu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">"Wannan zai iya yiwuwa ne saboda matsalar na'urar da muke aiki domin gyarawa. Gwada sake loda wannan shafin."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">Wartsake</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">Shafi ba ya samuwa a halin yanzu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">Sunan Ƙarshe</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a8">An kasa loda shafi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">Buɗe da...</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">Buɗe a cikin %1$s</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">Ƙarin zaɓuɓɓuka</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">Sunan Farko</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c3">Yanzu kuna kallon cikakken allo. Jawo zuwa hagu ko danna maɓallin komawa don fita.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">Sake gwadawa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f3">Tarihin hanyoyin haɗi. Danna sau biyu don jerin hanyoyin haɗi zuwa shafukan yanar gizo da kuka ziyarta a baya.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f5">Soke</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">Rufe</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">Taɓa don ka ƙara kati</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">Lambar titi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13013b">Tabbatar adireshin aika takardar biya ɗaya ne da na aika kaya</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130149">[card brand or issuer] hoton kati</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014a">Faɗaɗa bayanan mai cikewa da kansa da wuraren kula</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014b">Sami ƙarin bayani</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130156">Gilasanka a haɗe suke</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1301ce">Waya</string>
