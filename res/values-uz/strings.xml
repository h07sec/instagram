<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="APKTOOL_DUMMYVAL_0x7f130003">Shahar</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130004">Manzil</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130006">Kvartira/ofis (ixtiyoriy)</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">Reklama hisobingizdan karta bilan avtomatik kiritilsinmi?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Brauzerni yopish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">%1$s qurilmangiz kamerasidan foydalanmoqchi.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">%1$s qurilmangizning joylashuv axborotidan foydalanmoqchi.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Ruxsat</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Bloklash</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">Bu sayt uchun xavfsizlik sertifikatiga oid muammolar mavjud</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">Veb-saytga kirish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">Orqaga</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">%1$s domeni foydalanadigan sertifikat xavfsizligi bilan bogʻliq muammo yuzaga keldi. Parollar yoki kredit karta raqamlari kabi shaxsiy axborotlaringiz ushbu sahifaga ulashilganida xavfsiz boʻlmasligi mumkin.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">Bu veb-sayt xavfsiz ulanishdan foydalanmaydi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">Xavfsizlikka oid xato</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">Nimadir xato ketdi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009d">Yopish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">Siz koʻrayotgan veb-sayt tashqi ilovani ochishga urinmoqda. Davom etasizmi?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">Davom etish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">Siz ilovamizni tark etyapsiz</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">Bu biz tuzatish ustida ishlayotgan texnik xato sababli boʻlishi mumkin. Bu sahifani qayta yuklab koʻring.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">Yangilash</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">Sahifa ayni vaqtda mavjud emas</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">Familiya</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">Sahifa yuklanmadi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a8">Quyidagi orqali ochish:</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">%1$s ilovasida ochish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">Boshqa parametrlar</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">Ism</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">Butun ekran rejimi yoqildi. Bu rejimdan chiqish uchun chapga suring yoki Orqaga tugmasini bosing.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c3">Ayni damda %2$s ilovasi uchun %1$s tilini oʻrnatib boʻlmayapti. Qayta urining yoki %2$s ilovasidan hozircha ingliz tilida (AQSH) foydalaning.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">Biroz kuting. %1$s oʻrnatilmoqda...</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f1">Qayta urinish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f2">Ingliz (AQSH) tiliga oʻtish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f3">Bekor qilish</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f4">Karta qoʻshish uchun bosing</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">Koʻzoynagingiz ulandi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">Telefon</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">Vaqtni sozlash</string>
</resources>
