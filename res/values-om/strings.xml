<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="APKTOOL_DUMMYVAL_0x7f130008">Akkaawontii beeksisaa keessan irraa kaardii ofumaanii guutuu?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002c">Iyyaafataa Cufii</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002e">%1$s kaameraa fi qaaqiyyee meeshaa keetii fayyadamuu barbaada.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13002f">%1$s kaameraa meeshaa keetii fayyadamuu barbaada.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130030">%1$s argama meeshaa keetii fayyadamuu barbaada.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130031">%1$s qaaqiyyee meeshaa keetii fayyadamuu barbaada.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130032">Maaloo miidiyaaleen hundi filannoo faayilii akka fayyadaman hayyami</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130033">Eeyyamuu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130034">Ugguri</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130035">Biraawuzerii xiqqeessi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130036">"Duubatti deebi'i"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130037">Gara fuulduraatti</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130038">"Rakkoon ragaa nageenyaa marsariitii kanaa irratti mul'atu jira"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130039">Gara marsariitii itti fufi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003a">"Rakkoon ragaa nageenyaa %1$s itti fayyadamu irratti mul'atu jira. Odeeffannoon kan dhuunfaa keessan kan akka jecha darbii ykn lakkoofsa Kaardii Kireeditii yeroo marsariitii kana waliin qoodamu nageenya qabaachuu dhiisuu danda’a."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003b">Marsariitii kun qunnamtii nageenya qabu fayyadamaa hin jiru.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003c">Dogoggora nageenyaa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003d">Mata duree</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003e">Balleessi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13003f">Marsariitiin isin ilaalaa jirtan appilikeeshinii alarraa irratti banuuf yaalaa jira. Itti fufuu barbaadduu?</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13009e">Itti fufi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a1">Appilikeeshinii keenya keessaa bahaa jirtu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a2">"Kun tarii sababa rakkoo teeknikaa nuti furuudhaaf yaalaa jirruuf ta'uu mala. Fuula kana irradeebiin fe'uu yaali."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a3">Haaromsi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a4">Fuulli yeroo ammaa kana hin argamu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a5">"Toori fuula hin fe'amne"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a6">Waliin banaa …</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a7">%1$s keessatti banaa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300a9">Filannoowwan dabalataa</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300aa">"Amma iskiriinii guutuu argaa jirta. Keessaa bahuuf bitaatti haxaa'i ykn qabduu duubattii tuqi."</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ab">Geessituu waayessaa. Tarree geessituu marsariitiiwwan kanaan dura daawwattan argachuuf dachaa lama tuqaa.</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300ac">Dhiisi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300c8">Cufi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f5">Kaardii dabaluuf tuqi</string>
    <string name="APKTOOL_DUMMYVAL_0x7f1300f6">"Teessoo kaffaltii deddeebisa wajjin tokko ta'e mirkaneessi"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010a">[biraandii kaardii ykn dhiyeessaa] suuraa kaardii</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13010d">"Odeeffannoo fi too'annoolee ofumaan guutuu bal'isi"</string>
    <string name="APKTOOL_DUMMYVAL_0x7f130149">Dabalataan baradhu</string>
    <string name="APKTOOL_DUMMYVAL_0x7f13014a">Fuulleewwan kee quunnamsiifameera</string>
</resources>
