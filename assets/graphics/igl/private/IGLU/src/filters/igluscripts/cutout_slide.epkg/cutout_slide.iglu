[Filter IgluscriptCutoutSlideFilter]

# Hermite smoothstep — ease-in-out
fun smoothstep(f32 t) f32 {
  return t * t * (3.0 - 2.0 * t);
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {directionX = 0.0, min = -1.0, max = 1.0, description = "Horizontal slide direction (-1=left, 1=right, 0=none)"},
    {directionY = -1.0, min = -1.0, max = 1.0, description = "Vertical slide direction (-1=up, 1=down, 0=none)"},
    {iterations = 4.0, min = 1.0, max = 10.0, description = "Number of visible passes before settling"},
    {outro = 0.0, min = 0.0, max = 1.0, description = "0 = In, 1 = Out"},
  };

  filter.passes = {
    {
      name = 'dirBlur,
      inputs = {'default},
      uniforms = {
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = blurGlsl,
    },
    {
      name = 'slideFx,
      inputs = {'dirBlur},
      uniforms = {
        position = {0.0, 0.0},
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = glsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  f32 outro = getParameterFloat('outro);
  if (outro > 0.5) { p = 1.0 - p; }

  f32 eased = smoothstep(p);
  f32 iters = getParameterFloat('iterations);
  f32 dirX = getParameterFloat('directionX);
  f32 dirY = getParameterFloat('directionY);

  # slideFx hoists the cross-axis half of its edge clip out of the nine-tap loop,
  # which only holds while the taps move along a single axis. Snap the direction to
  # its dominant axis; every shipping wrapper already passes a pure axis.
  if (abs(dirX) >= abs(dirY)) {
    dirY = 0.0;
  } else {
    dirX = 0.0;
  }
  vec2 dir = {dirX, dirY};

  # Divide animation into phases:
  # Phases 0..N-2: full crossings (position goes -1 to +1)
  # Phase N-1: final settle (position goes -1 to 0)
  f32 totalPhases = iters;
  f32 scaledP = eased * totalPhases;

  # Clamp to prevent overflow at p=1
  f32 phase = floor(clamp(scaledP, 0.0, totalPhases - 0.001));
  f32 phaseP = scaledP - phase;

  f32 offset = 0.0;
  if (phase < totalPhases - 1.0) {
    # Crossing phase: offset sweeps from -1 to +1 (full pass-through)
    offset = 0.0 - 1.0 + phaseP * 2.0;
  } else {
    # Final settle: offset goes from -1 to 0
    offset = 0.0 - 1.0 + phaseP;
  }

  # Apply offset along direction axis
  f32 posX = dir.x * offset;
  f32 posY = dir.y * offset;
  vec2 pos = {posX, posY};

  # Tangent of movement curve drives ghosting
  # d(smoothstep)/dp = 6p(1-p), scaled by phases and phase multiplier
  f32 dpdt = 6.0 * p * (1.0 - p);
  f32 phaseMul = 2.0;
  if (phase >= totalPhases - 1.0) { phaseMul = 1.0; }
  f32 tangent = phaseMul * totalPhases * dpdt;

  # Normalize tangent to 0-1 (max tangent = 3 * totalPhases at p=0.5 crossing)
  f32 maxTangent = 3.0 * totalPhases;
  f32 tangentNorm = clamp(tangent / maxTangent, 0.0, 1.0);

  # Ghost spread: 0 to 2 texels per step, in UV space
  vec2 size = getTextureSize('default);
  f32 texelSize = abs(dir.x) / size.x + abs(dir.y) / size.y;
  f32 ghostSpread = tangentNorm * 10.0 * texelSize;

  # Spread measured in texels of the slide axis. Below a quarter texel all nine
  # taps land on the same pixel, so pin dirBlur's spread to exactly 0 and let it
  # take its single-tap path. slideFx keeps the unpinned spread: its alpha-over
  # accumulator is not a weighted mean, so it has no equivalent single-tap form.
  f32 axisSize = size.y;
  if (abs(dir.x) > 0.0) { axisSize = size.x; }
  f32 blurSpread = ghostSpread;
  if (ghostSpread * axisSize < 0.25) { blurSpread = 0.0; }

  setShaderUniform('dirBlur, 'ghostSpread, blurSpread);
  setShaderUniform('dirBlur, 'ghostDir, dir);
  setShaderUniform('slideFx, 'position, pos);
  setShaderUniform('slideFx, 'ghostSpread, ghostSpread*0.5);
  setShaderUniform('slideFx, 'ghostDir, dir);
}

string blurGlsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float ghostSpread;
uniform vec2 ghostDir;

void main() {
  vec2 uv = sourceTextureCoordinate;

  // preRender pins ghostSpread to 0 whenever the blur would be sub-texel, so the
  // settled frames cost one tap - and one colour-space conversion of the source -
  // instead of nine. Uniform branch: every fragment takes the same side.
  if (ghostSpread <= 0.0) {
    gl_FragColor = toOutputFormat(sampleInput(uv));
    return;
  }

  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  vec2 stepUV = ghostDir * ghostSpread;

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    float weight = 1.0 / (1.0 + 2.0 * abs(fi));
    color += sampleInput(uv + stepUV * fi) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(color / totalWeight);
}
";

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform vec2 position;
uniform float ghostSpread;
uniform vec2 ghostDir;

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec2 shifted = uv - position;

  // preRender snaps ghostDir to its dominant axis, so the taps move along one
  // coordinate only. Fall back to y when the direction is zero: the step is zero
  // there anyway, so either choice yields the same clip.
  vec2 axis = vec2(0.0, 1.0);
  if (abs(ghostDir.x) > 0.0) { axis = vec2(1.0, 0.0); }

  vec2 stepUV = ghostDir * ghostSpread;
  float m = dot(shifted, axis);
  float stepM = dot(stepUV, axis);

  // position sweeps the cutout from fully offscreen, across the frame and back
  // out again, iterations times, so for much of each crossing every tap lands
  // outside [0,1], every ga comes out 0 and the alpha-over accumulator never
  // leaves vec4(0). Reject before paying nine fetches for it. Only the whole
  // kernel being outside counts, so no partially covered pixel is touched.
  // ghostDir is axis-aligned, so the cutout covers a contiguous slab and the
  // branch is coherent across a warp.
  float reach = 4.0 * abs(stepM);
  if (min(m, 1.0 - m) < -reach) {
    gl_FragColor = toOutputFormat(vec4(0.0));
    return;
  }

  // step(0,v) * step(v,1) is exactly step(0, min(v,1-v)) - both are 1 only inside
  // [0,1]. And the taps move along one axis, so the cross-axis half of the clip is
  // identical for all nine of them; hoist it out of the loop.
  vec2 d = min(shifted, 1.0 - shifted);
  float caCross = step(0.0, dot(d, 1.0 - axis));

  // Ghost trail — 4 samples behind, main, 4 samples ahead
  // Each successive ghost falls off by 0.9x
  vec4 color = vec4(0.0);

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 gUV = shifted - stepUV * fi;
    float gm = m - stepM * fi;
    float ga = caCross * step(0.0, min(gm, 1.0 - gm));
    vec4 sample_color = sampleInput(gUV) * ga;

    // Logarithmic alpha taper: fixed curve, only spread scales with speed.
    // sqrt(1/(1+k|i|)) is inversesqrt(1+k|i|): one instruction, no divide or pow.
    sample_color *= inversesqrt(1.0 + 2.0 * abs(fi));

    // Alpha-over blend: src over dst
    color = color * (1.0 - sample_color.a) + sample_color;
  }

  gl_FragColor = toOutputFormat(color);
}
";
