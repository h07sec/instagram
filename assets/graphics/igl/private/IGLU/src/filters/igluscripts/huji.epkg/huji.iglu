[Filter Huji]
# "Huji" ported from the Spark effect (8268054849935608). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.5.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Overlay: 'huji_leak1 screen-blended full-frame at 0.767.
#   Overlay: 'huji_leak2 screen-blended full-frame at 0.74.
#   Overlay: 'huji_date screen-blended full-frame at 1.
#   The date stamp is Spark's static image (a fixed date), not Dynamic Text. Spark's black multiply at 0.1 is baked into the LUT (x0.9), so it lands before the leaks instead of after (difference is small).
#   Not ported: the face-tracked deform, lip tint, blush and under-eye layers (no face mesh in IGLUScript).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('huji_lut);
    makeTexture('huji_leak1);
    makeTexture('huji_leak2);
    makeTexture('huji_date);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {leak1_opacity = 0.767, min = 0.0, max = 1.0, description = "Opacity of the leak1 overlay"},
        {leak2_opacity = 0.74, min = 0.0, max = 1.0, description = "Opacity of the leak2 overlay"},
        {date_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the date overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'huji_lut, 'huji_leak1, 'huji_leak2, 'huji_date},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.5,
        leak1_opacity = 0.767,
        leak2_opacity = 0.74,
        date_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslHuji,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string huji_lut_path = "huji_lut_path";
string huji_lut_filename = "";
string huji_leak1_path = "huji_leak1_path";
string huji_leak1_filename = "";
string huji_leak2_path = "huji_leak2_path";
string huji_leak2_filename = "";
string huji_date_path = "huji_date_path";
string huji_date_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; huji_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(huji_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != huji_lut_filename) {
            huji_lut_filename = new_lut;
            loadTexture('huji_lut, huji_lut_filename);
        }
    }

    string huji_leak1_param = getParameterString(huji_leak1_path);
    if (huji_leak1_param != "") {
        string new_huji_leak1 = stringAppend("textureFilePath://", huji_leak1_param);
        if (new_huji_leak1 != huji_leak1_filename) {
            huji_leak1_filename = new_huji_leak1;
            loadTexture('huji_leak1, huji_leak1_filename);
        }
    }
    string huji_leak2_param = getParameterString(huji_leak2_path);
    if (huji_leak2_param != "") {
        string new_huji_leak2 = stringAppend("textureFilePath://", huji_leak2_param);
        if (new_huji_leak2 != huji_leak2_filename) {
            huji_leak2_filename = new_huji_leak2;
            loadTexture('huji_leak2, huji_leak2_filename);
        }
    }
    string huji_date_param = getParameterString(huji_date_path);
    if (huji_date_param != "") {
        string new_huji_date = stringAppend("textureFilePath://", huji_date_param);
        if (new_huji_date != huji_date_filename) {
            huji_date_filename = new_huji_date;
            loadTexture('huji_date, huji_date_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'leak1_opacity, getParameterFloat('leak1_opacity));
    setShaderUniform('pass0, 'leak2_opacity, getParameterFloat('leak2_opacity));
    setShaderUniform('pass0, 'date_opacity, getParameterFloat('date_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslHuji = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'huji_lut
    uniform sampler2D auxSampler2;  // 'huji_leak1
    uniform sampler2D auxSampler3;  // 'huji_leak2
    uniform sampler2D auxSampler4;  // 'huji_date

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float leak1_opacity;
    uniform float leak2_opacity;
    uniform float date_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'huji_leak1 (screen), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('huji_leak1).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), leak1_opacity * strength);
      }
      // Full-frame overlay 'huji_leak2 (screen), authored top-origin.
      {
        // auxSampler3 = pass input 4 ('huji_leak2).
        vec4 ov = texture2D(auxSampler3, topUv(uv));
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), leak2_opacity * strength);
      }
      // Full-frame overlay 'huji_date (screen), authored top-origin.
      {
        // auxSampler4 = pass input 5 ('huji_date).
        vec4 ov = texture2D(auxSampler4, topUv(uv));
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), date_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
