[Filter TransitionMulticlipNegativeFlicker]
# Source AE collect02, checked 2026-10-22. Prototype, not a shipped Edits identity.
[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.parameters={
    {duration=0.333333333333,min=0.1,max=5.0,description="Duration"},
    {intensity=1.0,min=0.0,max=1.0,description="Intensity"},
  };
  filter.passes={
    {name='negative,inputs={'default,'transition},shaderInputNames={'default,'s_texture1},uniforms={showB=0.0,scale=1.0,opacity=0.0,strobe=0.0,sameUV=1.0},glslShader=negativeGlsl},
  };
}
fun cubic(f32 a, f32 b, f32 u) f32 {
  f32 v = 1.0 - u;
  return 3.0*v*v*u*a + 3.0*v*u*u*b + u*u*u;
}
fun segment(f32 t, f32 t0, f32 v0, f32 t1, f32 v1, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 u = clamp((t-t0)/(t1-t0), 0.0, 1.0);
  f32 lo = 0.0;
  f32 hi = 1.0;
  f32 s = u;
  f32 i = 0.0;
  while (i < 20.0) {
    s = (lo+hi)*0.5;
    if (cubic(x1,x2,s) < u) { lo=s; } else { hi=s; }
    i=i+1.0;
  }
  f32 r = v0+(v1-v0)*cubic(y1,y2,s);
  if (t <= t0) { r=v0; }
  if (t >= t1) { r=v1; }
  return r;
}
fun opacityAt(f32 t) f32 {
  f32 r = 0.0;
  if (t >= 0.6) { r=0.0+(100.0-0.0)*clamp((t-0.6)/0.083333333333,0.0,1.0); }
  if (t >= 0.683333333333) { r=100.0; }
  if (t >= 0.783333333333) { r=100.0+(0.0-100.0)*clamp((t-0.783333333333)/0.15,0.0,1.0); }
  if (t >= 0.933333333333) { r=0.0; }
  return r;
}
fun scaleAt(f32 t) f32 {
  f32 r = 100.0;
  if (t >= 0.633333333333) { r=100.0+(133.0-100.0)*clamp((t-0.633333333333)/0.016666666667,0.0,1.0); }
  if (t >= 0.65) { r=133.0; }
  if (t >= 0.783333333333) { r=133.0+(100.0-133.0)*clamp((t-0.783333333333)/0.016666666667,0.0,1.0); }
  if (t >= 0.8) { r=100.0; }
  return r;
}
[PreRender]
fun preRender(Filter filter) {
 f32 p=clamp(max(getParameterFloat('progress),getParameterFloat('transition_progress)),0.0,1.0);
 f32 t=0.6+p*0.333333333333;
 f32 b=0.0;if(t >= 0.766666666667) {b=1.0;}
 f32 s=0.0;if(fract(t/0.15)*0.15 < 0.07) {s=1.0;}
 f32 op=opacityAt(t)*0.01*getParameterFloat('intensity);
 if(p<=0.0 or p>=1.0) {op=0.0;}
 f32 sc=scaleAt(t)*0.01;
 f32 sameUV=0.0;if(sc == 1.0) {sameUV=1.0;}
 setShaderUniform('negative,'showB,b);setShaderUniform('negative,'scale,sc);
 setShaderUniform('negative,'opacity,op);setShaderUniform('negative,'strobe,s);
 setShaderUniform('negative,'sameUV,sameUV);
}
string negativeGlsl="
precision highp float;
varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;
uniform sampler2D s_texture1;
uniform float showB;
vec4 current(vec2 uv) {
  if (showB > 0.5) return texture2D(s_texture1,uv);
  return sampleInput(uv);
}
uniform float scale;
uniform float opacity;
uniform float strobe;
// 1.0 when scale is exactly 1, so the zoomed sample is the source sample.
uniform float sameUV;
void main(){
 vec2 uv=sourceTextureCoordinate;
 if(opacity<=0.0){gl_FragColor=toOutputFormat(current(uv));return;}
 vec4 zoomed=current((uv-0.5)/scale+0.5);
 vec4 fx=zoomed;
 if(strobe>0.5){fx.rgb=vec3(fx.a);}else{fx.rgb=vec3(fx.a)-fx.rgb;}
 vec4 color=fx;
 if(opacity<1.0){
  vec4 src=zoomed;
  if(sameUV<0.5){src=current(uv);}
  color=mix(src,fx,opacity);
 }
 gl_FragColor=toOutputFormat(color);
}";
