[Filter PurpleGrains]
# "purple grains" (Spark 884676869115109), SCRATCH port of the screen-space layer. Single fragment pass.
#
#   Spark: canvas0/rectangle0 (100% x 100% of the 390x844 canvas), material0 defaultMaterial, unlit,
#   blend multiply, opacity 0.4: Purple_Texture (1024x1024 purple noise) stretched over the frame.
#   Multiply with a premultiplied source: dst * (1 - a + a * tex), a = 0.4.
#   Dropped: fullScreen skin smoothing 0.5 (faceMesh0 retouch). White.noise.b.w is packaged but unused.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('purple_grains_texture);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'purple_grains_texture},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslPurpleGrains,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string purple_grains_texture_path = "purple_grains_texture_path";
string purple_grains_texture_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote texture under the generic 'lut_path; purple_grains_texture_path is for local testing.
    string tex_param = getParameterString(lut_path);
    if (tex_param == "") {
        tex_param = getParameterString(purple_grains_texture_path);
    }
    if (tex_param != "") {
        string new_tex = stringAppend("textureFilePath://", tex_param);
        if (new_tex != purple_grains_texture_filename) {
            purple_grains_texture_filename = new_tex;
            loadTexture('purple_grains_texture, purple_grains_texture_filename);
        }
    }
}

#### GLSL shader ####

string glslPurpleGrains = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'purple_grains_texture (Purple_Texture, 1024x1024)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    const float kOpacity = 0.4;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 tex = texture2D(auxSampler1, topUv(uv)).rgb;
      vec3 col = clamp(cam.rgb, 0.0, 1.0) * (1.0 - kOpacity + kOpacity * tex);
      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
