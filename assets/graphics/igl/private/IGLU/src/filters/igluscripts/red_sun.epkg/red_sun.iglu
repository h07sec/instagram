[Filter RedSun]
# "Red Sun" (Spark 571681700240476), SCRATCH NO-FACE port. Single fragment pass, no assets.
#
#   Spark: one processor Shader Render Pass running lighting_shader.sca on the camera, then the final pass copies it.
#     luma (0.2989, 0.587, 0.114) -> *brightness 1.17846 -> contrast 1.92506 about 0.5 -> * colour (1, 0, 0)
#     -> * smoothstep(0.6491, -0.16865, distance(uv * (W/H, 0.75), centre)) vignette
#     -> * intro ramp (2 s from effect start: flash, then 3x easing back to 1x, pow 0.1)
#     -> * (1 + 0.2 * pulse / 100), pulse from script.js on a 5 s looped timeDriver (progress = t mod 5 / 5).
#   The packaged ray-star shader (shaderCodeAsset: color1, color2, armCount) has no consumer in the graph: not ported.
#   No face objects in the effect.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        strength = 1.0,
        time = 0.0,
        texSize = {1080.0, 1920.0},
      },
      glslShader = glslRedSun,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 sz = getTextureSize('default);
    if (sz.x > 0.0) {
        setShaderUniform('pass0, 'texSize, sz);
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslRedSun = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;
    uniform vec2 texSize;

    const vec3 kColor = vec3(1.0, 0.0, 0.0);
    const float kBrightness = 1.17846;
    const float kContrast = 1.92506;
    const float kVigMax = 0.6491;
    const float kVigMin = -0.16865;

    // GLSL smoothstep with edge0 > edge1 is undefined; this is the formula drivers use for it.
    float smoothstepAny(float e0, float e1, float x) {
      float s = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
      return s * s * (3.0 - 2.0 * s);
    }

    float introRamp(float effectTime) {
      float rampTime = 2.0;
      float rampTimeFirst = rampTime * 0.25;
      float maxEx = 3.0;
      float t = min(effectTime, rampTime);
      float rampUp;
      if (t > rampTimeFirst) {
        float v = (t - rampTimeFirst) / (rampTime - rampTimeFirst);
        v = pow(v, 0.1);
        rampUp = maxEx - (maxEx - 1.0) * v;
      } else {
        float v = t / rampTimeFirst;
        v = v * v;
        if (v > 0.2 && v < 0.75) {
          v *= 18.18383;
          v = clamp(fract(v), 0.2, 1.0);
        }
        rampUp = maxEx * v;
      }
      return rampUp;
    }

    // script.js setupPulse on progress = 5 s looped timeDriver. Reactive mod/floor/round on non-negative values.
    float pulse(float t) {
      float p = mod(t, 5.0) / 5.0;
      float a = mod(p * (p < 0.5 ? 1.0 : 0.0) * 100.0, 2.0) * 20.0;
      float inB = (p >= 0.15 && p < 0.2) ? 1.0 : 0.0;
      float b = mod(floor(p * inB * 100.0), 2.0) * 100.0 * 0.5 + 50.0;
      float inC = (p >= 0.2 && p < 1.0) ? 1.0 : 0.0;
      float c = 100.0 - mod(floor(p * inC * 100.0 + 0.5), 2.0) * 10.0;
      return a + b + c;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched.
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      float l = dot(cam.rgb, vec3(0.2989, 0.587, 0.114));
      l = (l * kBrightness - 0.5) * kContrast + 0.5;
      vec3 col = l * kColor;
      vec2 ratio = vec2(texSize.x / texSize.y, 0.75);
      float d = distance(uv * ratio, vec2(0.5) * ratio);
      col *= smoothstepAny(kVigMax, kVigMin, d);
      col *= introRamp(time);
      col *= 1.0 + (0.2 * pulse(time)) / 100.0;
      // Spark writes the pass into an 8-bit target, so its visible result is clamped before strength mixes it in.
      col = clamp(col, 0.0, 1.0);
      gl_FragColor = toOutputFormat(vec4(clamp(mix(cam.rgb, col, strength), 0.0, 1.0), cam.a));
    }
    ";
