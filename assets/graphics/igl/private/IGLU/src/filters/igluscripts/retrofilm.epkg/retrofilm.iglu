[Filter RetroFilm]
# "RetroFilm" (Spark 318235965536449), SCRATCH NO-FACE port. Twelve passes, 10 fps hold through a history texture.
#
#   Spark chain (main.json renderPasses + preProc / postProc / lowFps / colorLUTShader .sca):
#     preProc 1  cam -> sMean2x2 (1/2): 2x2 box at +-1 camera px, alpha = luma (0.2989, 0.587, 0.114).
#     preProc 2  -> sMean4x4 (1/4): box at +-2 camera px.
#     preProc 3  -> sBA (1/8): guided filter, 5x5 taps of sMean4x4 every 4 camera px, eps 0.025.
#     preProc 4  -> sMeanBA (1/8): 5x5 mean of sBA, same taps.
#     preProc 5/6 sMean4x4 -> gauss H -> gauss V (1/4): kernel int(20 * 0.45805) = 9, sigma 0.26593 * 8, 1 quarter-res texel.
#     preProc 7  cam -> pre-final: mix(cam, meanBA.a * cam + meanBA.rgb, 0.65); rows with |y - 0.5| > 0.50372 * W/H
#                fade to the gauss V blur over 0.1.
#     LUT copy   512x32 colour LUT (nearest) -> 256x16 target; baked offline as retrofilm_lut.png (texel 2i+1, 2j+1).
#     postProc 1 16^3 LUT (2 slices), colour wash (softlight blue / red, curve over 0.25 t), scratches (screen, stage
#                floor(fract(t) * 8)), noise 0.15, clamp, film border mixed by its alpha.
#     postProc 2 jitter (mod(0.5 t, 0.0013), mod(0.5 t, 0.0025)), chromatic aberration 0.00047 (Lab round trip),
#                roll in the last 7.1 % of a 4.95597 s loop, x 1.1.
#     hold       script.js: Time.ms.interval(33), update on ticks 0, 3, 6, ... (10 fps); non-update frames show the
#                previous output (Delay Frame + lowFps). Here: 'hold reads its own history ('prevHold, depth 1).
#   Spark processor uv is bottom-origin; loaded textures are sampled in Spark texture space (v = 0 is the image top).
#   No face objects in the effect.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('retrofilm_lut);
    makeTexture('retrofilm_film);
    makeTexture('retrofilm_scratch);
    makeHistoricalTexture('prevHold, 'hold);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'm2,
      inputs = {'default},
      scale = {0.5, 0.5},
      bufferType = 'uint8,
      uniforms = { camTexel = {0.000925926, 0.000520833} },
      glslShader = glslMean2,
    }, {
      name = 'm4,
      inputs = {'default, 'm2},
      scale = {0.25, 0.25},
      bufferType = 'uint8,
      uniforms = { camTexel = {0.000925926, 0.000520833} },
      glslShader = glslMean4,
    }, {
      name = 'ba,
      inputs = {'default, 'm4},
      scale = {0.125, 0.125},
      bufferType = 'uint8,
      uniforms = { camTexel = {0.000925926, 0.000520833}, guided = 1.0 },
      glslShader = glslGuided,
    }, {
      name = 'mba,
      inputs = {'default, 'ba},
      scale = {0.125, 0.125},
      bufferType = 'uint8,
      uniforms = { camTexel = {0.000925926, 0.000520833}, guided = 0.0 },
      glslShader = glslGuided,
    }, {
      name = 'gh,
      inputs = {'default, 'm4},
      scale = {0.25, 0.25},
      bufferType = 'uint8,
      uniforms = { dirX = 1.0, dirY = 0.0 },
      glslShader = glslGauss,
    }, {
      name = 'gv,
      inputs = {'default, 'gh},
      scale = {0.25, 0.25},
      bufferType = 'uint8,
      uniforms = { dirX = 0.0, dirY = 1.0 },
      glslShader = glslGauss,
    }, {
      name = 'pre,
      inputs = {'default, 'mba, 'gv},
      bufferType = 'uint8,
      glslShader = glslPre,
    }, {
      name = 'post1,
      inputs = {'pre, 'retrofilm_lut, 'retrofilm_film, 'retrofilm_scratch},
      bufferType = 'uint8,
      uniforms = { time = 0.0 },
      glslShader = glslPost1,
    }, {
      name = 'post2,
      inputs = {'post1},
      bufferType = 'uint8,
      uniforms = { time = 0.0 },
      glslShader = glslPost2,
    }, {
      name = 'hold,
      inputs = {'post2, 'prevHold},
      bufferType = 'uint8,
      uniforms = { updateFrame = 1.0 },
      glslShader = glslHold,
    }, {
      name = 'pass0,
      inputs = {'default, 'hold},
      uniforms = { strength = 1.0 },
      glslShader = glslFinal,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string retrofilm_lut_path = "retrofilm_lut_path";
string retrofilm_film_path = "retrofilm_film_path";
string retrofilm_scratch_path = "retrofilm_scratch_path";
string retrofilm_lut_filename = "";
string retrofilm_film_filename = "";
string retrofilm_scratch_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    string p = getParameterString(retrofilm_lut_path);
    if (p != "") {
        string f = stringAppend("textureFilePath://", p);
        if (f != retrofilm_lut_filename) {
            retrofilm_lut_filename = f;
            loadTexture('retrofilm_lut, retrofilm_lut_filename);
        }
    }
    string pf = getParameterString(retrofilm_film_path);
    if (pf != "") {
        string ff = stringAppend("textureFilePath://", pf);
        if (ff != retrofilm_film_filename) {
            retrofilm_film_filename = ff;
            loadTexture('retrofilm_film, retrofilm_film_filename);
        }
    }
    string ps = getParameterString(retrofilm_scratch_path);
    if (ps != "") {
        string fs = stringAppend("textureFilePath://", ps);
        if (fs != retrofilm_scratch_filename) {
            retrofilm_scratch_filename = fs;
            loadTexture('retrofilm_scratch, retrofilm_scratch_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 sz = getTextureSize('default);
    if (sz.x > 0.0) {
        f32 tx = 1.0 / sz.x;
        f32 ty = 1.0 / sz.y;
        vec2 texel = {tx, ty};
        setShaderUniform('m2, 'camTexel, texel);
        setShaderUniform('m4, 'camTexel, texel);
        setShaderUniform('ba, 'camTexel, texel);
        setShaderUniform('mba, 'camTexel, texel);
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('post1, 'time, t);
    setShaderUniform('post2, 'time, t);

    # script.js: tick k = floor(t / 33 ms); the frame updates before the first tick and on ticks 1, 4, 7, ...
    f32 k = floor(t / 0.033);
    f32 upd = 0.0;
    if (k < 1.0) {
        upd = 1.0;
    }
    if (k >= 1.0) {
        f32 km = k - 1.0;
        f32 rem = km - 3.0 * floor(km / 3.0);
        if (rem < 0.5) {
            upd = 1.0;
        }
    }
    setShaderUniform('hold, 'updateFrame, upd);
}

#### GLSL shaders ####

string glslMean2 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform vec2 camTexel;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 d = camTexel;
      vec3 c = 0.25 * (sampleInput(uv + vec2(-d.x, -d.y)).rgb + sampleInput(uv + vec2(d.x, -d.y)).rgb +
                       sampleInput(uv + vec2(-d.x, d.y)).rgb + sampleInput(uv + vec2(d.x, d.y)).rgb);
      gl_FragColor = vec4(clamp(c, 0.0, 1.0), dot(c, vec3(0.2989, 0.5870, 0.1140)));
    }
    ";

string glslMean4 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // data input, read raw (alpha carries data)
    uniform vec2 camTexel;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 d = 2.0 * camTexel;
      vec4 c = 0.25 * (texture2D(auxSampler1, uv + vec2(-d.x, -d.y)) + texture2D(auxSampler1, uv + vec2(d.x, -d.y)) +
                       texture2D(auxSampler1, uv + vec2(-d.x, d.y)) + texture2D(auxSampler1, uv + vec2(d.x, d.y)));
      gl_FragColor = clamp(c, 0.0, 1.0);
    }
    ";

# preProc passes 3 (guided = 1) and 4 (guided = 0): 5x5 taps every 4 camera px around uv.
string glslGuided = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // data input, read raw (alpha carries data)
    uniform vec2 camTexel;
    uniform float guided;

    void main() {
      vec2 duv = 4.0 * camTexel;
      vec2 uv0 = sourceTextureCoordinate - duv * 2.0;
      vec4 mean = vec4(0.0);
      vec4 corr = vec4(0.0);
      for (int j = 0; j < 5; j++) {
        for (int i = 0; i < 5; i++) {
          vec4 t = texture2D(auxSampler1, uv0 + duv * vec2(float(i), float(j)));
          mean += t;
          corr += t.w * t;
        }
      }
      mean *= 1.0 / 25.0;
      corr *= 1.0 / 25.0;
      vec4 c = mean;
      if (guided > 0.5) {
        vec4 v = corr - mean.w * mean;
        float eps2 = 0.025 * 0.025;
        float a = max(0.0, v.w / (v.w + eps2));
        c = vec4(mean.xyz - a * mean.xyz, a);
      }
      gl_FragColor = clamp(c, 0.0, 1.0);
    }
    ";

# preProc gaussianFilter1D, kernelSize 9, sigma 0.26593 * 8, bilinear-merged taps, one texel of this pass.
string glslGauss = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // data input, read raw
    uniform vec2 outputSize;
    uniform float dirX;
    uniform float dirY;

    float gw(float x) {
      float s = 0.26593 * 8.0;
      return exp(-0.5 * x * x / (s * s));
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 duv = vec2(dirX, dirY) / outputSize;
      float x = -4.0;
      float w = gw(x);
      vec4 acc = w * texture2D(auxSampler1, uv + x * duv);
      float wsum = w;
      for (int i = 1; i < 9; i += 2) {
        float x0 = -4.0 + float(i);
        float w0 = gw(x0);
        float w1 = gw(x0 + 1.0);
        float ws = w0 + w1;
        acc += ws * texture2D(auxSampler1, uv + (x0 + w1 / ws) * duv);
        wsum += ws;
      }
      gl_FragColor = clamp(acc / wsum, 0.0, 1.0);
    }
    ";

string glslPre = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'mba
    uniform sampler2D auxSampler2;  // 'gv
    uniform vec2 outputSize;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 base = sampleInput(uv);
      vec4 ab = texture2D(auxSampler1, uv);
      vec3 c = mix(base.rgb, ab.w * base.rgb + ab.rgb, 0.65);
      float dist = abs(uv.y - 0.5) - 0.50372 * outputSize.x / outputSize.y;
      if (dist > 0.0) {
        c = mix(c, texture2D(auxSampler2, uv).rgb, clamp(dist / 0.1, 0.0, 1.0));
      }
      gl_FragColor = vec4(clamp(c, 0.0, 1.0), 1.0);
    }
    ";

string glslPost1 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'retrofilm_lut (256x16, 16 slices of 16x16)
    uniform sampler2D auxSampler2;  // 'retrofilm_film (border, alpha)
    uniform sampler2D auxSampler3;  // 'retrofilm_scratch
    uniform float time;

    // postProc phSoftLight, including its sign() == 0 case (s == 0.5 takes half of pos plus all of neg).
    vec3 softLight(vec3 d, vec3 s) {
      vec3 m = sign(s - 0.5);
      vec3 mp = (m + 1.0) * 0.5;
      vec3 mn = ceil(-(m - 1.0) * 0.5);
      return mp * (1.0 - (1.0 - d) * (1.0 - (s - 0.5))) + mn * d * (s + 0.5);
    }

    vec2 scratchUv(vec2 uv, float stage) {
      vec2 n = uv;
      if (stage > 3.5) { n = uv.yx; stage -= 4.0; }
      if (stage < 0.5) { return mod(n, 1.0); }
      if (stage < 1.5) { return mod(vec2(n.x, 1.0 - n.y), 1.0); }
      if (stage < 2.5) { return mod(vec2(1.0 - n.x, 1.0 - n.y), 1.0); }
      return mod(vec2(1.0 - n.x, n.y), 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // Spark processor uv (bottom-origin).
      vec2 s = uv;
      if (UP < 0.0) { s.y = 1.0 - s.y; }
      vec3 c = sampleInput(uv).rgb;

      vec3 sc = c * 15.0;
      float bf = fract(sc.z);
      vec2 tc = (0.5 + sc.xy) * vec2(1.0 / 256.0, 1.0 / 16.0);
      tc.x += (sc.z - bf) / 16.0;
      c = mix(texture2D(auxSampler1, tc).rgb, texture2D(auxSampler1, vec2(tc.x + 1.0 / 16.0, tc.y)).rgb, bf);

      float tt = mod(0.25 * time, 6.28318);
      float st = sin(tt);
      float dist = s.y - (2.0 * st * s.x * s.x + 0.15 * sin(tt * st) * s.x + 1.0 + cos(4.0 * st));
      float cd = clamp(length(s - vec2(0.5)), 0.0, 0.5);
      float ma = 0.5 * (0.26852 + (1.0 - 0.26852) * 2.0 * cd);
      vec3 blue = mix(c, softLight(c, vec3(0.2, 0.2, 0.5)), ma);
      vec3 red = mix(c, softLight(c, vec3(0.75, 0.2, 0.2)), ma);
      if (dist >= 0.0) {
        c = blue;
      } else if (dist > -0.5) {
        c = mix(blue, red, clamp(dist / -0.5, 0.0, 1.0));
      } else {
        c = red;
      }

      vec2 su = scratchUv(s, floor(fract(time) * 8.0));
      vec3 sk = texture2D(auxSampler3, su).rgb;
      c = 1.0 - (1.0 - c) * (1.0 - sk);

      vec2 nuv = su * 4.0;
      float n = fract(sin(dot(nuv, vec2(2.9898, 8.233))) * 63758.123) - 0.5;
      c *= 1.0 + 0.15 * n;
      c = clamp(c, 0.0, 1.0);

      vec4 film = texture2D(auxSampler2, vec2(s.x, 1.0 - s.y));
      c = mix(c, film.rgb, film.a);
      gl_FragColor = vec4(clamp(c, 0.0, 1.0), 1.0);
    }
    ";

string glslPost2 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform float time;

    vec3 rgb2xyz(vec3 c) {
      vec3 t;
      t.x = (c.r > 0.04045) ? pow((c.r + 0.055) / 1.055, 2.4) : c.r / 12.92;
      t.y = (c.g > 0.04045) ? pow((c.g + 0.055) / 1.055, 2.4) : c.g / 12.92;
      t.z = (c.b > 0.04045) ? pow((c.b + 0.055) / 1.055, 2.4) : c.b / 12.92;
      mat3 m = mat3(0.4124, 0.3576, 0.1805, 0.2126, 0.7152, 0.0722, 0.0193, 0.1192, 0.9505);
      return 100.0 * t * m;
    }
    vec3 xyz2lab(vec3 c) {
      vec3 n = c / vec3(95.047, 100.0, 108.883);
      vec3 v;
      v.x = (n.x > 0.008856) ? pow(n.x, 1.0 / 3.0) : (7.787 * n.x) + (16.0 / 116.0);
      v.y = (n.y > 0.008856) ? pow(n.y, 1.0 / 3.0) : (7.787 * n.y) + (16.0 / 116.0);
      v.z = (n.z > 0.008856) ? pow(n.z, 1.0 / 3.0) : (7.787 * n.z) + (16.0 / 116.0);
      return vec3((116.0 * v.y) - 16.0, 500.0 * (v.x - v.y), 200.0 * (v.y - v.z));
    }
    vec3 lab2xyz(vec3 c) {
      float fy = (c.x + 16.0) / 116.0;
      float fx = c.y / 500.0 + fy;
      float fz = fy - c.z / 200.0;
      return vec3(95.047 * ((fx > 0.206897) ? fx * fx * fx : (fx - 16.0 / 116.0) / 7.787),
                  100.000 * ((fy > 0.206897) ? fy * fy * fy : (fy - 16.0 / 116.0) / 7.787),
                  108.883 * ((fz > 0.206897) ? fz * fz * fz : (fz - 16.0 / 116.0) / 7.787));
    }
    vec3 xyz2rgb(vec3 c) {
      mat3 m = mat3(3.2406, -1.5372, -0.4986, -0.9689, 1.8758, 0.0415, 0.0557, -0.2040, 1.0570);
      vec3 v = c / 100.0 * m;
      vec3 r;
      r.x = (v.r > 0.0031308) ? ((1.055 * pow(v.r, (1.0 / 2.4))) - 0.055) : 12.92 * v.r;
      r.y = (v.g > 0.0031308) ? ((1.055 * pow(v.g, (1.0 / 2.4))) - 0.055) : 12.92 * v.g;
      r.z = (v.b > 0.0031308) ? ((1.055 * pow(v.b, (1.0 / 2.4))) - 0.055) : 12.92 * v.b;
      return r;
    }
    vec3 labTrip(vec3 c) {
      vec3 lab = xyz2lab(rgb2xyz(c));
      lab = vec3(lab.x / 100.0, 0.5 + 0.5 * (lab.y / 127.0), 0.5 + 0.5 * (lab.z / 127.0));
      return xyz2rgb(lab2xyz(vec3(100.0 * lab.x, 2.0 * 127.0 * (lab.y - 0.5), 2.0 * 127.0 * (lab.z - 0.5))));
    }

    // s is Spark (bottom-origin) uv; convert back to this backend's sampler space.
    vec3 at(vec2 s) {
      if (UP < 0.0) { s.y = 1.0 - s.y; }
      return sampleInput(s).rgb;
    }

    vec3 ca(vec2 s, float ab) {
      vec2 v = s * 2.0 - 1.0;
      float l2 = dot(v, v);
      vec2 dir = v * inversesqrt(l2);
      // normalizeLength stores the length in z, so the weight is smoothstep of length^2 = l2.
      float w = smoothstep(0.0, 1.0, l2);
      vec2 duv = w * dir + 0.1;
      return vec3(labTrip(at(s + ab * duv * 3.0)).r, labTrip(at(s - ab * duv)).g, labTrip(at(s)).b);
    }

    void main() {
      vec2 s = sourceTextureCoordinate;
      if (UP < 0.0) { s.y = 1.0 - s.y; }
      s += vec2(mod(0.5 * time, 0.0013), mod(0.5 * time, 0.0025));
      float loop = 4.95597;
      float t = mod(time, loop);
      float jump = loop * 0.92873;
      if (t > jump) {
        s.y = mod(s.y - (t - jump) / (loop - jump), 1.0);
      }
      vec3 c = ca(s, 0.00047) * 1.1;
      gl_FragColor = vec4(clamp(c, 0.0, 1.0), 1.0);
    }
    ";

# Spark Delay Frame + lowFps: on non-update frames the output is last frame's output.
string glslHold = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'prevHold (this pass, previous frame)
    uniform bool hasHistory;
    uniform float updateFrame;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      if (updateFrame > 0.5 || !hasHistory) {
        gl_FragColor = vec4(sampleInput(uv).rgb, 1.0);
      } else {
        gl_FragColor = vec4(texture2D(auxSampler1, uv).rgb, 1.0);
      }
    }
    ";

string glslFinal = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'hold
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched.
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 c = texture2D(auxSampler1, uv).rgb;
      gl_FragColor = toOutputFormat(vec4(clamp(mix(cam.rgb, c, strength), 0.0, 1.0), cam.a));
    }
    ";
