# IGLUSCRIPTCOLLISION_BYPASS: IGLUScript port of transition_scanner_vertical, QE-selectable for A/B vs TransitionScannerVerticalFilter.
[Filter TransitionScannerVertical]

[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.passes = {{
    name = 'scanner,
    inputs = {'default, 'transition},
    shaderInputNames = {'default, 's_texture1},
    uniforms = {
      slideBase = 0.0,
      edgeLight = 0.5,
      halfEdge = 0.25,
      brightness = 1.2,
      outerColor = {1.0, 0.9686274510, 0.0470588235, 1.0},
      innerColor = {0.0470588235, 0.9294117647, 0.4745098039, 1.0},
    },
    glslShader = glsl,
  }};

  filter.parameters = {
    {width = 1.0, min = 0.0, max = 2.0, description = "Scanner band width"},
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 progress = getParameterFloat('progress);

  # slideDirection is the constant {0.0, 1.0}, so isVertical is true and
  # dot(slideDirection, v) collapses to v.y. The DOWN factor on slide stays in GLSL.
  vec2 size = getTextureSize('default);
  f32 aspectAdj = min(size.x / size.y, size.y / size.x);
  f32 aspectWidth = getParameterFloat('width) * aspectAdj;
  f32 halfWidth = aspectWidth * 0.5;

  # toRange(progress, -0.5 - halfWidth, 0.5 + halfWidth)
  f32 lo = -0.5 - halfWidth;
  f32 hi = 0.5 + halfWidth;
  setShaderUniform('scanner, 'slideBase, progress * (hi - lo) + lo);

  setShaderUniform('scanner, 'edgeLight, 1.0 - aspectWidth * 0.5);
  setShaderUniform('scanner, 'halfEdge, halfWidth * 0.5);
}

string glsl = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform sampler2D s_texture1;
  uniform float slideBase;
  uniform float edgeLight;
  uniform float halfEdge;
  uniform float brightness;
  uniform vec4 outerColor;
  uniform vec4 innerColor;
  void main() {
    vec2 uv = sourceTextureCoordinate;
    float slide = slideBase * DOWN;
    float v = uv.y - 0.5 - slide;
    float d = 1.0 - abs(v);
    float light = smoothstep(edgeLight, 1.0, d) * brightness;
    float alpha = 1.0 - smoothstep(-halfEdge, halfEdge, v);
    alpha = max(UP, 0.0) + DOWN * alpha;
    vec4 mixed = mix(sampleInput(uv), texture2D(s_texture1, uv), alpha);
    vec4 mixedLight = pow(light + 1.0, brightness) * mixed;
    vec4 lightGradient = mix(outerColor, innerColor, light);
    vec4 coloredLight = lightGradient * smoothstep(0.4, 1.2, light) * brightness;
    vec4 color = vec4(mixedLight.rgb + coloredLight.rgb, 1.0);
    gl_FragColor = toOutputFormat(color);
  }
";
