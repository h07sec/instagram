[Filter OldKino]
# "old kino" ported from the Spark effect (264021424588976). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 0.77.
#   Grain: static, pixel-locked hash noise (mean 0.58, spread 1), multiply-blended at 0.08
#   (replaces the Spark grain texture).
#   Overlay: 'old_kino_gate multiply-blended full-frame at 1.
#   Spark multiplies a static noise texture at 0.08 (procedural here) and a 12-frame, 15 fps film-gate sequence: one clean gate frame ships, jittered by up to 1 px per frame, plus animated dark dust specks and an occasional thin scratch (procedural, 15 fps).
#   Spark's Advanced LUT lifts the low clamp to 0.0478.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('old_kino_lut);
    makeTexture('old_kino_gate);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.77, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {grain_opacity = 0.08, min = 0.0, max = 0.5, description = "Film grain multiply-blend opacity"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the gate overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'old_kino_lut, 'old_kino_gate},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.77,
        grain_opacity = 0.08,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslOldKino,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string old_kino_lut_path = "old_kino_lut_path";
string old_kino_lut_filename = "";
string old_kino_gate_path = "old_kino_gate_path";
string old_kino_gate_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; old_kino_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(old_kino_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != old_kino_lut_filename) {
            old_kino_lut_filename = new_lut;
            loadTexture('old_kino_lut, old_kino_lut_filename);
        }
    }

    string old_kino_gate_param = getParameterString(old_kino_gate_path);
    if (old_kino_gate_param != "") {
        string new_old_kino_gate = stringAppend("textureFilePath://", old_kino_gate_param);
        if (new_old_kino_gate != old_kino_gate_filename) {
            old_kino_gate_filename = new_old_kino_gate;
            loadTexture('old_kino_gate, old_kino_gate_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslOldKino = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'old_kino_lut
    uniform sampler2D auxSampler2;  // 'old_kino_gate

    uniform float lut_strength;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0478, 0.98438);  // Spark's Advanced LUT lifts the low clamp
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Static pixel-locked grain.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y)) + vec2(0.0);
      float n = fract(sin(dot(px, vec2(12.9898, 78.233))) * 43758.5453);
      float grain = clamp(0.58 + (n - 0.5) * 1.0, 0.0, 1.0);
      result = mix(result, result * vec3(grain), grain_opacity * strength);
      // Full-frame overlay 'old_kino_gate (multiply), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('old_kino_gate).
        // Film-gate jitter: the gate shifts by up to 1 px in x and y, re-rolled at Spark's 15 fps.
        float fk = mod(floor(time * 15.0), 12.0);  // bounded seed: Spark's 12-frame gate loop
        vec2 px1 = 1.0 / vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
        vec2 jit = (floor(vec2(hash11(fk * 1.37 + 0.2), hash11(fk * 2.11 + 0.8)) * 3.0) - 1.0) * px1;
        vec4 ov = texture2D(auxSampler2, clamp(topUv(uv) + jit, vec2(0.0), vec2(1.0)));
        result = mix(result, result * ov.rgb, (overlay_opacity) * strength);
      }
      // Animated dust and scratches (Spark's gate frames carry specks and hairs): a few dark specks per
      // frame and, every few frames, a thin vertical scratch at a random x, re-rolled at 15 fps.
      {
        vec2 tuv = topUv(uv);
        vec2 pxp = floor(tuv * vec2(source_size_x, source_size_y));
        float fk2 = mod(floor(time * 15.0), 12.0);  // bounded seed: Spark's 12-frame gate loop
        float speck = step(0.99975, hash21(floor(pxp / 2.0) + fk2 * 7.31));
        float sx = hash11(fk2 * 3.3 + 1.7);
        float scratch = step(abs(tuv.x - sx), 0.7 / max(source_size_x, 1.0)) * step(0.7, hash11(fk2 + 9.4))
            * step(hash11(fk2 + 2.2) * 0.6, tuv.y) * step(tuv.y, 0.4 + hash11(fk2 + 4.8) * 0.6);
        float dust = max(speck, scratch * 0.7);
        result = mix(result, result * 0.25, dust * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
