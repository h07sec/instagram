[Filter FineTone]

[Init]
fun init(Filter filter)
{
    makeTexture('fine_tone_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.973, min = 0.0, max = 1.0, description = "LUT mix strength"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'fine_tone_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.973,
      },
      glslShader = glslLut,
    }};
}

string lut_path = "lut_path";
string fine_tone_lut_path = "fine_tone_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; fine_tone_lut_path is for local testing.

    string lut_filename_parameter = getParameterString(lut_path);

    if (lut_filename_parameter == "") {

        lut_filename_parameter = getParameterString(fine_tone_lut_path);

    }
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('fine_tone_lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, s);
}

#### GLSL shader ####

string glslLut = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float lut_strength;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);

      vec4 lutSource = texel;
      texel.rgb = clamp(texel.rgb, 0.00781, 0.98438);

      float x = texel.r / 8.0;
      float y = texel.g / 8.0;
      float z = texel.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Strength 0 passes the unclamped input through; at strength 1 the grade is unchanged.
      vec4 lutBase = strength >= 1.0 ? texel : mix(lutSource, texel, strength);
      texel = mix(lutBase, vec4(color, texel.a), strength * lut_strength);

      gl_FragColor = toOutputFormat(texel);
    }
    ";
