[Filter LightsParty]
# "Lights Party" ported from the Spark effect (2756933607963885). Single fragment pass, no face tracking.
#
#   Spark animates soft coloured light leaks with patches (no textured layer): a glow flares in from
#   an edge of the frame about every 1.6 s, flares for about half a second and fades, mostly green with magenta and
#   violet ones. Rebuilt procedurally: two overlapping leak cycles, each picking an edge position and
#   a colour per cycle, screen-blended. Spark's light skin smoothing (0.23) is dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the light leaks"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        strength = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslLightsParty,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Time drives the leaks.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source aspect, so the glows stay round. Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslLightsParty = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Hugo Elias-style hash (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }

    // Spark's leak colours: mostly green, with magenta and violet.
    vec3 leakColor(float h) {
      if (h < 0.5) { return vec3(0.42, 1.0, 0.23); }
      if (h < 0.85) { return vec3(0.88, 0.25, 1.0); }
      return vec3(0.55, 0.3, 1.0);
    }

    // One leak cycle: a soft glow anchored on a frame edge, fading in and out over the cycle.
    vec3 leak(vec2 tuv, float aspect, float period, float offset, float seed) {
      float t = time / period + offset;
      float n = mod(floor(t), 16.0);  // bounded seed: a 16-cycle loop
      float ph = fract(t);
      float env = smoothstep(0.0, 0.1, ph) * (1.0 - smoothstep(0.3, 0.55, ph));
      float side = hash11(n + seed);
      float along = 0.15 + 0.7 * hash11(n * 1.7 + seed + 3.0);
      vec2 c = side < 0.5 ? vec2(side < 0.25 ? -0.05 : 1.05, along) : vec2(along, 1.05);
      vec2 d = (tuv - c) * vec2(aspect, 1.0);
      float r = 0.38 + 0.2 * hash11(n * 2.3 + seed + 7.0);
      float g = exp(-dot(d, d) / (r * r));
      return leakColor(hash11(n * 3.1 + seed + 11.0)) * g * env;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec2 tuv = topUv(uv);
      float aspect = source_size_x / max(source_size_y, 1.0);

      // One main leak per 1.6 s cycle, a fainter second one on a 2.9 s cycle.
      vec3 glow = 1.6 * leak(tuv, aspect, 1.6, 0.0, 0.0) + 0.5 * leak(tuv, aspect, 2.9, 0.37, 19.0);
      glow = clamp(glow, 0.0, 1.0);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL; 0 is an exact passthrough.
      vec3 screened = 1.0 - (1.0 - cam.rgb) * (1.0 - glow);
      vec3 result = mix(cam.rgb, screened, overlay_opacity * strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
