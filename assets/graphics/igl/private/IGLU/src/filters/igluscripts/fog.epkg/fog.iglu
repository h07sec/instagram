[Filter Fog]
# "Fog": colour LUT plus rising procedural smoke. Cheap stand-in for Spark's
# smoke (a 106-frame 98x175 sequence at 14 fps, screen-blended full-screen).
#
# 'smoke: density at 1/8 resolution (r8). Four value-noise octaves on rotated
#   lattices: octaves 1-2 set coverage, 3-4 make the lumpy edges, 2-3 shade
#   the billows; octave 1 also warps 2-4. Time offsets come from
#   [PreRender], so each octave costs one value noise (4 hashes) plus 4 MADs.
# 'pass0: full resolution. LUT grade, then the bilinearly upsampled density is
#   tinted with Spark's blue-to-white ramp and screen-blended on top.

[Init]
fun init(Filter filter)
{
    makeTexture('fog_lut);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.000, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {fog_opacity = 0.800, min = 0.0, max = 1.0, description = "Fog opacity"},
        {speed = 0.823, min = 0.0, max = 3.0, description = "Rising motion speed"},
        {evolution = 0.738, min = 0.0, max = 3.0, description = "Wisp evolution / detail motion speed"},
        {density = 0.503, min = 0.0, max = 1.0, description = "Smoke density (higher = thicker wisps)"},
        {turbulence = 0.324, min = 0.0, max = 1.0, description = "Swirl / curl intensity"},
    };

    filter.passes = {
      {
        name = 'smoke,
        inputs = {'default},
        scale = {0.125, 0.125},
        bufferType = 'r8,
        uniforms = {
          o0 = {0.0, 0.0},
          o1 = {0.0, 3.1},
          o2 = {0.0, 7.7},
          o3 = {0.0, 11.9},
          warp = 0.78,
          lo = 0.178,
        },
        glslShader = glslSmoke,
      },
      {
        name = 'pass0,
        inputs = {'default, 'fog_lut, 'smoke},
        uniforms = {
          strength = 1.000,
          smoke_mix = 0.800,
        },
        glslShader = glslFog,
      },
    };
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('fog_lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, s);

    f32 fo = getParameterFloat('fog_opacity);
    setShaderUniform('pass0, 'smoke_mix, fo * s);

    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    # Same 200 s wrap as the shader-side mod() it replaces.
    f32 tw = time - floor(time / 200.0) * 200.0;

    # Base octave offset: slow sideways drift (evolution) and the rise (speed).
    f32 evo = tw * getParameterFloat('evolution) * 3.0;
    f32 ox = 0.07 * evo;
    f32 oy = tw * getParameterFloat('speed) * 0.30;
    vec2 o0 = {ox, oy};
    # Octave k samples A_k * (base point) + its own drift; A_k = (2.03 R)^k, R = rotation by 36.87 deg.
    vec2 o1 = {1.624 * ox - 1.218 * oy - 0.45 * evo, 1.218 * ox + 1.624 * oy + 0.15 * evo + 3.1};
    vec2 o2 = {1.15385 * ox - 3.95606 * oy + 0.35 * evo, 3.95606 * ox + 1.15385 * oy + 0.3 * evo + 7.7};
    vec2 o3 = {-2.94463 * ox - 7.83004 * oy - 0.25 * evo, 7.83004 * ox - 2.94463 * oy + 0.55 * evo + 11.9};
    setShaderUniform('smoke, 'o0, o0);
    setShaderUniform('smoke, 'o1, o1);
    setShaderUniform('smoke, 'o2, o2);
    setShaderUniform('smoke, 'o3, o3);

    f32 tr = getParameterFloat('turbulence);
    setShaderUniform('smoke, 'warp, tr * tr * 7.4);
    setShaderUniform('smoke, 'lo, 0.48 - 0.6 * getParameterFloat('density));
}

#### GLSL shader ####

string glslSmoke = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform vec2 o0;
    uniform vec2 o1;
    uniform vec2 o2;
    uniform vec2 o3;
    uniform float warp;
    uniform float lo;

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.x, p.y, p.x) * 0.1031);
      p3 = p3 + vec3(dot(p3, vec3(p3.y, p3.z, p3.x) + vec3(33.33)));
      return fract((p3.x + p3.y) * p3.z);
    }

    float valueNoise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (vec2(3.0) - 2.0 * f);
      float a = hash12(i);
      float b = hash12(i + vec2(1.0, 0.0));
      float c = hash12(i + vec2(0.0, 1.0));
      float d = hash12(i + vec2(1.0, 1.0));
      return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // uv.y = 0 is the top, so the offsets moving +y make the smoke rise.
      float n1 = valueNoise(vec2(uv.x, 1.7 * uv.y) + o0);
      float w = (n1 - 0.5) * warp;
      float n2 = valueNoise(vec2(1.624 * uv.x - 2.0706 * uv.y + w, 1.218 * uv.x + 2.7608 * uv.y) + o1);
      float n3 = valueNoise(vec2(1.15385 * uv.x - 6.72531 * uv.y + 1.7 * w, 3.95606 * uv.x + 1.96155 * uv.y) + o2);
      float n4 = valueNoise(vec2(-2.94463 * uv.x - 13.31107 * uv.y + 2.3 * w, 7.83004 * uv.x - 5.00587 * uv.y) + o3);
      float detail = 0.62 * n3 + 0.38 * n4;
      // Coverage, edge detail, and Spark's bias to the left and to mid-height.
      float x = 0.85 * n1 + 0.15 * n2 + 0.55 * detail - 0.28 * uv.x - 0.32 * abs(uv.y - 0.5);
      float d = clamp((x - lo) * 2.0, 0.0, 1.0);
      d = d * d * (3.0 - 2.0 * d);
      // Billow shading inside the dense parts, from the mid octaves.
      d = d * (0.475 + 0.475 * clamp(0.8 * (n2 + n3) - 0.3, 0.0, 1.0));
      gl_FragColor = toOutputFormat(vec4(d, d, d, 1.0));
    }
    ";

string glslFog = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'fog_lut
    uniform sampler2D auxSampler2;  // 'smoke (1/8-resolution density, bilinear)

    uniform float smoke_mix;  // fog_opacity * strength

    // 8x8 grid LUT lookup on auxSampler1 (drammatico pattern; works
    // for 512x512 packed 64x64 slices AND 1024x1024 packed 128x128
    // slices — math is grid-relative, not pixel-absolute).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x = x + blueX;
      y = y + blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);
      float d = texture2D(auxSampler2, sourceTextureCoordinate).r;

      vec3 graded = lutLookup(texel.rgb);
      vec3 base = mix(texel.rgb, graded, strength);

      // Spark's smoke colour (deep blue where thin, blue-white where dense),
      // screen-blended as Spark composites the sequence: base + smoke * (1 - base).
      float a = d * smoke_mix;
      vec3 smoke = a * (vec3(0.142, 0.332, 1.0) + d * vec3(0.809, 0.699, 0.0));
      vec3 result = mix(base, vec3(1.0), smoke);

      gl_FragColor = toOutputFormat(vec4(result, texel.a));
    }
    ";
