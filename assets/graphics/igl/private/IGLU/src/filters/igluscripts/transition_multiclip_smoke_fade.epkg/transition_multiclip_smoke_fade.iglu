[Filter TransitionMulticlipSmokeFade]
[Init]
fun init(Filter filter){
 makeTexture('transition);
 filter.parameters={{duration=1.683333333333,min=0.1,max=5.0,description="Duration"}};
 filter.passes={{name='compose,inputs={'default,'transition},shaderInputNames={'default,'s_texture1},uniforms={p=0.0,brightness=0.0,evolution=0.0,aspect=1.7777778,showB=0.0,showA=1.0,smokeOn=0.0},glslShader=glsl}};
}
fun cubic(f32 a, f32 b, f32 u) f32 {
  f32 v = 1.0 - u;
  return 3.0*v*v*u*a + 3.0*v*u*u*b + u*u*u;
}
fun segment(f32 t, f32 t0, f32 v0, f32 t1, f32 v1, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 u = clamp((t-t0)/(t1-t0), 0.0, 1.0);
  f32 lo = 0.0;
  f32 hi = 1.0;
  f32 s = u;
  f32 i = 0.0;
  while (i < 20.0) {
    s = (lo+hi)*0.5;
    if (cubic(x1,x2,s) < u) { lo=s; } else { hi=s; }
    i=i+1.0;
  }
  f32 r = v0+(v1-v0)*cubic(y1,y2,s);
  if (t <= t0) { r=v0; }
  if (t >= t1) { r=v1; }
  return r;
}
fun brightnessAt(f32 t) f32 {
  f32 r = (0.0 - 235.0);
  if (t >= 0.566666666667) { r=segment(t,0.566666666667,(0.0 - 235.0),2.25,149.05755967846,0.35545634826,0.0,0.463678131993,1.0); }
  if (t >= 2.25) { r=149.05755967846; }
  return r;
}
[PreRender]
fun preRender(Filter filter){
 f32 p=clamp(max(getParameterFloat('progress),getParameterFloat('transition_progress)),0.0,1.0);
 f32 t=34.0/60.0+p*101.0/60.0;
 vec2 size=getTextureSize('default);
 f32 showB=0.0;if(p >= 12.0/101.0){showB=1.0;}
 f32 showA=1.0;if(p >= 87.0/101.0){showA=0.0;}
 f32 brightness=brightnessAt(t)*0.01;
 # The matte is (1-smoke-0.5)*2.83+0.5+brightness with smoke in [0,1], so it stays 0
 # everywhere until brightness reaches -1.915.
 f32 smokeOn=0.0;if(showB > 0.5 and brightness >= (0.0 - 1.9151)){smokeOn=1.0;}
 setShaderUniform('compose,'p,p);setShaderUniform('compose,'brightness,brightness);
 setShaderUniform('compose,'smokeOn,smokeOn);
 setShaderUniform('compose,'evolution,t*400.0/360.0);setShaderUniform('compose,'aspect,size.y/max(size.x,1.0));
 setShaderUniform('compose,'showA,showA);setShaderUniform('compose,'showB,showB);
}
string glsl="
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;
uniform sampler2D s_texture1;
uniform float p;
uniform float brightness;
uniform float evolution;
uniform float aspect;
uniform float showA;
uniform float showB;
uniform float smokeOn;
float hash(vec3 p){p=fract(p*0.1031);p+=dot(p,p.yzx+33.33);return fract((p.x+p.y)*p.z);}
float noise3(vec3 q){
 vec3 i=floor(q), f=fract(q);f=f*f*(3.0-2.0*f);
 float a=mix(hash(i),hash(i+vec3(1,0,0)),f.x);
 float b=mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x);
 float c=mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x);
 float d=mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x);
 return mix(mix(a,b,f.y),mix(c,d,f.y),f.z);
}
// Returns clamp((1-smoke-0.5)*2.83+0.5+brightness,0,1). Each ridge is in [0,1], so after
// every octave the final matte is bounded; once the bound is clamped to 0 or 1 the
// remaining octaves cannot change it.
float smokeMatte(vec2 q){
 vec2 warp=vec2(noise3(vec3(q*0.7,evolution*0.4)),noise3(vec3(q*0.7+13.0,evolution*0.4)))-0.5;
 vec3 v=vec3(q+warp*1.5,evolution*0.55);
 float n=0.0,weight=0.5,total=0.0;
 // Octave weights sum to 1.470585; 2.83/1.470585 = 1.92440.
 float remaining=1.4706;
 for(int i=0;i<6;i++){
  float ridge=1.0-abs(noise3(v)*2.0-1.0);
  n+=weight*ridge;total+=weight;v=v*1.785714+vec3(8.3,7.1,3.7);remaining-=weight;weight*=0.7;
  if(i<5){
   float high=1.915+brightness-n*1.92441;
   if(high<=-0.0001)return 0.0;
   if(high-remaining*1.92441>=1.0001)return 1.0;
  }
 }
 return clamp(((1.0-n/total)-0.5)*2.83+0.5+brightness,0.0,1.0);
}
void main(){
 vec2 uv=sourceTextureCoordinate;
 if(p<=0.0){gl_FragColor=toOutputFormat(sampleInput(uv));return;}
 if(p>=1.0){gl_FragColor=toOutputFormat(texture2D(s_texture1,uv));return;}
 vec4 color;
 if(smokeOn<0.5){
  // Zero matte: the incoming clip contributes nothing.
  vec4 a=sampleInput(uv);
  color=vec4(a.rgb*showA,a.a*showA);
 }else{
  vec2 q=vec2(uv.x-0.5,UP*(uv.y-0.5)*aspect)*3.5;
  float m=smokeMatte(q)*showB;
  vec4 b=texture2D(s_texture1,uv);
  float ba=m*b.a;
  color=vec4(b.rgb*m,ba);
  if(showA>0.5){
   vec4 a=sampleInput(uv);
   float wa=1.0-ba;
   color=vec4(b.rgb*m+a.rgb*wa,ba+a.a*wa);
  }
 }
 gl_FragColor=toOutputFormat(color);
}";
