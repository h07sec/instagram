[Filter OldCamera]
# "Old Camera" (Spark 708576074181539), SCRATCH NO-FACE port of the screen-space layers. Single fragment pass.
#
#   Spark, canvas0 draw order (all layer0, 100% x 100% rectangles):
#     1. rectangle0, alpha, LIT: FastColorLUT(camera) split into R, G, B and recombined with Add blends, x1.3,
#        then the standard scene lighting K. The graph wraps G and B in textureTransforms (scale 1.03 / 1.06),
#        but their input is the LUT value already sampled at the vertex uv, so the shift renders as nothing:
#        the Spark sample has no channel fringe at the frame edges (a 1.06 shift is ~12 px at u = 0.2), and the
#        same graph family in production aesthetic_brown was ported without it for the same reason.
#     2. rectangle4, multiply 0.4: the raw camera.
#     3. rectangle7: opacity 0, not drawn.
#     4. rectangle5, screen 0.2: grain texture tinted #DCBB93.
#     5. rectangle2, screen, LIT: 29-frame scratch/dust sequence, 15 fps, looping. Its opacity is 0.65 (Richard's
#        review, 2026-11-10; Spark's own layer is at 1).
#   Dropped: the face layers (skin smoothing 0.22, faint multiply blush/lip/freckle mesh) and the dynamic
#   local-time text (DATE timeshort, orange, bottom right): IGLUScript has no wall clock to draw it from.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('old_camera_lut);
    makeTexture('old_camera_grain);
    makeTexture('old_camera_dust_a);
    makeTexture('old_camera_dust_b);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'old_camera_lut, 'old_camera_grain, 'old_camera_dust_a, 'old_camera_dust_b},
      uniforms = {
        strength = 1.0,
        time = 0.0,
      },
      glslShader = glslOldCamera,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string old_camera_lut_path = "old_camera_lut_path";
string old_camera_lut_filename = "";
string old_camera_grain_path = "old_camera_grain_path";
string old_camera_grain_filename = "";
string old_camera_dust_a_path = "old_camera_dust_a_path";
string old_camera_dust_a_filename = "";
string old_camera_dust_b_path = "old_camera_dust_b_path";
string old_camera_dust_b_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; old_camera_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(old_camera_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != old_camera_lut_filename) {
            old_camera_lut_filename = new_lut;
            loadTexture('old_camera_lut, old_camera_lut_filename);
        }
    }
    string grain_param = getParameterString(old_camera_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != old_camera_grain_filename) {
            old_camera_grain_filename = new_grain;
            loadTexture('old_camera_grain, old_camera_grain_filename);
        }
    }
    string dust_a_param = getParameterString(old_camera_dust_a_path);
    if (dust_a_param != "") {
        string new_dust_a = stringAppend("textureFilePath://", dust_a_param);
        if (new_dust_a != old_camera_dust_a_filename) {
            old_camera_dust_a_filename = new_dust_a;
            loadTexture('old_camera_dust_a, old_camera_dust_a_filename);
        }
    }
    string dust_b_param = getParameterString(old_camera_dust_b_path);
    if (dust_b_param != "") {
        string new_dust_b = stringAppend("textureFilePath://", dust_b_param);
        if (new_dust_b != old_camera_dust_b_filename) {
            old_camera_dust_b_filename = new_dust_b;
            loadTexture('old_camera_dust_b, old_camera_dust_b_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslOldCamera = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'old_camera_lut (mmmmmm, 512x512 8x8 grid)
    uniform sampler2D auxSampler2;  // 'old_camera_grain (614x1024)
    uniform sampler2D auxSampler3;  // 'old_camera_dust_a (frames 0-14, 5x3 cells of 575x1024)
    uniform sampler2D auxSampler4;  // 'old_camera_dust_b (frames 15-28, 5x3 cells of 575x1024)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;

    // Lit DefaultMaterial with the standard scene lights: ambient 0.2 + 0.8 * cos(-pi/4) * cos(5 deg).
    const float kLight = 0.76353283;
    // Scratch layer opacity (Spark: 1; Richard asked for 65%).
    const float kScratchOpacity = 0.65;
    const vec3 kGrainTint = vec3(220.0, 187.0, 147.0) / 255.0;
    const vec2 kCell = vec2(575.0, 1024.0);
    const vec2 kAtlas = vec2(2875.0, 3072.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // FastColorLUT patch: clamp 0.0078125 / 0.98438, 8x8 grid, one bilinear tap.
    vec3 lutCam(vec2 p) {
      vec3 c = clamp(sampleInput(p).rgb, 0.0078125, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 col = clamp(lutCam(uv) * 1.3 * kLight, 0.0, 1.0);

      // Multiply 0.4 with the raw camera: dst * (1 - a + a * src).
      col = col * (0.6 + 0.4 * cam.rgb);

      vec2 p = topUv(uv);
      // Screen 0.2, tinted grain: s + dst * (1 - s), s = 0.2 * tint * grain.
      vec3 g = 0.2 * kGrainTint * texture2D(auxSampler2, p).rgb;
      col = g + col * (1.0 - g);

      // Screen, lit, opacity kScratchOpacity: the scratch/dust frame at 15 fps over 29 frames, from frame 0.
      // mod() keeps it bounded.
      float frame = mod(floor(time * 15.0), 29.0);
      float local = frame < 15.0 ? frame : frame - 15.0;
      vec2 cell = vec2(mod(local, 5.0), floor(local / 5.0));
      vec2 inCell = clamp(p * kCell, vec2(0.5), kCell - 0.5);
      vec2 dustUv = (cell * kCell + inCell) / kAtlas;
      vec3 dust = frame < 15.0 ? texture2D(auxSampler3, dustUv).rgb : texture2D(auxSampler4, dustUv).rgb;
      vec3 d = kScratchOpacity * clamp(kLight * dust, 0.0, 1.0);
      col = d + col * (1.0 - d);

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
