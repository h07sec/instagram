[Filter LightAndFlare]
# "light & flare" ported from the Spark effect (5309904239120506). Single fragment pass, no face tracking.
#
#   Grade: 8x8 LUT (Spark's 'Cube File(1)') at full opacity.
#   Then Spark's 40-frame light-leak sequence, screen-blended at 0.84. The frames are soft colour
#   blobs, so they ship as one 8x5 atlas of 96x204 cells ('light_and_flare_leaks), played at 15 fps.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('light_and_flare_lut);
    makeTexture('light_and_flare_leaks);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the light leaks"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'light_and_flare_lut, 'light_and_flare_leaks},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
      },
      glslShader = glslLightAndFlare,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string light_and_flare_lut_path = "light_and_flare_lut_path";
string light_and_flare_lut_filename = "";
string light_and_flare_leaks_path = "light_and_flare_leaks_path";
string light_and_flare_leaks_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; light_and_flare_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(light_and_flare_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != light_and_flare_lut_filename) {
            light_and_flare_lut_filename = new_lut;
            loadTexture('light_and_flare_lut, light_and_flare_lut_filename);
        }
    }

    string leaks_param = getParameterString(light_and_flare_leaks_path);
    if (leaks_param != "") {
        string new_leaks = stringAppend("textureFilePath://", leaks_param);
        if (new_leaks != light_and_flare_leaks_filename) {
            light_and_flare_leaks_filename = new_leaks;
            loadTexture('light_and_flare_leaks, light_and_flare_leaks_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Time picks the light-leak frame.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslLightAndFlare = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'light_and_flare_lut
    uniform sampler2D auxSampler2;  // 'light_and_flare_leaks (8x5 atlas)

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark FastColorLUT decode (8x8 grid), matching Spark's sampling of this LUT.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL; it scales every layer,
      // so 0 is an exact passthrough.
      vec3 result = mix(src, lutLookup(src), strength * lut_strength);

      // Spark's 40-frame light-leak sequence at 15 fps, screen-blended at 0.84.
      float frame = mod(floor(time * 15.0), 40.0);  // bounded seed: Spark's 40-frame loop
      vec2 cell = vec2(mod(frame, 8.0), floor(frame / 8.0));
      vec2 tuv = topUv(uv);
      vec3 leak = texture2D(auxSampler2, (cell + tuv) / vec2(8.0, 5.0)).rgb;
      vec3 screened = 1.0 - (1.0 - result) * (1.0 - leak);
      result = mix(result, screened, 0.84 * overlay_opacity * strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
