[Filter FiveFrame]
# "Five Frame" (Spark 299705803967260), SCRATCH NO-FACE port. Four passes; the delayed panels use one history texture.
#
#   Spark chain (main.json renderPasses + preProcessor.sca / postProcessor.sca, graph_ssa.txt):
#     intro   runtime > 0.2 s fires two non-looped timeDrivers: blur radius 200 -> 0 over 1 s (sampler curve 8) and
#             a black overlay fade 1 -> 0 over 0.5 s (curve 7).
#     blurH   preProcessor pass 0 on the camera: horizontal S-curve-weighted box blur, radius int(r), 1 px taps.
#             (Spark evaluates it twice and never uses BlurV; the second copy and the tiled-camera pass are unused.)
#     store   postProcessor pass 0 into a 2x-screen 4x4 atlas: cell 0 = this frame's blurH, cell k = last frame's
#             cell k-1 (Delay Frame, depth 1); then mixed toward black by the overlay fade.
#     collage postProcessor pass 2: grid.png (nearest, eroded alpha) picks one of five panels per pixel; panel i reads
#             the PREVIOUS atlas (Delay Frame) at its time offset (0.5 / 0.25 / 0 / 0.75 / 1 -> cells 7 / 3 / 0 / 11 / 15,
#             i.e. frames n-8 / n-4 / n-1 / n-12 / n-16) with its offset and scale; levels (blue gamma 1.1,
#             overall gamma 1.3); background.png outside the panels.
#   IGLU: 'atlas reads its own previous frame through 'prevAtlas (makeHistoricalTexture depth 1), which is Spark's Delay Frame.
#   Before history exists the alias reads black, as Spark's Delay Frame texture does on the first frame.
#   Spark processor uv is bottom-origin; loaded textures are sampled in Spark texture space (v = 0 is the image top).
#   No face objects in the effect.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('five_frame_grid);
    makeTexture('five_frame_background);
    makeHistoricalTexture('prevAtlas, 'atlas);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'blurH,
      inputs = {'default},
      bufferType = 'uint8,
      uniforms = { radius = 200.0 },
      glslShader = glslBlurH,
    }, {
      name = 'atlas,
      inputs = {'blurH, 'prevAtlas},
      scale = {2.0, 2.0},
      bufferType = 'uint8,
      uniforms = { fade = 1.0 },
      glslShader = glslStore,
    }, {
      name = 'collage,
      inputs = {'atlas, 'prevAtlas, 'five_frame_grid, 'five_frame_background},
      bufferType = 'uint8,
      glslShader = glslCollage,
    }, {
      name = 'pass0,
      inputs = {'default, 'collage},
      uniforms = { strength = 1.0 },
      glslShader = glslFinal,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string five_frame_grid_path = "five_frame_grid_path";
string five_frame_background_path = "five_frame_background_path";
string five_frame_grid_filename = "";
string five_frame_background_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    string pg = getParameterString(five_frame_grid_path);
    if (pg != "") {
        string fg = stringAppend("textureFilePath://", pg);
        if (fg != five_frame_grid_filename) {
            five_frame_grid_filename = fg;
            loadTexture('five_frame_grid, five_frame_grid_filename);
        }
    }
    string pb = getParameterString(five_frame_background_path);
    if (pb != "") {
        string fb = stringAppend("textureFilePath://", pb);
        if (fb != five_frame_background_filename) {
            five_frame_background_filename = fb;
            loadTexture('five_frame_background, five_frame_background_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }

    # Both drivers start when runtime passes 0.2 s. Before that they sit at progress 0 (blur 200, fade 1).
    f32 pb1 = (t - 0.2) / 1.0;
    if (pb1 < 0.0) { pb1 = 0.0; }
    if (pb1 > 1.0) { pb1 = 1.0; }
    f32 pf1 = (t - 0.2) / 0.5;
    if (pf1 < 0.0) { pf1 = 0.0; }
    if (pf1 > 1.0) { pf1 = 1.0; }
    # Sampler curve 8 = easeOutCubic (200 -> 0), curve 7 = easeInCubic (1 -> 0): the Spark sample's fade fits power 3
    # (mean err 0.005 vs 0.014 for power 4; intro_fit.log).
    f32 ob = 1.0 - pb1;
    f32 easeOut = 1.0 - ob * ob * ob;
    f32 easeIn = pf1 * pf1 * pf1;
    setShaderUniform('blurH, 'radius, 200.0 - 200.0 * easeOut);
    setShaderUniform('atlas, 'fade, 1.0 - easeIn);
}

#### GLSL shaders ####

# preProcessor BlurH: weights SCurve(1 - |x| / r), taps every 1 px of this pass, radius int(r).
string glslBlurH = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform vec2 outputSize;
    uniform float radius;

    float sCurve(float x) {
      x = x * 2.0 - 1.0;
      return -x * abs(x) * 0.5 + x + 0.5;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      if (radius < 1.0) {
        gl_FragColor = vec4(sampleInput(uv).rgb, 1.0);
        return;
      }
      float r = floor(radius);
      float width = 1.0 / outputSize.x;
      float rm = 1.0 / radius;
      vec3 c = vec3(0.0);
      float div = 0.0;
      for (int xi = -200; xi <= 200; xi++) {
        float x = float(xi);
        if (abs(x) <= r) {
          float w = sCurve(1.0 - abs(x) * rm);
          c += sampleInput(uv + vec2(x * width, 0.0)).rgb * w;
          div += w;
        }
      }
      gl_FragColor = vec4(clamp(c / div, 0.0, 1.0), 1.0);
    }
    ";

# postProcessor storeFrame (pass 0). The atlas is internal, so it is laid out in this backend's sampler space.
string glslStore = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'prevAtlas (this pass, previous frame)
    uniform float fade;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      float box = step(0.0, uv.x) * step(uv.x, 0.25) * step(0.0, uv.y) * step(uv.y, 0.25);
      float oldSqx = floor(uv.x * 4.0);
      float oldSqy = floor(uv.y * 4.0);
      float oldIndex = oldSqy * 4.0 + oldSqx - 1.0;
      vec2 oldPos = vec2(oldSqx, oldSqy) / 4.0;
      float shiftSqy = floor(oldIndex / 4.0);
      float shiftSqx = oldIndex - shiftSqy * 4.0;
      vec2 shiftPos = vec2(shiftSqx, shiftSqy) / 4.0;
      vec3 old = texture2D(auxSampler1, uv + (shiftPos - oldPos)).rgb * (1.0 - box);
      vec3 raw = sampleInput(uv * 4.0).rgb * box;
      gl_FragColor = vec4(clamp(mix(old + raw, vec3(0.0), fade), 0.0, 1.0), 1.0);
    }
    ";

string glslCollage = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // auxSampler0: 'atlas (bound only so the atlas pass feeds a pass and keeps its history framebuffer)
    uniform sampler2D auxSampler1;  // 'prevAtlas (Spark Delay Frame texture)
    uniform sampler2D auxSampler2;  // 'five_frame_grid (1024, Spark filter nearest)
    uniform sampler2D auxSampler3;  // 'five_frame_background

    vec4 gridAt(vec2 t) {
      return texture2D(auxSampler2, (floor(t * 1024.0) + 0.5) / 1024.0);
    }
    float colorWeight(float target, float ch) {
      return step(min(1.0, abs(target - ch) * 2.0), 0.9);
    }
    vec2 mapUv(vec2 s, vec2 off, float sc) {
      return (s + off - 0.5) * (1.0 / sc) + 0.5;
    }
    float levels(float c, float g) {
      return pow(min(max(c, 0.0), 1.0), 1.0 / g);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 s = uv;
      if (UP < 0.0) { s.y = 1.0 - s.y; }
      vec2 tex = vec2(s.x, 1.0 - s.y);
      vec4 map = gridAt(tex);
      float sum = map.a - (1.0 - gridAt(tex + vec2(0.0, 0.001)).a) - (1.0 - gridAt(tex - vec2(0.0, 0.001)).a);
      map.a = step(0.5, sum);
      float w2 = colorWeight(0.5, map.b);
      float w3 = colorWeight(1.0, map.b);
      float w4 = colorWeight(0.5, map.g);
      float w5 = colorWeight(1.0, map.g);
      vec2 f = mapUv(s, vec2(0.2, -0.35), 0.7) * map.r + mapUv(s, vec2(0.2, -0.12), 1.0) * w2 +
               mapUv(s, vec2(0.2, 0.2), 0.74) * w3 + mapUv(s, vec2(-0.15, 0.35), 0.7075) * w4 +
               mapUv(s, vec2(-0.09391303, -0.1904348), 1.0) * w5;
      float off = 0.5 * map.r + 0.25 * w2 + 0.0 * w3 + 0.75 * w4 + 1.0 * w5;
      // sampleTime: cell max(0, floor(off * 16) - 1); the sample uv is converted from Spark to sampler space.
      float idx = max(0.0, floor(off * 4.0 * 4.0) - 1.0);
      float sqy = floor(idx / 4.0);
      vec2 pos = vec2(idx - sqy * 4.0, sqy) / 4.0;
      vec2 su = clamp(f, 0.0, 1.0);
      if (UP < 0.0) { su.y = 1.0 - su.y; }
      vec3 c = texture2D(auxSampler1, pos + su / 4.0).rgb;
      c.b = levels(c.b, 1.1);
      c = vec3(levels(c.r, 1.3), levels(c.g, 1.3), levels(c.b, 1.3));
      vec3 bg = texture2D(auxSampler3, tex).rgb;
      c = mix(c, bg, 1.0 - map.a);
      gl_FragColor = vec4(clamp(c, 0.0, 1.0), 1.0);
    }
    ";

string glslFinal = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform sampler2D auxSampler1;  // 'collage
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched.
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 c = texture2D(auxSampler1, uv).rgb;
      gl_FragColor = toOutputFormat(vec4(clamp(mix(cam.rgb, c, strength), 0.0, 1.0), cam.a));
    }
    ";
