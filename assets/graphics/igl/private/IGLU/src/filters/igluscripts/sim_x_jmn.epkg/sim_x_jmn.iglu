[Filter SimXJmn]
# "SIM x JMN" ported from the Spark effect (545696734338464). Single fragment pass, no assets beyond the LUT.
#
#   1. Edge blur: Spark's MotionBlur (direction (2, 0), strength 2) of the camera, tinted #E9FFF6 at 0.955
#      and shown through 'Overlay.png' (a radial vignette alpha: ~0.62 slightly right of centre, rising to
#      1.0 at the edges). Here: a 9-tap horizontal blur through a procedural ellipse fitted to that alpha.
#   2. Grade: 'ab7' 8x8 LUT (Spark LUT patch) at 0.75 over the blurred composite (BRCOSA is identity).
#   Dropped: the unused 'Border' sequence, and the 0.13-opacity mid-grey grain (std 0.04, invisible).
#
# Time source: none (static). GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('sim_x_jmn_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.75, min = 0.0, max = 1.0, description = "ab7 LUT mix (Spark 0.75)"},
        {blur_opacity = 0.955, min = 0.0, max = 1.0, description = "Tinted edge-blur opacity (Spark 0.955)"},
        {blur_px = 3.0, min = 0.0, max = 20.0, description = "Horizontal motion-blur tap spacing in px at 720 wide"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'sim_x_jmn_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.75,
        blur_opacity = 0.955,
        blur_px = 3.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslSimXJmn,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string sim_x_jmn_lut_path = "sim_x_jmn_lut_path";
string sim_x_jmn_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; sim_x_jmn_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(sim_x_jmn_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != sim_x_jmn_lut_filename) {
            sim_x_jmn_lut_filename = new_lut;
            loadTexture('sim_x_jmn_lut, sim_x_jmn_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'blur_opacity, getParameterFloat('blur_opacity));
    setShaderUniform('pass0, 'blur_px, getParameterFloat('blur_px));

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslSimXJmn = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'sim_x_jmn_lut
    uniform float lut_strength;
    uniform float blur_opacity;
    uniform float blur_px;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Spark 'Overlay.png' alpha, fitted: ~0.62 at (0.55, 0.52), rising to 1.0 by the frame edges.
    float edgeMask(vec2 tuv) {
      vec2 d = (tuv - vec2(0.55, 0.52)) / vec2(0.62, 0.55);
      return clamp(0.62 + 0.45 * smoothstep(0.15, 1.0, length(d)), 0.0, 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);

      // Horizontal motion blur, 9 taps with triangle weights (sum 25).
      float dx = blur_px * strength / 720.0;
      vec3 b = cam.rgb * 5.0;
      b += (sampleInput(uv + vec2(dx, 0.0)).rgb + sampleInput(uv - vec2(dx, 0.0)).rgb) * 4.0;
      b += (sampleInput(uv + vec2(2.0 * dx, 0.0)).rgb + sampleInput(uv - vec2(2.0 * dx, 0.0)).rgb) * 3.0;
      b += (sampleInput(uv + vec2(3.0 * dx, 0.0)).rgb + sampleInput(uv - vec2(3.0 * dx, 0.0)).rgb) * 2.0;
      b += (sampleInput(uv + vec2(4.0 * dx, 0.0)).rgb + sampleInput(uv - vec2(4.0 * dx, 0.0)).rgb) * 1.0;
      b = b / 25.0 * vec3(0.9137, 1.0, 0.9647);  // tint #E9FFF6

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      float m = edgeMask(topUv(uv)) * blur_opacity * strength;
      vec3 composite = mix(cam.rgb, b, m);
      vec3 result = mix(composite, lutLookup(composite), lut_strength * strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
