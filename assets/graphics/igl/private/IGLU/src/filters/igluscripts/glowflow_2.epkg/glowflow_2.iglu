[Filter Glowflow2]
# "glowflow_2" ported from the Spark effect (440394454234076). Single fragment pass, no face tracking. SCRATCH (batch 12, stack B).
#
#   Spark: two full-frame canvas rects with the same FastColorLUT material graph (rect `lut` on layer0, renderingOrder 2,
#   then rect `Person` on layer Make, renderingOrder 3), alpha blend, opacity 1, unlit: camera clamped to 0.04..0.96,
#   looked up in the 1024x1024 8x8 atlas 1 redmoon0 (cb03c857...PNG, sha256 f54c26ec7d61..., byte-identical to glowflow) with filter nearest (no half-texel inset);
#   src alpha = LUT alpha (opaque PNG), so each rect replaces the frame with the LUT colour.
#   A tap counter (maxCount 2) shows rect `noise` (Textures (13) 576x1024, 100% x 100%, multiply, opacity 0.2) only at
#   count 1; the untapped default is hidden, so noise_on defaults to 0.
#   Same Spark scene and textures as glowflow (hash-verified); a separate package because it is a separate Spark id.
#   Dropped (face tracked, BATCH-DROP): lip plump blendshape 0.219 (Lips, Lips1 0.904 same-LUT face re-render), Face LUT 0.95 same-LUT face copy, lip tint 0.18 multiply, Bochechas colorPaint 0.137, under-eye Olheiras 0.137 screen, PBR highlight Higlight 2 0.219, Contour 0.03 multiply, Blush 0 multiply, retouch smoothing 0.37 fullScreen; the iris planes (iris overlay1 0.233) are constant-hidden (Olho hidden = !(0==1)) and never drawn.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('glowflow_2_lut);
    makeTexture('glowflow_2_noise);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {noise_on = 0.0, min = 0.0, max = 1.0, description = "Noise overlay (Spark tap toggle; 0 = untapped default)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'glowflow_2_lut, 'glowflow_2_noise},
      uniforms = {
        strength = 1.0,
        noise_on = 0.0,
        lut_size_x = 1024.0,
        lut_size_y = 1024.0,
      },
      glslShader = glslGlowflow2,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string glowflow_2_lut_path = "glowflow_2_lut_path";
string glowflow_2_lut_filename = "";
string glowflow_2_noise_path = "glowflow_2_noise_path";
string glowflow_2_noise_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'noise_on, getParameterFloat('noise_on));

    # iOS passes the remote LUT under the generic 'lut_path; glowflow_2_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(glowflow_2_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != glowflow_2_lut_filename) {
            glowflow_2_lut_filename = new_lut;
            loadTexture('glowflow_2_lut, glowflow_2_lut_filename);
        }
    }
    string noise_param = getParameterString(glowflow_2_noise_path);
    if (noise_param != "") {
        string new_noise = stringAppend("textureFilePath://", noise_param);
        if (new_noise != glowflow_2_noise_filename) {
            glowflow_2_noise_filename = new_noise;
            loadTexture('glowflow_2_noise, glowflow_2_noise_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 lutSize = getTextureSize('glowflow_2_lut);
    if (lutSize.x > 0.0 and lutSize.y > 0.0) {
        setShaderUniform('pass0, 'lut_size_x, lutSize.x);
        setShaderUniform('pass0, 'lut_size_y, lutSize.y);
    }
}

#### GLSL shader ####

string glslGlowflow2 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'glowflow_2_lut (1024x1024, 8x8 atlas, nearest in Spark)
    uniform sampler2D auxSampler2;  // 'glowflow_2_noise (576x1024)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float noise_on;
    uniform float lut_size_x;
    uniform float lut_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for the overlay; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.04..0.96, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.04, 0.96);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec2 lutUv = vec2(c.r / 8.0 + col, c.g / 8.0 + row);
      // Spark samples this LUT with filter=nearest; snap to the texel centre so a linear sampler matches.
      vec2 lutSize = vec2(lut_size_x, lut_size_y);
      lutUv = (floor(lutUv * lutSize) + 0.5) / lutSize;
      vec4 L = texture2D(auxSampler1, lutUv);
      // Rect lut, then rect Person: same LUT colour, alpha blend with src alpha = LUT alpha.
      vec3 spark = mix(cam.rgb, L.rgb, L.a);
      spark = mix(spark, L.rgb, L.a);
      if (noise_on > 0.5) {
        // Rect noise, 100% x 100% (stretched like Spark), multiply with premultiplied src: dst * (0.2 * n + 0.8).
        vec3 n = texture2D(auxSampler2, topUv(uv)).rgb;
        spark = spark * (n * 0.2 + 0.8);
      }
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
