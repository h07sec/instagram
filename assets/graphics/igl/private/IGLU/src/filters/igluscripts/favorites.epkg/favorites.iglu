[Filter Favorites]
# "♥︎Favorites ⌵" ported from the Spark effect (1420655058696680). Single fragment pass.
#
#   Spark: nine full-frame camera rectangles, each graded by colorLUTShader('noir') and shifted onto one cell
#   of a 3x3 grid (thirds of the frame), with patch-driven texture transforms (zoom, offset, flips). The
#   'favorites' PNG (an iOS photo-album header plus grid lines and heart icons) sits on top.
#   Here: the same grid, with each cell showing a zoomed / offset / flipped crop of the camera matched to
#   Spark's sample frame by eye (the exact transforms are spread over ~1,000 patches), plus the same
#   overlay PNG. The 'blurexp+temp' LUT isn't wired.
#
# Time source: none (static). GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('favorites_lut);
    makeTexture('favorites_overlay);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "Noir LUT mix strength"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'favorites_lut, 'favorites_overlay},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
      },
      glslShader = glslFavorites,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string favorites_lut_path = "favorites_lut_path";
string favorites_lut_filename = "";
string favorites_overlay_path = "favorites_overlay_path";
string favorites_overlay_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the first remote image under the generic 'lut_path; the *_path strings are for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(favorites_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != favorites_lut_filename) {
            favorites_lut_filename = new_lut;
            loadTexture('favorites_lut, favorites_lut_filename);
        }
    }
    string ov_param = getParameterString(favorites_overlay_path);
    if (ov_param != "") {
        string new_ov = stringAppend("textureFilePath://", ov_param);
        if (new_ov != favorites_overlay_filename) {
            favorites_overlay_filename = new_ov;
            loadTexture('favorites_overlay, favorites_overlay_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
}

#### GLSL shader ####

string glslFavorites = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'favorites_lut
    uniform sampler2D auxSampler2;  // 'favorites_overlay
    uniform float lut_strength;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark colorLUTShader decode: nearest blue slice of an 8x8 grid, half a texel inside the cell.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      return texture2D(auxSampler1, (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) / 512.0).xyz;
    }

    // Per-cell crop of the camera (top-origin): x = zoom, y = centre x, z = centre y, w = flips
    // (1 = mirror x, 2 = flip y, 3 = both). Matched to Spark's sample by eye.
    vec4 cellXform(float cell) {
      if (cell < 0.5) { return vec4(2.6, 0.38, 0.62, 0.0); }   // top-left: close-up, hand + phone
      if (cell < 1.5) { return vec4(2.2, 0.62, 0.70, 0.0); }   // top-middle: forearm
      if (cell < 2.5) { return vec4(1.6, 0.55, 0.60, 1.0); }   // top-right: torso, mirrored
      if (cell < 3.5) { return vec4(2.0, 0.45, 0.40, 1.0); }   // mid-left: face + phone, mirrored
      if (cell < 4.5) { return vec4(1.0, 0.50, 0.50, 0.0); }   // centre: the whole frame
      if (cell < 5.5) { return vec4(2.2, 0.40, 0.40, 0.0); }   // mid-right: face close-up
      if (cell < 6.5) { return vec4(1.4, 0.50, 0.50, 2.0); }   // bottom-left: upside down
      if (cell < 7.5) { return vec4(2.4, 0.42, 0.66, 0.0); }   // bottom-middle: hand close-up
      return vec4(1.0, 0.50, 0.50, 1.0);                         // bottom-right: whole frame, mirrored
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec2 tuv = topUv(uv);

      vec2 cellIdx = min(floor(tuv * 3.0), vec2(2.0));
      vec2 local = tuv * 3.0 - cellIdx;                 // 0..1 inside the cell
      vec4 xf = cellXform(cellIdx.y * 3.0 + cellIdx.x);
      if (mod(xf.w, 2.0) > 0.5) { local.x = 1.0 - local.x; }
      if (xf.w > 1.5) { local.y = 1.0 - local.y; }
      // Each cell keeps the frame's aspect (cells are thirds), so a zoom of 1 shows the whole frame.
      vec2 src = clamp(vec2(xf.y, xf.z) + (local - 0.5) / xf.x, 0.0, 1.0);
      vec3 tile = sampleInput(topUv(src)).rgb;
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      tile = mix(tile, lutLookup(tile), lut_strength * strength);

      vec4 ov = texture2D(auxSampler2, tuv);
      vec3 result = mix(tile, ov.rgb, ov.a);
      result = mix(cam.rgb, result, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
