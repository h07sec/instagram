[Filter Aceh]
# "Aceh🌺" ported from the Spark effect (502892308647564). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.589.
#   Grade: 8x8 LUT (blends the two nearest blue slices, so a noisy LUT doesn't band) at 0.7123.
#   Chroma smoothing before the grade: the LUT is steep in skin reds, so small chroma differences
#   and 4:2:0 blocks would turn blotchy; luma is kept, so detail stays sharp.
#   Face approximations without face tracking: a fixed centre ellipse (selfie framing) plus colour
#   gates for lips and skin, so they work in hosts with no face tracker.
#   Blush: multiply (0.635, 0, 0) on skin tones in the cheek zones at 0.12.
#   Lip tint: alpha (0.51, 0, 0) on lip-coloured pixels in the lower face at 0.15.
#   Spark's LUT is a JPEG with block noise and steep red gain, which turned skin reds blotchy: it is denoised (3x3x3 median + Gaussian on the offset from identity, RMSE 1.2% vs the original), decoded between the two nearest blue slices, and chroma is smoothed before the grade (the iphone_14_max_pro fix).
#   Spark's face-tracked lip (#820000, 0.15) and blush (#A20000, 0.12) layers are approximated without face tracking (IG has no face tracker yet).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('aceh_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.7123, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.589, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {blush_opacity = 0.12, min = 0.0, max = 1.0, description = "Cheek blush (fakes the face-tracked blush layer)"},
        {lip_opacity = 0.15, min = 0.0, max = 1.0, description = "Lip tint (fakes the face-tracked lip layer)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'aceh_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.7123,
        smooth_strength = 0.589,
        blush_opacity = 0.12,
        lip_opacity = 0.15,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslAceh,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string aceh_lut_path = "aceh_lut_path";
string aceh_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; aceh_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(aceh_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != aceh_lut_filename) {
            aceh_lut_filename = new_lut;
            loadTexture('aceh_lut, aceh_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'blush_opacity, getParameterFloat('blush_opacity));
    setShaderUniform('pass0, 'lip_opacity, getParameterFloat('lip_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslAceh = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'aceh_lut

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float blush_opacity;
    uniform float lip_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    const vec3 kBlush = vec3(0.635, 0.0, 0.0);
    const vec3 kLip = vec3(0.51, 0.0, 0.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices (no banding on noisy LUTs).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Edge-aware chroma-only smoothing before the grade. Luma is kept, so detail stays sharp.
    vec4 chromaTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float ys = dot(s, vec3(0.299, 0.587, 0.114));
      float w = clamp(1.0 - abs(ys - y0) * 10.0, 0.0, 1.0);
      return vec4((s - vec3(ys)) * w, w);
    }
    vec3 smoothChroma(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.026;
      vec4 acc = vec4(c - vec3(y0), 1.0);
      // Inner ring: radius 0.5 at 0..300 deg; outer ring: radius 1.0 at 30..330 deg (constant offsets).
      acc += chromaTap(uv + d * vec2(0.5, 0.0), y0);
      acc += chromaTap(uv + d * vec2(0.25, 0.4330127), y0);
      acc += chromaTap(uv + d * vec2(-0.25, 0.4330127), y0);
      acc += chromaTap(uv + d * vec2(-0.5, 0.0), y0);
      acc += chromaTap(uv + d * vec2(-0.25, -0.4330127), y0);
      acc += chromaTap(uv + d * vec2(0.25, -0.4330127), y0);
      acc += chromaTap(uv + d * vec2(0.8660254, 0.5), y0);
      acc += chromaTap(uv + d * vec2(0.0, 1.0), y0);
      acc += chromaTap(uv + d * vec2(-0.8660254, 0.5), y0);
      acc += chromaTap(uv + d * vec2(-0.8660254, -0.5), y0);
      acc += chromaTap(uv + d * vec2(0.0, -1.0), y0);
      acc += chromaTap(uv + d * vec2(0.8660254, -0.5), y0);
      return clamp(vec3(y0) + acc.rgb / acc.a, 0.0, 1.0);
    }

    // Position in the assumed face ellipse (selfie framing): 0 at the centre, 1 at the ellipse edge.
    vec2 faceP(vec2 uv) {
      float aspect = source_size_x / max(source_size_y, 1.0);
      return (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
    }

    // Redness relative to brightness: skin sits around 0.06-0.16, lips above about 0.18.
    float redness(vec3 c) {
      return (c.r - c.g) / (c.r + c.g + c.b + 0.001);
    }

    float lipMask(vec2 uv, vec3 c) {
      vec2 fp = faceP(uv);
      float inFace = 1.0 - smoothstep(0.55, 0.85, length(fp * vec2(1.3, 0.75)));
      // Mouth band: below the nose tip (fp.y ~0.3), above the chin (~1.2).
      float mouth = smoothstep(0.45, 0.65, fp.y) * (1.0 - smoothstep(1.05, 1.3, fp.y));
      float lipColour = smoothstep(0.19, 0.27, redness(c)) * smoothstep(0.08, 0.18, c.r - c.b);
      return inFace * mouth * lipColour;
    }

    float skinMask(vec3 c) {
      float r = redness(c);
      float y = dot(c, vec3(0.299, 0.587, 0.114));
      float order = step(c.b, c.g) * step(c.g, c.r);
      return order * smoothstep(0.03, 0.07, r) * (1.0 - smoothstep(0.17, 0.22, r)) * smoothstep(0.15, 0.3, y);
    }

    float cheekMask(vec2 uv) {
      vec2 fp = faceP(uv);
      vec2 d = vec2(abs(fp.x) - 0.5, fp.y - 0.25) / vec2(0.42, 0.34);
      float m = 1.0 - smoothstep(0.0, 1.0, length(d));
      return m * m;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(smoothChroma(uv, src)), strength * lut_strength);
      vec3 result = graded;
      // Blush on skin-tone pixels in the cheek zones, judged on the ungraded camera.
      result = mix(result, result * kBlush, blush_opacity * strength * skinMask(cam.rgb) * cheekMask(uv));
      // Lip tint on lip-coloured pixels in the lower face, judged on the ungraded camera.
      result = mix(result, kLip, lip_opacity * strength * lipMask(uv, cam.rgb));

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
