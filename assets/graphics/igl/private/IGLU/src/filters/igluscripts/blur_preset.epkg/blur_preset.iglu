[Filter BlurPreset]
# "Blur -preset" ported from the Spark effect (312906926708192). Single fragment pass, no face
# tracking, no segmentation.
#
#   Spark, bottom to top:
#     1. the camera through BlurDirectional5 (horizontal only, weights 0.1/0.2/0.4/0.2/0.1, taps 4.5/1024 UV
#        apart);
#     2. the unblurred camera through FastColorLUT ("orange K1") tinted 0xF4C35F, at 33.7% opacity;
#     3. a lit lavender 0x9E85E7 rectangle with multiply blend at 50.6% opacity. Spark lights it with
#        0.2 ambient + 0.8 directional at -45/+5 degrees, about 0.763 on a camera-facing quad.
#   The packaged sparkle / kira / "no" textures and the "simple kira" patch are unused in Spark and
#   not ported.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('blur_preset_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'blur_preset_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslBlurPreset,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string blur_preset_lut_path = "blur_preset_lut_path";
string blur_preset_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; blur_preset_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(blur_preset_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != blur_preset_lut_filename) {
            blur_preset_lut_filename = new_lut;
            loadTexture('blur_preset_lut, blur_preset_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslBlurPreset = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'blur_preset_lut
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    // Spark BlurDirectional5: Strength 4.5 at TextureSize 1024, direction (1, 0).
    const vec2 kStep = vec2(4.5 / 1024.0, 0.0);
    const vec3 kTint = vec3(0.9569, 0.7647, 0.3725);
    // 0x9E85E7 times Spark's lighting on the quad (0.763; the Spark sample's highlights match it).
    const vec3 kWash = vec3(0.6196, 0.5216, 0.9059) * 0.763;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode, nearest blue slice).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 blur = 0.4 * cam.rgb + 0.2 * (sampleInput(uv - kStep).rgb + sampleInput(uv + kStep).rgb) +
          0.1 * (sampleInput(uv - 2.0 * kStep).rgb + sampleInput(uv + 2.0 * kStep).rgb);
      vec3 graded = mix(blur, lutLookup(cam.rgb) * kTint, 0.3370612);
      graded *= mix(vec3(1.0), kWash, 0.5057791);
      vec3 result = mix(cam.rgb, graded, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
