{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "identifier": "8bf610d7-2181-46f9-a388-07a8ae53c3c1",
  "displayName": "Vertex Fireflies",
  "description": "[IG Edits] Vertex-stage particle sample. Particles laid out on a grid are lit by the frame pixel they sit on, then ignite, swarm off-frame and fade on a loop.",
  "iglu": {
    "legacyId": 3020,
    "customization": [
      { "name": "amount", "default": 1.0, "min": 0.0, "max": 1.0, "displayName": "Opacity" },
      { "name": "duration", "default": 4.0, "min": 0.5, "max": 20.0, "displayName": "Duration" },
      { "name": "u_seed", "default": 3.0, "min": 0.0, "max": 100.0, "displayName": "Variation" },
      { "name": "u_sizeScale", "default": 4.0, "min": 0.2, "max": 8.0, "displayName": "Size" },
      { "name": "u_glow", "default": 0.8, "min": 0.0, "max": 4.0, "displayName": "Intensity" },
      {
        "name": "u_flicker",
        "default": 0.45,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Flicker",
        "displayNameDescription": "[IG Edits] Slider label controlling how deeply particles blink on and off (0 = steady, 1 = full blink)."
      },
      { "name": "u_flySpeed", "default": 0.9, "min": 0.0, "max": 3.0, "displayName": "Distance" }
    ]
  }
}
