[Filter PolaroidFrame]
# "polaroid" (Spark 768820121628618), SCRATCH port of the screen-space layers. Single fragment pass.
#
#   Spark draw order on canvas0 (375x667 pt, one layer stack, all unlit), over the camera background:
#     1. rectangle0 "camera", alpha, opaque: the camera (whole frame) shrunk to 0.6 x 0.6 of the canvas, centre
#        moved up 61.33 pt. Its colour = 5x5 box blur (25 equal taps, step 1.5 / screen px) of
#        colorLUTShader(camera, "film exposure", grid 8x8, intensity 0.5).
#     2. color "2" (same graph, 0.896): multiplyMode invertAlphaOnly with the camera as multiply texture, so its
#        alpha is 0 and it draws nothing.
#     3. grain, multiply 0.1029: Grain01 576x1024 over the canvas.
#     4. frame, alpha 1: polaroid1 576x1024 RGBA (opaque white card with a transparent photo window).
#   On frames that are not 9:16 the polaroid box is contain-fitted (never stretched; the card's white edge fills the
#   margins) and the camera is cover-cropped into the photo rect.
#   Dropped: face-only skin smoothing 0.206 (faceMesh0 retouch). Hidden: cybertexture1 layer (not ported).
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('polaroid_frame_lut);
    makeTexture('polaroid_frame_grain);
    makeTexture('polaroid_frame_frame);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'polaroid_frame_lut, 'polaroid_frame_grain, 'polaroid_frame_frame},
      uniforms = {
        strength = 1.0,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslPolaroidFrame,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string polaroid_frame_lut_path = "polaroid_frame_lut_path";
string polaroid_frame_lut_filename = "";
string polaroid_frame_grain_path = "polaroid_frame_grain_path";
string polaroid_frame_grain_filename = "";
string polaroid_frame_frame_path = "polaroid_frame_frame_path";
string polaroid_frame_frame_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; polaroid_frame_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(polaroid_frame_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != polaroid_frame_lut_filename) {
            polaroid_frame_lut_filename = new_lut;
            loadTexture('polaroid_frame_lut, polaroid_frame_lut_filename);
        }
    }
    string grain_param = getParameterString(polaroid_frame_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != polaroid_frame_grain_filename) {
            polaroid_frame_grain_filename = new_grain;
            loadTexture('polaroid_frame_grain, polaroid_frame_grain_filename);
        }
    }
    string frame_param = getParameterString(polaroid_frame_frame_path);
    if (frame_param != "") {
        string new_frame = stringAppend("textureFilePath://", frame_param);
        if (new_frame != polaroid_frame_frame_filename) {
            polaroid_frame_frame_filename = new_frame;
            loadTexture('polaroid_frame_frame, polaroid_frame_frame_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslPolaroidFrame = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'polaroid_frame_lut (film exposure, 1024x1024, 8x8 grid)
    uniform sampler2D auxSampler2;  // 'polaroid_frame_grain (Grain01, 576x1024)
    uniform sampler2D auxSampler3;  // 'polaroid_frame_frame (576x2048 opaque: top = straight RGB, bottom = alpha)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float source_size_x;
    uniform float source_size_y;

    const float kBoxAspect = 0.5625;                            // polaroid1 576x1024
    const vec2 kPhotoCentre = vec2(0.5, 0.5 - 61.33332 / 667.0); // canvas 375x667, y up -> top-origin minus
    const float kPhotoScale = 0.6;
    const float kGrainOpacity = 0.10292701198630137;
    const float kLutPixel = 1.0 / 1024.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // colorLUTShader.sca: clamp, slice = floor(64 * 255/256 * b), half-pixel inset, mix 0.5. p is top-origin.
    vec3 lutAt(vec2 p) {
      vec3 c = clamp(sampleInput(topUv(p)).rgb, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      vec2 lc = (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) * kLutPixel;
      return mix(c, texture2D(auxSampler1, lc).rgb, 0.5);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamps below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec2 p = topUv(uv);
      float aspect = source_size_x / source_size_y;
      // Contain-fit the 9:16 polaroid box; cover-crop the camera into the photo rect (identity on 9:16).
      vec2 boxSize = aspect > kBoxAspect ? vec2(kBoxAspect / aspect, 1.0) : vec2(1.0, aspect / kBoxAspect);
      vec2 q = (p - 0.5) / boxSize + 0.5;
      // One component of boxSize is 1, so it is also the camera crop that matches the box aspect.
      vec2 crop = boxSize;

      vec3 col = cam.rgb;
      vec2 r = (q - kPhotoCentre) / kPhotoScale + 0.5;
      if (r.x >= 0.0 && r.x <= 1.0 && r.y >= 0.0 && r.y <= 1.0) {
        vec2 cuv = (r - 0.5) * crop + 0.5;
        vec2 stepUv = 1.5 / vec2(source_size_x, source_size_y);
        vec3 sum = vec3(0.0);
        for (int i = -2; i <= 2; i++) {
          for (int j = -2; j <= 2; j++) {
            sum += lutAt(cuv + vec2(float(i), float(j)) * stepUv);
          }
        }
        col = clamp(sum / 25.0, 0.0, 1.0);
      }
      // grain: multiply, dst * (1 - a + a * g), on the box.
      float g = texture2D(auxSampler2, q).r;
      col = col * (1.0 - kGrainOpacity + kGrainOpacity * g);
      // frame: straight alpha over; clamp-to-edge extends its white edge outside the box.
      vec2 fq = clamp(q, 0.0, 1.0);
      float fy = clamp(fq.y * 1024.0, 0.5, 1023.5);
      vec3 frgb = texture2D(auxSampler3, vec2(fq.x, fy / 2048.0)).rgb;
      float fa = texture2D(auxSampler3, vec2(fq.x, (1024.0 + fy) / 2048.0)).r;
      col = mix(col, frgb, fa);

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
