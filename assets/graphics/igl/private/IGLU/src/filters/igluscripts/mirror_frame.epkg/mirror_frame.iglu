[Filter MirrorFrame]
# "mirror_frame" ported from the Spark effect (706890342997873). Six fragment passes, no face tracking. SCRATCH (batch 12, stack E).
#
#   Spark chain (main.json renderPasses; shaders preProcessorSparkSL.sca + postProcessor.sca, ported line by line):
#     sheen      1/8  preProcessor idx 0: dataTex.g at a skewed, time-swept uv (sheenU from DeviceMotion; -0.8 at rest).
#     finalbuff  1/1  preProcessor idx 1: mirror tiles = camera at the Plane_001 mesh uv (outputUV scene pass, mesh
#                     rasterised here analytically from the glb), metal frame (frameTex), sheen, colour gradient,
#                     spectrum highlights (sheenU constant 0.33806 in this pass). alpha = frame coverage.
#     prelast    1/1  preProcessor idx 2: 0.5 px chroma split of finalbuff over the camera with a dataTex shadow.
#     postB      1/2  postProcessor idx 0: (camera.r * step(0.1, frameTex.r) - 0.8518767) * 2.
#     postA      1/4  postProcessor idx 1: 9-tap diagonal blur of postB, weights (6-|i|)^2 / 144.
#     postLast   1/1  postProcessor idx 2: prelast + postA * 3.119735; then strength mix.
#   Dropped (BATCH-DROP): skin smoothing 0.5 fullScreen (retouchingMaterial Mean2x2/Mean8x8/MeanBA/BA/Composite chain);
#   the chain input is the raw camera.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('mirror_frame_frame);
    makeTexture('mirror_frame_data);
    makeTexture('mirror_frame_spectrum);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'sheen,
      inputs = {'default, 'mirror_frame_data},
      scale = {0.125, 0.125},
      uniforms = { time = 0.0, },
      glslShader = glslSheen,
    }, {
      name = 'finalbuff,
      inputs = {'default, 'sheen, 'mirror_frame_frame, 'mirror_frame_spectrum},
      uniforms = { time = 0.0, aspect = 0.5625, },
      glslShader = glslFinalBuff,
    }, {
      name = 'prelast,
      inputs = {'default, 'finalbuff, 'mirror_frame_data},
      uniforms = { src_w = 1080.0, src_h = 1920.0, },
      glslShader = glslPreLast,
    }, {
      name = 'postB,
      inputs = {'default, 'mirror_frame_frame},
      scale = {0.5, 0.5},
      uniforms = { dummy = 0.0, },
      glslShader = glslPostB,
    }, {
      name = 'postA,
      inputs = {'default, 'postB},
      scale = {0.25, 0.25},
      uniforms = { src_w = 1080.0, src_h = 1920.0, },
      glslShader = glslPostA,
    }, {
      name = 'postLast,
      inputs = {'default, 'prelast, 'postA},
      uniforms = { strength = 1.0, },
      glslShader = glslPostLast,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string frame_path = "mirror_frame_frame_path";
string data_path = "mirror_frame_data_path";
string spectrum_path = "mirror_frame_spectrum_path";
string frame_file = "";
string data_file = "";
string spectrum_file = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('postLast, 'strength, getParameterFloat('strength));

    f32 t = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('sheen, 'time, t);
    setShaderUniform('finalbuff, 'time, t);

    string fp = getParameterString(frame_path);
    if (fp != "") {
        string nf = stringAppend("textureFilePath://", fp);
        if (nf != frame_file) { frame_file = nf; loadTexture('mirror_frame_frame, frame_file); }
    }
    string dp = getParameterString(data_path);
    if (dp != "") {
        string nd = stringAppend("textureFilePath://", dp);
        if (nd != data_file) { data_file = nd; loadTexture('mirror_frame_data, data_file); }
    }
    string sp = getParameterString(spectrum_path);
    if (sp != "") {
        string ns = stringAppend("textureFilePath://", sp);
        if (ns != spectrum_file) { spectrum_file = ns; loadTexture('mirror_frame_spectrum, spectrum_file); }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('finalbuff, 'aspect, srcSize.x / srcSize.y);
        setShaderUniform('prelast, 'src_w, srcSize.x);
        setShaderUniform('prelast, 'src_h, srcSize.y);
        setShaderUniform('postA, 'src_w, srcSize.x);
        setShaderUniform('postA, 'src_h, srcSize.y);
    }
}

#### GLSL shaders ####

string glslSheen = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (camera, unused: sizes the pass)
    uniform sampler2D auxSampler1;  // 'mirror_frame_data (dataTex, repeat)
    uniform float time;
    const float kSheenU = -0.8;     // DeviceMotion at rest: -2 * (rotY + 0.4) + 2 * rotZ
    void main() {
      vec2 uv = sparkUv();
      vec2 sheenUV;
      sheenUV.x = uv.x * 0.878 - uv.y * 0.479;
      sheenUV.y = uv.y * 0.479 + uv.x * 0.878;
      sheenUV.x += time * 0.05;
      float sheen = texture2D(auxSampler1, imgRep(sheenUV * vec2(1.4, 1.0) + kSheenU * 0.3)).g;
      gl_FragColor = vec4(sheen);
    }
    ";

string glslFinalBuff = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'sheen (1/8)
    uniform sampler2D auxSampler2;  // 'mirror_frame_frame (1024x2048: top = straight RGB, bottom = alpha)
    uniform sampler2D auxSampler3;  // 'mirror_frame_spectrum (repeat)
    uniform float time;
    uniform float aspect;
    const float kSheenU = 0.33806;  // constant wired into this pass in Spark

    void tri(vec2 P, vec2 a, vec2 b, vec2 c, vec2 ta, vec2 tb, vec2 tc, inout float hit, inout vec2 muv) {
      vec2 e0 = b - a;
      vec2 e1 = c - a;
      vec2 e2 = P - a;
      float den = e0.x * e1.y - e1.x * e0.y;
      float l1 = (e2.x * e1.y - e1.x * e2.y) / den;
      float l2 = (e0.x * e2.y - e2.x * e0.y) / den;
      float l0 = 1.0 - l1 - l2;
      if (hit < 0.5 && l0 >= 0.0 && l1 >= 0.0 && l2 >= 0.0) {
        hit = 1.0;
        muv = ta * l0 + tb * l1 + tc * l2;
      }
    }

    // outputUV scene pass of Plane_001: (glTF uv, 1, 1) where the mesh covers, (0, 0, 0, 0) elsewhere.
    // Spark samples it at (s.x, 1 - s.y) and flips y back; with the glTF v flip on import that yields
    // mirrorData = (u_gltf, v_gltf, coverage) at the vertically mirrored screen point.
    vec3 mirrorAt(vec2 s) {
      vec2 ndc = vec2(2.0 * s.x - 1.0, 1.0 - 2.0 * s.y);
      vec2 P = vec2(ndc.x * aspect, ndc.y);
      float hit = 0.0;
      vec2 muv = vec2(0.0);
      tri(P, vec2(0.3927343, 0.6868612), vec2(0.3927343, 0.0000000), vec2(0.5664945, 0.0000000), vec2(0.2796368, 0.0932021), vec2(0.2796368, 0.9999390), vec2(0.7203632, 0.9999390), hit, muv);
      tri(P, vec2(0.3927343, 0.6868612), vec2(0.5664945, 0.0000000), vec2(0.5664945, 0.7612208), vec2(0.2796368, 0.0932021), vec2(0.7203632, 0.9999390), vec2(0.7203632, 0.0000610), hit, muv);
      tri(P, vec2(0.5664945, -0.7612208), vec2(0.5664945, 0.0000000), vec2(0.3927343, 0.0000000), vec2(0.7203632, 0.9999390), vec2(0.7203632, 0.0000610), vec2(0.2796368, 0.0000610), hit, muv);
      tri(P, vec2(0.5664945, -0.7612208), vec2(0.3927343, 0.0000000), vec2(0.3927343, -0.6868612), vec2(0.7203632, 0.9999390), vec2(0.2796368, 0.0000610), vec2(0.2796368, 0.9067979), hit, muv);
      tri(P, vec2(0.3906407, 0.6920996), vec2(0.5686918, 0.7558932), vec2(0.3170438, 1.0075588), vec2(0.5286183, 0.8592355), vec2(0.9797360, 0.6968032), vec2(0.0157778, 0.5622950), hit, muv);
      tri(P, vec2(0.3906407, 0.6920996), vec2(0.3170438, 1.0075588), vec2(0.2647024, 0.8245681), vec2(0.5286183, 0.8592355), vec2(0.0157778, 0.5622950), vec2(0.1210498, 0.7990692), hit, muv);
      tri(P, vec2(0.0000000, 0.8269390), vec2(0.2591744, 0.8269390), vec2(0.3225669, 1.0052390), vec2(0.0000458, 0.2565957), vec2(0.8115511, 0.2565957), vec2(0.9999542, 0.5207446), hit, muv);
      tri(P, vec2(0.0000000, 0.8269390), vec2(0.3225669, 1.0052390), vec2(0.0000000, 1.0052390), vec2(0.0000458, 0.2565957), vec2(0.9999542, 0.5207446), vec2(0.0000458, 0.5207446), hit, muv);
      tri(P, vec2(0.0000000, 0.8269390), vec2(0.0000000, 1.0052390), vec2(-0.3225669, 1.0052390), vec2(0.9999542, 0.2565957), vec2(0.9999542, 0.5207446), vec2(0.0000458, 0.5207446), hit, muv);
      tri(P, vec2(0.0000000, 0.8269390), vec2(-0.3225669, 1.0052390), vec2(-0.2591744, 0.8269390), vec2(0.9999542, 0.2565957), vec2(0.0000458, 0.5207446), vec2(0.1884489, 0.2565957), hit, muv);
      tri(P, vec2(-0.3906407, 0.6920996), vec2(-0.2647024, 0.8245681), vec2(-0.3170438, 1.0075588), vec2(0.5288624, 0.8646983), vec2(0.1099260, 0.8028534), vec2(0.0042420, 0.5586023), hit, muv);
      tri(P, vec2(-0.3906407, 0.6920996), vec2(-0.3170438, 1.0075588), vec2(-0.5686918, 0.7558932), vec2(0.5288624, 0.8646983), vec2(0.0042420, 0.5586023), vec2(0.9951019, 0.6968643), hit, muv);
      tri(P, vec2(-0.3927343, 0.6868612), vec2(-0.5664945, 0.7612208), vec2(-0.5664945, 0.0000000), vec2(0.7203632, 0.0932021), vec2(0.2796368, 0.0000610), vec2(0.2796368, 0.9999390), hit, muv);
      tri(P, vec2(-0.3927343, 0.6868612), vec2(-0.5664945, 0.0000000), vec2(-0.3927343, 0.0000000), vec2(0.7203632, 0.0932021), vec2(0.2796368, 0.9999390), vec2(0.7203632, 0.9999390), hit, muv);
      tri(P, vec2(-0.5664945, -0.7612208), vec2(-0.3927343, -0.6868612), vec2(-0.3927343, 0.0000000), vec2(0.2796368, 0.9999390), vec2(0.7203632, 0.9067979), vec2(0.7203632, 0.0000610), hit, muv);
      tri(P, vec2(-0.5664945, -0.7612208), vec2(-0.3927343, 0.0000000), vec2(-0.5664945, 0.0000000), vec2(0.2796368, 0.9999390), vec2(0.7203632, 0.0000610), vec2(0.2796368, 0.0000610), hit, muv);
      tri(P, vec2(-0.3906407, -0.6920996), vec2(-0.5686918, -0.7558932), vec2(-0.3170438, -1.0075588), vec2(0.5285420, 0.8576028), vec2(0.9751278, 0.6967880), vec2(0.0192264, 0.5634089), hit, muv);
      tri(P, vec2(-0.3906407, -0.6920996), vec2(-0.3170438, -1.0075588), vec2(-0.2647024, -0.8245681), vec2(0.5285420, 0.8576028), vec2(0.0192264, 0.5634089), vec2(0.1243915, 0.7979400), hit, muv);
      tri(P, vec2(0.0000000, -0.8269390), vec2(-0.2591744, -0.8269390), vec2(-0.3225669, -1.0052390), vec2(0.9999542, 0.2375067), vec2(0.1884489, 0.2375067), vec2(0.0000458, 0.5016556), hit, muv);
      tri(P, vec2(0.0000000, -0.8269390), vec2(-0.3225669, -1.0052390), vec2(0.0000000, -1.0052390), vec2(0.9999542, 0.2375067), vec2(0.0000458, 0.5016556), vec2(0.9999542, 0.5016556), hit, muv);
      tri(P, vec2(0.0000000, -0.8269390), vec2(0.0000000, -1.0052390), vec2(0.3225669, -1.0052390), vec2(0.0000458, 0.2375067), vec2(0.0000458, 0.5016556), vec2(0.9999542, 0.5016556), hit, muv);
      tri(P, vec2(0.0000000, -0.8269390), vec2(0.3225669, -1.0052390), vec2(0.2591744, -0.8269390), vec2(0.0000458, 0.2375067), vec2(0.9999542, 0.5016556), vec2(0.8115511, 0.2375067), hit, muv);
      tri(P, vec2(0.3170438, -1.0075588), vec2(0.5686918, -0.7558932), vec2(0.3906407, -0.6920996), vec2(0.0165103, 0.5625391), vec2(0.9787594, 0.6968032), vec2(0.5286030, 0.8588846), hit, muv);
      tri(P, vec2(0.3170438, -1.0075588), vec2(0.3906407, -0.6920996), vec2(0.2647024, -0.8245681), vec2(0.0165103, 0.5625391), vec2(0.5286030, 0.8588846), vec2(0.1217670, 0.7988251), hit, muv);
      tri(P, vec2(0.5741073, 0.7588829), vec2(0.5741073, 1.0182140), vec2(0.3248091, 1.0182140), vec2(0.1395590, 0.3830472), vec2(0.8209049, 0.0154421), vec2(0.9263294, 0.7560235), hit, muv);
      tri(P, vec2(-0.5741073, 0.7588829), vec2(-0.3248091, 1.0182140), vec2(-0.5741073, 1.0182140), vec2(0.1395590, 0.3830472), vec2(0.9263294, 0.7560235), vec2(0.8209049, 0.0154421), hit, muv);
      tri(P, vec2(0.5741073, -0.7588829), vec2(0.3248091, -1.0182140), vec2(0.5741073, -1.0182140), vec2(0.1395590, 0.3830472), vec2(0.9263294, 0.7560235), vec2(0.8209049, 0.0154421), hit, muv);
      tri(P, vec2(-0.5741073, -0.7588829), vec2(-0.5741073, -1.0182140), vec2(-0.3248091, -1.0182140), vec2(0.1395590, 0.3830472), vec2(0.8209049, 0.0154421), vec2(0.9263294, 0.7560235), hit, muv);
      return vec3(muv, hit);
    }

    vec4 frameAt(vec2 s) {
      vec2 q = vec2(s.x, 1.0 - s.y);
      float fy = clamp(q.y * 1024.0, 0.5, 1023.5);
      vec3 rgb = texture2D(auxSampler2, vec2(q.x, fy / 2048.0)).rgb;
      float a = texture2D(auxSampler2, vec2(q.x, (1024.0 + fy) / 2048.0)).r;
      return vec4(rgb, a);
    }

    void main() {
      vec2 uv = sparkUv();
      float u_Time = time;
      vec4 metalFrameData = frameAt(uv);
      vec3 mirrorData = mirrorAt(uv);

      float metalFrame = max(metalFrameData.a - 0.5, 0.0) * 2.0;
      vec2 metalFrameUV = metalFrameData.rg;
      float fullFrame = min(1.0, mirrorData.b + metalFrame);
      float mirrorFlairs = (1.0 - step(metalFrameData.a, 0.0)) * (1.0 - metalFrame) * fullFrame;

      vec2 mirrorUV = mix(mirrorData.rg, metalFrameUV, step(0.95, metalFrameData.a));
      mirrorUV -= mirrorFlairs * 0.01;

      vec3 reflect = sampleInput(nat(mirrorUV)).rgb;
      float reflectLuma = dot(reflect, vec3(0.299, 0.587, 0.114));
      reflect = mix(reflect, vec3(reflectLuma), 0.5 * metalFrame);

      float gradient = sin(uv.y * 6.0 + u_Time);
      reflect += vec3(0.075, 0.0, 0.125) * max(gradient, 0.0);
      reflect += vec3(0.2, 0.1, 0.0) * max(-gradient, 0.0);

      float sheen = texture2D(auxSampler1, nat(metalFrameUV)).r * metalFrame;
      float sheenGeneric = texture2D(auxSampler1, nat(uv)).r;
      vec3 final = vec3(1.4, 1.4, 1.1) * sheen + sheenGeneric * 0.1;

      float specWave = sin(uv.x * 13.0 + uv.y * 4.0);
      vec3 specColors = texture2D(auxSampler3, imgRep(metalFrameUV.xx * uv + specWave * 0.1 + u_Time * 0.02 + kSheenU)).rgb;
      specColors *= mirrorFlairs * (1.0 - metalFrame) * mirrorFlairs * sheenGeneric;

      final += specColors;
      final = final + reflect;
      // UNORM render target in Spark.
      gl_FragColor = vec4(clamp(final, 0.0, 1.0), fullFrame);
    }
    ";

string glslPreLast = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'finalbuff
    uniform sampler2D auxSampler2;  // 'mirror_frame_data (repeat)
    uniform float src_w;
    uniform float src_h;
    void main() {
      vec2 uv = sparkUv();
      vec2 pixel = vec2(0.5) / vec2(src_w, src_h);
      vec4 fullFrame;
      fullFrame.r = texture2D(auxSampler1, nat(uv + vec2(pixel.x, pixel.y))).r;
      fullFrame.g = texture2D(auxSampler1, nat(uv - vec2(pixel.x, pixel.y))).g;
      fullFrame.b = texture2D(auxSampler1, nat(uv + vec2(0.0, pixel.y))).b;
      fullFrame.a = texture2D(auxSampler1, nat(uv)).a;
      vec3 raw = sampleInput(nat(uv)).rgb;
      float shadow = texture2D(auxSampler2, imgRep(vec2(uv.x, 1.0 - uv.y) + vec2(-0.02, 0.015))).r;
      raw *= 1.0 - shadow * 0.3;
      gl_FragColor = vec4(clamp(mix(raw, fullFrame.rgb, fullFrame.a), 0.0, 1.0), 1.0);
    }
    ";

string glslPostB = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mirror_frame_frame (top half = straight RGB)
    void main() {
      vec2 uv = sparkUv();
      float fy = clamp((1.0 - uv.y) * 1024.0, 0.5, 1023.5);
      float fr = texture2D(auxSampler1, vec2(uv.x, fy / 2048.0)).r;
      float bright = sampleInput(nat(uv)).r * step(0.1, fr);
      gl_FragColor = vec4(clamp((bright - 0.8518766760826111) * 2.0, 0.0, 1.0));
    }
    ";

string glslPostA = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (sizes the pass)
    uniform sampler2D auxSampler1;  // 'postB (1/2)
    uniform float src_w;
    uniform float src_h;
    void main() {
      vec2 uv = sparkUv();
      vec2 pixel = vec2(-4.0 / src_w, 4.0 / src_h);
      float avg = 0.0;
      for (int i = -4; i <= 4; i++) {
        float weight = 6.0 - abs(float(i));
        weight *= weight;
        avg += texture2D(auxSampler1, nat(uv + pixel * float(i))).r * weight;
      }
      avg /= 144.0;
      gl_FragColor = vec4(vec3(clamp(avg, 0.0, 1.0)), 1.0);
    }
    ";

string glslPostLast = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    // Spark processor uv s is bottom-origin; p is top-origin (Metal native, UP == -1). s = (p.x, 1 - p.y).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }
    // Native uv of a pass output or the camera at Spark uv q.
    vec2 nat(vec2 q) { return topUv(vec2(q.x, 1.0 - q.y)); }
    // Loaded images are top-row-first: Spark uv q -> image uv (q.x, 1 - q.y). Repeat wrap via fract.
    vec2 imgRep(vec2 q) { q = fract(q); return vec2(q.x, 1.0 - q.y); }
    vec2 sparkUv() { vec2 p = topUv(sourceTextureCoordinate); return vec2(p.x, 1.0 - p.y); }

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'prelast
    uniform sampler2D auxSampler2;  // 'postA (1/4)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec2 uv = sparkUv();
      vec3 raw = texture2D(auxSampler1, nat(uv)).rgb;
      float flare = texture2D(auxSampler2, nat(uv)).r * 3.1197350025177;
      vec3 spark = clamp(raw + flare, 0.0, 1.0);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
