[Filter TransitionMulticlipShapeWipeSquare]

# Clip B opens through a growing square (the Shape Wipe Square In effect) over an
# untouched clip A.
#
# Ported from the Easel web tool's multiclip_shape_wipe_square.iglu.
# Easel eases progress by its [AnimationCurve quarticInOut] tag before the
# script sees it; the transition host passes linear progress, so the curve is
# applied in [PreRender] instead.
#
# The video_mask_wipe_rect mask and the over-composite run in one pass that reads
# both clips.

fun easeInOutQuartic(f32 t) f32 {
  if (t < 0.5) {
    return 8.0 * t * t * t * t;
  }
  f32 u = t - 1.0;
  return 1.0 - 8.0 * u * u * u * u;
}

[Init]
fun init(Filter filter) {
  makeTexture('transition);

  filter.parameters = {
    {amount = 0.05, min = 0.0, max = 1.0, description = "Edge smoothness"},
  };

  filter.passes = {
    {
      name = 'composite,
      inputs = {'default, 'transition},
      shaderInputNames = {'default, 's_texture1},
      uniforms = {
        amount = 0.01,
        aspect = 1.0,
        halfSize = {0.0, 0.0},
      },
      glslShader = glsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = easeInOutQuartic(max(getParameterFloat('progress), getParameterFloat('transition_progress)));
  # remap normalized amount to shader edge range [0,0.2], kept off 0 for smoothstep
  f32 amount = max(0.001, getParameterFloat('amount) * 0.2);
  vec2 size = getTextureSize('default);
  f32 aspect = size.x / size.y;
  f32 rp = mix(0.0 - amount, 1.0 + amount, p);
  vec2 halfSize = {0.0, 0.0};
  halfSize.x = rp * max(aspect, 1.0) * 0.5;
  halfSize.y = rp * 0.5;
  setShaderUniform('composite, 'amount, amount);
  setShaderUniform('composite, 'aspect, aspect);
  setShaderUniform('composite, 'halfSize, halfSize);
}

string glsl = "
precision highp float;
varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform sampler2D s_texture1;
uniform float amount;
uniform float aspect;
uniform vec2 halfSize;

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 a = sampleInput(uv);
  vec4 b = texture2D(s_texture1, uv);

  vec2 pt = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);
  vec2 d = abs(pt) - halfSize;
  float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
  b.a *= smoothstep(amount, -amount, dist);
  b.rgb *= b.a;

  // Clip B is premultiplied by its mask, so it goes over clip A without another
  // multiply by b.a.
  float outA = b.a + a.a * (1.0 - b.a);
  vec3 rgb = (b.rgb + a.rgb * a.a * (1.0 - b.a)) / max(outA, 1e-5);

  gl_FragColor = toOutputFormat(vec4(rgb, outA));
}
";
