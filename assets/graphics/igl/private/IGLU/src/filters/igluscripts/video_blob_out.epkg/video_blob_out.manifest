  "identifier": "d539dd21-b106-4618-a200-044c47c0a2f1",
  "displayName": "Blob Out",
  "description": "[IG Edits] Video effect name. With \"Blob out\", the creator can hide the frame behind embossed noise globs that refract the media as it lifts away.",
  "iglu": {
    "legacyId": 3230,
    "behavior": {
      "type": "fixedOutro",
      "durationMs": 600,
      "curve": "linear"
    },
    "customization": [
      {
        "name": "duration",
        "default": 0.6,
        "min": 0.2,
        "max": 3.0,
        "displayName": "Duration",
        "displayNameDescription": "[IG Edits] Slider label controlling how long a video effect's animation lasts; exact units and range vary per effect (seconds or normalized).",
        "displayMethod": "time"
      },
      {
        "name": "amount",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Amount",
        "displayNameDescription": "[IG Edits] Slider label controlling how finely the noise pattern of a video effect tiles across the frame; higher values give smaller, denser globs."
      }
    ]
  },
  "dependencies": [
    "video_blob_in"
  ]
}
