[Filter TextGlitchIn]
#
# Port of C++ text_glitch_in/TextGlitchInFilter.cpp (shared common_shaders/GlitchShader.cpp, outro = 0).
# Single-pass posterized directional glitch: 5 steps shift the UV in noise-chosen horizontal/vertical
# bands, with the offset falling off as the intro progress runs 0 -> 1. The band positions, flips and
# offset size depend only on the parameters, so PreRender computes them once per frame and the shader
# only compares each pixel against them. Metal is auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {progress = 0.0},
        {outro = 0.0, description = "0 = appearing (In), 1 = disappearing (Out)"},
        {maxOffset = 0.65, description = "Max UV displacement at progress 0"},
        {timeSteps = 25.0, description = "Number of posterized animation steps"},
        {falloffCurve = 5.0, description = "Exponent on the offset falloff curve"},
    };

    filter.passes = {{
        name = 'glitchIn,
        inputs = {'default},
        uniforms = {
            dividingLines = {0.0, 0.0, 0.0, 0.0},
            dividingLine4 = 0.0,
            flips = {0.0, 0.0, 0.0, 0.0},
            flip4 = 0.0,
            offsetScale = 0.0,
            visible = 0.0,
        },
        glslShader = glsl,
    }};
}

fun glitchStep(f32 edge, f32 x) f32 {
    if (x < edge) {
        return 0.0;
    }
    return 1.0;
}

fun dotNoise(f32 px, f32 py, f32 pz) f32 {
    f32 phi = 1.618033988;
    vec3 c0 = {-0.571464913, 0.814921382, 0.096597072};
    vec3 c1 = {-0.278044873, -0.303026659, 0.911518454};
    vec3 c2 = {0.772087367, 0.494042493, 0.399753815};
    f32 a0 = c0.x * px + c1.x * py + c2.x * pz;
    f32 a1 = c0.y * px + c1.y * py + c2.y * pz;
    f32 a2 = c0.z * px + c1.z * py + c2.z * pz;
    vec3 q = {phi * px, phi * py, phi * pz};
    f32 b0 = dot(q, c0);
    f32 b1 = dot(q, c1);
    f32 b2 = dot(q, c2);
    return cos(a0) * sin(b0) + cos(a1) * sin(b1) + cos(a2) * sin(b2);
}

fun dividingLine(f32 x, f32 posterized) f32 {
    f32 line = (dotNoise(x * 113.45, posterized * 56.2, 0.0) + 3.0) / 6.0;
    return line;
}

fun flip(f32 x, f32 posterized) f32 {
    return glitchStep(0.0, dotNoise(x * 113.45 + 5.0, posterized * 56.2 + 16.3, -9.0));
}

[PreRender]
fun preRender(Filter filter) {
    f32 progress = getParameterFloat('progress);
    f32 timeSteps = getParameterFloat('timeSteps);
    f32 p = mix(progress, 1.0 - progress, glitchStep(0.5, getParameterFloat('outro)));
    f32 posterized = ceil(p * timeSteps) / timeSteps;
    f32 curve = pow(1.0 - posterized, getParameterFloat('falloffCurve));
    vec4 lines = {dividingLine(0.0, posterized), dividingLine(1.0, posterized),
                  dividingLine(2.0, posterized), dividingLine(3.0, posterized)};
    vec4 flips = {flip(0.0, posterized), flip(1.0, posterized), flip(2.0, posterized),
                  flip(3.0, posterized)};
    setShaderUniform('glitchIn, 'dividingLines, lines);
    setShaderUniform('glitchIn, 'dividingLine4, dividingLine(4.0, posterized));
    setShaderUniform('glitchIn, 'flips, flips);
    setShaderUniform('glitchIn, 'flip4, flip(4.0, posterized));
    setShaderUniform('glitchIn, 'offsetScale, max(0.0, getParameterFloat('maxOffset) * curve));
    setShaderUniform('glitchIn, 'visible, glitchStep(0.001, p));
}


# --- GLSL Shader (port of GlitchShader.cpp glitchFragmentShaderStr; per-frame values from PreRender) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform vec4 dividingLines;
    uniform float dividingLine4;
    uniform vec4 flips;
    uniform float flip4;
    uniform float offsetScale;
    uniform float visible;

    vec2 shiftBand(vec2 uv, float dividingLine, float flip, float vert) {
        vec2 offset_h = vec2(step(dividingLine, uv.y) - 0.5, 0.0);
        vec2 offset_v = vec2(0.0, step(dividingLine, uv.x) - 0.5);
        vec2 offset = mix(offset_h, offset_v, vert);
        offset = mix(offset, offset * -1.0, flip);
        offset *= offsetScale;
        return uv + offset;
    }

    void main() {
        vec2 uv = sourceTextureCoordinate;
        uv = shiftBand(uv, dividingLines.x, flips.x, 0.0);
        uv = shiftBand(uv, dividingLines.y, flips.y, 1.0);
        uv = shiftBand(uv, dividingLines.z, flips.z, 0.0);
        uv = shiftBand(uv, dividingLines.w, flips.w, 1.0);
        uv = shiftBand(uv, dividingLine4, flip4, 0.0);
        vec4 color = sampleInput(uv);
        color *= visible;
        gl_FragColor = toOutputFormat(color);
    }
";
