[Filter Videotape]
# "Videotape ✧" ported from the Spark effect (198110665724571, export v141, SDK 164). One fragment pass, no face
# tracking.
#
#   Spark: two screen canvases of full-frame images, alpha "over" in authored order. A native picker
#   (initialIndex 0) selects the look:
#     look 0: canvas0 only: lut (camera -> YW LUT, mixed 0.9), then sharpn at opacity 0.4 (camera -> second LUT,
#             mix 1, through an asymmetric 3x3 sharpen, step 1.3 px).
#     look 1: look 0 + frame p (portrait CAM/date overlay, scale 0.95) + time p0 (counter, scale 1.3, moved).
#     look 2: look 0 + canvas2: lut0/lut1 (the same two layers on a 0.97 rect, 6.75% down), frame (letterbox
#             with CAM/date, scale 1.02, 0.75% up), vhs (noise still, lit by the classic lights: rgb * 0.76353283,
#             opacity 0.1), time (counter F1..F4 at 2 frames/s).
#   Every overlay goes through the same 5x5 sharpen (2I - binomial/256, step 1.2 px) after the per-tap
#   premultiplied decode. The Spark sample and thumbnail show look 2, so it is the default here; 'look selects
#   the others (IGLU has no picker UI).
#   Exact port of export v141. The Spark sample was recorded from a different version (the counter runs
#   20..30 at about 15 frames/s and the window is centred). See PORT_NOTES.md. Nothing is faked; the tap-gesture
#   patch has no consumer, and the picker icons are UI only, so both are dropped.
#   Overlays ship opaque (premultiplied rgb | alpha in separate textures) so IGLU's load-time premultiply cannot
#   change Spark's truncated storage bytes.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('videotape_lut);
    makeTexture('videotape_lut_sharp);
    makeTexture('videotape_vhs);
    makeTexture('videotape_overlay_rgb);
    makeTexture('videotape_overlay_alpha);
    makeTexture('videotape_counter);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {look = 2.0, min = 0.0, max = 2.0, description = "Spark picker look: 0 = grade only, 1 = portrait CAM overlay, 2 = letterboxed VHS camcorder"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'videotape_lut, 'videotape_lut_sharp, 'videotape_vhs, 'videotape_overlay_rgb,
                'videotape_overlay_alpha, 'videotape_counter},
      uniforms = {
        strength = 1.0,
        look = 2.0,
        seq_frame = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslVideotape,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string videotape_lut_path = "videotape_lut_path";
string videotape_lut_filename = "";
string videotape_lut_sharp_path = "videotape_lut_sharp_path";
string videotape_lut_sharp_filename = "";
string videotape_vhs_path = "videotape_vhs_path";
string videotape_vhs_filename = "";
string videotape_overlay_rgb_path = "videotape_overlay_rgb_path";
string videotape_overlay_rgb_filename = "";
string videotape_overlay_alpha_path = "videotape_overlay_alpha_path";
string videotape_overlay_alpha_filename = "";
string videotape_counter_path = "videotape_counter_path";
string videotape_counter_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'look, getParameterFloat('look));

    # iOS passes the remote LUT under the generic 'lut_path; videotape_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(videotape_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != videotape_lut_filename) {
            videotape_lut_filename = new_lut;
            loadTexture('videotape_lut, videotape_lut_filename);
        }
    }
    string sharp_param = getParameterString(videotape_lut_sharp_path);
    if (sharp_param != "") {
        string new_sharp = stringAppend("textureFilePath://", sharp_param);
        if (new_sharp != videotape_lut_sharp_filename) {
            videotape_lut_sharp_filename = new_sharp;
            loadTexture('videotape_lut_sharp, videotape_lut_sharp_filename);
        }
    }
    string vhs_param = getParameterString(videotape_vhs_path);
    if (vhs_param != "") {
        string new_vhs = stringAppend("textureFilePath://", vhs_param);
        if (new_vhs != videotape_vhs_filename) {
            videotape_vhs_filename = new_vhs;
            loadTexture('videotape_vhs, videotape_vhs_filename);
        }
    }
    string orgb_param = getParameterString(videotape_overlay_rgb_path);
    if (orgb_param != "") {
        string new_orgb = stringAppend("textureFilePath://", orgb_param);
        if (new_orgb != videotape_overlay_rgb_filename) {
            videotape_overlay_rgb_filename = new_orgb;
            loadTexture('videotape_overlay_rgb, videotape_overlay_rgb_filename);
        }
    }
    string oa_param = getParameterString(videotape_overlay_alpha_path);
    if (oa_param != "") {
        string new_oa = stringAppend("textureFilePath://", oa_param);
        if (new_oa != videotape_overlay_alpha_filename) {
            videotape_overlay_alpha_filename = new_oa;
            loadTexture('videotape_overlay_alpha, videotape_overlay_alpha_filename);
        }
    }
    string cnt_param = getParameterString(videotape_counter_path);
    if (cnt_param != "") {
        string new_cnt = stringAppend("textureFilePath://", cnt_param);
        if (new_cnt != videotape_counter_filename) {
            videotape_counter_filename = new_cnt;
            loadTexture('videotape_counter, videotape_counter_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    # Spark sequence l: frame = fmod(wholeMs / 1000 * 2, 4) (SceneAnimator.cpp), F1..F4 = tiles 0..3.
    f32 halfSeconds = floor(floor(time * 1000.0) / 500.0);
    setShaderUniform('pass0, 'seq_frame, halfSeconds - 4.0 * floor(halfSeconds / 4.0));

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslVideotape = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'videotape_lut (YW, 512x512)
    uniform sampler2D auxSampler2;  // 'videotape_lut_sharp (2020-11-06-121140189, 512x512)
    uniform sampler2D auxSampler3;  // 'videotape_vhs (852x480)
    uniform sampler2D auxSampler4;  // 'videotape_overlay_rgb (frame | p, premultiplied rgb, 1152x1024)
    uniform sampler2D auxSampler5;  // 'videotape_overlay_alpha (r = frame alpha, g = p alpha, 576x1024)
    uniform sampler2D auxSampler6;  // 'videotape_counter (F1..F4 crop rows; premultiplied rgb | alpha, 304x232)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float look;
    uniform float seq_frame;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kAfterMix = 0.9;
    const float kSharpMix = 1.0;
    const float kSharpStep = 1.3;
    const float kSharpOpacity = 0.4;
    const float kOverlayStep = 1.2;
    const float kVhsLight = 0.76353283;
    const float kVhsOpacity = 0.1;
    // Image rects: scale and centre offset (fractions of the frame, +y = down; LayoutUtils/BasicLayout/Layout.cpp).
    const float kLut0Scale = 0.9700000286102295;
    const float kLut0Y = 0.06746626686656672;
    const float kFrameScale = 1.0199999809265137;
    const float kFrameY = -0.007496251874062968;
    const float kVhsScale = 1.0199999809265137;
    const float kTimeY = -0.007496251874062968;
    const float kFramePScale = 0.949999988079071;
    const float kTimeP0Scale = 1.2999999523162842;
    const vec2 kTimeP0Offset = vec2(-0.11200000000000001, -0.23988005997001498);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark image UV (top-left origin) of screen point p for a full-frame rect scaled about its centre.
    vec2 rectUv(vec2 p, vec2 offset, float s) {
      return (p - (vec2(0.5) + offset)) / s + 0.5;
    }

    bool inRect(vec2 r) {
      return r.x >= 0.0 && r.y >= 0.0 && r.x < 1.0 && r.y < 1.0;
    }

    vec4 cam(vec2 r) {
      return sampleInput(topUv(clamp(r, 0.0, 1.0)));
    }

    // Advanced LUT patch: discrete blue slice, clamp 0.00781 + 0.02 .. 0.98438 on the colour only.
    vec3 lut(sampler2D t, vec3 c) {
      vec3 q = clamp(c, 0.00781 + 0.02, 0.98438);
      float row = floor(q.b * 8.0);
      float col = floor((q.b - row / 8.0) * 64.0);
      return texture2D(t, vec2(q.r / 8.0 + col / 8.0, q.g / 8.0 + row / 8.0)).rgb;
    }

    vec4 afterAt(vec2 r) {
      vec4 c = cam(r);
      return vec4(mix(c.rgb, lut(auxSampler1, c.rgb), kAfterMix), c.a);
    }

    vec4 sharpTap(vec2 r) {
      vec4 c = cam(r);
      return vec4(mix(c.rgb, lut(auxSampler2, c.rgb), kSharpMix), c.a);
    }

    // Authored wiring (not a cross): 5 at the centre, -1 at (-1,-1), (1,-1), (-1,0), (-1,1); denominator 1.
    vec4 sharpAt(vec2 r, vec2 st) {
      vec4 s = 5.0 * sharpTap(r) - sharpTap(r + vec2(-1.0, -1.0) * st) - sharpTap(r + vec2(1.0, -1.0) * st)
             - sharpTap(r + vec2(-1.0, 0.0) * st) - sharpTap(r + vec2(-1.0, 1.0) * st);
      return vec4(s.rgb, s.a * kSharpOpacity);
    }

    // Spark premultiplied-storage decode (ColorDecoding.sparksl).
    vec4 decode(vec3 p, float a) {
      return vec4(min(p / max(a, 0.001), 1.0), a);
    }

    // kind 0 = frame, 1 = p (both 576x1024, clamp-to-edge), 2 = sequence l at seq_frame.
    vec4 overlayTex(vec2 u, float kind) {
      if (kind > 1.5) {
        // Every texel outside x 396..547, y 336..393 is zero in F1..F4, and the crop keeps a zero border.
        vec2 x = u * vec2(576.0, 1024.0) - 0.5;
        if (x.x < 396.0 || x.x > 547.0 || x.y < 336.0 || x.y > 393.0) { return vec4(0.0); }
        vec2 a = vec2((x.x - 395.5) / 304.0, (x.y - 335.5 + seq_frame * 58.0) / 232.0);
        return decode(texture2D(auxSampler6, a).rgb, texture2D(auxSampler6, a + vec2(0.5, 0.0)).r);
      }
      vec2 c = clamp(u, vec2(0.5 / 576.0, 0.5 / 1024.0), vec2(1.0 - 0.5 / 576.0, 1.0 - 0.5 / 1024.0));
      vec3 p = texture2D(auxSampler4, vec2((c.x + kind) * 0.5, c.y)).rgb;
      vec2 a = texture2D(auxSampler5, c).rg;
      return decode(p, kind < 0.5 ? a.r : a.g);
    }

    // Raw weights binomial(i) * binomial(j), centre -476; sum / -256 (= 2I - G/256).
    vec4 sharpen5(vec2 r, float kind, vec2 st) {
      vec4 acc = vec4(0.0);
      for (int j = -2; j <= 2; j++) {
        float wj = j == 0 ? 6.0 : (j == 1 || j == -1 ? 4.0 : 1.0);
        for (int i = -2; i <= 2; i++) {
          float wi = i == 0 ? 6.0 : (i == 1 || i == -1 ? 4.0 : 1.0);
          float k = (i == 0 && j == 0) ? -476.0 : wi * wj;
          acc += k * overlayTex(r + vec2(float(i), float(j)) * st, kind);
        }
      }
      return acc / -256.0;
    }

    // Alpha blend into the 8-bit target: source clamped first, result stored at 8 bits.
    vec3 over(vec3 d, vec4 s) {
      float a = clamp(s.a, 0.0, 1.0);
      vec3 b = clamp(s.rgb, 0.0, 1.0) * a + d * (1.0 - a);
      return floor(b * 255.0 + 0.5) / 255.0;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 camc = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(camc);
        return;
      }
      vec2 p = topUv(uv);
      vec2 size = vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
      vec2 stSharp = vec2(kSharpStep) / size;
      vec2 stOverlay = vec2(kOverlayStep) / size;
      bool look2 = look > 1.5;
      bool look1 = look > 0.5 && !look2;

      vec2 r0 = rectUv(p, vec2(0.0, kLut0Y), kLut0Scale);
      bool lut0In = look2 && inRect(r0);
      vec4 lut0 = lut0In ? afterAt(r0) : vec4(0.0);

      vec3 d = camc.rgb;
      // canvas0 lut + sharpn; an opaque lut0 above replaces them, so they are skipped there.
      if (!(lut0In && lut0.a >= 1.0)) {
        d = over(d, afterAt(p));
        d = over(d, sharpAt(p, stSharp));
      }
      if (look1) {
        vec2 rp = rectUv(p, vec2(0.0), kFramePScale);
        if (inRect(rp)) { d = over(d, sharpen5(rp, 1.0, stOverlay)); }
        vec2 rt = rectUv(p, kTimeP0Offset, kTimeP0Scale);
        if (inRect(rt)) { d = over(d, sharpen5(rt, 2.0, stOverlay)); }
      }
      if (look2) {
        if (lut0In) {
          d = over(d, lut0);
          d = over(d, sharpAt(r0, stSharp));
        }
        vec2 rf = rectUv(p, vec2(0.0, kFrameY), kFrameScale);
        if (inRect(rf)) { d = over(d, sharpen5(rf, 0.0, stOverlay)); }
        vec2 rv = rectUv(p, vec2(0.0), kVhsScale);
        if (inRect(rv)) {
          vec4 v = texture2D(auxSampler3, rv);
          d = over(d, vec4(kVhsLight * v.rgb, kVhsOpacity * v.a));
        }
        vec2 rt = rectUv(p, vec2(0.0, kTimeY), 1.0);
        if (inRect(rt)) { d = over(d, sharpen5(rt, 2.0, stOverlay)); }
      }

      vec3 result = mix(camc.rgb, d, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), camc.a));
    }
    ";
