[Filter BrokenTv]
# "Broken TV" ported from the Spark effect (1497292140796442). Seven passes, no face tracking, one asset.
#
#   Spark (saved settings, same filters + FXAA + TV block family as HDRsharpen): the camera scene pass
#   feeds an FXAA function (EdgeSharpness 0.5, EdgeThreshold 0.5). The active TV block warps it
#   (Fisheye 0.018), adds scanlines (0.0045), a rolling sync ramp (0.127) and a fixed 0.1 radial flicker
#   term, all driven by runtime/time (its 0.05 s loop driver is disabled). That TV function is rendered
#   twice: at 1/2 res (RGB), then blurred by a 5-tap kernel with UV-constant offsets at 1/4 res
#   horizontally and again vertically (RGB), and at full res through the inactive tiltShift processor
#   (RGB). The filters block then applies the unsharp mask U = mix(I + 2*Sharpen*(I - B), B, Blur),
#   animated grain from a 512x512 repeat texture (seed mod(32132*t, 1)), an RGB->HSV->RGB round trip
#   with saturation -0.064, contrast -0.009, vignette 0.059, and a final copy.
#   symbols, tiltShift, glitch and lensFlare are inactive bypasses. Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('broken_tv_grain);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {
      {
        name = 'scene,
        inputs = {'default},
        bufferType = 'uint8,
        glslShader = glslScene,
      },
      {
        name = 'tvHalf,
        inputs = {'scene},
        scale = {0.5, 0.5},
        bufferType = 'uint8,
        uniforms = {
          sceneSize = {1080.0, 1920.0},
          tv_time = 0.001,
          tv_fisheye = 0.01818181818181608,
          tv_scanlines = 0.004545454545453512,
          tv_sync = 0.12727272727272626,
        },
        glslShader = glslTvFunction,
      },
      {
        name = 'blurH,
        inputs = {'tvHalf},
        scale = {0.25, 0.25},
        bufferType = 'uint8,
        uniforms = {
          dir = {1.0, 0.0},
        },
        glslShader = glslBlur,
      },
      {
        name = 'blurV,
        inputs = {'blurH},
        scale = {0.25, 0.25},
        bufferType = 'uint8,
        uniforms = {
          dir = {0.0, 1.0},
        },
        glslShader = glslBlur,
      },
      {
        name = 'tiltShift,
        inputs = {'scene},
        bufferType = 'uint8,
        uniforms = {
          sceneSize = {1080.0, 1920.0},
          tv_time = 0.001,
          tv_fisheye = 0.01818181818181608,
          tv_scanlines = 0.004545454545453512,
          tv_sync = 0.12727272727272626,
        },
        glslShader = glslTvFunction,
      },
      {
        name = 'filters,
        inputs = {'default, 'tiltShift, 'blurV, 'broken_tv_grain},
        bufferType = 'uint8,
        uniforms = {
          sharpen = 0.6590909090909081,
          blur_mix = 0.004545454545453512,
          glow = 0.0,
          grain = 0.004545454545453512,
          grain_size = 0.20909090909090808,
          grain_seed = 0.0,
          grain_tex_size = {512.0, 512.0},
          saturation = -0.0636363636363656,
          contrast = -0.009090909090911148,
          brightness = 0.0,
          vignette = 0.05909090909090806,
        },
        glslShader = glslFilters,
      },
      {
        name = 'output,
        inputs = {'default, 'filters},
        uniforms = {
          strength = 1.0,
        },
        glslShader = glslOutput,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string broken_tv_grain_path = "broken_tv_grain_path";
string broken_tv_grain_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('output, 'strength, getParameterFloat('strength));

    string grain_param = getParameterString(broken_tv_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != broken_tv_grain_filename) {
            broken_tv_grain_filename = new_grain;
            loadTexture('broken_tv_grain, broken_tv_grain_filename);
        }
    }
    vec2 grainSize = getTextureSize('broken_tv_grain);
    if (grainSize.x > 0.0 and grainSize.y > 0.0) {
        setShaderUniform('filters, 'grain_tex_size, grainSize);
    }

    # FXAA steps one texel of the scene texture (Spark's tex.size), which is the full input size.
    vec2 size = getTextureSize('default);
    if (size.x > 0.0 and size.y > 0.0) {
        setShaderUniform('tvHalf, 'sceneSize, size);
        setShaderUniform('tiltShift, 'sceneSize, size);
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    # Spark runtime/time: max(1, whole elapsed milliseconds) / 1000. Every term below repeats every
    # 10 s (10 * 32132 is a whole number), so time is wrapped to 10 s in whole milliseconds: the
    # first 10 s match Spark's float maths exactly, and later the products stay bounded (an
    # unbounded t * 32132 loses all fractional precision after ~9 min and freezes the grain).
    f32 ms = max(1.0, floor(time * 1000.0));
    f32 tvTime = (ms - 10000.0 * floor(ms / 10000.0)) / 1000.0;
    # Grain seed is Spark signal maths in float: fmod(float(t) * 32132, 1).
    f32 seedProduct = tvTime * 32132.0;
    setShaderUniform('filters, 'grain_seed, seedProduct - floor(seedProduct));
    # The TV terms mod(120*(y - 0.03*t), 1) and mod(y - t, 1) use the same wrapped time.
    setShaderUniform('tvHalf, 'tv_time, tvTime);
    setShaderUniform('tiltShift, 'tv_time, tvTime);
}

#### GLSL shaders ####

string glslScene = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)

    void main() {
      gl_FragColor = toOutputFormat(clamp(sampleInput(sourceTextureCoordinate), 0.0, 1.0));
    }
    ";

string glslTvFunction = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'scene
    uniform vec2 sceneSize;
    uniform float tv_time;
    uniform float tv_fisheye;
    uniform float tv_scanlines;
    uniform float tv_sync;

    // Spark's processor uv is top-left origin; OpenGL frames arrive bottom row first (UP == 1).
    // The flip is its own inverse, so it also maps a Spark uv back to a sampling uv.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    float fxaaLuma(vec4 c) {
      return dot(c.rgb, vec3(0.2989, 0.5870, 0.1140));
    }

    // Engine std::safeNormalize; a zero vector returns zero, so the edge branch returns the centre.
    vec2 safeNormalize(vec2 v) {
      float m = abs(v.x) + abs(v.y);
      if (m <= 0.0) {
        return vec2(0.0);
      }
      return normalize(v / max(m, 0.0001));
    }

    vec4 fxaa(vec2 uv) {
      float edgeSharpness = mix(1.0, 8.0, 0.5);
      float edgeThreshold = mix(0.075, 0.4, 0.5);
      vec2 offset = vec2(1.0) / sceneSize;
      float lumaNw = fxaaLuma(sampleInput(uv + vec2(-offset.x, -offset.y)));
      float lumaNe = fxaaLuma(sampleInput(uv + vec2(offset.x, -offset.y)));
      float lumaSw = fxaaLuma(sampleInput(uv + vec2(-offset.x, offset.y)));
      float lumaSe = fxaaLuma(sampleInput(uv + vec2(offset.x, offset.y)));
      vec4 colorM = sampleInput(uv);
      float lumaM = fxaaLuma(colorM);
      float lumaMax = max(max(lumaNe, lumaSe), max(lumaNw, lumaSw));
      float lumaMaxM = max(lumaMax, lumaM);
      float lumaMin = min(min(lumaNe, lumaSe), min(lumaNw, lumaSw));
      float lumaMinM = min(lumaMin, lumaM);
      float lumaMaxScaledClamped = max(0.04, lumaMax * edgeThreshold);
      vec4 res = colorM;
      if (lumaMaxM - lumaMinM >= lumaMaxScaledClamped) {
        float dirSwMinusNe = lumaSw - lumaNe;
        float dirSeMinusNw = lumaSe - lumaNw;
        vec2 dir1 = safeNormalize(vec2(dirSwMinusNe + dirSeMinusNw, dirSwMinusNe - dirSeMinusNw));
        float dirAbsMinTimesC = max(0.00001, min(abs(dir1.x), abs(dir1.y)) * edgeSharpness);
        vec2 dir2 = clamp(dir1 / dirAbsMinTimesC, -2.0, 2.0) * 2.0;
        vec4 colorN1 = sampleInput(uv - dir1 * offset);
        vec4 colorP1 = sampleInput(uv + dir1 * offset);
        vec4 colorN2 = sampleInput(uv - dir2 * offset);
        vec4 colorP2 = sampleInput(uv + dir2 * offset);
        res = (colorN1 + colorP1 + colorN2 + colorP2) * 0.25;
        float lumaRes = fxaaLuma(res);
        if (lumaRes < lumaMin || lumaRes > lumaMax) {
          res = (colorN1 + colorP1) * 0.5;
        }
      }
      return res;
    }

    float scanTerm(vec2 p) {
      float r = mod(120.0 * (p.y - 0.03 * tv_time), 1.0);
      return 0.1 * tv_scanlines * (mix(r, step(0.5, r), 0.5) - 2.0);
    }

    float syncTerm(vec2 p) {
      float z = mod(p.y - tv_time, 1.0);
      return 0.1 * tv_sync * (mix(z, step(0.8, z), 0.1) - 0.5);
    }

    void main() {
      vec2 p = topUv(sourceTextureCoordinate);
      // h(u) = 0.1 * (sync + scan at u, 0) shifts the fisheye-warped lookup horizontally.
      float a = scanTerm(p);
      float s = syncTerm(p);
      vec2 d = p - vec2(0.5);
      vec2 q = vec2(0.5) + (d + tv_fisheye * d * dot(d, d)) / (1.0 + 0.5 * tv_fisheye);
      q.x += 0.1 * (s + a);
      // The whole TV expression T is sampled at q, so its spatial terms are re-evaluated there.
      float aq = scanTerm(q);
      float sq = syncTerm(q);
      float flicker = 0.1 * (0.5 - 2.0 * length(q - vec2(0.5)));
      vec4 tv = fxaa(topUv(q)) + 4.0 * vec4(aq, aq, aq, 1.0) + vec4(flicker) + vec4(sq);
      // RGB target: alpha 1.
      gl_FragColor = toOutputFormat(vec4(clamp(tv.rgb, 0.0, 1.0), 1.0));
    }
    ";

string glslBlur = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform vec2 dir;

    void main() {
      // Saved weights (sum 1.00001, not renormalised) and offsets in normalised UV, not texels.
      vec2 uv = sourceTextureCoordinate;
      vec2 d1 = dir * (0.00136 * 4.0);
      vec2 d2 = dir * (0.00317 * 4.0);
      vec4 c = 0.22703 * sampleInput(uv);
      c += 0.31622 * sampleInput(uv + d1);
      c += 0.31622 * sampleInput(uv - d1);
      c += 0.07027 * sampleInput(uv + d2);
      c += 0.07027 * sampleInput(uv - d2);
      gl_FragColor = toOutputFormat(vec4(clamp(c.rgb, 0.0, 1.0), 1.0));
    }
    ";

string glslFilters = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (unused)
    uniform sampler2D auxSampler1;  // 'tiltShift (Image)
    uniform sampler2D auxSampler2;  // 'blurV (Blurred Image)
    uniform sampler2D auxSampler3;  // 'broken_tv_grain (512x512, repeat)
    uniform float sharpen;
    uniform float blur_mix;
    uniform float glow;
    uniform float grain;
    uniform float grain_size;
    uniform float grain_seed;
    uniform vec2 grain_tex_size;
    uniform float saturation;
    uniform float contrast;
    uniform float brightness;
    uniform float vignette;

    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    vec3 grainTexel(vec2 i) {
      vec2 w = mod(i, grain_tex_size);
      return texture2D(auxSampler3, (w + 0.5) / grain_tex_size).rgb;
    }

    // Spark samples the grain with repeat wrapping; the IGLU sampler clamps, so filter by hand
    // from texel centres (exact for linear or nearest sampler state).
    vec3 sampleGrain(vec2 st) {
      vec2 x = st * grain_tex_size - 0.5;
      vec2 i0 = floor(x);
      vec2 f = x - i0;
      vec3 c00 = grainTexel(i0);
      vec3 c10 = grainTexel(i0 + vec2(1.0, 0.0));
      vec3 c01 = grainTexel(i0 + vec2(0.0, 1.0));
      vec3 c11 = grainTexel(i0 + vec2(1.0, 1.0));
      return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
    }

    vec3 rgbToHsv(vec3 c) {
      float mx = max(c.r, max(c.g, c.b));
      float mn = min(c.r, min(c.g, c.b));
      float delta = mx - mn;
      vec3 q = vec3(c.g - c.b, c.b - c.r, c.r - c.g) / max(delta, 0.001);
      float h = q.z + 4.0;
      h = mix(h, q.y + 2.0, step(mx, c.g));
      h = mix(h, q.x, step(mx, c.r));
      h = mod(h / 6.0, 1.0);
      return vec3(h, delta / max(mx, 0.001), mx);
    }

    vec3 hsvToRgb(vec3 c) {
      vec3 hue = clamp(vec3(abs(6.0 * c.x - 3.0) - 1.0, 2.0 - abs(6.0 * c.x - 2.0), 2.0 - abs(6.0 * c.x - 4.0)), 0.0, 1.0);
      return c.z * mix(vec3(1.0), hue, c.y);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec3 img = texture2D(auxSampler1, uv).rgb;
      vec3 soft = texture2D(auxSampler2, uv).rgb;
      vec3 u = mix(img + 2.0 * sharpen * (img - soft), soft, blur_mix) + glow * soft;
      vec3 n = u + grain * (sampleGrain(topUv(uv) / grain_size + vec2(grain_seed)) - 0.5);
      // Alpha is 1 through every stage (+1 then clamp), so only rgb is carried.
      vec3 hsv = clamp(rgbToHsv(n) + vec3(0.0, saturation, 0.0), 0.0, 1.0);
      vec3 k = hsvToRgb(hsv);
      float c = contrast / 2.0;
      vec3 d = clamp(mix(k, smoothstep(vec3(c), vec3(1.0 - c), k), clamp(abs(4.0 * c), 0.0, 1.0)) + vec3(brightness), 0.0, 1.0);
      float g2 = 2.0 * length(uv - vec2(0.5));
      vec3 v = clamp(d * (1.0 - vignette * g2), 0.0, 1.0);
      gl_FragColor = toOutputFormat(vec4(v, 1.0));
    }
    ";

string glslOutput = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'filters
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Spark's final copy processor: the filters target, unchanged.
      vec3 fx = texture2D(auxSampler1, uv).rgb;
      vec3 result = mix(cam.rgb, fx, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
