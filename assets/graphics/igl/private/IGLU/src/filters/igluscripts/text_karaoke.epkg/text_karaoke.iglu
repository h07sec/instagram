[Filter Karaoke]

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {scanlineShift = 0.635, min = 0.0, max = 1.0, description = "Scanline Shift"},
        {scanlineDensity = 0.499, min = 0.0, max = 1.0, description = "Scanline Density"},
        {irregularity = 0.885, min = 0.0, max = 1.0, description = "Irregularity"},
        {rollShift = 0.12, min = 0.0, max = 1.0, description = "Roll Bar Shift"},
        {speed = 0.052, min = 0.0, max = 1.0, description = "Roll Speed"},
    };

    filter.passes = {{
        name = 'pass0,
        inputs = {'default},
        uniforms = {
            strength = 1.0,
            progress = 0.0,
            numberOfLines = 2.0,
        },
        glslShader = glslPassthrough,
    },
    {
        name = 'composite,
        inputs = {'default, 'pass0},
        uniforms = {

        },
        glslShader = compositeGlsl,
    },
    {
        name = 'crtBands,
        inputs = {'composite},
        uniforms = {
            outputSize = {1920.0, 1080.0},
            time = 0.0,
        },
        glslShader = glslCrtBands,
    },
    };
}

[PreRender]
fun preRender(Filter filter) {
    vec2 size = getTextureSize('default);
    f32 time = getParameterFloat('time_sec);
    # The wipe position, from the host's playback progress. Multi-pass scripts get no automatic
    # parameter-to-pass-uniform propagation, so without this forward `progress` keeps its
    # [Init] default of 0.0 and the mask never sweeps.
    f32 progress = getParameterFloat('progress);
    setShaderUniform('crtBands, 'outputSize, size);
    setShaderUniform('crtBands, 'time, time);
    setShaderUniform('pass0, 'progress, progress);
}

string glslPassthrough = "
    precision highp float;

    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float progress;
    uniform float numberOfLines;

    void main() {
        vec4 color = sampleInput(sourceTextureCoordinate);

  		float mask = (sourceTextureCoordinate.x + color.g * numberOfLines) / (numberOfLines + 1.0) ;

		mask = smoothstep(progress, progress + 0.01, mask);

        gl_FragColor = toOutputFormat(vec4(vec3(mask), color.a));
    }
";


string compositeGlsl = "
    precision highp float;

    varying vec2 sourceTextureCoordinate;

    uniform sampler2D auxSampler1;

    BaseUniformsOpenGL;

    void main() {
		vec4 srcColor = sampleInput(sourceTextureCoordinate);

		vec4 maskColor = texture2D(auxSampler1, sourceTextureCoordinate);

		vec4 colorB = vec4(0.9216, 0.9216, 0.9216, 1.0);
		vec4 colorA = vec4(0.8549, 0.8510, 0.3529, 1.0);


		float stroke = srcColor.b;

		vec4 finalColor = mix(colorA, colorB, maskColor.r );
		finalColor.a = srcColor.a;

		finalColor.rgb = mix(vec3(0.0), finalColor.rgb, 1.0 - stroke);

		gl_FragColor = toOutputFormat(vec4(finalColor.rgb * srcColor.a, srcColor.a) );

    }

";

string glslCrtBands = "
    precision highp float;

    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;

    uniform vec2 outputSize;
    uniform float time;
    uniform float scanlineShift;
    uniform float scanlineDensity;
    uniform float irregularity;
    uniform float rollShift;
    uniform float speed;

    float hash11(float p) {
        p = fract(p * 0.1031);
        p = p * (p + 33.33);
        p = p * (p + p);
        return fract(p);
    }

    float lineRandom(float lineIdx, float seed) {
        return hash11(lineIdx * 1.37 + seed * 7.13) * 2.0 - 1.0;
    }

    void main() {
        vec2 uv = sourceTextureCoordinate;

        float y = uv.y * UP;
        float pixelY = y * outputSize.y;
        float t = time * (0.15 + speed * 1.6);
        float invW = 1.0 / max(outputSize.x, 1.0);

        float lineHeight = mix(8.0, 2.0, scanlineDensity);
        float scrolledY = pixelY - t * 90.0;
        float lineIdx = floor(scrolledY / lineHeight);

        float fineWave = sin(scrolledY / lineHeight * 6.2831853);

        float stepA = floor(t * 14.0);
        float stepB = floor(t * 3.0);
        float jitterA = lineRandom(lineIdx, stepA);
        float jitterB = lineRandom(lineIdx * 0.25, stepB);
        float jitter = mix(jitterA, jitterB, 0.5);

        float fine = mix(fineWave, jitter, irregularity);
        float fineGate = mix(1.0, 0.35 + 0.65 * step(0.45, hash11(lineIdx * 3.11 + stepB)), irregularity);
        float offsetX = fine * fineGate * scanlineShift * 3.5 * invW;

        float mid = sin(y * 6.2831853 * 17.0 + t * 2.3)
                  + 0.7 * sin(y * 6.2831853 * 9.0 - t * 1.1)
                  + 0.5 * sin(y * 6.2831853 * 31.0 + t * 4.7);
        offsetX = offsetX + mid * scanlineShift * 2.2 * invW;

        float wide = sin(y * 6.2831853 * 3.0 + t * 0.9)
                   + 0.6 * sin(y * 6.2831853 * 1.3 - t * 0.5);
        offsetX = offsetX + wide * scanlineShift * 4.0 * invW;

        float rollPos = fract(y + t * 0.22);
        float rollBand = smoothstep(0.0, 0.16, rollPos) * smoothstep(0.34, 0.16, rollPos);
        float rollWobble = 1.0 + 0.4 * sin(t * 6.1);
        offsetX = offsetX + rollBand * rollShift * 14.0 * rollWobble * invW;

        float tearPos = fract(y * 1.0 + t * 0.61);
        float tearBand = smoothstep(0.0, 0.02, tearPos) * smoothstep(0.05, 0.02, tearPos);
        offsetX = offsetX + tearBand * lineRandom(floor(t * 5.0), 19.0) * rollShift * 26.0 * invW;

        vec2 distorted = vec2(uv.x + offsetX, uv.y);
        distorted = clamp(distorted, vec2(0.0), vec2(1.0));

        vec4 src = sampleInput(distorted);

        gl_FragColor = toOutputFormat(src);
    }
";
