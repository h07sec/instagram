[Filter DillMrx]
# "dill_mrx" ported from the Spark effect (1392319134589261). Single fragment pass, no face tracking. SCRATCH (batch 12, stack C).
#
#   Spark: one full-frame canvas rect `main_obj` (alpha blend, opacity 0.5753424657534246) over the camera whose shader is a
#   FastColorLUT patch: camera clamped to 0.0078125..0.98438, looked up in the 512x512 8x8 atlas
#   dill_2 (42596fed...jpg) (no half-texel inset), the LUT colour used directly.
#   The material is unlit.
#   Dropped (face tracked, BATCH-DROP): the face-mesh re-draw lut face 0.548 of the same dill_2 LUT (masked by Smooth Face (1)); the retouch material (0.973 fullScreen) has no scene binding, so Spark never smooths.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('dill_mrx_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'dill_mrx_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslDillMrx,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string dill_mrx_lut_path = "dill_mrx_lut_path";
string dill_mrx_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; dill_mrx_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(dill_mrx_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != dill_mrx_lut_filename) {
            dill_mrx_lut_filename = new_lut;
            loadTexture('dill_mrx_lut, dill_mrx_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslDillMrx = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'dill_mrx_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.0078125..0.98438, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.0078125, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = L.rgb;
      // Spark alpha blend of the rect over the camera: src alpha = L.a * 0.5753424657534246.
      float a = clamp(L.a * 0.5753424657534246, 0.0, 1.0);
      vec3 spark = mix(cam.rgb, g, a);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
