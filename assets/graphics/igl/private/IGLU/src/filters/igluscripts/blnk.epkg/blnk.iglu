[Filter Blnk]
# "BLNK*" (Spark 5096010263747897), SCRATCH port of the screen-space layers. Single fragment pass.
#
#   Spark draw order (layer renderingOrder, then scene order):
#     1. layer0 canvas0/rectangle0 "rgb shift", alpha, lit: FastColorLUT niceee (clamp 0.0078125 / 0.98438,
#        no camera mix), R/G/B taken at texture-transform scales 1 / 1.008 / 1.016 about the centre, add-blended,
#        x 1.3, then the standard scene lights (K = 0.2 + 0.8 cos(-pi/4) cos(5 deg)). Opaque.
#     2. layer1 canvas0/vignette, alpha 0.5, lit: 1024x640 RGBA vignette PNG on a 157.16% x 124.22% rect,
#        offset (-52.5, -39.5) pt on the 390x844 canvas.
#     3. layer1 canvas1/rectangle0 "dust", subtract 0.9452, unlit: 50 frames at 22 fps, looped. Each frame is a
#        flat grey (16..74), so the sequence is packed as a 50x1 strip (1x1 cell per frame).
#   Dropped: fullScreen skin smoothing 0.81 (face mesh retouch). The packaged TV block is not instantiated.
#   NOT Spark: kBrightLift 1.075 on the effect colour (Richard 2026-11-12, a bit too dark), inside the strength mix.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('blnk_lut);
    makeTexture('blnk_vignette);
    makeTexture('blnk_dust);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'blnk_lut, 'blnk_vignette, 'blnk_dust},
      uniforms = {
        strength = 1.0,
        time = 0.0,
      },
      glslShader = glslBlnk,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string blnk_lut_path = "blnk_lut_path";
string blnk_lut_filename = "";
string blnk_vignette_path = "blnk_vignette_path";
string blnk_vignette_filename = "";
string blnk_dust_path = "blnk_dust_path";
string blnk_dust_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; blnk_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(blnk_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != blnk_lut_filename) {
            blnk_lut_filename = new_lut;
            loadTexture('blnk_lut, blnk_lut_filename);
        }
    }
    string vig_param = getParameterString(blnk_vignette_path);
    if (vig_param != "") {
        string new_vig = stringAppend("textureFilePath://", vig_param);
        if (new_vig != blnk_vignette_filename) {
            blnk_vignette_filename = new_vig;
            loadTexture('blnk_vignette, blnk_vignette_filename);
        }
    }
    string dust_param = getParameterString(blnk_dust_path);
    if (dust_param != "") {
        string new_dust = stringAppend("textureFilePath://", dust_param);
        if (new_dust != blnk_dust_filename) {
            blnk_dust_filename = new_dust;
            loadTexture('blnk_dust, blnk_dust_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslBlnk = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'blnk_lut (niceee, 512x512, 8x8 grid)
    uniform sampler2D auxSampler2;  // 'blnk_vignette (1024x1280 opaque: top = straight RGB, bottom = alpha)
    uniform sampler2D auxSampler3;  // 'blnk_dust (50x1, one flat grey level per sequence frame)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;

    // Standard Spark scene lights on a lit screen material: 0.2 + 0.8 * cos(pi/4) * cos(5 deg).
    const float kLight = 0.76353283;
    // vignette rect on the 390x844 canvas: size 157.15556% x 124.21875%, centre moved 52.5 pt left, 39.5 pt up
    // (canvas y is up: polaroid_frame -61.3 pt only fits its window as up).
    const vec2 kVigSize = vec2(1.5715556, 1.2421875);
    const vec2 kVigCentre = vec2(0.5 - 52.50001525878906 / 390.0, 0.5 - 39.50001525878906 / 844.0);
    const float kVigOpacity = 0.5;
    const float kDustOpacity = 0.9452054794520548;
    const float kFps = 22.0;
    const float kFrames = 50.0;
    // NOT from Spark (Richard's review call, 2026-11-12): exposure gain on the finished effect colour, sized so the
    // portrait over the full dust loop matches the mean luma of Spark's last sample frames (79.6). Inside the
    // strength mix, so strength 0 stays the untouched camera.
    const float kBrightLift = 1.075;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // FastColorLUT patch: clamp 0.0078125 / 0.98438, 8x8 grid, one bilinear tap, no camera mix.
    vec3 lut(vec2 p) {
      vec3 c = clamp(sampleInput(p).rgb, 0.0078125, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamps below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Texture Transform samples at inverse(M) * uv; M scales about pivot (0.5, 0.5).
      vec2 uvG = (uv - 0.5) / 1.008 + 0.5;
      vec2 uvB = (uv - 0.5) / 1.016 + 0.5;
      vec3 d = min(vec3(lut(uv).r, lut(uvG).g, lut(uvB).b), 1.0);
      vec3 col = clamp(d * 1.3 * kLight, 0.0, 1.0);

      // vignette: straight alpha over, lit colour, opacity 0.5. Spark rect uv origin = top-left.
      vec2 tv = (topUv(uv) - kVigCentre) / kVigSize + 0.5;
      if (tv.x >= 0.0 && tv.x <= 1.0 && tv.y >= 0.0 && tv.y <= 1.0) {
        float y = clamp(tv.y * 640.0, 0.5, 639.5);
        vec3 vrgb = texture2D(auxSampler2, vec2(tv.x, y / 1280.0)).rgb;
        float va = texture2D(auxSampler2, vec2(tv.x, (640.0 + y) / 1280.0)).r * kVigOpacity;
        col = clamp(mix(col, vrgb * kLight, va), 0.0, 1.0);
      }

      // dust: ReverseSubtract (dst - a * src), frame = floor(t * 22) mod 50.
      float frame = mod(floor(time * kFps), kFrames);
      float g = texture2D(auxSampler3, vec2((frame + 0.5) / kFrames, 0.5)).r;
      col = max(col - kDustOpacity * g, 0.0);

      vec3 result = mix(cam.rgb, col * kBrightLift, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
