{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "identifier": "2dafe976-b794-4148-86f6-7fb0ea581c5d",
  "displayName": "Clone Slide Horizontal Out",
  "description": "[IG Edits] Transition name. \"Clone Slide Horizontal Out\" slides the segmented subject off to the side in repeating clone passes with motion-blur ghosting as a 1-second outro.",
  "iglu": {
    "legacyId": 3997,
    "behavior": {
      "type": "stickyOutro",
      "durationMs": 1000,
      "curve": "linear"
    },
    "customization": [
      {
        "name": "direction",
        "defaultSelection": "right",
        "available": [
          "left",
          "right"
        ],
        "displayName": "Direction"
      },
      {
        "name": "duration",
        "default": 1.0,
        "min": 0.1,
        "max": 5.0,
        "displayName": "Duration",
        "displayMethod": "time"
      },
      {
        "name": "amount",
        "displayName": "Amount",
        "displayNameDescription": "[IG Edits] Slider label controlling how many repeated copies of the subject a video effect draws; exact range varies per effect.",
        "default": 5,
        "min": 1,
        "max": 10,
        "displayMethod": "number"
      },
      {
        "name": "distance",
        "displayName": "Spacing",
        "displayNameDescription": "[IG Edits] Slider label controlling the size of the gap between the repeated copies of the subject that a video effect draws; at the low end the copies sit flush against each other.",
        "displayMethod": "percent",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      }
    ]
  },
  "dependencies": [
    "video_clone_slide"
  ],
