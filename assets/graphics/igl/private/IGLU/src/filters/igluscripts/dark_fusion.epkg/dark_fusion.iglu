[Filter DarkFusion]

[Init]
fun init(Filter filter)
{
    makeTexture('dark_fusion_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.9726027397260274, min = 0.0, max = 1.0, description = "LUT mix strength"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'dark_fusion_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.9726027397260274,
      },
      glslShader = glslLut,
    }};
}

string dark_fusion_lut_path = "dark_fusion_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    string lut_filename_parameter = getParameterString(dark_fusion_lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('dark_fusion_lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, s);
}

#### GLSL shader ####

string glslLut = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler1;

    uniform float lut_strength;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);

      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(texel);
        return;
      }

      // Spark FastColorLUT uses discrete blue tiles and bilinear R/G sampling.
      vec3 c = clamp(texel.rgb, 0.0078125, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      // Material opacity mixes the grade over the original, not its clamped copy.
      texel.rgb = clamp(mix(texel.rgb, color, strength * lut_strength), 0.0, 1.0);

      gl_FragColor = toOutputFormat(texel);
    }
    ";
