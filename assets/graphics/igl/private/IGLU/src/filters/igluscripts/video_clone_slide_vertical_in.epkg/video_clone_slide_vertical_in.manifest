{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "identifier": "93dbc1e2-f5e0-408b-8c57-869ccfaf2827",
  "displayName": "Clone Slide Vertical In",
  "description": "[IG Edits] Transition name. \"Clone Slide Vertical In\" slides the segmented subject in from above in repeating clone passes with motion-blur ghosting as a 1-second intro.",
  "iglu": {
    "legacyId": 3998,
    "behavior": {
      "type": "stickyIntro",
      "durationMs": 1000,
      "curve": "linear"
    },
    "customization": [
      {
        "name": "direction",
        "defaultSelection": "up",
        "available": [
          "up",
          "down"
        ],
        "displayName": "Direction"
      },
      {
        "name": "duration",
        "default": 1.0,
        "min": 0.1,
        "max": 5.0,
        "displayName": "Duration",
        "displayMethod": "time"
      },
      {
        "name": "amount",
        "displayName": "Amount",
        "displayNameDescription": "[IG Edits] Slider label controlling how many repeated copies of the subject a video effect draws; exact range varies per effect.",
        "default": 5,
        "min": 1,
        "max": 10,
        "displayMethod": "number"
      },
      {
        "name": "distance",
        "displayName": "Spacing",
        "displayNameDescription": "[IG Edits] Slider label controlling the size of the gap between the repeated copies of the subject that a video effect draws; at the low end the copies sit flush against each other.",
        "displayMethod": "percent",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      }
    ]
  },
  "dependencies": [
    "video_clone_slide"
  ],
