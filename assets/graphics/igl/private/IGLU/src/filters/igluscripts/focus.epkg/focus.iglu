[Filter Focus]
# "Focus" ported from the Spark effect (208681691022343). Seven passes, no face tracking, no assets.
#
#   Spark: the camera with (1 - person) in alpha, box-downsampled to 1/2, 1/4 and 1/8 res, then an
#   alpha-weighted s-curve blur at 1/8 res (horizontal, then vertical), so the person does not bleed
#   into the background blur. The composite mixes the camera towards that blur by the background
#   ramp (0.2..0.8) and a radial focus vignette, screen-blends the result with itself at 0.15 and
#   adds 0.2 s-curve contrast.
#
#   Spark turned the vignette off on the front camera (CameraInfo). IGLU hosts report no camera
#   facing, so front_camera is a parameter; its default 1 is the front-camera look of the Spark
#   sample. blur_amount is Spark's persisted slider: blur radius = 0.25 + 2.25 * blur_amount.
#
#   Segmentation: the person mask is the host-bound 'mask named input (the manifest's iglu.subject
#   block asks the host for it). Coverage is the brightest channel, so SAM3 instance colours and
#   single-channel masks both work. Hosts that bind no mask get the blur on the full frame.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {blur_amount = 0.5, min = 0.0, max = 1.0, description = "Background blur amount (the Spark slider)"},
        {front_camera = 1.0, min = 0.0, max = 1.0, description = "1 = front-camera look (even background blur), 0 = back-camera look (radial focus vignette)"},
    };

    filter.passes = {
      {
        name = 'prepass,
        inputs = {'default, 'mask},
        uniforms = {
          has_mask = 0.0,
        },
        glslShader = glslPrepass,
      },
      {
        name = 'mean2,
        inputs = {'prepass},
        scale = {0.5, 0.5},
        uniforms = {
          inputSize = {1080.0, 1920.0},
        },
        glslShader = glslBox,
      },
      {
        name = 'mean4,
        inputs = {'mean2},
        scale = {0.25, 0.25},
        uniforms = {
          inputSize = {540.0, 960.0},
        },
        glslShader = glslBox,
      },
      {
        name = 'mean8,
        inputs = {'mean4},
        scale = {0.125, 0.125},
        uniforms = {
          inputSize = {270.0, 480.0},
        },
        glslShader = glslBox,
      },
      {
        name = 'blurH,
        inputs = {'mean8},
        scale = {0.125, 0.125},
        uniforms = {
          inputSize = {135.0, 240.0},
          dir = {1.0, 0.0},
          max_blur = 1.375,
          front_camera = 1.0,
          aspect = 1.7777778,
        },
        glslShader = glslBlur,
      },
      {
        name = 'blurV,
        inputs = {'blurH},
        scale = {0.125, 0.125},
        uniforms = {
          inputSize = {135.0, 240.0},
          dir = {0.0, 1.0},
          max_blur = 1.375,
          front_camera = 1.0,
          aspect = 1.7777778,
        },
        glslShader = glslBlur,
      },
      {
        name = 'composite,
        inputs = {'default, 'blurV, 'mask},
        uniforms = {
          strength = 1.0,
          has_mask = 0.0,
          front_camera = 1.0,
          aspect = 1.7777778,
        },
        glslShader = glslComposite,
      },
    };
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('composite, 'strength, getParameterFloat('strength));

    # A host-bound mask is at least a few px; an unbound slot reports (0, 0) or a 1x1 placeholder.
    vec2 maskSize = getTextureSize('mask);
    f32 hasMask = 0.0;
    if (maskSize.x > 4.0) {
        hasMask = 1.0;
    }
    setShaderUniform('prepass, 'has_mask, hasMask);
    setShaderUniform('composite, 'has_mask, hasMask);

    # inputSize is the size of the surface a pass READS (Spark's u_Texture.size). The graph
    # allocates a scaled pass at max(1, floor(size * scale)), so compute the same here rather
    # than query a target that may not exist yet.
    vec2 size = getTextureSize('default);
    vec2 halfSize = {max(1.0, floor(size.x * 0.5)), max(1.0, floor(size.y * 0.5))};
    vec2 quarterSize = {max(1.0, floor(size.x * 0.25)), max(1.0, floor(size.y * 0.25))};
    vec2 eighthSize = {max(1.0, floor(size.x * 0.125)), max(1.0, floor(size.y * 0.125))};
    setShaderUniform('mean2, 'inputSize, size);
    setShaderUniform('mean4, 'inputSize, halfSize);
    setShaderUniform('mean8, 'inputSize, quarterSize);
    setShaderUniform('blurH, 'inputSize, eighthSize);
    setShaderUniform('blurV, 'inputSize, eighthSize);

    # The vignette is measured in each pass's own render target (Spark's getRenderTargetSize).
    f32 eighthAspect = eighthSize.y / eighthSize.x;
    setShaderUniform('blurH, 'aspect, eighthAspect);
    setShaderUniform('blurV, 'aspect, eighthAspect);
    setShaderUniform('composite, 'aspect, size.y / size.x);

    f32 amount = clamp(getParameterFloat('blur_amount), 0.0, 1.0);
    f32 maxBlur = 0.25 + amount * 2.25;
    setShaderUniform('blurH, 'max_blur, maxBlur);
    setShaderUniform('blurV, 'max_blur, maxBlur);

    f32 front = clamp(getParameterFloat('front_camera), 0.0, 1.0);
    setShaderUniform('blurH, 'front_camera, front);
    setShaderUniform('blurV, 'front_camera, front);
    setShaderUniform('composite, 'front_camera, front);
}

#### GLSL shaders ####

string glslPrepass = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mask (host person segmentation)
    uniform float has_mask;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      float person = 0.0;
      if (has_mask > 0.5) {
        vec4 m = texture2D(auxSampler1, uv);
        person = clamp(max(m.r, max(m.g, m.b)), 0.0, 1.0);
      }
      // Straight RGB with the background in alpha, as Spark's PrePass stores it.
      gl_FragColor = toOutputFormat(vec4(cam.rgb, 1.0 - person));
    }
    ";

string glslBox = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform vec2 inputSize;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 d = 1.0 / inputSize;
      vec4 c = sampleInput(uv + vec2(-d.x, -d.y));
      c += sampleInput(uv + vec2(d.x, -d.y));
      c += sampleInput(uv + vec2(-d.x, d.y));
      c += sampleInput(uv + vec2(d.x, d.y));
      gl_FragColor = toOutputFormat(0.25 * c);
    }
    ";

string glslBlur = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform vec2 inputSize;
    uniform vec2 dir;
    uniform float max_blur;
    uniform float front_camera;
    uniform float aspect;  // render target height / width

    float sCurve(float x) {
      x = x * 2.0 - 1.0;
      return -x * abs(x) * 0.5 + x + 0.5;
    }

    float blurVignette(vec2 uv) {
      vec2 res = vec2(1.0, aspect);
      return mix(smoothstep(0.0, 0.65, length(res * (uv - vec2(0.5)))), 1.0, front_camera);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      float fradius = max_blur * blurVignette(uv);
      if (fradius < 1.0) {
        gl_FragColor = toOutputFormat(sampleInput(uv));
        return;
      }
      // max_blur <= 2.5, so radius <= 2 and at most 5 taps.
      int radius = int(fradius);
      float radiusMultiplier = 1.0 / fradius;
      vec2 duv = 2.0 * dir / inputSize;
      vec4 c = vec4(0.0);
      float divisor = 0.0;
      for (int i = 0; i < 5; i++) {
        if (i > 2 * radius) {
          break;
        }
        float x = float(i - radius);
        vec2 st = uv + x * duv;
        float inScreen = clamp(step(abs(st.x - 0.5), 0.5) - (1.0 - step(abs(st.y - 0.5), 0.5)), 0.0, 1.0);
        vec4 a = sampleInput(st);
        float weight = a.a * sCurve(1.0 - abs(x) * radiusMultiplier) * inScreen;
        c += a * weight;
        divisor += weight;
      }
      // An all-person window divides 0 by 0 in Spark, which its 8-bit targets store as 0.
      gl_FragColor = toOutputFormat(divisor > 0.0 ? c / divisor : vec4(0.0));
    }
    ";

string glslComposite = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'blurV
    uniform sampler2D auxSampler2;  // 'mask (host person segmentation)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float has_mask;
    uniform float front_camera;
    uniform float aspect;  // render target height / width

    float blurVignette(vec2 uv) {
      vec2 res = vec2(1.0, aspect);
      return mix(smoothstep(0.0, 0.65, length(res * (uv - vec2(0.5)))), 1.0, front_camera);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      float person = 0.0;
      if (has_mask > 0.5) {
        vec4 m = texture2D(auxSampler2, uv);
        person = clamp(max(m.r, max(m.g, m.b)), 0.0, 1.0);
      }
      vec3 blur = texture2D(auxSampler1, uv).rgb;
      float blurBlend = smoothstep(0.0, 0.35, blurVignette(uv));
      float seg = clamp(((1.0 - person) - 0.2) / (0.8 - 0.2), 0.0, 1.0);
      vec3 color = mix(cam.rgb, blur, seg * blurBlend);
      color = mix(color, vec3(1.0) - (vec3(1.0) - color) * (vec3(1.0) - color), 0.15);
      color = mix(color, smoothstep(0.0, 1.0, color), 0.2);
      vec3 result = mix(cam.rgb, color, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
