[Filter Vhs20]
# "ＶＨＳ2.0" ported from the Spark effect (376902046847987). Single fragment pass, no face tracking.
#
#   Grade: 8x8 LUT (Spark's G1) alpha-blended over the camera at 0.5.
#   Then Spark's layers in order: a #0055FF multiply tint at 0.096, a multiply grain at 0.22, faint VHS
#   tape noise (Spark's 45-frame scanline sequence; rebuilt procedurally, added), an RGB split at 0.51
#   (Spark's three offset camera copies), and the static PLAY / VHS / date stamp ('vhs2_0_stamp).
#   Spark's 0.5 skin smoothing is dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('vhs2_0_lut);
    makeTexture('vhs2_0_stamp);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the PLAY / date stamp"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'vhs2_0_lut, 'vhs2_0_stamp},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslVhs20,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string vhs2_0_lut_path = "vhs2_0_lut_path";
string vhs2_0_lut_filename = "";
string vhs2_0_stamp_path = "vhs2_0_stamp_path";
string vhs2_0_stamp_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; vhs2_0_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(vhs2_0_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != vhs2_0_lut_filename) {
            vhs2_0_lut_filename = new_lut;
            loadTexture('vhs2_0_lut, vhs2_0_lut_filename);
        }
    }

    string stamp_param = getParameterString(vhs2_0_stamp_path);
    if (stamp_param != "") {
        string new_stamp = stringAppend("textureFilePath://", stamp_param);
        if (new_stamp != vhs2_0_stamp_filename) {
            vhs2_0_stamp_filename = new_stamp;
            loadTexture('vhs2_0_stamp, vhs2_0_stamp_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Time drives the grain and tape noise.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslVhs20 = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'vhs2_0_lut
    uniform sampler2D auxSampler2;  // 'vhs2_0_stamp

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices (no banding on noisy LUTs).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }
    vec3 camAt(vec2 tuv) {
      return sampleInput(topUv(tuv)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;
      vec2 tuv = topUv(uv);

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL; it scales every layer,
      // so 0 is an exact passthrough.
      vec3 result = mix(src, lutLookup(src), 0.5 * strength * lut_strength);

      // Spark's #0055FF multiply tint at 0.096.
      result = mix(result, result * vec3(0.0, 0.333, 1.0), 0.096 * strength);

      // Spark's three-frame multiply grain at 0.22 (mean 0.5, sd 0.13), pixel-locked, 3 frames at 12 fps.
      {
        float fg = mod(floor(time * 12.0), 3.0);  // bounded seed: Spark's 3-frame grain loop
        vec2 px = floor(tuv * vec2(source_size_x, source_size_y));
        float g = 0.5 + 0.45 * (hash21(px + fg * 97.0) - 0.5);
        result = mix(result, result * g, 0.22 * strength);
      }

      // VHS tape noise (Spark's 45-frame scanline sequence, added): faint coloured streaks across part of
      // a row, rolling slowly down the frame like tape tracking, with a rare white dropout dash. Each
      // pattern holds for 3 frames (at 30 fps) so it reads in video instead of flickering away.
      {
        float fv = mod(floor(time * 10.0), 45.0);  // bounded seed: Spark's 45-frame VHS loop
        float roll = fract(time / 24.0);  // seamless: one full roll every 24 s
        float ry = fract(tuv.y + roll) * 288.0;
        float row = floor(ry);
        float rowHash = hash21(vec2(row, fv));
        float x0 = hash11(row * 3.1 + fv * 0.7);
        float w = 0.25 + 0.6 * hash11(row * 5.3 + fv * 1.9);
        float span = smoothstep(x0 - 0.04, x0, tuv.x) * (1.0 - smoothstep(x0 + w, x0 + w + 0.04, tuv.x));
        float inRow = 1.0 - abs(fract(ry) - 0.5) * 2.0;
        float streak = step(0.94, rowHash) * span * smoothstep(0.0, 0.6, inRow);
        vec3 tint = 0.55 + 0.45 * vec3(hash11(row + fv), hash11(row * 1.3 + fv), hash11(row * 1.7 + fv));
        vec2 pxp = floor(tuv * vec2(source_size_x, source_size_y));
        vec2 dash = vec2(hash11(fv * 1.7 + 0.3), hash11(fv * 2.9 + 0.7)) * vec2(source_size_x, source_size_y);
        float on = step(0.93, hash11(fv + 11.0));
        float dropout = on * step(abs(pxp.y - floor(dash.y)), 0.5) * step(pxp.x, dash.x + 10.0) * step(dash.x, pxp.x);
        result = min(result + (streak * 0.16 * tint + vec3(dropout)) * strength, vec3(1.0));
      }

      // Spark's RGB split: the raw camera with red shifted left and blue shifted right, x1.3,
      // alpha-blended at 0.51 over the stack.
      {
        float d = 0.004;
        vec3 split = vec3(camAt(tuv + vec2(d, 0.0)).r, src.g, camAt(tuv - vec2(d, 0.0)).b);
        result = mix(result, min(split * 1.3, vec3(1.0)), 0.51 * strength);
      }

      // Static PLAY / VHS / date stamp, authored top-origin, alpha-blended over everything.
      {
        vec4 stamp = texture2D(auxSampler2, tuv);
        result = mix(result, stamp.rgb, stamp.a * overlay_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
