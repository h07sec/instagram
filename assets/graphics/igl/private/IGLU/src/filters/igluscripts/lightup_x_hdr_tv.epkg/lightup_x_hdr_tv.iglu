[Filter LightupXHdrTv]
# "LIGHTUP X HDR TV" (Spark 1141714769781221), SCRATCH NO-FACE port. Six passes.
#
#   Spark chain (main.json + the seven block documents):
#     scene   camera background + full-screen rect, lit defaultMaterial (standard lights: x K 0.76353283),
#             FastColorLUT "Light up" (8x8, clamp 0.04 / 0.96) on the camera.
#     FXAA    imageBasedAntiAliasingShader (EdgeSharpness 0.5, EdgeThreshold 0.5) on the scene.
#     TV      block, active: Sync 0.0864, Scanlines 0.0182, Fisheye -0.0364 (runtime-driven sync bar + scanlines,
#             centre lift / corner darkening, fisheye warp). Evaluated in two passes: full res and 1/2 res.
#     blur    1/2-res TV copy, then 5-tap horizontal and vertical Gaussians at 1/4 res (UV offsets).
#     filters block, active: Sharpen 0.7818, Blur 0.0045, Glow 0.2636, Grain 0 (no-op), HSV clamp round trip,
#             Contrast 0, Brightness 0, Vignette 0.0591 (circular, UV space).
#   Inactive in Spark (active = false, each returns its Image unchanged): symbols, tiltShift, glitch, lensFlare.
#   No face objects in the effect.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lightup_x_hdr_tv_lut);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'scene,
      inputs = {'default, 'lightup_x_hdr_tv_lut},
      glslShader = glslScene,
    }, {
      name = 'tv,
      inputs = {'scene},
      uniforms = {
        time = 0.0,
        sceneTexel = {0.000925926, 0.000520833},
      },
      glslShader = glslTv,
    }, {
      name = 'half,
      inputs = {'scene},
      scale = {0.5, 0.5},
      uniforms = {
        time = 0.0,
        sceneTexel = {0.000925926, 0.000520833},
      },
      glslShader = glslTv,
    }, {
      name = 'blurH,
      inputs = {'half},
      scale = {0.25, 0.25},
      uniforms = {
        blur_dir_x = 1.0,
        blur_dir_y = 0.0,
      },
      glslShader = glslBlur,
    }, {
      name = 'blurV,
      inputs = {'blurH},
      scale = {0.25, 0.25},
      uniforms = {
        blur_dir_x = 0.0,
        blur_dir_y = 1.0,
      },
      glslShader = glslBlur,
    }, {
      name = 'pass0,
      inputs = {'default, 'tv, 'blurV},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslFinal,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lightup_x_hdr_tv_lut_path = "lightup_x_hdr_tv_lut_path";
string lightup_x_hdr_tv_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; lightup_x_hdr_tv_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lightup_x_hdr_tv_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lightup_x_hdr_tv_lut_filename) {
            lightup_x_hdr_tv_lut_filename = new_lut;
            loadTexture('lightup_x_hdr_tv_lut, lightup_x_hdr_tv_lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 sz = getTextureSize('default);
    if (sz.x > 0.0) {
        f32 tx = 1.0 / sz.x;
        f32 ty = 1.0 / sz.y;
        vec2 texel = {tx, ty};
        setShaderUniform('tv, 'sceneTexel, texel);
        setShaderUniform('half, 'sceneTexel, texel);
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('tv, 'time, t);
    setShaderUniform('half, 'time, t);
}

#### GLSL shaders ####

string glslScene = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lightup_x_hdr_tv_lut (Light up, 1024x1024, 8x8 grid)

    // Lit defaultMaterial under the standard scene lights (ambient 0.2 + directional 0.8, rotX -pi/4, rotY 5 deg).
    const float kLight = 0.76353283;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec3 c = clamp(sampleInput(uv).rgb, 0.04, 0.96);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec3 lut = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row)).rgb;
      gl_FragColor = toOutputFormat(vec4(clamp(lut * kLight, 0.0, 1.0), 1.0));
    }
    ";

string glslTv = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    // 'scene (full resolution) is the pass input, read through sampleInput().
    uniform float time;
    uniform vec2 sceneTexel;

    const float kSync = 0.08636363636363534 * 0.1;
    const float kScan = 0.01818181818181715 * 0.1;
    const float kFisheye = -0.036363636363638374;

    // Spark gradient type 1 (vertical) is measured top-down, as Spark's screen UV (top-left origin).
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    float fxaaLuma(vec3 c) {
      return dot(c, vec3(0.2989, 0.5870, 0.1140));
    }

    vec2 safeNormalize(vec2 v) {
      float l2 = dot(v, v);
      return l2 > 0.0 ? v * inversesqrt(l2) : vec2(0.0);
    }

    // imageBasedAntiAliasingShader.sca: edgeSharpness mix(1, 8, 0.5) = 4.5, edgeThreshold mix(0.075, 0.4, 0.5).
    vec3 fxaa(vec2 uv) {
      const float edgeSharpness = 4.5;
      const float edgeThreshold = 0.2375;
      vec2 o = sceneTexel;
      float lumaNw = fxaaLuma(sampleInput(uv + vec2(-o.x, -o.y)).rgb);
      float lumaNe = fxaaLuma(sampleInput(uv + vec2(o.x, -o.y)).rgb);
      float lumaSw = fxaaLuma(sampleInput(uv + vec2(-o.x, o.y)).rgb);
      float lumaSe = fxaaLuma(sampleInput(uv + vec2(o.x, o.y)).rgb);
      vec3 colorM = sampleInput(uv).rgb;
      float lumaM = fxaaLuma(colorM);
      float lumaMax = max(max(lumaNe, lumaSe), max(lumaNw, lumaSw));
      float lumaMaxM = max(lumaMax, lumaM);
      float lumaMin = min(min(lumaNe, lumaSe), min(lumaNw, lumaSw));
      float lumaMinM = min(lumaMin, lumaM);
      float lumaMaxScaledClamped = max(0.04, lumaMax * edgeThreshold);
      vec3 res = colorM;
      if (lumaMaxM - lumaMinM >= lumaMaxScaledClamped) {
        float dirSwMinusNe = lumaSw - lumaNe;
        float dirSeMinusNw = lumaSe - lumaNw;
        vec2 dir1 = safeNormalize(vec2(dirSwMinusNe + dirSeMinusNw, dirSwMinusNe - dirSeMinusNw));
        float dirAbsMinTimesC = max(0.00001, min(abs(dir1.x), abs(dir1.y)) * edgeSharpness);
        vec2 dir2 = clamp(dir1 / dirAbsMinTimesC, -2.0, 2.0) * 2.0;
        vec3 colorN1 = sampleInput(uv - dir1 * o).rgb;
        vec3 colorP1 = sampleInput(uv + dir1 * o).rgb;
        vec3 colorN2 = sampleInput(uv - dir2 * o).rgb;
        vec3 colorP2 = sampleInput(uv + dir2 * o).rgb;
        res = (colorN1 + colorP1 + colorN2 + colorP2) * 0.25;
        float lumaRes = fxaaLuma(res);
        if (lumaRes < lumaMin || lumaRes > lumaMax) {
          res = (colorN1 + colorP1) * 0.5;
        }
      }
      return res;
    }

    // TV block terms, all functions of the (top-origin) screen uv p.
    float scanTerm(vec2 p) {
      float m = mod((p.y - 0.03 * time) * 120.0, 1.0);
      return (mix(m, step(0.5, m), 0.5) - 2.0) * kScan;
    }
    float syncTerm(vec2 p) {
      float q = mod(p.y - time, 1.0);
      return (mix(q, step(0.8, q), 0.1) - 0.5) * kSync;
    }
    float vigTerm(vec2 p) {
      return (1.0 - 2.0 * length(p - 0.5) - 0.5) * 0.1;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 tuv = topUv(uv);
      vec2 d = tuv - 0.5;
      vec2 w = tuv + d * dot(d, d) * kFisheye;
      w = (w - 0.5) / (1.0 + kFisheye * 0.5) + 0.5;
      w.x += 0.1 * (syncTerm(tuv) + scanTerm(tuv));
      // The block re-evaluates its whole signal (Image + scanlines + vignette + sync) at the warped uv.
      float s = scanTerm(w);
      vec3 c = fxaa(topUv(w)) + vec3(4.0 * s) + vec3(vigTerm(w) + syncTerm(w));
      gl_FragColor = toOutputFormat(vec4(clamp(c, 0.0, 1.0), 1.0));
    }
    ";

string glslBlur = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float blur_dir_x;
    uniform float blur_dir_y;

    // Spark's linear-sampled 9-tap Gaussian, offsets in UV (0.00136 * 4, 0.00317 * 4).
    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 dir = vec2(blur_dir_x, blur_dir_y);
      vec2 o1 = dir * 0.00544;
      vec2 o2 = dir * 0.01268;
      vec3 c = 0.22703 * sampleInput(uv).rgb +
          0.31622 * (sampleInput(uv + o1).rgb + sampleInput(uv - o1).rgb) +
          0.07027 * (sampleInput(uv + o2).rgb + sampleInput(uv - o2).rgb);
      gl_FragColor = toOutputFormat(vec4(clamp(c, 0.0, 1.0), 1.0));
    }
    ";

string glslFinal = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'tv (filters Image)
    uniform sampler2D auxSampler2;  // 'blurV (filters Blurred Image)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    // Spark shaderkit ColorSpaces.sparksl.
    vec3 rgbToHsv(vec3 rgb) {
      float cmax = max(rgb.r, max(rgb.g, rgb.b));
      float cmin = min(rgb.r, min(rgb.g, rgb.b));
      float d = cmax - cmin;
      vec3 dc = vec3(rgb.g - rgb.b, rgb.b - rgb.r, rgb.r - rgb.g) / max(d, 0.001);
      float h = dc.z + 4.0;
      h = mix(h, dc.y + 2.0, step(cmax, rgb.g));
      h = mix(h, dc.x, step(cmax, rgb.r));
      h = mod(h / 6.0, 1.0);
      return vec3(h, d / max(cmax, 0.001), cmax);
    }
    vec3 hsvToRgb(vec3 hsv) {
      vec3 k = clamp(vec3(abs(hsv.x * 6.0 - 3.0) - 1.0, 2.0 - abs(hsv.x * 6.0 - 2.0), 2.0 - abs(hsv.x * 6.0 - 4.0)), 0.0, 1.0);
      return hsv.z * mix(vec3(1.0), k, hsv.y);
    }

    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched.
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 img = texture2D(auxSampler1, uv).rgb;
      vec3 b = texture2D(auxSampler2, uv).rgb;
      vec3 m = mix(img, img + (img - b) * 2.0, 0.7818181818181809);
      m = mix(m, b, 0.004545454545453512);
      m += b * 0.2636363636363626;
      vec3 c = clamp(hsvToRgb(clamp(rgbToHsv(m), 0.0, 1.0)), 0.0, 1.0);
      float g = 2.0 * length(topUv(uv) - 0.5);
      c = clamp(c * (1.0 - g * 0.05909090909090806), 0.0, 1.0);
      gl_FragColor = toOutputFormat(vec4(clamp(mix(cam.rgb, c, strength), 0.0, 1.0), cam.a));
    }
    ";
