[Filter Lagertha]
# "Lagertha" ported from the Spark effect (740607436566886). Single fragment pass, one asset (the LUT).
#
#   Layer 1: the camera graded by Spark's "Nuevo marron desaturado" 8x8 LUT (FastColorLUT), full frame.
#   Layer 2: the whole graded camera again at 75% scale, centred, through a rounded-corner mask
#            (Spark draws it on a 0.75-scale rectangle multiplied by a 375x667 rounded-corner PNG;
#            the corner radius is 26 px = 0.069 of the inset width). Procedural, anti-aliased.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lagertha_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {inset_scale = 0.75, min = 0.3, max = 1.0, description = "Picture-in-picture scale (Spark 0.75)"},
        {corner_radius = 0.069, min = 0.0, max = 0.25, description = "Corner radius as a fraction of the inset width (Spark 0.069)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lagertha_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        inset_scale = 0.75,
        corner_radius = 0.069,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslLagertha,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lagertha_lut_path = "lagertha_lut_path";
string lagertha_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; lagertha_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(lagertha_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lagertha_lut_filename) {
            lagertha_lut_filename = new_lut;
            loadTexture('lagertha_lut, lagertha_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'inset_scale, getParameterFloat('inset_scale));
    setShaderUniform('pass0, 'corner_radius, getParameterFloat('corner_radius));

    # Source resolution for the aspect-correct rounded corners and the 1 px anti-aliased edge.
    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslLagertha = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lagertha_lut

    uniform float lut_strength;
    uniform float inset_scale;
    uniform float corner_radius;
    uniform float source_size_x;
    uniform float source_size_y;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      float s = strength * lut_strength;
      vec3 result = mix(cam.rgb, lutLookup(cam.rgb), s);

      // Rounded-rectangle inset in pixel units, so the corners stay round at any aspect ratio.
      vec2 local = (uv - 0.5) / inset_scale + 0.5;
      vec2 insetPx = vec2(source_size_x, source_size_y) * inset_scale;
      vec2 q = abs(local - 0.5) * insetPx;
      float r = corner_radius * insetPx.x;
      vec2 d = q - (insetPx * 0.5 - vec2(r));
      float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
      float inside = 1.0 - smoothstep(-0.5, 0.5, dist * (source_size_x / max(insetPx.x, 1.0)));
      if (inside > 0.0) {
        vec3 insetCam = sampleInput(clamp(local, 0.0, 1.0)).rgb;
        result = mix(result, mix(insetCam, lutLookup(insetCam), s), inside);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
