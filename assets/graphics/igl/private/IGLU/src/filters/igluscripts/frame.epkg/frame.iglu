[Filter Frame]
# "♡ frame ♡" — 2x2 photo grid. Ported from the Spark effect "frame"
# (tracker "♡ frame ♡", 267206724814377). Single fragment pass, bottom -> top:
#
#   Layer 1 — Four grid cells. Each cell is a miniature of the whole camera image
#             (Spark: four camera rectangles at scale 0.51, offset +/-96 px, +/-170 px
#             on a 375x667 canvas) through the LUT at full strength.
#   Layer 2 — White dividers + hearts overlay (frame_overlay.png), alpha blended.
#
# Spark's white "fundo" background rectangle is fully covered by the four cells,
# so it is not drawn.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('frame_lut);
    makeTexture('frame_overlay);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength inside the grid cells"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'frame_lut, 'frame_overlay},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
      },
      glslShader = glslFrame,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string frame_lut_path = "frame_lut_path";
string frame_lut_filename = "";
string frame_overlay_path = "frame_overlay_path";
string frame_overlay_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; frame_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(frame_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != frame_lut_filename) {
            frame_lut_filename = new_lut;
            loadTexture('frame_lut, frame_lut_filename);
        }
    }
    string overlay_param = getParameterString(frame_overlay_path);
    if (overlay_param != "") {
        string new_overlay = stringAppend("textureFilePath://", overlay_param);
        if (new_overlay != frame_overlay_filename) {
            frame_overlay_filename = new_overlay;
            loadTexture('frame_overlay, frame_overlay_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, s);
}

#### GLSL shader ####

string glslFrame = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'frame_lut
    uniform sampler2D auxSampler2;  // 'frame_overlay

    uniform float lut_strength;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);

      // Spark cell centres in UV (canvas 375x667, y up there, down here) and the
      // 0.51 cell scale. Columns split at x = 0.5, rows at y = 0.5.
      vec2 tuv = topUv(uv);
      float cx = tuv.x < 0.5 ? 0.2420 : 0.7540;
      float cy = tuv.y < 0.5 ? 0.2546 : 0.7642;
      vec2 cell = clamp((tuv - vec2(cx, cy)) / 0.51 + 0.5, 0.0, 1.0);

      vec3 c = sampleInput(topUv(cell)).rgb;
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(c, lutLookup(c), strength * lut_strength);

      vec4 overlay = texture2D(auxSampler2, tuv);
      vec3 result = mix(graded, overlay.rgb, overlay.a);

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
