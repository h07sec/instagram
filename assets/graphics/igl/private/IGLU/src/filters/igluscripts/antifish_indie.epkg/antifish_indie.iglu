[Filter AntifishIndie]
# "Antifish Indie" ported from the Spark effect (701664057181969). Single fragment pass, no assets beyond the LUT.
#
#   Spark chain: camera -> Advanced LUT -> RGB Shift (amount 0.5) -> Sharpen3 -> Fisheye PRO -> screen.
#   Here, in one pass: barrel (fisheye) UV warp, a small RGB split along the radius, a 5-tap unsharp mask,
#   then the indie LUT. The warp is radially symmetric, so it's the same on GL and Metal.
#   Dropped: the 0.04-opacity glitter noise layer and the hidden vignette.
#
# Time source: none (static). GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('antifish_indie_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "Indie LUT mix strength"},
        {fisheye = 0.38, min = 0.0, max = 1.0, description = "Barrel distortion amount"},
        {rgb_shift = 0.5, min = 0.0, max = 1.0, description = "Radial RGB split (Spark 0.5)"},
        {sharpen = 0.6, min = 0.0, max = 2.0, description = "Unsharp-mask amount"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'antifish_indie_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        fisheye = 0.38,
        rgb_shift = 0.5,
        sharpen = 0.6,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslAntifishIndie,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string antifish_indie_lut_path = "antifish_indie_lut_path";
string antifish_indie_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; antifish_indie_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(antifish_indie_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != antifish_indie_lut_filename) {
            antifish_indie_lut_filename = new_lut;
            loadTexture('antifish_indie_lut, antifish_indie_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'fisheye, getParameterFloat('fisheye));
    setShaderUniform('pass0, 'rgb_shift, getParameterFloat('rgb_shift));
    setShaderUniform('pass0, 'sharpen, getParameterFloat('sharpen));

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslAntifishIndie = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'antifish_indie_lut
    uniform float lut_strength;
    uniform float fisheye;
    uniform float rgb_shift;
    uniform float sharpen;
    uniform float source_size_x;
    uniform float source_size_y;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Barrel warp in an aspect-correct space; normalised so the frame corners stay at the corners.
    vec2 barrel(vec2 uv, float k) {
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 p = (uv - 0.5) * vec2(aspect, 1.0);
      float rc = length(vec2(aspect, 1.0) * 0.5);
      float r = length(p) / rc;
      float f = (1.0 - k) + k * r * r;
      p *= f;
      return p / vec2(aspect, 1.0) + 0.5;
    }

    // Unsharp mask of one channel (ch selects it). The RGB split gives each channel its own UV, so the
    // fetches can't be shared; only the needed channel's math is done.
    float sampleSharp(vec2 uv, vec2 px, vec3 ch) {
      float c = dot(sampleInput(uv).rgb, ch);
      float n = dot(sampleInput(uv + vec2(px.x, 0.0)).rgb + sampleInput(uv - vec2(px.x, 0.0)).rgb
                  + sampleInput(uv + vec2(0.0, px.y)).rgb + sampleInput(uv - vec2(0.0, px.y)).rgb, ch);
      return c + (c - n * 0.25) * sharpen * strength;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      float k = fisheye * strength;
      vec2 wuv = barrel(uv, k);
      vec2 dir = wuv - 0.5;
      vec2 px = 1.0 / vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
      float s = rgb_shift * strength * 0.006;
      vec3 c;
      c.r = sampleSharp(clamp(wuv + dir * s, 0.0, 1.0), px, vec3(1.0, 0.0, 0.0));
      c.g = sampleSharp(clamp(wuv, 0.0, 1.0), px, vec3(0.0, 1.0, 0.0));
      c.b = sampleSharp(clamp(wuv - dir * s, 0.0, 1.0), px, vec3(0.0, 0.0, 1.0));
      c = clamp(c, 0.0, 1.0);
      vec3 graded = mix(c, lutLookup(c), lut_strength * strength);
      gl_FragColor = toOutputFormat(vec4(clamp(graded, 0.0, 1.0), cam.a));
    }
    ";
