[Filter GLOW]
# "• G L O W •" ported from the Spark effect (840909253024552). Two passes, no face tracking.
#
#   Spark: the camera through the "Vintage-2" FastColorLUT, then five glitter layers drawn over it in order
#   (grid scales 0.4, 0.55, 0.7, 0.475, 0.625) with straight-alpha "over" blending. Each layer cuts the frame
#   into a (27g x 48g) cell grid. Each cell takes one 3x3 Laplacian of the camera (not the LUT output) at a
#   fixed point in the cell; if the edge score passes Spark's gate, the cell draws the star sprite, sized by
#   edge strength and centred in the cell. So stars sit wherever the camera has bright edges (hair, sheen),
#   not on the face. Nothing is time-driven.
#   Spark's 0.5 skin smoothing is faked with a soft centre-weighted edge-aware blur, applied before both the
#   LUT and the edge taps. The face reprojection layers and the slider face reshape (0 by default) are
#   dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('g_l_o_w_lut);
    makeTexture('g_l_o_w_star);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"}
    };

    filter.passes = {
      {
        name = 'base,
        inputs = {'default},
        uniforms = {
          smooth_strength = 0.5,
          source_size_x = 1080.0,
          source_size_y = 1920.0,
        },
        glslShader = glslBase,
      },
      {
        name = 'composite,
        inputs = {'default, 'base, 'g_l_o_w_lut, 'g_l_o_w_star},
        uniforms = {
          strength = 1.0,
        },
        glslShader = glslComposite,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string g_l_o_w_lut_path = "g_l_o_w_lut_path";
string g_l_o_w_lut_filename = "";
string g_l_o_w_star_path = "g_l_o_w_star_path";
string g_l_o_w_star_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('composite, 'strength, getParameterFloat('strength));
    setShaderUniform('base, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; g_l_o_w_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(g_l_o_w_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != g_l_o_w_lut_filename) {
            g_l_o_w_lut_filename = new_lut;
            loadTexture('g_l_o_w_lut, g_l_o_w_lut_filename);
        }
    }
    string star_param = getParameterString(g_l_o_w_star_path);
    if (star_param != "") {
        string new_star = stringAppend("textureFilePath://", star_param);
        if (new_star != g_l_o_w_star_filename) {
            g_l_o_w_star_filename = new_star;
            loadTexture('g_l_o_w_star, g_l_o_w_star_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('base, 'source_size_x, srcSize.x);
        setShaderUniform('base, 'source_size_y, srcSize.y);
    }
}

#### GLSL shaders ####

string glslBase = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec3 c = sampleInput(uv).rgb;
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float sm = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (sm > 0.0) {
        c = mix(c, skinBlur(uv, c), sm);
      }
      gl_FragColor = toOutputFormat(vec4(c, 1.0));
    }
    ";

string glslComposite = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'base (camera after the faked smoothing)
    uniform sampler2D auxSampler2;  // 'g_l_o_w_lut (Vintage-2, 512x512)
    uniform sampler2D auxSampler3;  // 'g_l_o_w_star (982x1024; R, G = sprite red and green/blue, B = alpha)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    // Spark's Laplacian tap step is 6.5 px of its render target; fixed here in uv at the sample's 720x1280,
    // so star density does not change with resolution.
    const vec2 kStep = vec2(6.5 / 720.0, 6.5 / 1280.0);
    const vec3 kLuma = vec3(0.298911988735199, 0.5866109728813171, 0.11447799950838089);
    // The glitter materials are lit: ambient 0.2 + directional 0.8 * cos(-pi/4) * cos(5 deg).
    const float kLight = 0.76353283;

    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Samples the smoothed camera at a top-origin position.
    vec3 cam(vec2 p) {
      return texture2D(auxSampler1, topUv(p)).rgb;
    }

    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0078125, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler2, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    // One glitter layer drawn over dst. x is the top-origin frame position.
    vec3 glitter(vec3 dst, vec2 x, float g, vec2 t, float k) {
      vec2 n = vec2(9.0, 16.0) * 3.0 * g;
      vec2 cellSize = 1.0 / n;
      vec2 q = floor(x / cellSize) * cellSize + t;
      vec3 c = cam(q);
      vec2 z = q + vec2(0.012, 0.007);
      vec3 l = 8.0 * cam(z)
          - cam(z + vec2(1.0, 1.0) * kStep) - cam(z + vec2(-1.0, -1.0) * kStep)
          - cam(z + vec2(0.0, -1.0) * kStep) - cam(z + vec2(1.0, -1.0) * kStep)
          - cam(z + vec2(-1.0, 0.0) * kStep) - cam(z + vec2(1.0, 0.0) * kStep)
          - cam(z + vec2(-1.0, 1.0) * kStep) - cam(z + vec2(0.0, 1.0) * kStep);
      // Spark's contrast x10, then x9, then x1.7 ('Particle size'), then luma.
      vec3 e = (((l - 0.5) * 10.0 + 0.5 - 0.5) * 9.0 + 0.5) * 1.7;
      float y = dot(e, kLuma);
      vec3 gRgb = y * (c + 1.0) - 1.0;
      if (gRgb.r < 1.2) {
        return dst;
      }
      vec2 f = fract(x * n);
      float m = (0.7 - gRgb.r) * k;
      vec2 s = ((f - 0.5) / m + 0.5) / 1.15;
      // The sprite ships opaque (its green and blue are equal, so alpha rides in blue) so that no loader
      // premultiplies it: Spark samples it as straight alpha.
      vec3 starTexel = texture2D(auxSampler3, s).rgb;
      vec3 starRgb = vec3(starTexel.r, starTexel.g, starTexel.g);
      vec3 rgb = clamp(0.01 * (starRgb + 0.1) * gRgb * kLight, 0.0, 1.0);
      float a = clamp(2.4 * starTexel.b, 0.0, 1.0);
      return mix(dst, rgb, a);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 camera = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(camera);
        return;
      }
      vec2 x = topUv(uv);
      vec3 dst = lutLookup(texture2D(auxSampler1, uv).rgb);
      dst = glitter(dst, x, 0.4, vec2(0.033, 0.018), 0.002);
      dst = glitter(dst, x, 0.55, vec2(0.0225, 0.0125), 0.003);
      dst = glitter(dst, x, 0.7, vec2(0.012, 0.007), 0.003);
      dst = glitter(dst, x, 0.475, vec2(0.02775, 0.01525), 0.0025);
      dst = glitter(dst, x, 0.625, vec2(0.01725, 0.00975), 0.003);
      vec3 result = mix(camera.rgb, dst, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), camera.a));
    }
    ";
