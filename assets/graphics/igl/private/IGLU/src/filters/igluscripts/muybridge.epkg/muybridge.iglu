[Filter Muybridge]
# "Muybridge" ported from the Spark effect (288025045776886). Two passes, no assets.
#
#   A 3x3 contact sheet of the whole camera frame (Spark's effect has nine frame materials), each tile a
#   moment later than the one before in reading order: top-left is the oldest, bottom-right is live, and
#   tiles are 4 frames (0.13 s) apart, the per-step delay measured from the Spark sample.
#   Here 'small keeps a third-resolution copy of the camera, eight historical aliases read it 4..32 frames
#   back (they share one pool of retained frames), and 'pass0 draws the grid.
#   Face tracking: Spark has an empty face tracker in the scene (nothing is drawn on it), so none is needed.
#
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeHistoricalTexture('hist4, 'small, 4.0);
    makeHistoricalTexture('hist8, 'small, 8.0);
    makeHistoricalTexture('hist12, 'small, 12.0);
    makeHistoricalTexture('hist16, 'small, 16.0);
    makeHistoricalTexture('hist20, 'small, 20.0);
    makeHistoricalTexture('hist24, 'small, 24.0);
    makeHistoricalTexture('hist28, 'small, 28.0);
    makeHistoricalTexture('hist32, 'small, 32.0);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'small,
      inputs = {'default},
      scale = 0.3334,
      uniforms = {},
      glslShader = glslMuybridgeCopy,
    }, {
      name = 'pass0,
      inputs = {'default, 'small, 'hist4, 'hist8, 'hist12, 'hist16, 'hist20, 'hist24, 'hist28, 'hist32},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslMuybridge,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
}

#### GLSL shaders ####

string glslMuybridgeCopy = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    void main() {
      gl_FragColor = toOutputFormat(sampleInput(sourceTextureCoordinate));
    }
    ";

string glslMuybridge = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;   // 'default (camera)
    uniform sampler2D auxSampler1;   // 'small (live, quarter resolution)
    uniform sampler2D auxSampler2;   // 'hist4
    uniform sampler2D auxSampler3;   // 'hist8
    uniform sampler2D auxSampler4;   // 'hist12
    uniform sampler2D auxSampler5;   // 'hist16
    uniform sampler2D auxSampler6;   // 'hist20
    uniform sampler2D auxSampler7;   // 'hist24
    uniform sampler2D auxSampler8;   // 'hist28
    uniform sampler2D auxSampler9;   // 'hist32
    // The sampler chain below holds exactly 9 ages (live + 8 delays), so the grid is fixed at 3x3.
    const float grid = 3.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and back for lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec2 tuv = topUv(uv);

      // Tiles are the whole frame at 1/grid size (same aspect, no crop), in reading order.
      vec2 cell = min(floor(tuv * grid), vec2(grid - 1.0));
      vec2 cuv = topUv(fract(tuv * grid));
      // Age in 4-frame steps: the last tile (bottom-right) is live, each earlier tile 4 frames older.
      float age = grid * grid - 1.0 - (cell.y * grid + cell.x);

      // One sampler per age; independent ifs (not an else-if chain) keep shaderc's nesting shallow.
      vec3 c = texture2D(auxSampler1, cuv).rgb;
      if (age > 0.5) { c = texture2D(auxSampler2, cuv).rgb; }
      if (age > 1.5) { c = texture2D(auxSampler3, cuv).rgb; }
      if (age > 2.5) { c = texture2D(auxSampler4, cuv).rgb; }
      if (age > 3.5) { c = texture2D(auxSampler5, cuv).rgb; }
      if (age > 4.5) { c = texture2D(auxSampler6, cuv).rgb; }
      if (age > 5.5) { c = texture2D(auxSampler7, cuv).rgb; }
      if (age > 6.5) { c = texture2D(auxSampler8, cuv).rgb; }
      if (age > 7.5) { c = texture2D(auxSampler9, cuv).rgb; }

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      gl_FragColor = toOutputFormat(vec4(mix(cam.rgb, c, strength), cam.a));
    }
    ";
