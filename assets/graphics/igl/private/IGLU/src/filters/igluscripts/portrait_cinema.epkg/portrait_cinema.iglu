[Filter PortraitCinema]
# "Portrait | Cinema" ported from the Spark effect (583783949611964). Single fragment pass,
# no face tracking.
#
#   Spark: a BlurBox5 of the raw camera (5x5 equal taps, 5/512 UV apart), then the sharp camera cut out by
#   the person segmentation, then the graded camera (FastColorLUT at 0.75) through the same mask. So the
#   person is sharp and warm-graded and the background is box-blurred and ungraded ("portrait mode").
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.18.
#   Spark's face warp and faint makeup layers are dropped: they need face tracking.
#
#   Segmentation: the person mask is the host-bound 'mask named input, as for the cutout_* effects (the
#   manifest's iglu.subject block asks the host for it). Hosts that bind no mask (IG camera today) get a
#   soft head-and-shoulders silhouette instead, so the centre stays sharp and the edges blur.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('portrait_cinema_lut);
    makeTexture('mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.75, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.18, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'portrait_cinema_lut, 'mask},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.75,
        smooth_strength = 0.18,
        has_mask = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslPortraitCinema,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string portrait_cinema_lut_path = "portrait_cinema_lut_path";
string portrait_cinema_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; portrait_cinema_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(portrait_cinema_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != portrait_cinema_lut_filename) {
            portrait_cinema_lut_filename = new_lut;
            loadTexture('portrait_cinema_lut, portrait_cinema_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # A host-bound mask is at least a few px; an unbound slot reports (0, 0) or a 1x1 placeholder.
    vec2 maskSize = getTextureSize('mask);
    f32 hasMask = 0.0;
    if (maskSize.x > 4.0) {
        hasMask = 1.0;
    }
    setShaderUniform('pass0, 'has_mask, hasMask);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslPortraitCinema = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'portrait_cinema_lut
    uniform sampler2D auxSampler2;  // 'mask (host person segmentation)

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;
    uniform float has_mask;

    // Spark BlurBox5 defaults: Strength 5 at TextureSize 512.
    const vec2 kBoxStep = vec2(5.0 / 512.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 must return the camera untouched: Edits iOS shows this script's output directly (the
      // subject path only binds the mask), and the clamp below would clip extended-range input.
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // Person coverage: the host-bound 'mask (iglu.subject), else a soft head-and-shoulders silhouette.
      float cover;
      if (has_mask > 0.5) {
        // Same convention as the cutout_* effects: coverage is the brightest channel.
        vec4 m = texture2D(auxSampler2, uv);
        cover = max(m.r, max(m.g, m.b));
      } else {
        vec2 p = topUv(uv);
        vec2 head = (p - vec2(0.5, 0.40)) * vec2(aspect, 1.0) / vec2(0.26, 0.22);
        vec2 body = (p - vec2(0.5, 1.02)) * vec2(aspect, 1.0) / vec2(0.46, 0.36);
        float neck = (1.0 - smoothstep(0.08, 0.1, abs(p.x - 0.5) * aspect)) * step(0.5, p.y) * step(p.y, 0.75);
        cover = max(max(1.0 - smoothstep(0.92, 1.0, length(head)), 1.0 - smoothstep(0.92, 1.0, length(body))), neck);
      }
      // Background: Spark BlurBox5 of the raw (ungraded) camera, 5x5 equal taps.
      vec3 bg = vec3(0.0);
      if (cover < 1.0) {
        for (int j = -2; j <= 2; j++) {
          for (int i = -2; i <= 2; i++) {
            bg += sampleInput(uv + vec2(float(i), float(j)) * kBoxStep).rgb;
          }
        }
        bg /= 25.0;
      }
      // Spark draws the sharp camera, then its LUT at 0.75, both through the person mask.
      vec3 person = mix(src, lutLookup(src), lut_strength);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = mix(cam.rgb, mix(bg, person, clamp(cover, 0.0, 1.0)), strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
