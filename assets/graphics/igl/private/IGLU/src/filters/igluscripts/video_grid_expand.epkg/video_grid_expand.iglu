[Filter IgluscriptVideoGridExpandFilter]
# Progressively subdivides the frame into a tiled grid, doubling column and row count in stages.
#
# On the clock, `progress` crosses three thresholds to step through four subdivisions. With
# `useBeats` true the stage comes from `beatStep` instead, so one subdivision lands per beat and the
# four stages cycle.

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {beatStep = 0.0, min = 0.0, max = 3.0, description = "Beat step counter"},
    {useBeats = false, description = "True while the beat system is driving this effect"},
  };

  filter.passes = {{
      name = 'grid_expand, inputs = {'default},
      uniforms = {
        progress = 0.0,
        stepIndex = 0.0,
        beatMode = 0.0,
      },
      glslShader = glsl
    }};
}

[PreRender]
fun preRender(Filter filter) {
  # Get behavior parameters from parameter map (set by JNI/keyframe system)
  f32 progressValue = getParameterFloat('progress);

  # Apply to shader uniform
  setShaderUniform('grid_expand, 'progress, progressValue);

  # Uniforms are floats, so beat mode is selected with 0.0 / 1.0 rather than a boolean.
  f32 beatMode = 0.0;
  f32 stepIndex = 0.0;
  if (getParameterBoolean('useBeats)) {
    beatMode = 1.0;
    stepIndex = getParameterFloat('beatStep);
  }
  setShaderUniform('grid_expand, 'beatMode, beatMode);
  setShaderUniform('grid_expand, 'stepIndex, stepIndex);
}

string glsl = "precision highp float;

varying vec2 textureCoordinate;
varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float progress;
uniform float stepIndex;
uniform float beatMode;

void main() {

vec2 uv = sourceTextureCoordinate;

// Four subdivision stages. On the clock they are reached by progress crossing 1/4, 2/4 and 3/4;
// on a beat the step counter selects one directly, cycling every four beats.
float stage = mod(stepIndex, 4.0);
float s1 = mix(step(1.0/4.0, progress), step(1.0, stage), beatMode);
float s2 = mix(step(2.0/4.0, progress), step(2.0, stage), beatMode);
float s3 = mix(step(3.0/4.0, progress), step(3.0, stage), beatMode);

vec2 subD = vec2(1.0 + s2 + s3, 1.0 + s1 + s3);

vec2 localUV = fract(uv * subD);

float vertGrid = s1 - s2;
localUV.y = mix(localUV.y, localUV.y * 0.5 + 0.25, vertGrid);


  vec4 color = sampleInput(localUV);
  gl_FragColor = toOutputFormat(color);
}
";
