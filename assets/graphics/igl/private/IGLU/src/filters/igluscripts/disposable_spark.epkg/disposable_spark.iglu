[Filter DisposableSpark]
# "𝘿𝙞𝙨𝙥𝙤𝙨𝙖𝙗𝙡𝙚" ported from the Spark effect (271790227266072). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Overlay: 'disposable_spark_leaks add-blended full-frame at 1.
#   Overlay: 'disposable_spark_date alpha-blended full-frame at 1.
#   Spark adds a 188-frame leak sequence at 25 fps (7.52 s loop), about 75% black; here its 8 bursts (one key frame each, 4x2 atlas) show only inside their Spark time windows, with a fade.
#   Date stamp: Spark draws the live device clock in its Date Stamp font (#FF4800); it ships as a fixed stamp image in the same font.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('disposable_spark_lut);
    makeTexture('disposable_spark_leaks);
    makeTexture('disposable_spark_date);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {leaks_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the leaks overlay"},
        {date_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the date overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'disposable_spark_lut, 'disposable_spark_leaks, 'disposable_spark_date},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        leaks_opacity = 1.0,
        date_opacity = 1.0,
        time = 0.0,
      },
      glslShader = glslDisposableSpark,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string disposable_spark_lut_path = "disposable_spark_lut_path";
string disposable_spark_lut_filename = "";
string disposable_spark_leaks_path = "disposable_spark_leaks_path";
string disposable_spark_leaks_filename = "";
string disposable_spark_date_path = "disposable_spark_date_path";
string disposable_spark_date_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; disposable_spark_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(disposable_spark_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != disposable_spark_lut_filename) {
            disposable_spark_lut_filename = new_lut;
            loadTexture('disposable_spark_lut, disposable_spark_lut_filename);
        }
    }

    string disposable_spark_leaks_param = getParameterString(disposable_spark_leaks_path);
    if (disposable_spark_leaks_param != "") {
        string new_disposable_spark_leaks = stringAppend("textureFilePath://", disposable_spark_leaks_param);
        if (new_disposable_spark_leaks != disposable_spark_leaks_filename) {
            disposable_spark_leaks_filename = new_disposable_spark_leaks;
            loadTexture('disposable_spark_leaks, disposable_spark_leaks_filename);
        }
    }
    string disposable_spark_date_param = getParameterString(disposable_spark_date_path);
    if (disposable_spark_date_param != "") {
        string new_disposable_spark_date = stringAppend("textureFilePath://", disposable_spark_date_param);
        if (new_disposable_spark_date != disposable_spark_date_filename) {
            disposable_spark_date_filename = new_disposable_spark_date;
            loadTexture('disposable_spark_date, disposable_spark_date_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'leaks_opacity, getParameterFloat('leaks_opacity));
    setShaderUniform('pass0, 'date_opacity, getParameterFloat('date_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslDisposableSpark = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'disposable_spark_lut
    uniform sampler2D auxSampler2;  // 'disposable_spark_leaks
    uniform sampler2D auxSampler3;  // 'disposable_spark_date

    uniform float lut_strength;
    uniform float leaks_opacity;
    uniform float date_opacity;
    uniform float time;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // (atlas slot, first frame, last frame) of the Spark leak burst covering frame f; slot -1 = none.
    vec3 burstWindow(float f) {
      if (f >= 28.0 && f <= 31.0) { return vec3(0.0, 28.0, 31.0); }
      if (f >= 34.0 && f <= 39.0) { return vec3(1.0, 34.0, 39.0); }
      if (f >= 67.0 && f <= 73.0) { return vec3(2.0, 67.0, 73.0); }
      if (f >= 74.0 && f <= 74.0) { return vec3(3.0, 74.0, 74.0); }
      if (f >= 102.0 && f <= 111.0) { return vec3(4.0, 102.0, 111.0); }
      if (f >= 136.0 && f <= 141.0) { return vec3(5.0, 136.0, 141.0); }
      if (f >= 142.0 && f <= 150.0) { return vec3(6.0, 142.0, 150.0); }
      if (f >= 185.0 && f <= 186.0) { return vec3(7.0, 185.0, 186.0); }
      return vec3(-1.0, 0.0, 0.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'disposable_spark_leaks (add), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('disposable_spark_leaks).
        // Spark's 188-frame, 25 fps leak (7.52 s loop) is black ~75% of the time; its 8 bursts each show
        // one key frame (4x2 atlas) only inside the burst's Spark frame window, with a sine fade.
        float f = mod(floor(time * 25.0), 188.0);
        vec3 win = burstWindow(f);
        if (win.x >= 0.0) {
          vec2 cuv = clamp(topUv(uv), vec2(0.5 / 288.0, 0.5 / 512.0), vec2(1.0 - 0.5 / 288.0, 1.0 - 0.5 / 512.0)) / vec2(4.0, 2.0);
          vec3 lk = texture2D(auxSampler2, vec2(mod(win.x, 4.0), floor(win.x / 4.0)) / vec2(4.0, 2.0) + cuv).rgb;
          float env = sin(3.14159265 * (f - win.y + 0.5) / (win.z - win.y + 1.0));
          result = min(result + lk * env * leaks_opacity * strength, vec3(1.0));
        }
      }
      // Full-frame overlay 'disposable_spark_date (alpha), authored top-origin.
      {
        // auxSampler3 = pass input 4 ('disposable_spark_date).
        vec4 ov = texture2D(auxSampler3, topUv(uv));
        result = mix(result, ov.rgb, (date_opacity * ov.a) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
