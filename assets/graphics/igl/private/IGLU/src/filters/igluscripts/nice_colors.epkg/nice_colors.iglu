[Filter NiceColors]
# "NICE COLORS" ported from the Spark effect (437231326935400). Single fragment pass, no face tracking.
#
#   Spark: the default (no-tap) state of a "Lightroom PRO" LUT/adjustment effect. The camera goes through the
#   adjustment chain (exposure, contrast, highlights, shadows, temperature, tint, vibrance; all 0 at start, so
#   the chain is the identity), then picker LUT 0 ("lut_01", 8x8 FastColorLUT, clamp 0.0078125..0.98438, no
#   texel-centre correction) mixed 0.5 over the adjusted colour, drawn opaque over the camera (unlit, alpha).
#   Dropped: the face re-grade mesh (same chain on the face texture, so it repaints the same colours), the
#   teeth whitening (0.75 x teeth mask; the sample keeps the mouth closed) and the under-eye concealer
#   (0.5 x a <= 0.61 mask, cheek-colour fill; not visible in the sample). Sharpen, vignette and the
#   capture-hidden hint are off by default. Spark's face-only retouch starts at factor 0; it is faked with the
#   centre-weighted edge-aware blur behind smooth_strength (default 0, so off).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('nice_colors_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.0, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch, 0 at Spark start)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'nice_colors_lut},
      uniforms = {
        strength = 1.0,
        smooth_strength = 0.0,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslNiceColors,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string nice_colors_lut_path = "nice_colors_lut_path";
string nice_colors_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; nice_colors_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(nice_colors_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != nice_colors_lut_filename) {
            nice_colors_lut_filename = new_lut;
            loadTexture('nice_colors_lut, nice_colors_lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslNiceColors = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'nice_colors_lut (lut_01, 512x512)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = cam.rgb;
      if (smooth_strength > 0.0) {
        float aspect = source_size_x / max(source_size_y, 1.0);
        vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
        float sm = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
        if (sm > 0.0) {
          s = mix(s, skinBlur(uv, s), sm);
        }
      }
      // FastColorLUT decode (C300..C324): clamp, floor-selected blue slice, no texel-centre correction.
      vec3 c = clamp(s, 0.0078125, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec3 graded = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row)).rgb;
      // lut_intensity 0.5 (script config), mixed over the unclamped adjusted colour (C327).
      vec3 spark = mix(s, graded, 0.5);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
