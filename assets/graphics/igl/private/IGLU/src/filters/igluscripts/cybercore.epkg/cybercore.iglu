[Filter Cybercore]
# "cybercore:" ported from the Spark effect (2183397352008840). No face tracking;
# every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark colorLUTShader (nearest blue slice)) at 1.
#   Spark adds a 5x5 box blur (5 px steps) of the LUT-graded camera, tinted #99F8C7, at 0.4163 over the camera: a green bloom.
#   Dropped: the face warp on 4 face trackers (face tracking).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('cybercore_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"}
    };

    filter.passes = {
      {
        name = 'lut_grade,
        inputs = {'default, 'cybercore_lut},
        bufferType = 'float16,
        glslShader = glslLutGrade,
      },
      {
        name = 'bloom_h,
        inputs = {'default, 'lut_grade},
        shaderInputNames = {'default, 'gradeTex},
        bufferType = 'float16,
        uniforms = {
          source_size_x = 1024.0,
        },
        glslShader = glslBloomH,
      },
      {
        name = 'pass0,
        inputs = {'default, 'bloom_h},
        shaderInputNames = {'default, 'bloomHTex},
        uniforms = {
          strength = 1.0,
          lut_strength = 1.0,
          source_size_y = 1024.0,
        },
        glslShader = glslCybercore,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string cybercore_lut_path = "cybercore_lut_path";
string cybercore_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; cybercore_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(cybercore_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != cybercore_lut_filename) {
            cybercore_lut_filename = new_lut;
            loadTexture('cybercore_lut, cybercore_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('bloom_h, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslLutGrade = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'cybercore_lut

    // Spark colorLUTShader decode: nearest blue slice of an 8x8 grid, sampled half a texel
    // inside the cell so bilinear filtering never bleeds into the neighbouring slice.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) / 512.0).xyz;
    }

    void main() {
      gl_FragColor = toOutputFormat(vec4(lutLookup(sampleInput(sourceTextureCoordinate).rgb), 1.0));
    }
    ";

# Spark's green bloom is a 5x5 box blur (5 px steps) of the LUT-graded camera, split into a
# horizontal and a vertical 5-tap pass. Every tap lands on a texel centre of a same-size target, so
# both passes read exactly the texels the 2D box read. bloom_h stores the 5-tap mean, not the sum,
# so it stays in 0..1 when a device falls back to an 8-bit target. Its first input is 'default so it
# works in the camera's colour space like pass0; with lut_grade first, an HDR frame would be
# converted to BT.709 and back in this pass, clipping wide-gamut colours.
string glslBloomH = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D gradeTex;

    uniform float source_size_x;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      float stx = 5.0 / max(source_size_x, 1.0);
      vec3 acc = texture2D(gradeTex, uv - vec2(2.0 * stx, 0.0)).rgb
          + texture2D(gradeTex, uv - vec2(stx, 0.0)).rgb + texture2D(gradeTex, uv).rgb
          + texture2D(gradeTex, uv + vec2(stx, 0.0)).rgb
          + texture2D(gradeTex, uv + vec2(2.0 * stx, 0.0)).rgb;
      gl_FragColor = toOutputFormat(vec4(acc * 0.2, 1.0));
    }
    ";

string glslCybercore = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D bloomHTex;

    uniform float lut_strength;
    uniform float source_size_y;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Vertical half of the bloom, tinted #99F8C7 and added over the camera at 0.4163.
      float sty = 5.0 / max(source_size_y, 1.0);
      vec3 acc = texture2D(bloomHTex, uv - vec2(0.0, 2.0 * sty)).rgb
          + texture2D(bloomHTex, uv - vec2(0.0, sty)).rgb + texture2D(bloomHTex, uv).rgb
          + texture2D(bloomHTex, uv + vec2(0.0, sty)).rgb
          + texture2D(bloomHTex, uv + vec2(0.0, 2.0 * sty)).rgb;
      vec3 bloom = 0.4163 * vec3(0.600, 0.973, 0.780) * (acc * 0.2);
      vec3 result = clamp(src + strength * lut_strength * bloom, 0.0, 1.0);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
