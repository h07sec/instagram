[Filter McDonaldsV2]
# "mcdonald's v2" ported from the Spark effect (1138895629932705). Single fragment pass, no face tracking.
#
#   Spark: one full-screen image ("JassonPowell", material "Filter", alpha blend, opaque) whose diffuse texture is
#   a FastColorLUT lookup of the camera into the 512x512 8x8 atlas "mcdonalds" (clamp 0.0078125..0.98438, blue
#   slice floor-quantised, no slice interpolation, no intensity). The material is lit (lightingEnabled) by the
#   scene's ambient 0.2 + directional 0.8 (rotX -pi/4, rotY 5 deg) on a +Z quad, so its RGB is scaled by
#   K = 0.2 + 0.8 * cos(-pi/4) * cos(5 deg) = 0.76353283. A second full-screen image (white, unlit, multiply,
#   opacity 0.15) is premultiplied before the multiply blend, giving 0.15*D + 0.85*D = D: identity, so omitted.
#   The packaged "mcdonald" (singular) texture has no live sink and is not shipped. Nothing is faked; the
#   declared "tap_to_play" instruction has no tap patch, so it is dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('mcdonald_s_v2_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'mcdonald_s_v2_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslMcDonaldsV2,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string mcdonald_s_v2_lut_path = "mcdonald_s_v2_lut_path";
string mcdonald_s_v2_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; mcdonald_s_v2_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(mcdonald_s_v2_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != mcdonald_s_v2_lut_filename) {
            mcdonald_s_v2_lut_filename = new_lut;
            loadTexture('mcdonald_s_v2_lut, mcdonald_s_v2_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslMcDonaldsV2 = "
    precision highp float;

    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mcdonald_s_v2_lut (512x512, 8x8 tiles of 64x64, linear)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    // Spark DefaultMaterial Phong on a +Z screen quad: ambient + directional * max(dot(L, N), 0).
    const float kLight = 0.76353283;

    // Spark FastColorLUT decode, constants as serialized (the lower clamp is half a LUT texel).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0078125, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row)).rgb;
    }

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 effect = kLight * lutLookup(cam.rgb);
      vec3 result = mix(cam.rgb, effect, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
