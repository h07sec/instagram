[Filter TannedVintage]
# "tanned_vintage" ported from the Spark effect (2595309367287982). Single fragment pass, no face tracking. SCRATCH (batch 12, stack E).
#
#   Spark: one full-frame canvas rect `lut` (alpha blend, opacity 1) over the camera whose shader is a
#   FastColorLUT-style patch: camera clamped to 0.04..0.96, looked up in the 512x512 8x8 atlas
#   Kaju (cf81c309...png) (no half-texel inset), the LUT colour used directly.
#   The material is unlit.
#   Dropped (face tracked, BATCH-DROP): face reshape blendShape 0.15 (face lut, a same-LUT face re-render), nose and alpha-eyes same-LUT re-renders, concealer 0.25 + concealer 2 0.03 screen, teeth whitening 0.35, contour face 0.08 + contour nose 0.03 multiply, skin smoothing retouch 0.15 fullScreen. The rect graph also holds an RGB->HSV->RGB round trip (hue+0 mod 1, sat*1, val*1) and a desaturate mix with factor false: both are identity, not emitted.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('tanned_vintage_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'tanned_vintage_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslTannedVintage,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string tanned_vintage_lut_path = "tanned_vintage_lut_path";
string tanned_vintage_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; tanned_vintage_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(tanned_vintage_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != tanned_vintage_lut_filename) {
            tanned_vintage_lut_filename = new_lut;
            loadTexture('tanned_vintage_lut, tanned_vintage_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslTannedVintage = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'tanned_vintage_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.04..0.96, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.04, 0.96);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = L.rgb;
      // Spark alpha blend of the rect over the camera: src alpha = cam.a.
      float a = clamp(cam.a, 0.0, 1.0);
      vec3 spark = mix(cam.rgb, g, a);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
