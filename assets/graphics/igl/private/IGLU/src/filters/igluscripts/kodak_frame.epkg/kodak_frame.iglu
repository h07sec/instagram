[Filter KodakFrame]
# "Kodak frame ✧" — two scrolling Kodak Portra 400 film strips over the camera.
# Ported from the Spark effect "kodak film aesthetic" (tracker "Kodak frame ✧",
# 285122257716867). Single fragment pass, bottom -> top:
#
#   Layer 1 — Camera background (Spark draws the camera feed behind the scene);
#             `background_dim` fades it toward black.
#   Layer 2 — Left strip: large (72% of the canvas), black & white. Each film cell
#             is a miniature of the whole camera image through the LUT at 55%,
#             then fully desaturated (Spark Adjust Colors, saturation -1).
#   Layer 3 — Right strip: smaller (48%), colour (same 55% LUT, no desaturation).
#   Layer 4 — Kodak border per cell (kodak_frame_border.png). Spark desaturates it
#             and adds contrast +0.5; that is baked into the PNG.
#
# Both strips scroll down continuously (Spark: 2 cells per 13 s loop). Strip
# sizes and centres come from the Spark scene transforms. Dropped from the Spark
# project: an unused second LUT ("oldfish"), an unused RGB-shift patch, and the
# hidden centre strip / light-leak layers.
#
# Time source: the host's time_sec parameter. GLSL only — Metal is generated by shaderc.

[Init]
fun init(Filter filter)
{
    makeTexture('kodak_frame_lut);
    makeTexture('kodak_frame_border);

    filter.parameters = {
        {lut_strength = 0.550, min = 0.0, max = 1.0, description = "LUT mix inside the film cells (Spark AdvancedLUT intensity 0.55)"},
        {scroll_speed = 0.154, min = 0.0, max = 2.0, description = "Strip scroll speed in film cells per second (Spark: 2 cells per 13 s loop)"},
        {background_dim = 0.000, min = 0.0, max = 1.0, description = "Darken the camera background behind the strips (1 = black)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'kodak_frame_lut, 'kodak_frame_border},
      uniforms = {
        lut_strength = 0.550,
        scroll_speed = 0.154,
        background_dim = 0.000,
        time = 0.0,
      },
      glslShader = glslKodakFrame,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string kodak_frame_lut_path = "kodak_frame_lut_path";
string kodak_frame_lut_filename = "";
string kodak_frame_border_path = "kodak_frame_border_path";
string kodak_frame_border_filename = "";

[PreRender]
fun preRender(Filter filter){
    # iOS passes the remote LUT under the generic 'lut_path; kodak_frame_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(kodak_frame_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != kodak_frame_lut_filename) {
            kodak_frame_lut_filename = new_lut;
            loadTexture('kodak_frame_lut, kodak_frame_lut_filename);
        }
    }
    string border_param = getParameterString(kodak_frame_border_path);
    if (border_param != "") {
        string new_border = stringAppend("textureFilePath://", border_param);
        if (new_border != kodak_frame_border_filename) {
            kodak_frame_border_filename = new_border;
            loadTexture('kodak_frame_border, kodak_frame_border_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 ss = getParameterFloat('scroll_speed);
    setShaderUniform('pass0, 'scroll_speed, ss);

    f32 bd = getParameterFloat('background_dim);
    setShaderUniform('pass0, 'background_dim, bd);

    # Time drives the strip scroll.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslKodakFrame = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'kodak_frame_lut
    uniform sampler2D auxSampler2;  // 'kodak_frame_border

    uniform float lut_strength;
    uniform float scroll_speed;
    uniform float background_dim;
    uniform float time;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode; works on Spark's 1024 atlas).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One film strip: cells are scaled copies of the canvas (`size` of it), centred
    // at `center`, stacked vertically and scrolled by `scroll` cells. Returns the
    // strip colour in .rgb and its coverage in .a (0 outside the strip).
    vec4 filmStrip(vec2 uv, vec2 center, float size, float scroll, float mono) {
      vec2 local = (uv - center) / size + 0.5;
      if (local.x < 0.0 || local.x > 1.0) {
        return vec4(0.0);
      }
      vec2 cell = vec2(local.x, fract(local.y - scroll));
      vec3 cam = sampleInput(topUv(cell)).rgb;
      vec3 graded = mix(cam, lutLookup(cam), lut_strength);
      if (mono > 0.0) {
        float luma = dot(graded, vec3(0.2126, 0.7152, 0.0722));
        graded = mix(graded, vec3(luma), mono);
      }
      vec4 border = texture2D(auxSampler2, cell);
      return vec4(mix(graded, border.rgb, border.a), 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 result = cam.rgb * (1.0 - background_dim);

      float scroll = time * scroll_speed;
      vec2 tuv = topUv(uv);
      vec4 right = filmStrip(tuv, vec2(0.862, 0.5), 0.48, scroll, 0.0);
      result = mix(result, right.rgb, right.a);
      vec4 left = filmStrip(tuv, vec2(0.270, 0.343), 0.72, scroll, 1.0);
      result = mix(result, left.rgb, left.a);

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
