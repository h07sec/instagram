[Filter BrightLavender]
# "밝은 Lavender" ported from the Spark effect (486015456573546). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.3.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 0.8.
#   Dreamy blur: 25-tap horizontal gaussian of the graded image (3.5 px steps at 720 px wide),
#   drawn at 0.6 over the ungraded camera (Spark BlurDirectional25 on a 0.6-opacity canvas).
#   Spark grades a contrast-1.1 copy of the camera (pivot 0.62), then screens a 25-tap triangular horizontal blur of it, graded at 0.6, over the grade at 0.6: soft horizontal light glow.
#   Dropped: lip, blush and retouch layers on the face mesh (face tracking).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('bright_lavender_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.8, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.3, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {blur_opacity = 0.6, min = 0.0, max = 1.0, description = "Opacity of the horizontally blurred grade over the camera"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'bright_lavender_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.8,
        smooth_strength = 0.3,
        blur_opacity = 0.6,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslBrightLavender,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string bright_lavender_lut_path = "bright_lavender_lut_path";
string bright_lavender_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; bright_lavender_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(bright_lavender_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != bright_lavender_lut_filename) {
            bright_lavender_lut_filename = new_lut;
            loadTexture('bright_lavender_lut, bright_lavender_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'blur_opacity, getParameterFloat('blur_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslBrightLavender = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'bright_lavender_lut

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float blur_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    const int kBlurTaps = 25;
    const float kBlurStep = 0.0048828;  // Spark: 5/1024 UV per tap

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Spark grades a contrast-1.1 copy of the camera (pivot 0.62) at 0.8 ...
      vec3 sc = clamp((src - vec3(0.62)) * 1.1 + vec3(0.62), 0.0, 1.0);
      vec3 graded = mix(sc, lutLookup(sc), lut_strength);
      // ... then a 25-tap triangular horizontal blur of the same contrast copy, graded at 0.6, is
      // screened over it: soft horizontal light streaks. Each tap also averages a little vertically
      // (+-1.5 steps), which softens the streaks into a glow.
      vec3 accB = vec3(0.0);
      float wsum = 0.0;
      float vy = kBlurStep * 1.5 * source_size_x / max(source_size_y, 1.0);
      for (int i = 0; i < kBlurTaps; i++) {
        float o = float(i) - float(kBlurTaps - 1) * 0.5;
        float w = 13.0 - abs(o);
        vec2 tp = uv + vec2(o * kBlurStep, 0.0);
        vec3 s = 0.5 * sampleInput(tp).rgb
            + 0.25 * (sampleInput(tp + vec2(0.0, vy)).rgb + sampleInput(tp - vec2(0.0, vy)).rgb);
        accB += clamp((s - vec3(0.62)) * 1.1 + vec3(0.62), 0.0, 1.0) * w;
        wsum += w;
      }
      vec3 bavg = accB / wsum;
      vec3 blurred = mix(bavg, lutLookup(bavg), 0.6);
      // Screen-blended, not alpha: Spark's output keeps full detail with the streaks only as glow.
      vec3 result = mix(graded, 1.0 - (1.0 - graded) * (1.0 - blurred), blur_opacity);
      // Whiter whites: the brightest tones ease toward white so highlights read white, not violet.
      float hl = smoothstep(0.6, 1.0, dot(result, vec3(0.299, 0.587, 0.114)));
      result = mix(result, vec3(1.0), 0.5 * hl);
      result = mix(src, result, strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
