[Filter F1]
# "F1" ported from the Spark effect (485166113657471). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#   Glitch: Spark's GLITCH block (0.5 s gate at 20% chance, about 0.15 s bursts of 4 shifted bands
#   and an R vs GB split, re-randomised every 0.09 s), applied to the camera before the grade.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.3.
#   Grade: Spark's two Professional LUTs (dark 0.9, then pop 0.9) baked into one 8x8 LUT, at 1.
#   Vignette: black, 1 * smoothstep(0.6, 1.3, r) at 0.2 (replaces the Spark vignette PNG).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('f1_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.3, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {vignette_opacity = 0.2, min = 0.0, max = 1.0, description = "Black vignette opacity"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'f1_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.3,
        vignette_opacity = 0.2,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslF1,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string f1_lut_path = "f1_lut_path";
string f1_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; f1_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(f1_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != f1_lut_filename) {
            f1_lut_filename = new_lut;
            loadTexture('f1_lut, f1_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'vignette_opacity, getParameterFloat('vignette_opacity));
    # Time drives the glitch bursts.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslF1 = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'f1_lut

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float vignette_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kVigE0 = 0.6;
    const float kVigE1 = 1.3;
    const float kVigMax = 1.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      // Spark Professional LUT block clamp.
      vec3 c = clamp(inRgb, 0.00781, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Sin-free hashes (Hugo Elias / Hoskins style), identical on GL and Metal.
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }

    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Spark GLITCH block: each 0.5 s window fires with 20% chance; a burst lasts about 0.15 s and
      // re-randomises its RGB split and 4 slice offsets every 0.09 s. Glitched before the grade,
      // as in Spark.
      float gw = mod(floor(time / 0.5), 4096.0);  // bounded seed
      float gOn = step(hash21(vec2(gw, 17.0)), 0.2) * step(mod(time, 0.5), 0.15) * strength;
      if (gOn > 0.0) {
        float ty = topUv(uv).y;
        float gs = mod(floor(time / 0.09), 4096.0);  // bounded seed
        float dx = 0.0;
        for (int i = 0; i < 4; i++) {
          float fi = float(i);
          float y0 = hash11(gs * 7.0 + fi * 1.31);
          float h = 0.03 + 0.12 * hash11(gs * 7.0 + fi * 2.71);
          dx += (ty > y0 && ty < y0 + h) ? (hash11(gs * 7.0 + fi * 4.13) * 2.0 - 1.0) * 0.05 : 0.0;
        }
        float split = 0.045 * (0.5 + 0.5 * hash11(gs + 9.1));
        vec2 base = uv + vec2(dx, 0.0);
        vec3 gsrc = vec3(sampleInput(base + vec2(split, 0.0)).r, sampleInput(base - vec2(split, 0.0)).gb);
        src = mix(src, gsrc, gOn);
      }

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp))) * (1.0 - gOn);
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Procedural black vignette on the normalised elliptical radius (1.0 at the edge midpoints).
      float vr = length((uv - 0.5) * 2.0);
      result = mix(result, vec3(0.0), strength * vignette_opacity * kVigMax * smoothstep(kVigE0, kVigE1, vr));

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
