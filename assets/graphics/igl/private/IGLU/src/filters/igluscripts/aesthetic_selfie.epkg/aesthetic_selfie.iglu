[Filter AestheticSelfie]
# "Aesthetic Selfie ✦" ported from the Spark effect (284012920978319). Three passes.
#
#   Spark: three copies of the graded camera rotated +-90 degrees at 0.7 scale over a 1.5x graded camera,
#   then five person cut-outs (camera x person segmentation) with white sticker outlines at fixed scales,
#   angles and offsets, then a 0.055 full-frame subtract (slight darken). Grade: FastColorLUT('BISKUIT').
#   Here the transforms are Spark's (canvas points on its 390x844 canvas, scaled to the frame).
#
#   Segmentation: the person mask is the host-bound 'mask named input, as for the cutout_* effects (the
#   manifest's iglu.subject block asks the host for it). Hosts that bind no mask (IG camera today) get a
#   soft head-and-shoulders silhouette instead, so the collage still reads as stickers.
#   'maskSrc picks the host mask or the silhouette, 'maskDilated grows it for the outline, 'pass0 composites.
#
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('aesthetic_selfie_lut);
    makeTexture('mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {outline_px = 9.0, min = 0.0, max = 20.0, description = "White sticker outline width in px at 1080 wide"},
        {darken = 0.055, min = 0.0, max = 0.3, description = "Full-frame darken (Spark subtract layer at 0.055)"}
    };

    filter.passes = {{
      name = 'maskSrc,
      inputs = {'default, 'mask},
      scale = 0.5,
      uniforms = {
        has_mask = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslMaskSrc,
    }, {
      name = 'maskDilated,
      inputs = {'maskSrc},
      scale = 0.5,
      uniforms = {
        outline_px = 9.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslMaskDilate,
    }, {
      name = 'pass0,
      inputs = {'default, 'aesthetic_selfie_lut, 'maskSrc, 'maskDilated},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        darken = 0.055,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslAestheticSelfie,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string aesthetic_selfie_lut_path = "aesthetic_selfie_lut_path";
string aesthetic_selfie_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; aesthetic_selfie_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(aesthetic_selfie_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != aesthetic_selfie_lut_filename) {
            aesthetic_selfie_lut_filename = new_lut;
            loadTexture('aesthetic_selfie_lut, aesthetic_selfie_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'darken, getParameterFloat('darken));
    setShaderUniform('maskDilated, 'outline_px, getParameterFloat('outline_px));

    # A host-bound mask is at least a few px; an unbound slot reports (0, 0) or a 1x1 placeholder.
    vec2 maskSize = getTextureSize('mask);
    f32 hasMask = 0.0;
    if (maskSize.x > 4.0) {
        hasMask = 1.0;
    }
    setShaderUniform('maskSrc, 'has_mask, hasMask);

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('maskSrc, 'source_size_x, srcSize.x);
        setShaderUniform('maskSrc, 'source_size_y, srcSize.y);
        setShaderUniform('maskDilated, 'source_size_x, srcSize.x);
        setShaderUniform('maskDilated, 'source_size_y, srcSize.y);
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shaders ####

string glslMaskSrc = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mask (host person segmentation)
    uniform float has_mask;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      float cover;
      if (has_mask > 0.5) {
        // Same convention as the cutout_* effects: coverage is the brightest channel.
        vec4 m = texture2D(auxSampler1, uv);
        cover = max(m.r, max(m.g, m.b));
      } else {
        // No host segmentation: a soft head-and-shoulders silhouette in selfie framing.
        vec2 p = topUv(uv);
        float aspect = source_size_x / max(source_size_y, 1.0);
        vec2 head = (p - vec2(0.5, 0.40)) * vec2(aspect, 1.0) / vec2(0.26, 0.22);
        vec2 body = (p - vec2(0.5, 1.02)) * vec2(aspect, 1.0) / vec2(0.46, 0.36);
        float neck = (1.0 - smoothstep(0.08, 0.1, abs(p.x - 0.5) * aspect)) * step(0.5, p.y) * step(p.y, 0.75);
        cover = max(max(1.0 - smoothstep(0.92, 1.0, length(head)), 1.0 - smoothstep(0.92, 1.0, length(body))), neck);
      }
      gl_FragColor = toOutputFormat(vec4(vec3(cover), 1.0));
    }
    ";

string glslMaskDilate = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float outline_px;
    uniform float source_size_x;
    uniform float source_size_y;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // Outline width scales with the frame (outline_px at 1080 wide).
      vec2 r = vec2(1.0, source_size_x / max(source_size_y, 1.0)) * (outline_px / 1080.0);
      float m = sampleInput(uv).r;
      for (float i = 0.0; i < 16.0; i += 1.0) {
        float a = i * 0.3927;
        m = max(m, sampleInput(uv + vec2(cos(a), sin(a)) * r).r);
        m = max(m, sampleInput(uv + vec2(cos(a), sin(a)) * r * 0.5).r);
      }
      gl_FragColor = toOutputFormat(vec4(vec3(m), 1.0));
    }
    ";

string glslAestheticSelfie = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'aesthetic_selfie_lut
    uniform sampler2D auxSampler2;  // 'maskSrc (person coverage)
    uniform sampler2D auxSampler3;  // 'maskDilated (outline coverage)
    uniform float lut_strength;
    uniform float darken;
    uniform float source_size_x;
    uniform float source_size_y;

    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      vec3 g = texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
      return mix(inRgb, g, lut_strength);
    }

    // Top-origin uv inside a full-frame rectangle that Spark scaled by s, rotated by rot (radians,
    // counter-clockwise) and moved by (tx, ty) canvas points on its 390x844 canvas (y up).
    vec2 rectUv(vec2 p, float s, float rot, float tx, float ty) {
      vec2 px = vec2((p.x - 0.5) * source_size_x, (0.5 - p.y) * source_size_y);
      px -= vec2(tx / 390.0 * source_size_x, ty / 844.0 * source_size_y);
      float c = cos(rot);
      float sn = sin(rot);
      px = vec2(c * px.x + sn * px.y, -sn * px.x + c * px.y) / s;
      return vec2(px.x / source_size_x + 0.5, 0.5 - px.y / source_size_y);
    }

    float inside(vec2 q) {
      return step(0.0, q.x) * step(q.x, 1.0) * step(0.0, q.y) * step(q.y, 1.0);
    }

    // One sticker: white outline, then the person on top. Spark's segmentation texture arrives rotated
    // 180 degrees relative to the camera, so its sticker angles are offset by pi here.
    vec3 sticker(vec3 under, vec2 p, float s, float rot, float tx, float ty) {
      vec2 q = rectUv(p, s, rot + 3.14159, tx, ty);
      float ins = inside(q);
      vec2 tq = topUv(q);
      float outline = smoothstep(0.3, 0.6, texture2D(auxSampler3, tq).r) * ins;
      float person = smoothstep(0.35, 0.65, texture2D(auxSampler2, tq).r) * ins;
      vec3 col = mix(under, vec3(1.0), outline);
      return mix(col, lutLookup(sampleInput(tq).rgb), person);
    }

    // A full graded copy of the camera in a transformed rectangle (background bands).
    vec3 band(vec3 under, vec2 p, float s, float rot, float tx, float ty) {
      vec2 q = rectUv(p, s, rot, tx, ty);
      return mix(under, lutLookup(sampleInput(topUv(q)).rgb), inside(q));
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec2 p = topUv(uv);

      // Background: the camera at 1.5x, then three +-90 degree bands at 0.7 (Spark 'BG', '1', '2', '3').
      vec3 col = lutLookup(sampleInput(topUv(rectUv(p, 1.5, 0.0, 0.0, 0.0))).rgb);
      col = band(col, p, 0.7, -1.5708, 0.0, -220.0);
      col = band(col, p, 0.7, 1.5708, 0.0, 0.0);
      col = band(col, p, 0.7, -1.5708, 0.0, 220.0);

      // Five stickers, back to front (Spark 'bg seg', 'bg seg1', 'bg seg0', 'bg seg2', 'bg seg3').
      col = sticker(col, p, 0.4, -0.6438, -92.0, 238.0);
      col = sticker(col, p, 0.6, 0.3851, 93.0, 211.67);
      col = sticker(col, p, 0.7, -1.1152, -75.14, -4.07);
      col = sticker(col, p, 0.5, 2.2470, 86.5, -222.0);
      col = sticker(col, p, 0.4, -2.1958, -128.5, -257.5);

      col = max(col - vec3(darken), vec3(0.0));
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(graded, 0.0, 1.0), cam.a));
    }
    ";
