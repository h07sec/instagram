[Filter ColorHighlighter]
# "Color Highlighter" ported from the Spark effect (457629568574286). Six fragment passes, no assets. SCRATCH (batch 12, stack E).
#
#   Spark chain (main.json renderPasses; shaders box_shader.sca, blur_shader.sca, colorize_shader.sca, ported line by line):
#     mean2    1/2  box_shader: 4 bilinear taps at +-1 input texel, averaged.
#     mean4    1/4  box_shader on mean2.
#     blurh    1/8  blur_shader blur5, direction (1, 0), offset 1.333333 input texels, weights 0.2941176 / 0.3529412.
#     blurv    1/8  blur_shader blur5, direction (0, 1).
#     csample  32x32 ColorSamplerPass: mix(blurv sampled at samplePos, Delay Frame (its own previous output), freeze).
#                   Delay Frame = makeHistoricalTexture('prev_csample, 'csample).
#     output   1/1  colorize_shader(camera, csample, u_Enabled, u_Threshold), then the strength mix.
#   Timeline (script.js displayNUX, no taps): u_Enabled = easeInOutSine 0 -> 1 over 1.5..2.0 s and 1 -> 0 over 7.5..8.0 s;
#   picks at 1.5 / 3.5 / 5.5 s at (0.17, 0.2), (0.75, 0.4), (0.3, 0.8) (top-origin); freeze = (t - pick) > 0.05 s.
#   loop = 0 (Spark): one 8 s cycle, then the plain camera. loop = 1 repeats the cycle every 8 s.
#   Hold: csample also writes a pick tag into its lower half; while frozen it keeps its previous colour only when the
#   previous frame carries the same tag, otherwise (first frame, seek, new cycle) it re-samples the current frame.
#   Dropped (BATCH-DROP): face-count threshold switch (0.16 with a face); fixed no-face threshold 0.10.
#   Not ported: the colorPlane picker ring (hidden while capturing), taps and pans.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {loop = 0.0, min = 0.0, max = 1.0, description = "0 = one 8 s highlight cycle then the plain camera (Spark); 1 = repeat the cycle every 8 s"}
    };

    makeHistoricalTexture('prev_csample, 'csample);

    filter.passes = {{
      name = 'mean2,
      inputs = {'default},
      scale = {0.5, 0.5},
      uniforms = { texel = {0.001, 0.001}, },
      glslShader = glslBox,
    }, {
      name = 'mean4,
      inputs = {'mean2},
      scale = {0.25, 0.25},
      uniforms = { texel = {0.001, 0.001}, },
      glslShader = glslBox,
    }, {
      name = 'blurh,
      inputs = {'mean4},
      scale = {0.125, 0.125},
      uniforms = { texel = {0.001, 0.001}, dir = {1.0, 0.0}, },
      glslShader = glslBlur5,
    }, {
      name = 'blurv,
      inputs = {'blurh},
      scale = {0.125, 0.125},
      uniforms = { texel = {0.001, 0.001}, dir = {0.0, 1.0}, },
      glslShader = glslBlur5,
    }, {
      name = 'csample,
      inputs = {'blurv, 'prev_csample},
      uniforms = { pos_x = 0.0, pos_y = 0.0, follow = 1.0, tag = 0.0, },
      glslShader = glslColorSampler,
    }, {
      name = 'output,
      inputs = {'default, 'csample},
      uniforms = { strength = 1.0, enabled = 0.0, },
      glslShader = glslColorize,
    }};

    vec2 sampleSize = {32.0, 32.0};
    setTextureSize('csample, sampleSize);
}

fun easeInOutSine(f32 x) f32 {
  return 0.5 - 0.5 * cos(3.14159265 * x);
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('output, 'strength, getParameterFloat('strength));

    vec2 sampleSize = {32.0, 32.0};
    setTextureSize('csample, sampleSize);

    # Guarded because getTextureSize() can return (0, 0) before bind. Pass sizes = floor(source * scale).
    vec2 src = getTextureSize('default);
    if (src.x > 0.0 and src.y > 0.0) {
        vec2 t1 = {1.0 / src.x, 1.0 / src.y};
        vec2 t2 = {1.0 / max(1.0, floor(src.x * 0.5)), 1.0 / max(1.0, floor(src.y * 0.5))};
        vec2 t4 = {1.0 / max(1.0, floor(src.x * 0.25)), 1.0 / max(1.0, floor(src.y * 0.25))};
        vec2 t8 = {1.0 / max(1.0, floor(src.x * 0.125)), 1.0 / max(1.0, floor(src.y * 0.125))};
        setShaderUniform('mean2, 'texel, t1);
        setShaderUniform('mean4, 'texel, t2);
        setShaderUniform('blurh, 'texel, t4);
        setShaderUniform('blurv, 'texel, t8);
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    f32 cycle = 0.0;
    f32 tc = t;
    if (getParameterFloat('loop) > 0.5) {
        cycle = floor(t / 8.0);
        tc = t - 8.0 * cycle;
    }

    f32 enabled = 0.0;
    if (tc >= 1.5 and tc < 2.0) {
        enabled = easeInOutSine((tc - 1.5) / 0.5);
    } else if (tc >= 2.0 and tc < 7.5) {
        enabled = 1.0;
    } else if (tc >= 7.5 and tc < 8.0) {
        enabled = easeInOutSine(1.0 - (tc - 7.5) / 0.5);
    }
    setShaderUniform('output, 'enabled, enabled);

    # Before the first pick Spark's freeze is false and samplePos is unset (0, 0); u_Enabled is 0 there.
    f32 px = 0.0;
    f32 py = 0.0;
    f32 follow = 1.0;
    f32 tag = 0.0;
    if (tc >= 1.5) {
        f32 k = min(floor((tc - 1.5) / 2.0), 2.0);
        px = 0.17;
        py = 0.2;
        if (k > 0.5) {
            px = 0.75;
            py = 0.4;
        }
        if (k > 1.5) {
            px = 0.3;
            py = 0.8;
        }
        follow = 0.0;
        if (tc - (1.5 + 2.0 * k) <= 0.05) {
            follow = 1.0;
        }
        f32 id = cycle * 3.0 + k;
        tag = id - 250.0 * floor(id / 250.0) + 1.0;
    }
    setShaderUniform('csample, 'pos_x, px);
    setShaderUniform('csample, 'pos_y, py);
    setShaderUniform('csample, 'follow, follow);
    setShaderUniform('csample, 'tag, tag);
}

#### GLSL shaders ####

string glslBox = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform vec2 texel;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 c = sampleInput(uv + vec2(-texel.x, -texel.y));
      c += sampleInput(uv + vec2(texel.x, -texel.y));
      c += sampleInput(uv + vec2(-texel.x, texel.y));
      c += sampleInput(uv + vec2(texel.x, texel.y));
      gl_FragColor = toOutputFormat(0.25 * c);
    }
    ";

string glslBlur5 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform vec2 texel;
    uniform vec2 dir;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 off1 = vec2(1.333333) * dir * texel;
      vec4 c = sampleInput(uv) * 0.2941176;
      c += sampleInput(uv + off1) * 0.3529412;
      c += sampleInput(uv - off1) * 0.3529412;
      gl_FragColor = toOutputFormat(vec4(c.rgb, 1.0));
    }
    ";

string glslColorSampler = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;

    uniform bool hasHistory;
    uniform float pos_x;
    uniform float pos_y;
    uniform float follow;
    uniform float tag;

    void main() {
      // Spark samplePos is top-origin; OpenGL textures are bottom-origin (UP == 1), Metal top-origin (UP == -1).
      vec2 p = vec2(pos_x, pos_y);
      if (UP > 0.0) { p.y = 1.0 - p.y; }
      vec3 live = sampleInput(p).rgb;

      // Upper half (uv.y < 0.5) carries the colour, lower half the pick tag; every texel of a half is equal.
      vec3 prevColor = texture2D(auxSampler1, vec2(0.5, 0.25)).rgb;
      float prevTag = texture2D(auxSampler1, vec2(0.5, 0.75)).r * 255.0;
      bool holdPrev = follow < 0.5 && hasHistory && abs(prevTag - tag) < 0.5;
      vec3 color = holdPrev ? prevColor : live;

      vec3 outRgb = sourceTextureCoordinate.y < 0.5 ? color : vec3(tag / 255.0, 0.0, 0.0);
      gl_FragColor = toOutputFormat(vec4(outRgb, 1.0));
    }
    ";

string glslColorize = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;

    uniform float enabled;

    // Spark std::rgbToHsv (shaderkit ColorSpaces.sparksl): hue / min / max / delta form, eps 0.001.
    vec3 rgbToHsv(vec3 rgb) {
      float cmax = max(rgb.r, max(rgb.g, rgb.b));
      float cmin = min(rgb.r, min(rgb.g, rgb.b));
      float cdelta = cmax - cmin;
      vec3 dc = vec3(rgb.g - rgb.b, rgb.b - rgb.r, rgb.r - rgb.g) / max(cdelta, 0.001);
      float hue = dc.z + 4.0;
      hue = mix(hue, dc.y + 2.0, step(cmax, rgb.g));
      hue = mix(hue, dc.x, step(cmax, rgb.r));
      hue = mod(hue / 6.0, 1.0);
      return vec3(hue, cdelta / max(cmax, 0.001), cmax);
    }

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      vec3 base = cam.rgb;
      vec3 highlight = texture2D(auxSampler1, vec2(0.5, 0.25)).rgb;

      vec3 dist = abs(rgbToHsv(base) - rgbToHsv(highlight));
      dist.x = dist.x > 0.5 ? (1.0 - dist.x) : dist.x;
      float d = dot(vec3(0.8, 0.25, 0.25), dist);
      // u_Threshold: no-face 0.1 (Spark uses 0.16 while a face is tracked).
      float amt = smoothstep(0.1 - 0.04, 0.1 + 0.04, d);
      amt = mix(-0.15, 1.0, amt);
      vec3 desat = mix(base, vec3(dot(vec3(0.3, 0.59, 0.11), base)), amt);
      vec3 color = mix(base, desat, enabled);

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL; clamp after the mix (Spark 8-bit target).
      vec3 outRgb = clamp(mix(base, color, strength), 0.0, 1.0);
      gl_FragColor = toOutputFormat(vec4(outRgb, mix(cam.a, 1.0, strength)));
    }
    ";
