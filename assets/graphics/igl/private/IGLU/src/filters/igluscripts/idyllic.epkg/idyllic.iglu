[Filter Idyllic]
# "Idyllic ⟡♡" ported from the Spark effect (539608694397378). Two fragment passes,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   'graded: the camera through the LUT, once per pixel.
#   'output: skin smoothing and the blur, reading the blur taps from 'graded.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.5.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Dreamy blur: 25-tap horizontal gaussian of the graded image (2 px steps at 720 px wide),
#   drawn at 0.65 over the ungraded camera (Spark BlurDirectional25 on a 0.65-opacity canvas).
#   Dropped: faint face-mesh blush/lip texture.
#   Blur opacity 0.65 (Spark 0.767), per Richard's review.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('idyllic_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {blur_opacity = 0.65, min = 0.0, max = 1.0, description = "Opacity of the horizontally blurred grade over the camera"}
    };

    filter.passes = {
      {
        name = 'graded,
        inputs = {'default, 'idyllic_lut},
        glslShader = glslGrade,
      },
      {
        name = 'output,
        inputs = {'default, 'graded},
        uniforms = {
          strength = 1.0,
          lut_strength = 1.0,
          smooth_strength = 0.5,
          blur_opacity = 0.65,
          source_size_x = 1024.0,
          source_size_y = 1024.0,
        },
        glslShader = glslIdyllic,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string idyllic_lut_path = "idyllic_lut_path";
string idyllic_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('output, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; idyllic_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(idyllic_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != idyllic_lut_filename) {
            idyllic_lut_filename = new_lut;
            loadTexture('idyllic_lut, idyllic_lut_filename);
        }
    }

    setShaderUniform('output, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('output, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('output, 'blur_opacity, getParameterFloat('blur_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('output, 'source_size_x, srcSize.x);
        setShaderUniform('output, 'source_size_y, srcSize.y);
    }
}

#### GLSL shaders ####

string glslGrade = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'idyllic_lut

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      gl_FragColor = vec4(lutLookup(cam.rgb), cam.a);
    }
    ";

string glslIdyllic = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'graded (the camera through the LUT)

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float blur_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kBlurStep = 0.002778;  // 2 px at Spark's 720 px reference width

    vec3 graded(vec2 uv) {
      return texture2D(auxSampler1, uv).rgb;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Two symmetric blur taps (offset k * kBlurStep left and right), graded, with weight w.
    vec3 blurPair(vec2 uv, float k, float w) {
      vec2 o = vec2(k * kBlurStep, 0.0);
      return (graded(uv + o) + graded(uv - o)) * w;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // Horizontal 25-tap gaussian (sigma 6.25 taps) of the graded image, drawn over the ungraded camera.
      // Weights are the normalized gaussian, precomputed; each tap is graded before averaging, as in Spark.
      vec3 acc = graded(uv) * 0.0668574;
      acc += blurPair(uv, 1.0, 0.0660071);
      acc += blurPair(uv, 2.0, 0.0635205);
      acc += blurPair(uv, 3.0, 0.0595825);
      acc += blurPair(uv, 4.0, 0.0544761);
      acc += blurPair(uv, 5.0, 0.0485484);
      acc += blurPair(uv, 6.0, 0.0421722);
      acc += blurPair(uv, 7.0, 0.0357075);
      acc += blurPair(uv, 8.0, 0.0294697);
      acc += blurPair(uv, 9.0, 0.0237068);
      acc += blurPair(uv, 10.0, 0.0185889);
      acc += blurPair(uv, 11.0, 0.0142074);
      acc += blurPair(uv, 12.0, 0.0105842);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 blurred = mix(src, acc, strength * lut_strength);
      vec3 result = mix(cam.rgb, blurred, blur_opacity);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
