[Filter KodakFilm]
# "Kodak 🎞" ported from the Spark effect (166743358730623). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Grain: static, pixel-locked hash noise (mean 0.016, spread 0.173), add-blended at 1
#   (replaces the Spark grain texture).
#   Grain animation: re-seeded at 30 fps, looping every 64 frames like Spark's grain sequence
#   (bounded seed keeps the hash in full f32 precision however long the clip runs).
#   Overlay: 'kodak_film_frame add-blended full-frame at 1.
#   Spark's LUT clamps its input to 0.05..0.96 (a matte black lift and highlight cap). The KODAK PORTRA 400 edge-print frame is added (Spark's default blend).
#   Grain: Spark adds a fresh grain (mean 0.016, sd 0.05) over the whole composite every frame; reproduced procedurally at 30 fps.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('kodak_film_lut);
    makeTexture('kodak_film_frame);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {grain_opacity = 1.0, min = 0.0, max = 1.0, description = "Film grain add-blend opacity"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the frame overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'kodak_film_lut, 'kodak_film_frame},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        grain_opacity = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslKodakFilm,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string kodak_film_lut_path = "kodak_film_lut_path";
string kodak_film_lut_filename = "";
string kodak_film_frame_path = "kodak_film_frame_path";
string kodak_film_frame_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; kodak_film_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(kodak_film_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != kodak_film_lut_filename) {
            kodak_film_lut_filename = new_lut;
            loadTexture('kodak_film_lut, kodak_film_lut_filename);
        }
    }

    string kodak_film_frame_param = getParameterString(kodak_film_frame_path);
    if (kodak_film_frame_param != "") {
        string new_kodak_film_frame = stringAppend("textureFilePath://", kodak_film_frame_param);
        if (new_kodak_film_frame != kodak_film_frame_filename) {
            kodak_film_frame_filename = new_kodak_film_frame;
            loadTexture('kodak_film_frame, kodak_film_frame_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslKodakFilm = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'kodak_film_lut
    uniform sampler2D auxSampler2;  // 'kodak_film_frame

    uniform float lut_strength;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kGrainFps = 30.0;
    const float kGrainFrames = 64.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.05, 0.96);  // Spark's matte black lift and highlight cap
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'kodak_film_frame (add), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('kodak_film_frame).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, min(result + ov.rgb, vec3(1.0)), (overlay_opacity) * strength);
      }
      // Static pixel-locked grain.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y)) + vec2(mod(floor(time * kGrainFps), kGrainFrames) * 17.0);
      float n = fract(sin(dot(px, vec2(12.9898, 78.233))) * 43758.5453);
      float grain = (0.016 + (n - 0.5) * 0.173);
      result = clamp(result + vec3(grain) * grain_opacity * strength, 0.0, 1.0);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
