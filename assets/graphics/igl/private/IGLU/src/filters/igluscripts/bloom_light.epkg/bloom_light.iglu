[Filter BloomLight]
# "Bloom Light" ported from the Spark effect (2664901703522376). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Spark's Bloom template, steady state (its 2 s white-out intro is not ported).
#   Smoothing: full-frame 3x3 guided filter on luma (Spark's retouch composite, eps 0.015).
#   Grade: Spark's per-pixel post grade (screen 0.1, saturation +0.2, brightness x0.7, contrast -0.16,
#   clamp 0.05, VintageFade 32^3 LUT at 0.5) baked into one 8x8 LUT.
#   Bloom: threshold 0.45, gaussian sigma 0.046 of the width (32-tap golden-angle disk), added at 1.
#   Then an overlay blend with #8C8C82 and Spark's pow-4 corner vignette (x0.15 at 0.45).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('bloom_light_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 1.0, min = 0.0, max = 1.0, description = "Full-frame guided-filter smoothing (Spark retouch composite)"},
        {bloom_strength = 1.0, min = 0.0, max = 1.0, description = "Bloom glow around bright areas"},
        {vignette_opacity = 1.0, min = 0.0, max = 1.0, description = "Corner darkening"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'bloom_light_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 1.0,
        bloom_strength = 1.0,
        vignette_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslBloomLight,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string bloom_light_lut_path = "bloom_light_lut_path";
string bloom_light_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; bloom_light_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(bloom_light_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != bloom_light_lut_filename) {
            bloom_light_lut_filename = new_lut;
            loadTexture('bloom_light_lut, bloom_light_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'bloom_strength, getParameterFloat('bloom_strength));
    setShaderUniform('pass0, 'vignette_opacity, getParameterFloat('vignette_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslBloomLight = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'bloom_light_lut

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float bloom_strength;
    uniform float vignette_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    const float kGfStep = 0.0074;       // 8 px at 1080 wide: Spark guided-filter tap spacing, in width units
    const float kGfEps2 = 0.000225;     // eps 0.015 squared
    const float kBloomSigma = 0.046;    // 49.5 px at 1080 wide, in width units
    const float kBloomThresh = 0.45;
    const vec3 kOverlay = vec3(0.549, 0.549, 0.510);

    vec3 bloomTap(vec2 p) {
      vec3 c = sampleInput(p).rgb;
      float y = dot(c, vec3(0.2989, 0.587, 0.114));
      return c * max(0.0, (y - kBloomThresh) / (1.0 - kBloomThresh));
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform; it scales every stage, so 0 is an exact passthrough.
      float aspect = source_size_x / max(source_size_y, 1.0);
      // Width-unit offsets to UV, with y in top-origin image space so GL and Metal sample the same
      // taps in the same order (the bloom spiral is not y-symmetric).
      vec2 wu = vec2(1.0, aspect * (UP > 0.0 ? -1.0 : 1.0));
      // 1. Full-frame guided filter on luma (Spark retouch composite), 3x3 taps.
      vec3 m = vec3(0.0);
      float my = 0.0;
      float myy = 0.0;
      for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
          vec3 s = sampleInput(uv + vec2(float(i), float(j)) * kGfStep * wu).rgb;
          float y = dot(s, vec3(0.2989, 0.587, 0.114));
          m += s;
          my += y;
          myy += y * y;
        }
      }
      m /= 9.0;
      my /= 9.0;
      float gv = max(myy / 9.0 - my * my, 0.0);
      float ga = gv / (gv + kGfEps2);
      vec3 sm = mix(src, ga * src + (1.0 - ga) * m, strength * smooth_strength);
      // 2. Pre-bloom grade (screen, saturation, brightness, contrast, clamp and VintageFade, baked).
      vec3 c = mix(src, lutLookup(sm), strength * lut_strength);
      // 3. Bloom: 32-tap golden-angle disk out to 2.5 sigma, gaussian weights, thresholded raw camera.
      vec3 bl = vec3(0.0);
      float bw = 0.0;
      for (int k = 0; k < 32; k++) {
        float fk = float(k);
        float r = sqrt((fk + 0.5) / 32.0) * 2.5 * kBloomSigma;
        float an = fk * 2.3999632;
        float w = exp(-0.5 * r * r / (kBloomSigma * kBloomSigma));
        bl += w * bloomTap(uv + vec2(cos(an), sin(an)) * r * wu);
        bw += w;
      }
      c += strength * bloom_strength * bl / bw;
      // 4. Overlay with #8C8C82, then the vignette (distance not clamped, as in Spark).
      vec3 ovLo = 2.0 * c * kOverlay;
      vec3 ovHi = 1.0 - 2.0 * (1.0 - c) * (1.0 - kOverlay);
      c = mix(c, mix(ovLo, ovHi, step(0.5, c)), strength);
      vec2 vdir = vec2(1.15, 1.0 / aspect) * (uv - 0.5);
      c = mix(c, c * 0.15, pow(length(vdir), 4.0) * 0.45 * strength * vignette_opacity);
      vec3 result = c;

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
