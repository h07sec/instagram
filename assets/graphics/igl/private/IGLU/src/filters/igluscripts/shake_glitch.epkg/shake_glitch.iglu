[Filter ShakeGlitch]
# "Shake Glitch" ported from the Spark effect (309468581898006). Single fragment pass, one asset (the LUT).
#
#   Grade: Spark's "Orange Blue" 8x8 LUT (FastColorLUT) at 0.6 over the camera.
#   Shake: Spark loops a 1 s timer; for the first 0.3 s of each beat it mixes in (at 0.6) a copy of
#          the graded frame zoomed up to 1.1x by an exponentially smoothed ramp, and the whole result
#          is brightened x1.1. That reads as a rhythmic double-image zoom "shake". Procedural.
#   Skin: soft centre smoothing (fakes Spark's face-tracked guided-filter retouch at 0.5).
#
# Time source: the host's time_sec parameter. GLSL only — Metal is generated by shaderc.

[Init]
fun init(Filter filter)
{
    makeTexture('shake_glitch_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.6, min = 0.0, max = 1.0, description = "LUT mix strength (Spark 0.6)"},
        {shake_amount = 0.1, min = 0.0, max = 0.3, description = "Peak zoom of the shake copy (Spark 0.1 = 1.1x)"},
        {shake_mix = 0.6, min = 0.0, max = 1.0, description = "Share of the zoomed copy during a beat (Spark 0.6)"},
        {smooth_strength = 0.25, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'shake_glitch_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.6,
        shake_amount = 0.1,
        shake_mix = 0.6,
        smooth_strength = 0.25,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslShakeGlitch,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string shake_glitch_lut_path = "shake_glitch_lut_path";
string shake_glitch_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; shake_glitch_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(shake_glitch_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != shake_glitch_lut_filename) {
            shake_glitch_lut_filename = new_lut;
            loadTexture('shake_glitch_lut, shake_glitch_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'shake_amount, getParameterFloat('shake_amount));
    setShaderUniform('pass0, 'shake_mix, getParameterFloat('shake_mix));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # Time drives the beat.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslShakeGlitch = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'shake_glitch_lut

    uniform float lut_strength;
    uniform float shake_amount;
    uniform float shake_mix;
    uniform float smooth_strength;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kBeat = 1.0;     // Spark looped timer, seconds
    const float kPulse = 0.3;    // Spark delay before the toggle flips back, seconds
    const float kEase = 20.0;    // exponential smoothing rate of the zoom ramp (Spark expSmooth, damping 150)
    const float kBrighten = 1.1;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      return acc.rgb / acc.a;
    }

    vec3 graded(vec2 uv) {
      vec3 c = sampleInput(uv).rgb;
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      return mix(c, lutLookup(c), strength * lut_strength);
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);

      vec3 src = cam.rgb;
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      vec3 base = mix(src, lutLookup(src), strength * lut_strength);

      // Beat envelope: ramps up during the 0.3 s pulse and eases back after it. mod() keeps the
      // phase bounded however long the clip runs.
      float phase = mod(time, kBeat);
      float on = step(phase, kPulse);
      float env = on > 0.5 ? 1.0 - exp(-phase * kEase) : (1.0 - exp(-kPulse * kEase)) * exp(-(phase - kPulse) * kEase);
      float zoom = 1.0 + shake_amount * env;
      vec3 zoomed = graded(0.5 + (uv - 0.5) / zoom) * kBrighten;
      // Spark's final mix: the zoomed, brightened copy at 0.6 during the pulse, fully otherwise
      // (where the zoom has eased back to ~1x, so it is just the brightened grade).
      vec3 result = on > 0.5 ? mix(base, zoomed, shake_mix * strength) : mix(base, zoomed, strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
