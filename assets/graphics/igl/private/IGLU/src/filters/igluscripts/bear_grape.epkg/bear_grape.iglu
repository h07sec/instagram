[Filter BearGrape]
# "ʕ•́ᴥ•̀ʔっ♡💜🛐🍇👾" ported from the Spark effect (1292211961282032). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Overlay: 'bear_grape_screen multiply-blended full-frame at 0.4, cover-fitted with a uniform scale
#   (Spark stretches it over a ~9:16 screen, which is nearly uniform) and box-prefiltered per pixel.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('bear_grape_lut);
    makeTexture('bear_grape_screen);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 0.4, min = 0.0, max = 1.0, description = "Opacity of the screen overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'bear_grape_lut, 'bear_grape_screen},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 0.4,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslBearGrape,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string bear_grape_lut_path = "bear_grape_lut_path";
string bear_grape_lut_filename = "";
string bear_grape_screen_path = "bear_grape_screen_path";
string bear_grape_screen_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(bear_grape_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != bear_grape_lut_filename) {
            bear_grape_lut_filename = new_lut;
            loadTexture('bear_grape_lut, bear_grape_lut_filename);
        }
    }

    string bear_grape_screen_param = getParameterString(bear_grape_screen_path);
    if (bear_grape_screen_param != "") {
        string new_bear_grape_screen = stringAppend("textureFilePath://", bear_grape_screen_param);
        if (new_bear_grape_screen != bear_grape_screen_filename) {
            bear_grape_screen_filename = new_bear_grape_screen;
            loadTexture('bear_grape_screen, bear_grape_screen_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Frame size for the uniform cover fit. Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslBearGrape = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'bear_grape_lut
    uniform sampler2D auxSampler2;  // 'bear_grape_screen

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.05, 0.98);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'bear_grape_screen (multiply), authored top-origin. The texture is a 378x744 macro photo of an
      // LCD sub-pixel grid: a non-uniform stretch turns that grid into diagonal interference waves, so cover-fit it with
      // one scale (Spark: stretched over a ~9:16 screen, which is within 10% of uniform), centred.
      {
        vec2 frame = vec2(source_size_x, source_size_y);
        vec2 tex = vec2(378.0, 744.0);
        float k = max(frame.x / tex.x, frame.y / tex.y);
        vec2 suv = 0.5 + (topUv(uv) - 0.5) * frame / (tex * k);
        // Box prefilter over one output pixel (4 bilinear taps), so small outputs do not alias the ~4 texel stripe pitch.
        vec2 fp = 0.25 / (tex * k);
        // auxSampler2 = pass input 3 ('bear_grape_screen).
        vec3 ov = 0.25 * (texture2D(auxSampler2, suv + vec2(-fp.x, -fp.y)).rgb + texture2D(auxSampler2, suv + vec2(fp.x, -fp.y)).rgb
                        + texture2D(auxSampler2, suv + vec2(-fp.x, fp.y)).rgb + texture2D(auxSampler2, suv + vec2(fp.x, fp.y)).rgb);
        result = mix(result, result * ov, overlay_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
