[Filter InstCPolaroid]
# "Inst C Polaroid" ported from the Spark effect (824133093179587). Single fragment pass,
# no face tracking.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.5.
#   Grade: 8x8 LUT (Spark Advanced LUT, clamp floor 0.108 from its 0.1 shadow lift) at 0.9.
#   Soft focus: the same grade of a 5x5 binomial camera blur (5 px steps) at 0.5, drawn over the face
#   layers as in Spark, then the lip tint, then the overlays (Spark order; the overlays are never tinted).
#   Overlay: 'inst_c_polaroid_dust screen-blended full-frame at 0.4.
#   Overlay: 'inst_c_polaroid_frame alpha-blended full-frame at 1.
#   Face approximations without face tracking: a fixed centre ellipse (selfie framing) plus colour
#   gates for lips and skin, so they work in hosts with no face tracker.
#   Lip tint: multiply (0.851, 0.192, 0.192) on lip-coloured pixels in the lower face at 0.14.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('inst_c_polaroid_lut);
    makeTexture('inst_c_polaroid_dust);
    makeTexture('inst_c_polaroid_frame);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.9, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {soft_opacity = 0.5, min = 0.0, max = 1.0, description = "Soft-focus layer opacity (Spark blurred-grade canvas)"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {dust_opacity = 0.4, min = 0.0, max = 1.0, description = "Opacity of the dust overlay"},
        {frame_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the frame overlay"},
        {lip_opacity = 0.14, min = 0.0, max = 1.0, description = "Lip tint (fakes the face-tracked lip layer)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'inst_c_polaroid_lut, 'inst_c_polaroid_dust, 'inst_c_polaroid_frame},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.9,
        smooth_strength = 0.5,
        soft_opacity = 0.5,
        dust_opacity = 0.4,
        frame_opacity = 1.0,
        lip_opacity = 0.14,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslInstCPolaroid,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string inst_c_polaroid_lut_path = "inst_c_polaroid_lut_path";
string inst_c_polaroid_lut_filename = "";
string inst_c_polaroid_dust_path = "inst_c_polaroid_dust_path";
string inst_c_polaroid_dust_filename = "";
string inst_c_polaroid_frame_path = "inst_c_polaroid_frame_path";
string inst_c_polaroid_frame_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; inst_c_polaroid_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(inst_c_polaroid_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != inst_c_polaroid_lut_filename) {
            inst_c_polaroid_lut_filename = new_lut;
            loadTexture('inst_c_polaroid_lut, inst_c_polaroid_lut_filename);
        }
    }

    string inst_c_polaroid_dust_param = getParameterString(inst_c_polaroid_dust_path);
    if (inst_c_polaroid_dust_param != "") {
        string new_inst_c_polaroid_dust = stringAppend("textureFilePath://", inst_c_polaroid_dust_param);
        if (new_inst_c_polaroid_dust != inst_c_polaroid_dust_filename) {
            inst_c_polaroid_dust_filename = new_inst_c_polaroid_dust;
            loadTexture('inst_c_polaroid_dust, inst_c_polaroid_dust_filename);
        }
    }
    string inst_c_polaroid_frame_param = getParameterString(inst_c_polaroid_frame_path);
    if (inst_c_polaroid_frame_param != "") {
        string new_inst_c_polaroid_frame = stringAppend("textureFilePath://", inst_c_polaroid_frame_param);
        if (new_inst_c_polaroid_frame != inst_c_polaroid_frame_filename) {
            inst_c_polaroid_frame_filename = new_inst_c_polaroid_frame;
            loadTexture('inst_c_polaroid_frame, inst_c_polaroid_frame_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'soft_opacity, getParameterFloat('soft_opacity));
    setShaderUniform('pass0, 'dust_opacity, getParameterFloat('dust_opacity));
    setShaderUniform('pass0, 'frame_opacity, getParameterFloat('frame_opacity));
    setShaderUniform('pass0, 'lip_opacity, getParameterFloat('lip_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslInstCPolaroid = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'inst_c_polaroid_lut
    uniform sampler2D auxSampler2;  // 'inst_c_polaroid_dust
    uniform sampler2D auxSampler3;  // 'inst_c_polaroid_frame

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float soft_opacity;
    uniform float dust_opacity;
    uniform float frame_opacity;
    uniform float lip_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    const vec3 kLip = vec3(0.851, 0.192, 0.192);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      // Spark Advanced LUT clamp with its 0.1 shadow lift.
      vec3 c = clamp(inRgb, 0.108, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Position in the assumed face ellipse (selfie framing): 0 at the centre, 1 at the ellipse edge.
    vec2 faceP(vec2 uv) {
      float aspect = source_size_x / max(source_size_y, 1.0);
      return (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
    }

    // Redness relative to brightness: skin sits around 0.06-0.16, lips above about 0.18.
    float redness(vec3 c) {
      return (c.r - c.g) / (c.r + c.g + c.b + 0.001);
    }

    float lipMask(vec2 uv, vec3 c) {
      vec2 fp = faceP(uv);
      float inFace = 1.0 - smoothstep(0.55, 0.85, length(fp * vec2(1.3, 0.75)));
      // Mouth band: below the nose tip (fp.y ~0.3), above the chin (~1.2).
      float mouth = smoothstep(0.45, 0.65, fp.y) * (1.0 - smoothstep(1.05, 1.3, fp.y));
      float lipColour = smoothstep(0.19, 0.27, redness(c)) * smoothstep(0.08, 0.18, c.r - c.b);
      return inFace * mouth * lipColour;
    }

    float skinMask(vec3 c) {
      float r = redness(c);
      float y = dot(c, vec3(0.299, 0.587, 0.114));
      float order = step(c.b, c.g) * step(c.g, c.r);
      return order * smoothstep(0.03, 0.07, r) * (1.0 - smoothstep(0.17, 0.22, r)) * smoothstep(0.15, 0.3, y);
    }

    float cheekMask(vec2 uv) {
      vec2 fp = faceP(uv);
      vec2 d = vec2(abs(fp.x) - 0.5, fp.y - 0.25) / vec2(0.42, 0.34);
      float m = 1.0 - smoothstep(0.0, 1.0, length(d));
      return m * m;
    }

    float binom(float o) {
      float a = abs(o);
      return a < 0.5 ? 6.0 : (a < 1.5 ? 4.0 : 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Spark canvas1 rectangle0: the same grade of a 5x5 binomial camera blur (5 px steps), alpha 0.5.
      {
        // y step in top-origin image space, so GL and Metal sum the taps in the same order.
        vec2 st = vec2(5.0 / max(source_size_x, 1.0), (UP > 0.0 ? -5.0 : 5.0) / max(source_size_y, 1.0));
        vec3 bsum = vec3(0.0);
        for (int j = -2; j <= 2; j++) {
          for (int i = -2; i <= 2; i++) {
            vec2 o = vec2(float(i), float(j));
            bsum += binom(o.x) * binom(o.y) * sampleInput(uv + o * st).rgb;
          }
        }
        vec3 b = bsum / 256.0;
        vec3 soft = mix(b, lutLookup(b), lut_strength);
        result = mix(result, soft, soft_opacity * strength);
      }
      // Lip tint on lip-coloured pixels in the lower face, judged on the ungraded camera.
      result = mix(result, result * kLip, lip_opacity * strength * lipMask(uv, cam.rgb));
      // Full-frame overlay 'inst_c_polaroid_dust (screen), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('inst_c_polaroid_dust).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), (dust_opacity) * strength);
      }
      // Full-frame overlay 'inst_c_polaroid_frame (alpha), authored top-origin.
      {
        // auxSampler3 = pass input 4 ('inst_c_polaroid_frame).
        vec4 ov = texture2D(auxSampler3, topUv(uv));
        result = mix(result, ov.rgb, (frame_opacity * ov.a) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
