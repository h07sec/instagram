[Filter Mango]
# "mango" ported from the Spark effect (333819782488337). Single fragment pass, no face tracking.
#
#   Spark: a two-LUT grade ("lut teste 5" mixed 0.4 towards "cutenoise", both 8x8 FastColorLUT atlases looked
#   up at the same uv, clamp 0.04..0.96), applied at 0.8 over the camera, then a static grain texture
#   subtracted at 0.08 from an oversized canvas rect (109.74% x 105.69%, pinned top-left at -27/-24 pt).
#   Both LUTs ship as-is: "lut teste 5" is 510x512 and Spark samples it in normalised uv, so baking the two into
#   one image would not match. Spark's 0.10 full-frame skin smoothing is faked with a light edge-aware blur;
#   its faint face concealer (0.45), makeup (<= 0.08) and face reprojection are dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('mango_lut_a);
    makeTexture('mango_lut_b);
    makeTexture('mango_grain);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.10, min = 0.0, max = 1.0, description = "Soft full-frame smoothing (fakes the Spark skin retouch)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'mango_lut_a, 'mango_lut_b, 'mango_grain},
      uniforms = {
        strength = 1.0,
        smooth_strength = 0.10,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
        grain_offset_y = 0.026905831,
      },
      glslShader = glslMango,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string mango_lut_a_path = "mango_lut_a_path";
string mango_lut_a_filename = "";
string mango_lut_b_path = "mango_lut_b_path";
string mango_lut_b_filename = "";
string mango_grain_path = "mango_grain_path";
string mango_grain_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; mango_lut_a_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(mango_lut_a_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != mango_lut_a_filename) {
            mango_lut_a_filename = new_lut;
            loadTexture('mango_lut_a, mango_lut_a_filename);
        }
    }
    string lut_b_param = getParameterString(mango_lut_b_path);
    if (lut_b_param != "") {
        string new_lut_b = stringAppend("textureFilePath://", lut_b_param);
        if (new_lut_b != mango_lut_b_filename) {
            mango_lut_b_filename = new_lut_b;
            loadTexture('mango_lut_b, mango_lut_b_filename);
        }
    }
    string grain_param = getParameterString(mango_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != mango_grain_filename) {
            mango_grain_filename = new_grain;
            loadTexture('mango_grain, mango_grain_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
        # Spark's canvas is 390 pt wide and follows the frame's aspect; the grain rect's 24 pt top pin is in
        # those points, so its uv offset depends on the canvas height.
        f32 canvasHeight = 390.0 * srcSize.y / srcSize.x;
        setShaderUniform('pass0, 'grain_offset_y, 24.0 / (1.056872 * canvasHeight));
    }
}

#### GLSL shader ####

string glslMango = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mango_lut_a (lut teste 5, 510x512)
    uniform sampler2D auxSampler2;  // 'mango_lut_b (cutenoise, 512x512)
    uniform sampler2D auxSampler3;  // 'mango_grain (576x1024)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;
    uniform float grain_offset_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat areas soften.
    vec4 smoothTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    vec3 smoothBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += smoothTap(uv + d * vec2(1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, 1.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, -1.0), y0);
      acc += smoothTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = cam.rgb;
      if (smooth_strength > 0.0) {
        s = mix(s, smoothBlur(uv, s), smooth_strength);
      }
      // Spark's LUT patch clamps to 0.04..0.96 (not FastColorLUT's 0.0078125..0.98438).
      vec3 c = clamp(s, 0.04, 0.96);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec2 lutUv = vec2(c.r / 8.0 + col, c.g / 8.0 + row);
      vec3 graded = mix(texture2D(auxSampler1, lutUv).rgb, texture2D(auxSampler2, lutUv).rgb, 0.4);
      vec3 lutLayer = mix(s, graded, 0.8);
      vec2 g = topUv(uv) * vec2(0.911214951, 0.946188375) + vec2(0.063084112, grain_offset_y);
      vec3 spark = max(lutLayer - 0.08 * texture2D(auxSampler3, g).rgb, 0.0);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
