[Filter KodakGrain]
# "ᴋᴏᴅᴀᴋ ɢʀᴀɪɴ" ported from the Spark effect (740687216913775). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Grain: static, pixel-locked hash noise (mean 0.545, spread 0.505), multiply-blended at 0.3
#   (replaces the Spark grain texture).
#   Overlay: 'kodak_grain_leak screen-blended full-frame at 1.
#   Text: Spark 2dText0 date stamp (VCR OSD Mono 14 pt, #EE8A00, rotated -90 deg) baked as 'kodak_grain_date, alpha-blended last.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('kodak_grain_lut);
    makeTexture('kodak_grain_leak);
    makeTexture('kodak_grain_date);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {grain_opacity = 0.3, min = 0.0, max = 0.5, description = "Film grain multiply-blend opacity"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the leak overlay"},
        {text_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the date stamp"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'kodak_grain_lut, 'kodak_grain_leak, 'kodak_grain_date},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        grain_opacity = 0.3,
        overlay_opacity = 1.0,
        text_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslKodakGrain,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string kodak_grain_lut_path = "kodak_grain_lut_path";
string kodak_grain_lut_filename = "";
string kodak_grain_leak_path = "kodak_grain_leak_path";
string kodak_grain_leak_filename = "";
string kodak_grain_date_path = "kodak_grain_date_path";
string kodak_grain_date_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(kodak_grain_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != kodak_grain_lut_filename) {
            kodak_grain_lut_filename = new_lut;
            loadTexture('kodak_grain_lut, kodak_grain_lut_filename);
        }
    }

    string kodak_grain_leak_param = getParameterString(kodak_grain_leak_path);
    if (kodak_grain_leak_param != "") {
        string new_kodak_grain_leak = stringAppend("textureFilePath://", kodak_grain_leak_param);
        if (new_kodak_grain_leak != kodak_grain_leak_filename) {
            kodak_grain_leak_filename = new_kodak_grain_leak;
            loadTexture('kodak_grain_leak, kodak_grain_leak_filename);
        }
    }
    string kodak_grain_date_param = getParameterString(kodak_grain_date_path);
    if (kodak_grain_date_param != "") {
        string new_kodak_grain_date = stringAppend("textureFilePath://", kodak_grain_date_param);
        if (new_kodak_grain_date != kodak_grain_date_filename) {
            kodak_grain_date_filename = new_kodak_grain_date;
            loadTexture('kodak_grain_date, kodak_grain_date_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    setShaderUniform('pass0, 'text_opacity, getParameterFloat('text_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslKodakGrain = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'kodak_grain_lut
    uniform sampler2D auxSampler2;  // 'kodak_grain_leak
    uniform sampler2D auxSampler3;  // 'kodak_grain_date

    uniform float lut_strength;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float text_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Spark RGB Shift layer: LUT(cam) at scales 1.00 / 1.01 / 1.02 about the centre (R/G/B), x1.3 x #D6D6D6, alpha 0.5 over the LUT layer.
      vec3 lr = lutLookup(src);
      vec3 lg = lutLookup(sampleInput(0.5 + (uv - 0.5) * 1.01).rgb);
      vec3 lb = lutLookup(sampleInput(0.5 + (uv - 0.5) * 1.02).rgb);
      vec3 shifted = clamp(1.0907 * vec3(lr.r, lg.g, lb.b), 0.0, 1.0);
      vec3 graded = mix(src, mix(lr, shifted, 0.5), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'kodak_grain_leak (screen), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('kodak_grain_leak).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), (overlay_opacity) * strength);
      }
      // Static pixel-locked grain.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y)) + vec2(0.0);
      vec3 p3 = fract(vec3(px.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      float n = fract((p3.x + p3.y) * p3.z);
      float grain = clamp(0.545 + (n - 0.5) * 0.505, 0.0, 1.0);
      result = mix(result, result * vec3(grain), grain_opacity * strength);

      // Spark 2dText0, drawn last in canvas0 with the default alpha material: the date in VCR OSD Mono 14 pt, colour #EE8A00,
      // rotated -90 deg so it reads top to bottom. Centre pinned at (0.5 - 0.3387, 0.5 + 0.3163) of the frame; the text is
      // sized in points, so it scales uniformly with the shorter frame side (ink length 0.2417 of it, measured on the
      // 720x1280 sample). Texture 73x672 = 664 px ink + 4 px transparent border.
      {
        vec2 frame = vec2(source_size_x, source_size_y);
        vec2 box = vec2(73.0, 672.0) * (0.2417 * min(frame.x, frame.y) / 664.0);
        vec2 tuv = (topUv(uv) * frame - vec2(0.1613, 0.8163) * frame) / box + 0.5;
        float inBox = step(0.0, tuv.x) * step(tuv.x, 1.0) * step(0.0, tuv.y) * step(tuv.y, 1.0);
        // auxSampler3 = pass input 4 ('kodak_grain_date), straight alpha.
        vec4 tx = texture2D(auxSampler3, clamp(tuv, 0.0, 1.0));
        result = mix(result, tx.rgb, tx.a * inBox * text_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
