[Filter DazzFilm]
# "Dazz film" ported from the Spark effect (2061442264188141). Single fragment pass,
# no face tracking.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.4.
#   Grade: 8x8 LUT (Spark FastColorLUT, input clamp 0.05..0.96) at 1.
#   Light leak: Spark's 25-frame orange (#FF9822 tint) sequence at 12 fps, screen-blended; the 8 frames with a leak
#   are packed in one 4x2 atlas ('dazz_film_leak), the empty ones are a constant shadow lift.
#   Grain: static, pixel-locked hash noise (mean 0.385, spread 0.56), subtract-blended at 0.15
#   (replaces the Spark grain texture).
#   Overlay: 'dazz_film_frame (black film border, square window, FILM PRO 400 edge print) alpha-blended at 1.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('dazz_film_lut);
    makeTexture('dazz_film_frame);
    makeTexture('dazz_film_leak);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.4, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {grain_opacity = 0.15, min = 0.0, max = 0.5, description = "Film grain subtract-blend opacity"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the frame overlay"},
        {leak_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the orange light-leak flipbook"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'dazz_film_lut, 'dazz_film_frame, 'dazz_film_leak},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.4,
        grain_opacity = 0.15,
        overlay_opacity = 1.0,
        time = 0.0,
        leak_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslDazzFilm,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string dazz_film_lut_path = "dazz_film_lut_path";
string dazz_film_lut_filename = "";
string dazz_film_frame_path = "dazz_film_frame_path";
string dazz_film_frame_filename = "";
string dazz_film_leak_path = "dazz_film_leak_path";
string dazz_film_leak_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; dazz_film_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(dazz_film_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != dazz_film_lut_filename) {
            dazz_film_lut_filename = new_lut;
            loadTexture('dazz_film_lut, dazz_film_lut_filename);
        }
    }

    string dazz_film_frame_param = getParameterString(dazz_film_frame_path);
    if (dazz_film_frame_param != "") {
        string new_dazz_film_frame = stringAppend("textureFilePath://", dazz_film_frame_param);
        if (new_dazz_film_frame != dazz_film_frame_filename) {
            dazz_film_frame_filename = new_dazz_film_frame;
            loadTexture('dazz_film_frame, dazz_film_frame_filename);
        }
    }
    string dazz_film_leak_param = getParameterString(dazz_film_leak_path);
    if (dazz_film_leak_param != "") {
        string new_dazz_film_leak = stringAppend("textureFilePath://", dazz_film_leak_param);
        if (new_dazz_film_leak != dazz_film_leak_filename) {
            dazz_film_leak_filename = new_dazz_film_leak;
            loadTexture('dazz_film_leak, dazz_film_leak_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'leak_opacity, getParameterFloat('leak_opacity));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time picks the light-leak frame.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslDazzFilm = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'dazz_film_lut
    uniform sampler2D auxSampler2;  // 'dazz_film_frame
    uniform sampler2D auxSampler3;  // 'dazz_film_leak (4x2 atlas, 8 leak frames)

    uniform float lut_strength;
    uniform float leak_opacity;
    uniform float smooth_strength;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode, with this effect's input clamp 0.05..0.96).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.05, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Orange light-leak flipbook (Spark sequence, 25 frames at 12 fps, screen). Only 8 frames carry a leak;
      // they are packed 4x2 and the other 17 are the flat JPEG floor (3, 21, 2).
      {
        float f = mod(floor(time * 12.0), 25.0);
        float cell = -1.0;
        if (f == 0.0) { cell = 0.0; } else if (f == 4.0) { cell = 1.0; } else if (f == 5.0) { cell = 2.0; }
        else if (f == 6.0) { cell = 3.0; } else if (f == 13.0) { cell = 4.0; } else if (f == 16.0) { cell = 5.0; }
        else if (f == 19.0) { cell = 6.0; } else if (f == 23.0) { cell = 7.0; }
        vec3 leak = vec3(0.012, 0.082, 0.008);
        if (cell >= 0.0) {
          // Inset half a texel per cell so bilinear taps never read the neighbouring frame.
          vec2 inCell = clamp(topUv(uv), vec2(0.5 / 194.0, 0.5 / 345.0), vec2(1.0 - 0.5 / 194.0, 1.0 - 0.5 / 345.0));
          leak = texture2D(auxSampler3, (vec2(mod(cell, 4.0), floor(cell / 4.0)) + inCell) / vec2(4.0, 2.0)).rgb;
        }
        leak *= vec3(1.0, 0.596, 0.133);
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - leak), leak_opacity * strength);
      }
      // Static pixel-locked grain.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y)) + vec2(0.0);
      vec3 p3 = fract(vec3(px.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      float n = fract((p3.x + p3.y) * p3.z);
      float grain = clamp(0.385 + (n - 0.5) * 0.56, 0.0, 1.0);
      result = max(result - vec3(grain) * grain_opacity * strength, vec3(0.0));
      // Full-frame overlay 'dazz_film_frame (alpha), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('dazz_film_frame).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, ov.rgb, (overlay_opacity * ov.a) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
