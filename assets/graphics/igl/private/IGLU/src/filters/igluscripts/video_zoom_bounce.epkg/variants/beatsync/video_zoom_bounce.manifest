{
  "schemaVersion": 1,
  "iglu": {
    "behavior": {
      "type": "static"
    },
    "customization": [
      {
        "name": "amount",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Amount",
        "displayNameDescription": "[IG Edits] Slider label controlling the magnitude or quantity of a video effect. Generic across many effects; exact range varies per effect."
      },
      {
        "name": "beatProgress",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "beatReactive": {
          "mode": "curvePlayback",
          "curvePlayback": {
            "durationScale": 0.9375,
            "output": "position",
            "maxDuration": 1.2
          },
          "range": [
            0.0,
            1.0
          ]
        }
      }
    ]
  }
}
