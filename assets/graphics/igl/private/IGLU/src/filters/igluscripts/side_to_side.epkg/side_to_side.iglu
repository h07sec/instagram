[Filter SideToSide]
# "Side To Side" ported from the Spark effect (2350074958427177). Single fragment pass.
#
#   Spark stacks three canvases: (1) the camera rotated 180 degrees through a black-and-white LUT, full
#   frame; (2) the camera through a warm LUT, scaled to 0.7 and centred; (3) a white instant-film frame
#   PNG over the full frame. Here all three are composited in one pass: background, inner photo inside
#   its 0.7 rectangle, then the frame (alpha).
#   Dropped: Spark's light-leak rectangle sits behind the inner photo at the same size, so it never shows.
#
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('side_to_side_lut);
    makeTexture('side_to_side_photo_lut);
    makeTexture('side_to_side_frame);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {photo_scale = 0.7, min = 0.4, max = 1.0, description = "Size of the inner photo (Spark 0.7)"},
        {frame_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the instant-film frame"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'side_to_side_lut, 'side_to_side_photo_lut, 'side_to_side_frame},
      uniforms = {
        strength = 1.0,
        photo_scale = 0.7,
        frame_opacity = 1.0,
      },
      glslShader = glslSideToSide,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string side_to_side_lut_path = "side_to_side_lut_path";
string side_to_side_lut_filename = "";
string side_to_side_photo_lut_path = "side_to_side_photo_lut_path";
string side_to_side_photo_lut_filename = "";
string side_to_side_frame_path = "side_to_side_frame_path";
string side_to_side_frame_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the first remote image under the generic 'lut_path; the stem-named keys are for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(side_to_side_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != side_to_side_lut_filename) {
            side_to_side_lut_filename = new_lut;
            loadTexture('side_to_side_lut, side_to_side_lut_filename);
        }
    }
    string photo_param = getParameterString(side_to_side_photo_lut_path);
    if (photo_param != "") {
        string new_photo = stringAppend("textureFilePath://", photo_param);
        if (new_photo != side_to_side_photo_lut_filename) {
            side_to_side_photo_lut_filename = new_photo;
            loadTexture('side_to_side_photo_lut, side_to_side_photo_lut_filename);
        }
    }
    string frame_param = getParameterString(side_to_side_frame_path);
    if (frame_param != "") {
        string new_frame = stringAppend("textureFilePath://", frame_param);
        if (new_frame != side_to_side_frame_filename) {
            side_to_side_frame_filename = new_frame;
            loadTexture('side_to_side_frame, side_to_side_frame_filename);
        }
    }
    setShaderUniform('pass0, 'photo_scale, getParameterFloat('photo_scale));
    setShaderUniform('pass0, 'frame_opacity, getParameterFloat('frame_opacity));
}

#### GLSL shader ####

string glslSideToSide = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'side_to_side_lut (black and white, background)
    uniform sampler2D auxSampler2;  // 'side_to_side_photo_lut (warm, inner photo)
    uniform sampler2D auxSampler3;  // 'side_to_side_frame (instant-film frame, RGBA)
    uniform float photo_scale;
    uniform float frame_opacity;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookups (Spark FastColorLUT decode); one per LUT so each sampler stays a constant.
    vec2 lutCoord(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);

      // Background: the camera rotated 180 degrees (a point flip is the same in either Y convention).
      vec3 back = sampleInput(vec2(1.0) - uv).rgb;
      vec3 result = texture2D(auxSampler1, lutCoord(back)).xyz;

      // Inner photo: the whole camera frame shrunk to photo_scale and centred.
      vec2 tuv = topUv(uv);
      vec2 local = (tuv - 0.5) / photo_scale + 0.5;
      if (local.x >= 0.0 && local.x <= 1.0 && local.y >= 0.0 && local.y <= 1.0) {
        vec3 photo = sampleInput(topUv(local)).rgb;
        result = texture2D(auxSampler2, lutCoord(photo)).xyz;
      }

      // Instant-film frame, authored top-origin.
      vec4 fr = texture2D(auxSampler3, tuv);
      result = mix(result, fr.rgb, fr.a * frame_opacity);

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      result = mix(cam.rgb, result, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
