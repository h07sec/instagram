[Filter AlwaysBlurred]
# "Always blurred" ported from the Spark effect (565766141315669).
#
#   Grade: 'moody beach' 8x8 LUT (Spark Advanced LUT) mixed at 0.4.
#   Blur: Spark's full-frame Gaussian Blur (radius 4, downsampled) as a separable 13-tap gaussian
#         (sigma = 2 taps), tap spacing blur_step px at 720 wide: two full-res passes, so no scaled-pass
#         inheritance issues on Android.
#   Grain: Spark's 0.39-opacity grain PNG replaced by procedural mean-zero grain (no extra asset).
#   Dropped: the face makeup layers (concealer 0, contour 0.14, blush 0.09, eyeshadow 0.21) are invisible
#            under the blur; the unused BOHEMIAN / moody beach(1) LUTs.
#
# Time source: none (static). GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('always_blurred_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.4, min = 0.0, max = 1.0, description = "Moody beach LUT mix (Spark 0.4)"},
        {blur_step = 4.5, min = 0.0, max = 10.0, description = "Blur tap spacing in px at 720 wide (12 taps span ~6x this)"},
        {grain_opacity = 0.05, min = 0.0, max = 0.3, description = "Film grain amplitude"}
    };

    filter.passes = {
      {
        name = 'graded,
        inputs = {'default, 'always_blurred_lut},
        uniforms = {
          strength = 1.0,
          lut_strength = 0.4,
        },
        glslShader = glslGrade,
      },
      {
        name = 'blur_h,
        inputs = {'graded},
        uniforms = {
          strength = 1.0,
          blur_step = 4.5,
          dir_x = 1.0,
          dir_y = 0.0,
          source_size_x = 1024.0,
          source_size_y = 1024.0,
        },
        glslShader = glslBlur,
      },
      {
        name = 'blur_v,
        inputs = {'blur_h},
        uniforms = {
          strength = 1.0,
          blur_step = 4.5,
          grain_opacity = 0.05,
          source_size_x = 1024.0,
          source_size_y = 1024.0,
        },
        glslShader = glslBlurGrain,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string always_blurred_lut_path = "always_blurred_lut_path";
string always_blurred_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('graded, 'strength, effect_strength);
    setShaderUniform('blur_h, 'strength, effect_strength);
    setShaderUniform('blur_v, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; always_blurred_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(always_blurred_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != always_blurred_lut_filename) {
            always_blurred_lut_filename = new_lut;
            loadTexture('always_blurred_lut, always_blurred_lut_filename);
        }
    }
    setShaderUniform('graded, 'lut_strength, getParameterFloat('lut_strength));

    f32 step = getParameterFloat('blur_step);
    setShaderUniform('blur_h, 'blur_step, step);
    setShaderUniform('blur_v, 'blur_step, step);
    setShaderUniform('blur_v, 'grain_opacity, getParameterFloat('grain_opacity));

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('blur_h, 'source_size_x, srcSize.x);
        setShaderUniform('blur_h, 'source_size_y, srcSize.y);
        setShaderUniform('blur_v, 'source_size_x, srcSize.x);
        setShaderUniform('blur_v, 'source_size_y, srcSize.y);
    }
}

#### GLSL shaders ####

string glslGrade = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'always_blurred_lut
    uniform float lut_strength;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(cam.rgb, lutLookup(cam.rgb), strength * lut_strength);
      gl_FragColor = toOutputFormat(vec4(graded, cam.a));
    }
    ";

string glslBlur = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float blur_step;
    uniform float dir_x;
    uniform float dir_y;
    uniform float source_size_x;
    uniform float source_size_y;

    // 13-tap gaussian, sigma = 2 taps (weights precomputed, sum = 1).
    vec3 tap2(vec2 uv, vec2 d, float w) {
      return (sampleInput(uv + d).rgb + sampleInput(uv - d).rgb) * w;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // blur_step is in px at 720 wide; scale to this frame's width, then to UV.
      // strength fades the blur radius too, so strength 0 is the untouched camera.
      float px = blur_step * strength * source_size_x / 720.0;
      vec2 d = vec2(dir_x / max(source_size_x, 1.0), dir_y / max(source_size_y, 1.0)) * px;
      vec4 c0 = sampleInput(uv);
      vec3 c = c0.rgb * 0.19968;
      c += tap2(uv, d, 0.17621);
      c += tap2(uv, d * 2.0, 0.12111);
      c += tap2(uv, d * 3.0, 0.06483);
      c += tap2(uv, d * 4.0, 0.02702);
      c += tap2(uv, d * 5.0, 0.00877);
      c += tap2(uv, d * 6.0, 0.00222);
      gl_FragColor = toOutputFormat(vec4(c, c0.a));
    }
    ";

string glslBlurGrain = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float blur_step;
    uniform float grain_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    vec3 tap2(vec2 uv, vec2 d, float w) {
      return (sampleInput(uv + d).rgb + sampleInput(uv - d).rgb) * w;
    }

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // strength fades the blur radius too, so strength 0 is the untouched camera.
      float px = blur_step * strength * source_size_x / 720.0;
      vec2 d = vec2(0.0, 1.0 / max(source_size_y, 1.0)) * px;
      vec4 c0 = sampleInput(uv);
      vec3 c = c0.rgb * 0.19968;
      c += tap2(uv, d, 0.17621);
      c += tap2(uv, d * 2.0, 0.12111);
      c += tap2(uv, d * 3.0, 0.06483);
      c += tap2(uv, d * 4.0, 0.02702);
      c += tap2(uv, d * 5.0, 0.00877);
      c += tap2(uv, d * 6.0, 0.00222);
      // Static pixel-locked grain, seeded top-origin so it matches across platforms.
      float g = hash12(floor(topUv(uv) * vec2(source_size_x, source_size_y))) - 0.5;
      c += vec3(g * grain_opacity * strength);
      gl_FragColor = toOutputFormat(vec4(clamp(c, 0.0, 1.0), c0.a));
    }
    ";
