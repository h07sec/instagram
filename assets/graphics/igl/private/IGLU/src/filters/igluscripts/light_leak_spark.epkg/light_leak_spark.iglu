[Filter LightLeakSpark]
# "LIGHT LEAK" ported from the Spark effect (133977889325739). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 0.4.
#   Overlay: 'light_leak_spark_leaks screen-blended full-frame at 1.
#   Spark screens a 52-frame light-leak sequence at 35 fps (1.486 s loop) over its LUT at 0.4; here 8 evenly spaced frames at half resolution in one 4x2 atlas cross-fade over the same loop.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('light_leak_spark_lut);
    makeTexture('light_leak_spark_leaks);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.4, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the leaks overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'light_leak_spark_lut, 'light_leak_spark_leaks},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.4,
        overlay_opacity = 1.0,
        time = 0.0,
      },
      glslShader = glslLightLeakSpark,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string light_leak_spark_lut_path = "light_leak_spark_lut_path";
string light_leak_spark_lut_filename = "";
string light_leak_spark_leaks_path = "light_leak_spark_leaks_path";
string light_leak_spark_leaks_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; light_leak_spark_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(light_leak_spark_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != light_leak_spark_lut_filename) {
            light_leak_spark_lut_filename = new_lut;
            loadTexture('light_leak_spark_lut, light_leak_spark_lut_filename);
        }
    }

    string light_leak_spark_leaks_param = getParameterString(light_leak_spark_leaks_path);
    if (light_leak_spark_leaks_param != "") {
        string new_light_leak_spark_leaks = stringAppend("textureFilePath://", light_leak_spark_leaks_param);
        if (new_light_leak_spark_leaks != light_leak_spark_leaks_filename) {
            light_leak_spark_leaks_filename = new_light_leak_spark_leaks;
            loadTexture('light_leak_spark_leaks, light_leak_spark_leaks_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslLightLeakSpark = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'light_leak_spark_lut
    uniform sampler2D auxSampler2;  // 'light_leak_spark_leaks

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'light_leak_spark_leaks (screen), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('light_leak_spark_leaks).
        // 8 key frames of Spark's 52-frame, 35 fps leak (1.486 s loop) in a 4x2 atlas, cross-faded.
        // The half-texel clamp keeps bilinear sampling inside one cell.
        float f = fract(time / (52.0 / 35.0)) * 8.0;
        float i0 = floor(f);
        float i1 = mod(i0 + 1.0, 8.0);
        vec2 cuv = clamp(topUv(uv), vec2(0.5 / 288.0, 0.5 / 512.0), vec2(1.0 - 0.5 / 288.0, 1.0 - 0.5 / 512.0)) / vec2(4.0, 2.0);
        vec2 c0 = vec2(mod(i0, 4.0), floor(i0 / 4.0)) / vec2(4.0, 2.0);
        vec2 c1 = vec2(mod(i1, 4.0), floor(i1 / 4.0)) / vec2(4.0, 2.0);
        vec4 ov = mix(texture2D(auxSampler2, c0 + cuv), texture2D(auxSampler2, c1 + cuv), f - i0);
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov.rgb), (overlay_opacity) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
