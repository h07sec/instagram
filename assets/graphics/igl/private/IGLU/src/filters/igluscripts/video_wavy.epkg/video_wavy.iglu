# IGLUSCRIPTCOLLISION_BYPASS: Intentional replacement of C++ native effect - IGLUScript takes precedence on Android/iOS; C++ filter retained as fallback for direct C++ callers (sample app, server tools).

[Filter VideoWavy]
# Rotate the frame around its centre and pulse a zoom. Port of VideoWavyFilter: pass 1 rotates
# and mirrors the edges, pass 2 is the shared pulse-zoom shader. Each pass transforms its texture
# coordinate in the vertex stage; only the edge mirror, which is not linear, runs per pixel.
#
# Off the clock the rotation is `sin(rotation_speed * time_sec)` and the zoom pulses on a sine of
# the same clock. With `useBeats` true one curve position drives both: it sweeps the rotation from
# one side to the other across a beat, reversing on the next, and the zoom peaks on the beat.
#
# BeatReactiveController writes `useBeats` when a manifest declares beatReactive; otherwise the
# false default selects the clock.

# VideoWavyFilter.cpp:31-40. The sliders are normalized [0,1] and lerp into these.
f32 kRotationSpeedMin = 1.0;
f32 kRotationSpeedMax = 10.0;
f32 kRotationScaleMin = 0.05;
f32 kRotationScaleMax = 0.5;
f32 kZoomEndMin = 1.03;
f32 kZoomEndMax = 1.3;
f32 kZoomStart = 1.0;
f32 kPulseSpeed = 0.6;

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {speed = 0.3611111, min = 0.0, max = 1.0, description = "Clock rate; unread in beat mode"},
        {zoom = 0.1851852, min = 0.0, max = 1.0, description = "Rotation depth and zoom depth"},
        {swing = 0.0, min = -1.0, max = 1.0, description = "Beat sway position, -1 to +1"},
        {useBeats = false, description = "True while the beat system is driving this effect"},
    };

    filter.passes = {
        {
            name = 'wavy,
            inputs = {'default},
            uniforms = {
                rotationScale = 0.15,
                angle = 0.0,
                sourceSize = {1080.0, 1920.0},
            },
            glslVertexShader = vsWavy,
            glslShader = glslWavy,
        },
        {
            name = 'pulse_zoom,
            inputs = {'wavy},
            uniforms = {
                zoom = 1.0,
            },
            glslVertexShader = vsPulseZoom,
            glslShader = glslPulseZoom,
        },
    };
}

[PreRender]
fun preRender(Filter filter) {
    boolean useBeats = getParameterBoolean('useBeats);
    f32 zoomNorm = getParameterFloat('zoom);

    # VideoWavyFilter.cpp:160-166: the zoom slider drives the rotation depth and the zoom depth.
    # The speed slider only feeds the clock, so beat mode leaves it unread.
    f32 rotationScale = mix(kRotationScaleMin, kRotationScaleMax, zoomNorm);
    f32 zoomEnd = mix(kZoomEndMin, kZoomEndMax, zoomNorm);
    setShaderUniform('wavy, 'rotationScale, rotationScale);

    f32 angle = 0.0;
    f32 zoomT = 0.0;
    if (useBeats) {
        # `swing` sweeps -1 to +1 across one beat and back across the next. Rest is 0, upright.
        f32 swing = getParameterFloat('swing);
        angle = rotationScale * swing;
        # The zoom peaks at each extreme of the sway, where a beat lands. Squaring eases it through
        # the centre so its only sharp turn is on the beat.
        zoomT = swing * swing;
    } else {
        # VideoWavyFilter.cpp:67 and PulseZoomShader.cpp.
        f32 timeSec = getParameterFloat('time_sec);
        f32 rotationSpeed = mix(kRotationSpeedMin, kRotationSpeedMax, getParameterFloat('speed));
        angle = rotationScale * sin(rotationSpeed * timeSec);
        zoomT = 0.5 * (1.0 + sin(timeSec * kPulseSpeed * 6.2831));
    }
    setShaderUniform('wavy, 'angle, angle);
    setShaderUniform('pulse_zoom, 'zoom, mix(kZoomStart, zoomEnd, zoomT));

    # A vec2 uniform does not pick up its [Init] default, so the size is written every frame.
    setShaderUniform('wavy, 'sourceSize, getTextureSize('default));
}

#### Pass 1: rotate about the centre, mirrored at the edges ####

# Mirrors IGLU's shared fullscreen vertex shader (filters/common/Common.cpp vertexShaderStr) up to
# the texture coordinate, then applies the crop and rotation, which are linear in it.
string vsWavy = "
  attribute vec3 a_position;
  attribute vec2 a_texCoord;

  uniform mat4 content_transform;
  uniform mat4 texture_transform;
  uniform float rotationScale;
  uniform float angle;
  uniform vec2 sourceSize;

  varying vec2 rotatedUV;

  void main() {
    gl_Position = content_transform * vec4(a_position, 1.0);
    vec4 texel = texture_transform * vec4(a_texCoord, 0.0, 1.0);
    vec2 uv = texel.xy / texel.w + vec2(0.5);

    vec2 center = vec2(0.5, 0.5);
    vec2 ratio = sourceSize.xy / sourceSize.y;
    vec2 pos = (uv - center) * ratio;

    // Inset so the rotation never exposes an edge; deeper rotation needs a tighter crop.
    float imgCrop = 0.94 - (rotationScale * 0.9);
    pos = pos * imgCrop;

    float s = sin(angle);
    float c = cos(angle);
    vec2 rotatedPos = vec2(pos.x * c - pos.y * s, pos.x * s + pos.y * c);
    rotatedUV = rotatedPos / ratio + center;
  }
";

string glslWavy = "
  varying vec2 rotatedUV;
  BaseUniformsOpenGL;

  vec2 mirror(vec2 v) { return abs(v - 2.0 * floor(v * 0.5 + 0.5)); }

  void main() {
    gl_FragColor = toOutputFormat(sampleInput(mirror(rotatedUV)));
  }
";

#### Pass 2: zoom about the centre ####

string vsPulseZoom = "
  attribute vec3 a_position;
  attribute vec2 a_texCoord;

  uniform mat4 content_transform;
  uniform mat4 texture_transform;
  uniform float zoom;

  varying vec2 zoomedUV;

  void main() {
    gl_Position = content_transform * vec4(a_position, 1.0);
    vec4 texel = texture_transform * vec4(a_texCoord, 0.0, 1.0);
    vec2 uv = texel.xy / texel.w + vec2(0.5);

    vec2 center = vec2(0.5);
    zoomedUV = center + (uv - center) / zoom;
  }
";

string glslPulseZoom = "
  precision highp float;

  varying vec2 zoomedUV;
  BaseUniformsOpenGL;

  void main() {
    gl_FragColor = toOutputFormat(sampleInput(zoomedUV));
  }
";
