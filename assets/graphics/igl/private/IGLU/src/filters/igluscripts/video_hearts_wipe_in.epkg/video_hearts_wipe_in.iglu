[Filter InOutV2ProcHeartsWipeIn]

[Init]
fun init(Filter filter) {
    makeTexture('particles_all);

    filter.parameters = {
        {bandWidth = 0.233696, min = 0.01, max = 0.5, description = "bandWidth"},
        {alphaBandWidth = 0.153804, min = 0.01, max = 0.5, description = "alphaBandWidth"},
        {wipeScale = 0.6, min = 0.1, max = 1.0, description = "wipeScale"},
        {glowEdgeOffset = 0.34358695652173915, min = 0.01, max = 1.0, description = "glowEdgeOffset"},
        {glowBrightness = 25.543478260869566, min = 0.0, max = 50.0, description = "glowBrightness"},
        {particleBrightness = 0.9347826086956522, min = 0.0, max = 2.0, description = "particleBrightness"},
        {radius = 24.7283, min = 0.0, max = 25.0, description = "radius"},
        {blurSize = 2.2, min = 0.0, max = 10.0, description = "blurSize"},
        {wipeDirection = {0.015625, 0.734009}, description = "wipeDirection"},
        {outro = 0.0, min = 0.0, max = 1.0, description = "outro"},
        {distortion = 0.163043, min = 0.0, max = 1.0, description = "distortion"},
        {glowTrail = 0.0, min = 0.0, max = 1.0, description = "glowTrail"},
        {overallExposure = 2.282608695652174, min = 0.0, max = 10.0, description = "overallExposure"},
        {particleExposure = 3.369565217391304, min = 0.0, max = 10.0, description = "particleExposure"},
        {particleSize = 15.0, min = 4.0, max = 50.0, description = "particleSize"},
        {particleFadeInStart = 0.22826086956521738, min = 0.0, max = 0.5, description = "particleFadeInStart"},
        {particleSpeed = 0.456522, min = 0.0, max = 2.0, description = "particleSpeed"},
        {particleGlow = 0.3, min = 0.0, max = 1.0, description = "particleGlow"},
        {particleOffset = 0.0, min = -0.1, max = 0.1, description = "particleOffset"},
        {particleRotationSpeed = 0.0, min = -10.0, max = 10.0, description = "particleRotationSpeed"},
        {particleRotationRandomness = 0.0, min = 0.0, max = 1.0, description = "particleRotationRandomness"},
        {particleScaleWindow = {0.8, 1.0}, description = "particleScaleWindow"},
        {directionRandomness = 0.3, min = 0.0, max = 1.0, description = "directionRandomness"},
        {particleColor = {1.0, 0.2823529411764706, 0.7450980392156863}, description = "particleColor"},
        {useCustomColor = 0.0, min = 0.0, max = 1.0, description = "useCustomColor"},
        {directionBias = {-0.3125, 0.379517}, description = "directionBias"},
        {particleIndex = 1.0, min = 0.0, max = 3.0, description = "particleIndex"},
        {color = {1.0, 0.368421, 0.692934, 1.0}, description = "color"},
        {amount = 0.5, min = 0.0, max = 1.0, description = "amount"},
        {size = 1.92, min = -0.08, max = 3.92, description = "size"},
        {direction = 2.0, min = 2.0, max = 3.0, description = "Wipe travel direction: 2 = up, 3 = down"},
    };

    filter.passes = {{
        name = 'base,
        igid = 'video_particles,
        inputs = {'default, 'particles_all},
        uniforms = {
            bandWidth = 0.23369565217391303,
            alphaBandWidth = 0.15380434782608698,
            wipeScale = 0.8,
            glowEdgeOffset = 0.3758695652173913,
            glowColor = {1.0, 0.368421, 0.692934},
            glowBrightness = 21.195652173913043,
            particleBrightness = 1.0,
            radius = 24.728260869565215,
            blurSize = 0.10869565217391304,
            wipeDirection = {0.015625, 0.7340087890625},
            outro = 0.0,
            distortion = 0.16304347826086957,
            glowTrail = 0.0,
            overallExposure = 0.0,
            particleExposure = 0.0,
            particleSize = 16.5,
            particleSpeed = 0.45652173913043476,
            particleGlow = 0.34782608695652173,
            particleFadeInStart = 0.15,
            particleOffset = 0.1,
            sparsity = 0.5,
            particleRotationSpeed = 0.1,
            particleRotationRandomness = 1.0,
            particleScale = 1.92,
            particleScaleWindow = {0.8, 1.0},
            directionRandomness = 0.3,
            particleColor = {1.0, 0.2823529411764706, 0.7450980392156863},
            useCustomColor = 0.0,
            directionBias = {-0.3125, 0.3795166015625},
            particleIndex = 1.0,
        }
    }};
}

[PreRender]
fun preRender(Filter filter) {
    vec4 color = getParameterVec4('color);
    vec3 glowColor = {color.r, color.g, color.b};
    setShaderUniform('base, 'glowColor, glowColor);
    setShaderUniform('base, 'sparsity, clamp(1.0 - getParameterFloat('amount), 0.0, 1.0));
    setShaderUniform('base, 'particleScale, max(getParameterFloat('size), 0.1));
    # The authored wipe travels up; down mirrors the layout vertically.
    f32 mirrorY = 0.0;
    if (getParameterFloat('direction) > 2.5) {
        mirrorY = 1.0;
    }
    setShaderUniform('base, 'mirrorY, mirrorY);
}
