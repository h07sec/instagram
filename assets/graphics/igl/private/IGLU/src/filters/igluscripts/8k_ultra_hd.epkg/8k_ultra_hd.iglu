[Filter UltraHD8K]
# "8K Ultra HD" ported from the Spark effect (930687388439111). Three passes, no face tracking.
#
#   Spark: the camera scene pass also draws a full-frame black rectangle with multiply blend at opacity 0.12
#   (camera x 0.88), then a 3x3 sharpen ([0,-1,0; -1,5,-1; 0,-1,0], taps screenScale physical px apart) mixed
#   0.15 over that, then a face-masked guided-filter skin smoothing (Intensity 0.3), then the "8k quality"
#   8x8 FastColorLUT (clamp 0.0078125..0.98438, intensity 1). Every Spark render target is 8-bit, so the
#   darken and the sharpen each get their own uint8 pass here.
#   The skin smoothing is faked with the soft centre-weighted edge-aware blur from g_l_o_w, applied to the
#   sharpened image before the LUT. The two-face makeup (blush, contour, nose contour, illumination,
#   highlighter, lipstick, lip liner, brows, base, set spray, face grain), under-eye concealer and teeth
#   whitening are dropped: every layer is <= ~15% coverage and the LUT carries the look.
#   The stem starts with a digit, so the [Filter] name is CamelCase (the tokenizer would split "8k...").
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('8k_ultra_hd_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.3, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {screen_scale = 3.0, min = 1.0, max = 4.0, description = "Sharpen tap spacing in output pixels (Spark's device screenScale)"}
    };

    filter.passes = {
      {
        name = 'scene,
        inputs = {'default},
        glslShader = glslScene,
      },
      {
        name = 'sharpen,
        inputs = {'scene},
        uniforms = {
          step_x = 0.0027777778,
          step_y = 0.0015625,
        },
        glslShader = glslSharpen,
      },
      {
        name = 'final,
        inputs = {'default, 'sharpen, '8k_ultra_hd_lut},
        uniforms = {
          strength = 1.0,
          smooth_strength = 0.3,
          source_size_x = 1080.0,
          source_size_y = 1920.0,
        },
        glslShader = glslFinal,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lut_param_name = "8k_ultra_hd_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('final, 'strength, getParameterFloat('strength));
    setShaderUniform('final, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; 8k_ultra_hd_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lut_param_name);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lut_filename) {
            lut_filename = new_lut;
            loadTexture('8k_ultra_hd_lut, lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        f32 scale = getParameterFloat('screen_scale);
        setShaderUniform('sharpen, 'step_x, scale / srcSize.x);
        setShaderUniform('sharpen, 'step_y, scale / srcSize.y);
        setShaderUniform('final, 'source_size_x, srcSize.x);
        setShaderUniform('final, 'source_size_y, srcSize.y);
    }
}

#### GLSL shaders ####

string glslScene = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    void main() {
      vec3 c = clamp(sampleInput(sourceTextureCoordinate).rgb, 0.0, 1.0);
      // Black multiply rect at 0.12 (premultiplied src): dst * (1 - 0.12) + 0 * dst.
      gl_FragColor = toOutputFormat(vec4(c * 0.88, 1.0));
    }
    ";

string glslSharpen = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float step_x;
    uniform float step_y;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 d = vec2(step_x, step_y);
      vec3 c = sampleInput(uv).rgb;
      // The kernel's four zero-weight corner taps are skipped (0 * x adds nothing).
      vec3 n = sampleInput(uv + vec2(0.0, -1.0) * d).rgb
          + sampleInput(uv + vec2(-1.0, 0.0) * d).rgb
          + sampleInput(uv + vec2(1.0, 0.0) * d).rgb
          + sampleInput(uv + vec2(0.0, 1.0) * d).rgb;
      vec3 conv = 5.0 * c - n;
      gl_FragColor = toOutputFormat(vec4(clamp(mix(c, conv, 0.15), 0.0, 1.0), 1.0));
    }
    ";

string glslFinal = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'sharpen (darkened, sharpened camera)
    uniform sampler2D auxSampler2;  // '8k_ultra_hd_lut (8k quality, 512x512)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = texture2D(auxSampler1, uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0078125, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler2, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = texture2D(auxSampler1, uv).rgb;
      if (smooth_strength > 0.0) {
        float aspect = source_size_x / max(source_size_y, 1.0);
        vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
        float sm = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
        if (sm > 0.0) {
          s = mix(s, skinBlur(uv, s), sm);
        }
      }
      vec3 result = mix(cam.rgb, lutLookup(s), strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
