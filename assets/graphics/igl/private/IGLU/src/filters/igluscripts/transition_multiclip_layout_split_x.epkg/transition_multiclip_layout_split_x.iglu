[Filter TransitionMulticlipLayoutSplitX]

fun bez(f32 a, f32 b, f32 s) f32 {
  f32 r = 1.0 - s;
  return 3.0 * r * r * s * a + 3.0 * r * s * s * b + s * s * s;
}
fun aeEase(f32 u, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 lo = 0.0;
  f32 hi = 1.0;
  f32 s = 0.0;
  f32 i = 0.0;
  while (i < 24.0) {
    s = (lo + hi) * 0.5;
    if (bez(x1, x2, s) < u) { lo = s; } else { hi = s; }
    i = i + 1.0;
  }
  return bez(y1, y2, s);
}

fun l1_0(f32 t) f32 {
  f32 v = 360.0;
  if (t < 1.0) {
    f32 u = clamp((t - 0.0) / 1.0, 0.0, 1.0);
    v = 360.0 + 360.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else if (t < 2.0) {
    v = 720.0;
  }
  else if (t < 2.96666666667) {
    f32 u = clamp((t - 2.0) / 0.966666666667, 0.0, 1.0);
    v = 720.0 + 360.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else { v = 1080.0; }
  return v;
}
fun l1_1(f32 t) f32 { f32 v = 640.0; return v; }
fun l2_2(f32 t) f32 {
  f32 v = 0.0;
  if (t < 1.0) {
    f32 u = clamp((t - 0.0) / 1.0, 0.0, 1.0);
    v = 0.0 + 170.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else if (t < 2.0) {
    v = 170.0;
  }
  else if (t < 2.96666666667) {
    f32 u = clamp((t - 2.0) / 0.966666666667, 0.0, 1.0);
    v = 170.0 + 190.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else { v = 360.0; }
  return v;
}
fun l2_3(f32 t) f32 { f32 v = 640.0; return v; }
fun l3_4(f32 t) f32 { f32 v = 0.0; return v; }
fun l3_5(f32 t) f32 { f32 v = 0.0; return v; }
fun l4_6(f32 t) f32 { f32 v = 0.0; return v; }
fun l4_7(f32 t) f32 { f32 v = 0.0; return v; }
fun l5_8(f32 t) f32 { f32 v = 0.0; return v; }
fun l5_9(f32 t) f32 { f32 v = 0.0; return v; }
fun l6_10(f32 t) f32 { f32 v = 0.0; return v; }
fun l6_11(f32 t) f32 { f32 v = 0.0; return v; }
fun l7_12(f32 t) f32 {
  f32 v = 360.0;
  if (t < 1.0) {
    f32 u = clamp((t - 0.0) / 1.0, 0.0, 1.0);
    v = 360.0 + 180.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else if (t < 2.0) {
    v = 540.0;
  }
  else if (t < 2.96666666667) {
    f32 u = clamp((t - 2.0) / 0.966666666667, 0.0, 1.0);
    v = 540.0 + 380.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else { v = 920.0; }
  return v;
}
fun l7_13(f32 t) f32 { f32 v = 640.0; return v; }
fun l8_14(f32 t) f32 { f32 v = 0.0; return v; }
fun l8_15(f32 t) f32 { f32 v = 0.0; return v; }
fun l9_16(f32 t) f32 { f32 v = 0.0; return v; }
fun l9_17(f32 t) f32 { f32 v = 0.0; return v; }
fun l10_18(f32 t) f32 { f32 v = 0.0; return v; }
fun l10_19(f32 t) f32 { f32 v = 0.0; return v; }
fun l11_20(f32 t) f32 { f32 v = 360.0; return v; }
fun l11_21(f32 t) f32 { f32 v = 640.0; return v; }

[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.parameters = {
    {duration = 3.0, min = 0.1, max = 5.0, description = "Duration"},
  };
  filter.passes = {{
    name = 'layout,
    inputs = {'default, 'transition},
    shaderInputNames = {'default, 's_texture1},
    uniforms = {
      edgeScale = {720.0, 1280.0},
      progress = 0.0,
      m1 = {0.0, 0.0, 1.0, 1.0},
      matteActive1 = 0.0,
      o10 = {0.0, 0.0},
      active10 = 0.0,
      active9 = 0.0,
      active8 = 0.0,
      o6 = {0.0, 0.0},
      active6 = 0.0,
      active5 = 0.0,
      active4 = 0.0,
      active3 = 0.0,
    },
    glslShader = glsl,
  }};
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = max(getParameterFloat('progress), getParameterFloat('transition_progress));
  f32 t = clamp(p, 0.0, 1.0) * 3.0;
  vec2 size = getTextureSize('default);
  setShaderUniform('layout, 'edgeScale, size);
  setShaderUniform('layout, 'progress, p);
  vec4 m1 = {((l1_0(t) + (((0.0 - 36.3046875)) - (0.0 - 36.3046875)) * 1.0) - 360.0) / 720.0, ((l1_1(t) + (((0.0 - 34.1796875)) - (0.0 - 34.1796875)) * 1.0) - 640.0) / 1280.0, ((l1_0(t) + (((0.0 - 36.3046875)) - (0.0 - 36.3046875)) * 1.0) + 360.0) / 720.0, ((l1_1(t) + (((0.0 - 34.1796875)) - (0.0 - 34.1796875)) * 1.0) + 640.0) / 1280.0};
  setShaderUniform('layout, 'm1, m1);
  f32 matteActive1 = 0.0;
  if (t >= 0.0 and t < 3.0) { matteActive1 = 1.0; }
  setShaderUniform('layout, 'matteActive1, matteActive1);
  vec2 o10 = {((l7_12(t) + (((l10_18(t) + ((360.0) - 360.0) * 1.0)) - 0.0) * 1.0) - 360.0) / 720.0, ((l7_13(t) + (((l10_19(t) + ((640.0) - 640.0) * 1.0)) - 0.0) * 1.0) - 640.0) / 1280.0};
  setShaderUniform('layout, 'o10, o10);
  f32 active10 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active10 = 1.0; }
  setShaderUniform('layout, 'active10, active10);
  f32 active9 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active9 = 1.0; }
  setShaderUniform('layout, 'active9, active9);
  f32 active8 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active8 = 1.0; }
  setShaderUniform('layout, 'active8, active8);
  vec2 o6 = {((l2_2(t) + (((l6_10(t) + ((1080.0) - 1080.0) * 0.333333333333)) - 0.0) * 1.0) - 360.0) / 720.0, ((l2_3(t) + (((l6_11(t) + ((1920.0) - 1920.0) * 0.333333333333)) - 0.0) * 1.0) - 640.0) / 1280.0};
  setShaderUniform('layout, 'o6, o6);
  f32 active6 = 0.0;
  if (t >= 0.0 and t < 5.01666666667) { active6 = 1.0; }
  setShaderUniform('layout, 'active6, active6);
  f32 active5 = 0.0;
  if (t >= 0.0 and t < 5.01666666667) { active5 = 1.0; }
  setShaderUniform('layout, 'active5, active5);
  f32 active4 = 0.0;
  if (t >= 0.0 and t < 5.01666666667) { active4 = 1.0; }
  setShaderUniform('layout, 'active4, active4);
  f32 active3 = 0.0;
  if (t >= 2.86666666667 and t < 5.01666666667) { active3 = 1.0; }
  setShaderUniform('layout, 'active3, active3);
}

string glsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;
uniform sampler2D s_texture1;
uniform vec2 edgeScale;
uniform float progress;
uniform vec4 m1;
uniform float matteActive1;
uniform vec2 o10;
uniform float active10;
uniform float active9;
uniform float active8;
uniform vec2 o6;
uniform float active6;
uniform float active5;
uniform float active4;
uniform float active3;

// Exact area coverage of an axis-aligned rectangle, at the output resolution.
float rectCoverage(vec2 xy, vec4 r) {
  vec2 d = min(xy - r.xy, r.zw - xy) * edgeScale;
  vec2 cov = clamp(d + 0.5, 0.0, 1.0);
  return cov.x * cov.y;
}
void main() {
  vec2 uv = sourceTextureCoordinate;
  if (progress < 0.0) { gl_FragColor = toOutputFormat(sampleInput(uv)); return; }
  if (progress >= 1.0) { gl_FragColor = toOutputFormat(texture2D(s_texture1, uv)); return; }
  // AE uses top-down coordinates; UP keeps this native on OpenGL and Metal.
  vec2 xy = vec2(uv.x, 0.5 - UP * (uv.y - 0.5));
  vec3 col = vec3(0.0);
  // Duplicate layers share one offset and sample; each keeps its own normal-over step.
  float matte1 = matteActive1 * rectCoverage(xy, m1);
  float coverA = rectCoverage(xy - o10, vec4(0.0, 0.0, 1.0, 1.0));
  vec4 cA = sampleInput(uv + vec2(-o10.x, UP * o10.y));
  float coverB = rectCoverage(xy - o6, vec4(0.0, 0.0, 1.0, 1.0));
  vec4 cB = texture2D(s_texture1, uv + vec2(-o6.x, UP * o6.y));
  // AE layers 10, 9, 8: PRE_A, matte 1, 5013.
  float a10 = active10 * coverA * matte1;
  col = cA.rgb * a10 + col * (1.0 - a10 * cA.a);
  float a9 = active9 * coverA * matte1;
  col = cA.rgb * a9 + col * (1.0 - a9 * cA.a);
  float a8 = active8 * coverA * matte1;
  col = cA.rgb * a8 + col * (1.0 - a8 * cA.a);
  // AE layers 6, 5, 4, 3: PRE_B, matte 1, 5014.
  float a6 = active6 * coverB * (1.0 - matte1);
  col = cB.rgb * a6 + col * (1.0 - a6 * cB.a);
  float a5 = active5 * coverB * (1.0 - matte1);
  col = cB.rgb * a5 + col * (1.0 - a5 * cB.a);
  float a4 = active4 * coverB * (1.0 - matte1);
  col = cB.rgb * a4 + col * (1.0 - a4 * cB.a);
  float a3 = active3 * coverB * (1.0 - matte1);
  col = cB.rgb * a3 + col * (1.0 - a3 * cB.a);
  gl_FragColor = toOutputFormat(vec4(col, 1.0));
}
";
