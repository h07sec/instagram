[Filter BeautyGlitch]
# "Beauty Glitch" ported from the Spark effect (742799540876459). Single fragment pass, no assets beyond the LUT.
#
#   Grade: camera -> FastColorLUT('player') -> material at 0.74 (alpha). The 'aurora' LUT isn't wired.
#   Old-film overlay: Spark adds a 47-frame 750x422 sequence at 10 fps (white dust specks, hairs and
#   hairline vertical scratches on black, added on top). Here it's procedural at the same 10 fps: sparse short
#   hairs and a few specks (half opacity), 0-2 hairline scratches (0.6), and occasional ~0.1 s brightness
#   flashes (measured from the Spark sample: +10-25%, every 0.3-1.5 s).
#   Dropped: the face retouch/lipstick layers (the face tracker has no children) and an unreferenced vignette.
#
# Time source: the host's time_sec parameter, so the overlay follows scrubbing and export.
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('beauty_glitch_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.74, min = 0.0, max = 1.0, description = "Player LUT mix (Spark 0.74)"},
        {dust_opacity = 0.85, min = 0.0, max = 1.0, description = "White dust / scratch overlay opacity"},
        {flash_strength = 0.18, min = 0.0, max = 0.5, description = "Brightness of the occasional flashes"},
        {overlay_fps = 10.0, min = 1.0, max = 30.0, description = "Overlay frames per second (Spark sequence 10 fps)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'beauty_glitch_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.74,
        dust_opacity = 0.85,
        flash_strength = 0.18,
        overlay_fps = 10.0,
        u_time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslBeautyGlitch,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string beauty_glitch_lut_path = "beauty_glitch_lut_path";
string beauty_glitch_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; beauty_glitch_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(beauty_glitch_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != beauty_glitch_lut_filename) {
            beauty_glitch_lut_filename = new_lut;
            loadTexture('beauty_glitch_lut, beauty_glitch_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'dust_opacity, getParameterFloat('dust_opacity));
    setShaderUniform('pass0, 'flash_strength, getParameterFloat('flash_strength));
    setShaderUniform('pass0, 'overlay_fps, getParameterFloat('overlay_fps));

    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslBeautyGlitch = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'beauty_glitch_lut
    uniform float lut_strength;
    uniform float dust_opacity;
    uniform float flash_strength;
    uniform float overlay_fps;
    uniform float u_time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }
    vec2 hash22(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.xx + p3.yz) * p3.zy);
    }

    // Sparse dust on an aspect-correct cell grid (~1 per 25 cells): about a third are round specks, the
    // rest short thin hairs at random angles. th = hair thickness in cell units.
    float specks(vec2 p, float f, float th) {
      vec2 off = vec2(f * 13.7, f * 7.3);
      vec2 g = floor(p * 26.0 + off);
      vec2 cell = fract(p * 26.0 + off);
      float has = step(0.96, hash21(g + f * 1.31));
      vec2 rp = 0.2 + 0.6 * hash22(g + 0.7);
      float sz = 0.03 + 0.05 * hash21(g + 1.7);
      float spk = smoothstep(sz, sz * 0.3, distance(cell, rp));
      float a = 6.2831 * hash21(g + 3.1);
      vec2 dir = vec2(cos(a), sin(a));
      float halfLen = 0.08 + 0.17 * hash21(g + 4.7);
      vec2 d = cell - rp;
      float along = clamp(dot(d, dir), -halfLen, halfLen);
      float hair = (1.0 - smoothstep(th * 0.5, th * 1.5, length(d - dir * along))) * (0.6 + 0.4 * hash21(g + 5.9));
      return has * mix(spk, hair, step(0.35, hash21(g + 2.3)));
    }

    // 0-2 hairline vertical scratches per frame, about 1.5 px wide, fading along their length.
    float scratches(vec2 tuv, float f, float px) {
      float s = 0.0;
      for (float i = 0.0; i < 2.0; i += 1.0) {
        float k = f * 3.1 + i * 11.7;
        if (hash11(k + 0.13) < 0.55) {
          float x = hash11(k + 0.29);
          float w = px * (1.0 + hash11(k + 0.37));
          float len = smoothstep(hash11(k + 0.41) * 0.6, 1.0, 1.0 - abs(tuv.y - hash11(k + 0.53)));
          s = max(s, (1.0 - smoothstep(0.0, w, abs(tuv.x - x))) * len);
        }
      }
      return s;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = mix(cam.rgb, lutLookup(cam.rgb), lut_strength * strength);

      vec2 tuv = topUv(uv);
      // Bounded frame index keeps the hashes in full f32 precision however long the clip runs.
      float f = mod(floor(u_time * overlay_fps), 997.0);
      vec2 p = vec2(tuv.x * source_size_x / max(source_size_y, 1.0), tuv.y);
      float px = 1.5 / max(source_size_x, 1.0);
      float th = 1.2 * 26.0 / max(source_size_y, 1.0);
      float dust = max(specks(p, f, th) * 0.5, scratches(tuv, f, px) * 0.6);
      // Occasional ~0.1 s flash: ~1 in 6 frames, brightening 10-25%.
      float flash = step(0.83, hash11(f * 0.7 + 5.3)) * (0.55 + 0.45 * hash11(f + 9.1));
      result = result * (1.0 + flash_strength * flash * strength);
      result += vec3(dust * dust_opacity * strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
