[Filter PinkTea]
# "pink tea :-)" ported from the Spark effect (213026050749069). Single fragment pass, no face tracking.
#
#   Spark: a full-screen FastColorLUT of the camera ("CUTE TONE", 1024x1024 8x8 atlas, nearest filter, colour
#   clamp 0.0078125..0.98438), drawn opaque and unlit, then a static grain rect (layer1, 110% x 100% of the canvas,
#   pinned top-left) multiplied on top with tint 230/255. A screen tap toggles the grain; with no tap it is ON.
#   The pink look is the LUT: it lifts blue on warm tones (beige 150,135,120 -> 179,162,155).
#   Dropped (face-tracked): blush "mkup" (texture alpha <= 56/255 x 0.389, so <= 8.5% peak), lips (colorPaint,
#   <= 12.5% peak) and three face-region LUT meshes that re-apply the same LUT to the same camera pixels.
#   Spark's 0.2775 retouch smoothing is faked with a light edge-aware full-frame blur.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('pink_tea_lut);
    makeTexture('pink_tea_grain);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.2774758534888699, min = 0.0, max = 1.0, description = "Soft full-frame smoothing (fakes the Spark skin retouch)"},
        {grain_on = 1.0, min = 0.0, max = 1.0, description = "Grain layer (Spark tap toggle; 1 = untapped default)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'pink_tea_lut, 'pink_tea_grain},
      uniforms = {
        strength = 1.0,
        smooth_strength = 0.2774758534888699,
        grain_on = 1.0,
        lut_size_x = 1024.0,
        lut_size_y = 1024.0,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslPinkTea,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string pink_tea_lut_path = "pink_tea_lut_path";
string pink_tea_lut_filename = "";
string pink_tea_grain_path = "pink_tea_grain_path";
string pink_tea_grain_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'grain_on, getParameterFloat('grain_on));

    # iOS passes the remote LUT under the generic 'lut_path; pink_tea_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(pink_tea_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != pink_tea_lut_filename) {
            pink_tea_lut_filename = new_lut;
            loadTexture('pink_tea_lut, pink_tea_lut_filename);
        }
    }
    string grain_param = getParameterString(pink_tea_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != pink_tea_grain_filename) {
            pink_tea_grain_filename = new_grain;
            loadTexture('pink_tea_grain, pink_tea_grain_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 lutSize = getTextureSize('pink_tea_lut);
    if (lutSize.x > 0.0 and lutSize.y > 0.0) {
        setShaderUniform('pass0, 'lut_size_x, lutSize.x);
        setShaderUniform('pass0, 'lut_size_y, lutSize.y);
    }
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslPinkTea = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'pink_tea_lut (CUTE TONE, 1024x1024, nearest in Spark)
    uniform sampler2D auxSampler2;  // 'pink_tea_grain (576x1024)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float grain_on;
    uniform float lut_size_x;
    uniform float lut_size_y;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat areas soften.
    vec4 smoothTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    vec3 smoothBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += smoothTap(uv + d * vec2(1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, 1.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, -1.0), y0);
      acc += smoothTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = cam.rgb;
      if (smooth_strength > 0.0) {
        s = mix(s, smoothBlur(uv, s), smooth_strength);
      }
      vec3 c = clamp(s, 0.0078125, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec2 lutUv = vec2(c.r / 8.0 + col, c.g / 8.0 + row);
      // Spark samples this LUT with filter=nearest; snap to the texel centre so a linear sampler matches.
      vec2 lutSize = vec2(lut_size_x, lut_size_y);
      lutUv = (floor(lutUv * lutSize) + 0.5) / lutSize;
      vec3 spark = texture2D(auxSampler1, lutUv).rgb;
      if (grain_on > 0.5) {
        // Grain rect is 110% of the canvas width, pinned left/top, so the frame shows u in [0, 1/1.1].
        vec2 t = topUv(uv);
        vec3 g = texture2D(auxSampler2, vec2(t.x / 1.1, t.y)).rgb;
        // Spark multiply with premultiplied opaque source: dst * src.rgb; src.rgb = grain * 230/255.
        spark = spark * (g * 0.9019607843137255);
      }
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
