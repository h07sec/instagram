[Filter Jack]
# "Jack" — black & white picture-in-picture. Ported from the Spark effect "jack"
# (tracker "Jack", 696213375070690). Static, single fragment pass, bottom -> top:
#
#   Layer 1 — Background: the camera zoomed 2x about the centre (Spark: a camera
#             rectangle at 200% of the 375x667 canvas, centred), through the LUT.
#   Layer 2 — A 20% white veil over the background (Spark: untextured default
#             material, opacity 0.2), so the inset stands out.
#   Layer 3 — Inset: a miniature of the whole camera image, 65% of the canvas,
#             centred (Spark: camera rectangle at 65%, offset (65.6, 116.7)),
#             through the same LUT.
#
# Both camera layers use Spark's "lagertha" FastColorLUT, a pure black & white
# grade. The project's other two LUTs ("rojo", "Black day") are not sampled by
# the compiled graph and are dropped. Nothing in the Spark project animates.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('jack_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength (Spark FastColorLUT, full strength)"},
        {veil_opacity = 0.2, min = 0.0, max = 1.0, description = "White veil over the zoomed background (Spark material opacity 0.2)"},
        {inset_size = 0.65, min = 0.3, max = 1.0, description = "Inset size as a fraction of the frame (Spark: 65%)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'jack_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        veil_opacity = 0.2,
        inset_size = 0.65,
      },
      glslShader = glslJack,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string jack_lut_path = "jack_lut_path";
string jack_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; jack_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(jack_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != jack_lut_filename) {
            jack_lut_filename = new_lut;
            loadTexture('jack_lut, jack_lut_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 vo = getParameterFloat('veil_opacity);
    setShaderUniform('pass0, 'veil_opacity, vo);

    f32 is = getParameterFloat('inset_size);
    setShaderUniform('pass0, 'inset_size, is);
}

#### GLSL shader ####

string glslJack = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'jack_lut

    uniform float lut_strength;
    uniform float veil_opacity;
    uniform float inset_size;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    vec3 graded(vec2 uv) {
      vec3 c = sampleInput(uv).rgb;
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      return mix(c, lutLookup(c), strength * lut_strength);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);

      // Layer 3: centred inset showing the whole camera image. Inside it, skip the
      // background's two texture fetches, which the inset would overwrite anyway.
      vec2 local = (uv - 0.5) / inset_size + 0.5;
      vec3 result;
      if (local.x >= 0.0 && local.x <= 1.0 && local.y >= 0.0 && local.y <= 1.0) {
        result = graded(local);
      } else {
        // Layers 1 + 2: centre-zoomed 2x background under a white veil.
        result = mix(graded((uv - 0.5) * 0.5 + 0.5), vec3(1.0), veil_opacity);
      }

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
