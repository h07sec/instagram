[Filter VhsIi]
# "VHS ll" ported from the Spark effect (234871828164970). Single fragment pass,
# no face tracking.
#
#   Grade: 8x8 LUT (Spark FastColorLUT, input clamp 0.05..0.98) at 1, x #FFF0FF and the 0.0959 #4F4F4F multiply (baked).
#   Noise: Spark 50-frame VHS sequence (20 fps, 2.5 s loop), screen 0.8, procedural.
#   Label: PLAY + blinking triangle (Spark pla1/pla2 at 1 fps, 2 s period), screen 0.9,
#          anchored top-right and scaled by the shorter frame side so it never stretches.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('vhs_ii_lut);
    makeTexture('vhs_ii_play);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 0.9, min = 0.0, max = 1.0, description = "Opacity of the play overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'vhs_ii_lut, 'vhs_ii_play},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 0.9,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslVhsIi,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string vhs_ii_lut_path = "vhs_ii_lut_path";
string vhs_ii_lut_filename = "";
string vhs_ii_play_path = "vhs_ii_play_path";
string vhs_ii_play_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(vhs_ii_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != vhs_ii_lut_filename) {
            vhs_ii_lut_filename = new_lut;
            loadTexture('vhs_ii_lut, vhs_ii_lut_filename);
        }
    }

    string vhs_ii_play_param = getParameterString(vhs_ii_play_path);
    if (vhs_ii_play_param != "") {
        string new_vhs_ii_play = stringAppend("textureFilePath://", vhs_ii_play_param);
        if (new_vhs_ii_play != vhs_ii_play_filename) {
            vhs_ii_play_filename = new_vhs_ii_play;
            loadTexture('vhs_ii_play, vhs_ii_play_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
    # Time drives the noise and the blinking triangle.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslVhsIi = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'vhs_ii_lut
    uniform sampler2D auxSampler2;  // 'vhs_ii_play

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.05, 0.98);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;
      vec2 tu = topUv(uv);

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Spark 50-frame VHS noise (20 fps, screen 0.8, tint #FFEBFF), procedural on the 388x690 frame grid:
      // dark top-down ramp, tracking band in the bottom 10 %, white specks on the bottom edge, per-frame grain,
      // sparse faint dropout dashes (about 5 per frame) and a rare faint full-height vertical line.
      {
        float nf = mod(floor(time * 20.0), 50.0);
        vec2 g = tu * vec2(388.0, 690.0);
        float h = hash12(floor(g) + vec2(nf * 17.0));
        float base = 0.024 + 0.055 * smoothstep(0.0, 0.35, tu.y) + 0.055 * smoothstep(0.88, 0.92, tu.y);
        float speck = step(0.9, h) * smoothstep(0.97, 0.995, tu.y) * 0.7;
        // Dropout dashes: 24x3 cells, about 1 in 700 lit per frame, a 4..20 px white run, 1 px tall.
        vec2 dc = floor(g / vec2(24.0, 3.0));
        float dh = hash12(dc + vec2(nf * 31.0, 7.0));
        float dlen = 4.0 + 16.0 * fract(dh * 97.0);
        float dx = g.x - dc.x * 24.0;
        float dy = g.y - dc.y * 3.0;
        float dash = step(0.9986, dh) * step(dx, dlen) * step(1.0, dy) * step(dy, 2.0) * (0.25 + 0.3 * fract(dh * 53.0));
        // Vertical line: on about 1 frame in 6, one column, faint.
        float vh = hash12(vec2(nf, 3.0));
        float vline = step(0.83, vh) * step(abs(g.x - floor(fract(vh * 71.0) * 388.0) - 0.5), 0.6) * 0.06;
        vec3 vn = clamp(vec3(base * (0.7 + 0.6 * h) + speck + dash + vline) * vec3(1.0, 0.97, 1.3), 0.0, 1.0);
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - vn), 0.8 * strength);
      }
      // PLAY label from 'vhs_ii_play (pla1 | pla2 side by side, each 576x1024, authored top-origin).
      // Only the label rectangle (x 382..536, y 86..124 of the 576x1024 frame) is sampled, anchored to the
      // top-right corner and scaled by min(width, height) / 576, so its aspect ratio never changes.
      // Spark flips pla1 / pla2 at 1 fps: the triangle is on for 1 s, off for 1 s.
      {
        // auxSampler2 = pass input 3 ('vhs_ii_play).
        float pf = mod(floor(time), 2.0);
        vec2 sz = vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
        vec2 px = tu * sz;
        float s = min(sz.x, sz.y) / 576.0;
        vec2 rp = vec2(576.0 - (sz.x - px.x) / s, px.y / s);
        float inside = step(382.0, rp.x) * step(rp.x, 536.0) * step(86.0, rp.y) * step(rp.y, 124.0);
        vec2 rc = clamp(rp, vec2(382.0, 86.0), vec2(536.0, 124.0));
        vec3 ov = texture2D(auxSampler2, vec2((rc.x + pf * 576.0) / 1152.0, rc.y / 1024.0)).rgb * inside;
        result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov), overlay_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
