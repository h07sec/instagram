[Filter IgluscriptVideoJumpFilter]

# Exact AE curves from POSITION_JUMP_IN/POS.
f32 WINDOW_DURATION = 1.5;
f32 VELOCITY_STEP = 0.008;
f32 BLUR_SCALE = 46.25;
f32 PI = 3.14159265;

# Position Y keyframes, normalized to the behavior progress window.
# Values are offsets from the final rest position in fractions of frame height.
f32 PYT0 = 0.0;
f32 PYT1 = 0.32;
f32 PYT2 = 0.5185066667;
f32 PYT3 = 0.6296177778;
f32 PYT4 = 0.7407288889;
f32 PYT5 = 0.85184;
f32 PYT6 = 1.0;
f32 PYK0 = 0.5404542742;
f32 PYK1 = -0.0781004133;
f32 PYK2 = -0.0328125;
f32 PYK3 = -0.0315631633;
f32 PYK4 = -0.00546875;
f32 PYK5 = -0.00859375;
f32 PYK6 = 0.0;

# Rotation keyframes, normalized independently because the AE times differ.
f32 RT0 = 0.0;
f32 RT1 = 0.3703822222;
f32 RT2 = 0.5185066667;
f32 RT3 = 0.7407288889;
f32 RT4 = 0.85184;
f32 RT5 = 1.0;
f32 RK0 = 0.0;
f32 RK1 = -15.0;
f32 RK2 = -21.0;
f32 RK3 = 4.0;
f32 RK4 = -1.0;
f32 RK5 = 0.0;

fun mix(f32 a, f32 b, f32 t) f32 {
  return a * (1.0 - t) + b * t;
}

fun cssBezier(f32 time, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 t = time;
  f32 i = 0.0;
  while (i < 8.0) {
    f32 u = 1.0 - t;
    f32 xt = 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t;
    f32 dxdt = 3.0 * u * u * x1 + 6.0 * u * t * (x2 - x1) + 3.0 * t * t * (1.0 - x2);
    t = t - (xt - time) / max(dxdt, 0.0001);
    t = clamp(t, 0.0, 1.0);
    i = i + 1.0;
  }
  f32 u = 1.0 - t;
  return 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t;
}

fun evalOffsetY(f32 p) f32 {
  f32 offsetY = PYK6;
  f32 f = 0.0;
  f32 t = 0.0;

  if (p < PYT1) {
    f = (p - PYT0) / (PYT1 - PYT0);
    t = cssBezier(f, 0.166667, 0.166667, 0.0, 1.0);
    offsetY = mix(PYK0, PYK1, t);
  } else if (p < PYT2) {
    f = (p - PYT1) / (PYT2 - PYT1);
    t = cssBezier(f, 0.632182, 0.0, 0.833333, 0.833333);
    offsetY = mix(PYK1, PYK2, t);
  } else if (p < PYT3) {
    f = (p - PYT2) / (PYT3 - PYT2);
    t = cssBezier(f, 0.166667, 0.166667, 0.517996, -2.890487);
    offsetY = mix(PYK2, PYK3, t);
  } else if (p < PYT4) {
    f = (p - PYT3) / (PYT4 - PYT3);
    t = cssBezier(f, 0.573986, 0.068401, 0.887189, 0.909312);
    offsetY = mix(PYK3, PYK4, t);
  } else if (p < PYT5) {
    f = (p - PYT4) / (PYT5 - PYT4);
    t = cssBezier(f, 0.160721, -1.078862, 0.688274, 1.0);
    offsetY = mix(PYK4, PYK5, t);
  } else if (p < PYT6) {
    f = (p - PYT5) / (PYT6 - PYT5);
    t = cssBezier(f, 0.338934, 0.0, 0.833333, 0.833333);
    offsetY = mix(PYK5, PYK6, t);
  }

  return offsetY;
}

fun evalRotationDeg(f32 p) f32 {
  f32 rotationDeg = RK5;
  f32 f = 0.0;
  f32 t = 0.0;

  if (p < RT1) {
    f = (p - RT0) / (RT1 - RT0);
    t = cssBezier(f, 0.166667, 0.166667, 0.0, 1.0);
    rotationDeg = mix(RK0, RK1, t);
  } else if (p < RT2) {
    f = (p - RT1) / (RT2 - RT1);
    t = cssBezier(f, 1.0, 0.0, 0.833333, 0.833333);
    rotationDeg = mix(RK1, RK2, t);
  } else if (p < RT3) {
    f = (p - RT2) / (RT3 - RT2);
    t = cssBezier(f, 0.166667, 0.166667, 0.833333, 0.833333);
    rotationDeg = mix(RK2, RK3, t);
  } else if (p < RT4) {
    f = (p - RT3) / (RT4 - RT3);
    t = cssBezier(f, 0.166667, 0.166667, 0.833333, 1.0);
    rotationDeg = mix(RK3, RK4, t);
  } else if (p < RT5) {
    f = (p - RT4) / (RT5 - RT4);
    t = cssBezier(f, 0.166667, 0.0, 0.833333, 0.833333);
    rotationDeg = mix(RK4, RK5, t);
  }

  return rotationDeg;
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {duration = 1.125, min = 0.9, max = 1.5, description = "Jump length in seconds"},
    {amount = 1.0, min = 0.0, max = 1.0, description = "Rotation amount"},
  };

  filter.passes = {
    {
      name = 'dirBlur,
      inputs = {'default},
      uniforms = {
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
        inputSize = {720.0, 1280.0},
      },
      glslShader = blurGlsl,
    },
    {
      name = 'jumpFx,
      inputs = {'dirBlur},
      uniforms = {
        offsetY = 0.0,
        rotation = 0.0,
        opacity = 1.0,
        aspect = 1.0,
        inputSize = {720.0, 1280.0},
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = glsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 progressFromHost = getParameterFloat('progress);
  f32 duration = getParameterFloat('duration);
  f32 playbackRate = WINDOW_DURATION / duration;
  f32 p = clamp(progressFromHost * playbackRate, 0.0, 1.0);

  vec2 size = getTextureSize('default);
  f32 texelSize = 1.0 / size.y;
  f32 aspect = size.x / size.y;

  # Evaluate current and prior local progress for velocity-oriented motion blur.
  f32 pPrev = max(p - VELOCITY_STEP, 0.0);
  f32 offsetY = evalOffsetY(p);
  f32 offsetYPrev = evalOffsetY(pPrev);
  f32 amount = clamp(getParameterFloat('amount), 0.0, 1.0);
  f32 rotationDeg = evalRotationDeg(p) * amount;
  f32 rotation = rotationDeg * PI / 180.0;

  vec2 velocity = {0.0, offsetY - offsetYPrev};
  f32 speed = length(velocity);
  vec2 ghostDir = {0.0, 1.0};
  if (speed > 0.00001) {
    ghostDir = velocity / speed;
  }

  # BLUR_SCALE compensates for the smaller authored offset units. playbackRate
  # makes shorter duration settings smear farther because they move faster.
  f32 ghostSpread = speed * BLUR_SCALE * 10.0 * texelSize * playbackRate;
  f32 blurFade = clamp((1.0 - p) / 0.1, 0.0, 1.0);
  ghostSpread = ghostSpread * blurFade;

  # Keep the inherited first-frame fade to avoid a visible entrance pop.
  f32 opacity = clamp(p / 0.06, 0.0, 1.0);

  setShaderUniform('dirBlur, 'ghostSpread, ghostSpread);
  setShaderUniform('dirBlur, 'ghostDir, ghostDir);
  setShaderUniform('dirBlur, 'inputSize, size);
  setShaderUniform('jumpFx, 'offsetY, offsetY);
  setShaderUniform('jumpFx, 'rotation, rotation);
  setShaderUniform('jumpFx, 'opacity, opacity);
  setShaderUniform('jumpFx, 'aspect, aspect);
  setShaderUniform('jumpFx, 'inputSize, size);
  setShaderUniform('jumpFx, 'ghostSpread, ghostSpread * 0.5);
  setShaderUniform('jumpFx, 'ghostDir, ghostDir);
}

string blurGlsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float ghostSpread;
uniform vec2 ghostDir;
uniform vec2 inputSize;

float clipAlpha(vec2 uv) {
  vec2 texel = 1.0 / max(inputSize, vec2(1.0));
  vec2 d = min(uv, 1.0 - uv);
  vec2 a = clamp(d / texel + 0.5, 0.0, 1.0);
  return a.x * a.y;
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 gUV = uv + ghostDir * ghostSpread * fi;
    float k = 2.0;
    float weight = (1.0 / (1.0 + k * abs(fi))) * clipAlpha(gUV);
    color += sampleInput(gUV) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(color / max(totalWeight, 0.001));
}
";

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float offsetY;
uniform float rotation;
uniform float opacity;
uniform float aspect;
uniform vec2 inputSize;
uniform float ghostSpread;
uniform vec2 ghostDir;

// One-pixel antialiased frame edge. The +0.5 bias keeps an untransformed
// frame fully opaque at interior pixel centers while clipping transformed UVs.
float clipAlpha(vec2 uv) {
  vec2 texel = 1.0 / max(inputSize, vec2(1.0));
  vec2 d = min(uv, 1.0 - uv);
  vec2 a = clamp(d / texel + 0.5, 0.0, 1.0);
  return a.x * a.y;
}

void main() {
  // Apply the inverse of AE's position-then-rotation layer transform in
  // isotropic units of frame height so non-square inputs do not skew.
  vec2 p = (sourceTextureCoordinate - vec2(0.5)) * vec2(aspect, 1.0);
  p.y += UP * offsetY;

  float rot = UP * rotation;
  float c = cos(rot);
  float s = sin(rot);
  p = vec2(p.x * c - p.y * s, p.x * s + p.y * c);

  vec2 uv = p / vec2(aspect, 1.0) + vec2(0.5);
  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 gUV = uv - ghostDir * ghostSpread * fi;
    float k = 2.0;
    float falloff = pow(1.0 / (1.0 + k * abs(fi)), 0.5);
    float weight = falloff * clipAlpha(gUV);
    color += sampleInput(gUV) * weight;
    totalWeight += weight;
  }

  color /= max(totalWeight, 0.001);
  color *= opacity;
  gl_FragColor = toOutputFormat(color);
}
";
