[Filter BlurBackground]
# "Blur Background ✨" ported from the Spark effect (516514899698264). Single fragment pass, no face
# tracking, no assets.
#
#   Spark: the camera blurred with its library Blur patch (Amount 0.6) as the bottom layer, the sharp
#   camera on top through the person segmentation. The blur is the average of a 21-tap horizontal and a
#   21-tap vertical binomial blur (C(24,k)/2^24, Spark's stored 5-decimal weights), both read straight
#   from the camera, 1/563.2 UV apart. It's a plus-shaped blur, not a separable 2-D one.
#   So the person is sharp and the background is blurred. No grade, overlay, time or UI.
#
#   Segmentation: the person mask is the host-bound 'mask named input (the manifest's iglu.subject
#   block asks the host for it). Coverage is the brightest channel, so SAM3 instance colours and
#   single-channel masks both work. Hosts that bind no mask get the effect on the full frame.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'mask},
      uniforms = {
        strength = 1.0,
        has_mask = 0.0,
      },
      glslShader = glslBlurBackground,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # A host-bound mask is at least a few px; an unbound slot reports (0, 0) or a 1x1 placeholder.
    vec2 maskSize = getTextureSize('mask);
    f32 hasMask = 0.0;
    if (maskSize.x > 4.0) {
        hasMask = 1.0;
    }
    setShaderUniform('pass0, 'has_mask, hasMask);
}

#### GLSL shader ####

string glslBlurBackground = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'mask (host person segmentation)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float has_mask;

    // Spark Blur patch, Amount 0.6: toRange(0.6, 1024, 256) = 563.2.
    const float kStep = 1.0 / 563.2;

    vec3 pairTap(vec2 uv, vec2 d, float w) {
      return w * (sampleInput(uv + d).rgb + sampleInput(uv - d).rgb);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Person coverage from the host mask; no mask = the effect on the full frame.
      float cover = 0.0;
      if (has_mask > 0.5) {
        vec4 m = texture2D(auxSampler1, uv);
        cover = clamp(max(m.r, max(m.g, m.b)), 0.0, 1.0);
      }

      // Fully covered pixels show the sharp camera, so they skip the blur.
      vec3 blur = vec3(0.0);
      if (cover < 1.0) {
        vec2 dx = vec2(kStep, 0.0);
        vec2 dy = vec2(0.0, kStep);
        vec3 h = 0.16118 * cam.rgb;
        vec3 v = h;
        h += pairTap(uv, dx, 0.14878);         v += pairTap(uv, dy, 0.14878);
        h += pairTap(uv, dx * 2.0, 0.11690);   v += pairTap(uv, dy * 2.0, 0.11690);
        h += pairTap(uv, dx * 3.0, 0.07793);   v += pairTap(uv, dy * 3.0, 0.07793);
        h += pairTap(uv, dx * 4.0, 0.04384);   v += pairTap(uv, dy * 4.0, 0.04384);
        h += pairTap(uv, dx * 5.0, 0.02063);   v += pairTap(uv, dy * 5.0, 0.02063);
        h += pairTap(uv, dx * 6.0, 0.00802);   v += pairTap(uv, dy * 6.0, 0.00802);
        h += pairTap(uv, dx * 7.0, 0.00253);   v += pairTap(uv, dy * 7.0, 0.00253);
        h += pairTap(uv, dx * 8.0, 0.00063);   v += pairTap(uv, dy * 8.0, 0.00063);
        h += pairTap(uv, dx * 9.0, 0.00012);   v += pairTap(uv, dy * 9.0, 0.00012);
        h += pairTap(uv, dx * 10.0, 0.00002);  v += pairTap(uv, dy * 10.0, 0.00002);
        blur = 0.5 * (h + v);
      }
      vec3 result = mix(cam.rgb, mix(blur, cam.rgb, cover), strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
