[Filter RetrZinho]
# "RETROZINHO" ported from the Spark effect (344872754171117). Single fragment pass, NO face tracking.
#
#   Spark, in draw order (all unlit default materials, canvas images 100% x 100%):
#   1. Two identical full-screen rects (lut, rgb 1) with the same shader: Professional LUT patch (clamp 0.04 / 0.96
#      into an 8x8 atlas, no blue interpolation) on mix(Classsix, 5, 0.4), applied at 0.85 over the camera, then an
#      RGB split: R at uv, G and B sampled through Texture Transform scales 1.006 and 1.012 about the frame centre,
#      recombined with the visual-shader Add blend. Opaque, so the second rect repeats the first.
#   2. Face pair (DROPPED): occ redraws the same grade from the face-region texture under faceMeshMask (same pixels
#      as step 1); deform redraws it on a 0.95 x-scaled face mesh under a small nose mask at opacity 0.507,
#      a ~2.5% effective nose slim. Both too faint to be a signature of the look.
#   3. grain: Grain 02 multiply at 0.0685, then grain0: Grain 02 subtract at 0.219. Spark hides both on the back
#      camera, and the Spark sample is a back-camera clip, so front_camera defaults to 0 (1 adds them).
#   4. dust: 102-frame dust sequence, 13 fps, looping, screen at 0.548. Frames ship in one 6x6 atlas of 368x640
#      cells, three greyscale frames per cell (R, G, B) in sequence order.
#   Not ported: the hidden retouch mesh (skin smoothing factor 0.02, negligible).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('retr_zinho_lut_a);
    makeTexture('retr_zinho_lut_b);
    makeTexture('retr_zinho_grain);
    makeTexture('retr_zinho_dust);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {front_camera = 0.0, min = 0.0, max = 1.0, description = "0 = back-camera look as in the Spark sample (grain hidden), 1 = front-camera look with the two grain layers"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'retr_zinho_lut_a, 'retr_zinho_lut_b, 'retr_zinho_grain, 'retr_zinho_dust},
      uniforms = {
        strength = 1.0,
        time = 0.0,
        front_camera = 0.0,
      },
      glslShader = glslRetrZinho,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string retr_zinho_lut_a_path = "retr_zinho_lut_a_path";
string retr_zinho_lut_a_filename = "";
string retr_zinho_lut_b_path = "retr_zinho_lut_b_path";
string retr_zinho_lut_b_filename = "";
string retr_zinho_grain_path = "retr_zinho_grain_path";
string retr_zinho_grain_filename = "";
string retr_zinho_dust_path = "retr_zinho_dust_path";
string retr_zinho_dust_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'front_camera, getParameterFloat('front_camera));

    # iOS passes the remote LUT under the generic 'lut_path; retr_zinho_lut_a_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(retr_zinho_lut_a_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != retr_zinho_lut_a_filename) {
            retr_zinho_lut_a_filename = new_lut;
            loadTexture('retr_zinho_lut_a, retr_zinho_lut_a_filename);
        }
    }
    string lut_b_param = getParameterString(retr_zinho_lut_b_path);
    if (lut_b_param != "") {
        string new_lut_b = stringAppend("textureFilePath://", lut_b_param);
        if (new_lut_b != retr_zinho_lut_b_filename) {
            retr_zinho_lut_b_filename = new_lut_b;
            loadTexture('retr_zinho_lut_b, retr_zinho_lut_b_filename);
        }
    }
    string grain_param = getParameterString(retr_zinho_grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != retr_zinho_grain_filename) {
            retr_zinho_grain_filename = new_grain;
            loadTexture('retr_zinho_grain, retr_zinho_grain_filename);
        }
    }
    string dust_param = getParameterString(retr_zinho_dust_path);
    if (dust_param != "") {
        string new_dust = stringAppend("textureFilePath://", dust_param);
        if (new_dust != retr_zinho_dust_filename) {
            retr_zinho_dust_filename = new_dust;
            loadTexture('retr_zinho_dust, retr_zinho_dust_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslRetrZinho = "
    precision highp float;

    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'retr_zinho_lut_a (Classsix, 510x510)
    uniform sampler2D auxSampler2;  // 'retr_zinho_lut_b (5, 512x512)
    uniform sampler2D auxSampler3;  // 'retr_zinho_grain (Grain 02, 1024x1024)
    uniform sampler2D auxSampler4;  // 'retr_zinho_dust (6x6 atlas of 368x640 cells, 3 frames per cell)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;
    uniform float front_camera;

    const vec2 kCell = vec2(368.0, 640.0);
    const vec2 kAtlas = vec2(2208.0, 3840.0);
    const float kFps = 13.0;
    const float kFrames = 102.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark LUT shader at one camera position: the clamp only feeds the lookup, the 0.85 mix uses the raw camera.
    vec3 grade(vec2 p) {
      vec3 c = sampleInput(p).rgb;
      vec3 cc = clamp(c, 0.04, 0.96);
      float row = floor(cc.b * 8.0) / 8.0;
      float col = floor((cc.b - row) * 64.0) / 8.0;
      vec2 lutUv = vec2(cc.r / 8.0 + col, cc.g / 8.0 + row);
      vec3 lut = mix(texture2D(auxSampler1, lutUv).rgb, texture2D(auxSampler2, lutUv).rgb, 0.4);
      return mix(c, lut, 0.85);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamps below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Texture Transform samples at inverse(M) * uv; M scales about pivot (0.5, 0.5) by 1.006 (G) and 1.012 (B).
      vec2 uvG = (uv - 0.5) / 1.006 + 0.5;
      vec2 uvB = (uv - 0.5) / 1.012 + 0.5;
      // Add-blend recombination of x001 / 0y01 / 00z1, min(dest + src, 1); then the UNORM target clamps.
      vec3 d = clamp(min(vec3(grade(uv).r, grade(uvG).g, grade(uvB).b), 1.0), 0.0, 1.0);

      vec2 st = topUv(uv);
      if (front_camera > 0.5) {
        vec3 g = texture2D(auxSampler3, st).rgb;
        // grain: multiply blend, premultiplied source (g * a, a): dst * (g * a + 1 - a).
        d = d * (1.0 - 0.0684931506849315 + 0.0684931506849315 * g);
        // grain0: subtract blend, ReverseSubtract with SrcAlpha / One.
        d = max(d - 0.2191780821917808 * g, 0.0);
      }

      // dust: frame at 13 fps looping over 102 frames; mod() keeps the index small however long the clip runs.
      float frame = mod(floor(time * kFps), kFrames);
      float cell = floor(frame / 3.0);
      float ch = frame - cell * 3.0;
      vec2 cellXY = vec2(mod(cell, 6.0), floor(cell / 6.0));
      vec2 inCell = clamp(st * kCell, vec2(0.5), kCell - 0.5);
      vec3 t = texture2D(auxSampler4, (cellXY * kCell + inCell) / kAtlas).rgb;
      float dust = ch < 0.5 ? t.r : (ch < 1.5 ? t.g : t.b);
      // screen blend, premultiplied source: src + dst * (1 - src).
      float s = 0.547945205479452 * dust;
      d = s + d * (1.0 - s);

      vec3 result = mix(cam.rgb, d, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
