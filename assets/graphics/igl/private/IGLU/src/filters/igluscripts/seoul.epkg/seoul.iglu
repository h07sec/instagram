[Filter Seoul]
# "Seoul" (Spark 885986782275200), SCRATCH port of the screen-space layers. Single fragment pass.
#
#   Spark draw order (canvas lut, scene order), all unlit:
#     1. lut: 8x8-grid LUT "by chin2" (750x750; clamp 0.05 / 0.98, one bilinear tap), alpha over at 0.8356.
#     2. lut0 (picker index 1 only): RGB noise 375x667 stretched to the frame, multiply at 0.14.
#     3. lut1 (picker index 2 only): KiraKira sparkle patch on texture "2". NOT ported (see PORT_NOTES).
#   Param mode: 0 = picker default (the Spark sample), 1 = + noise multiply. 2 renders as 0.
#   Dropped: blush 0.342, PBR face sheen (gloww), lips 0.15, fullScreen smoothing 1.0 (x6 meshes).
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('seoul_lut);
    makeTexture('seoul_noise);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {mode = 0.0, min = 0.0, max = 1.0, description = "Spark picker option: 0 = grade (default), 1 = grade + colour-noise multiply; rounded to an integer"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'seoul_lut, 'seoul_noise},
      uniforms = {
        strength = 1.0,
        mode = 0.0,
      },
      glslShader = glslSeoul,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string seoul_lut_path = "seoul_lut_path";
string seoul_lut_filename = "";
string seoul_noise_path = "seoul_noise_path";
string seoul_noise_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'mode, getParameterFloat('mode));

    # iOS passes the remote LUT under the generic 'lut_path; seoul_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(seoul_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != seoul_lut_filename) {
            seoul_lut_filename = new_lut;
            loadTexture('seoul_lut, seoul_lut_filename);
        }
    }
    string noise_param = getParameterString(seoul_noise_path);
    if (noise_param != "") {
        string new_noise = stringAppend("textureFilePath://", noise_param);
        if (new_noise != seoul_noise_filename) {
            seoul_noise_filename = new_noise;
            loadTexture('seoul_noise, seoul_noise_filename);
        }
    }
}

#### GLSL shader ####

string glslSeoul = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'seoul_lut (by chin2, 750x750, 8x8 grid)
    uniform sampler2D auxSampler2;  // 'seoul_noise (375x667 RGB noise, opaque)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float mode;

    const float kLutOpacity = 0.8356164383561644;
    const float kNoiseOpacity = 0.14;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark LUT patch as compiled: clamp 0.05 / 0.98, 8x8 grid, one bilinear tap.
    vec3 lut(vec3 rgb) {
      vec3 c = clamp(rgb, 0.05, 0.98);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamps below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 col = mix(cam.rgb, lut(cam.rgb), kLutOpacity);
      if (floor(mode + 0.5) == 1.0) {
        vec3 n = texture2D(auxSampler2, topUv(uv)).rgb;
        col = col * mix(vec3(1.0), n, kNoiseOpacity);
      }
      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
