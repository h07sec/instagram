[Filter PaperFrame]
# "Paper Frame" ported from the Spark effect (443558793314163). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Overlay: 'paper_frame_paper alpha-blended full-frame at 1.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('paper_frame_lut);
    makeTexture('paper_frame_paper);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the paper overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'paper_frame_lut, 'paper_frame_paper},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
      },
      glslShader = glslPaperFrame,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string paper_frame_lut_path = "paper_frame_lut_path";
string paper_frame_lut_filename = "";
string paper_frame_paper_path = "paper_frame_paper_path";
string paper_frame_paper_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(paper_frame_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != paper_frame_lut_filename) {
            paper_frame_lut_filename = new_lut;
            loadTexture('paper_frame_lut, paper_frame_lut_filename);
        }
    }

    string paper_frame_paper_param = getParameterString(paper_frame_paper_path);
    if (paper_frame_paper_param != "") {
        string new_paper_frame_paper = stringAppend("textureFilePath://", paper_frame_paper_param);
        if (new_paper_frame_paper != paper_frame_paper_filename) {
            paper_frame_paper_filename = new_paper_frame_paper;
            loadTexture('paper_frame_paper, paper_frame_paper_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
}

#### GLSL shader ####

string glslPaperFrame = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'paper_frame_lut
    uniform sampler2D auxSampler2;  // 'paper_frame_paper

    uniform float lut_strength;
    uniform float overlay_opacity;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Spark 'back': the camera rotated 180 deg, 3x3 [1,2,1] gaussian at a 3/512 UV step, fully desaturated.
      // Spark 'lut': the graded camera, alpha = the paper mask.
      {
        vec2 ruv = vec2(1.0) - uv;
        vec2 bd = vec2(3.0 / 512.0);
        vec3 bs = sampleInput(ruv).rgb * 4.0;
        bs += (sampleInput(ruv + vec2(bd.x, 0.0)).rgb + sampleInput(ruv - vec2(bd.x, 0.0)).rgb
             + sampleInput(ruv + vec2(0.0, bd.y)).rgb + sampleInput(ruv - vec2(0.0, bd.y)).rgb) * 2.0;
        bs += sampleInput(ruv + bd).rgb + sampleInput(ruv - bd).rgb
            + sampleInput(ruv + vec2(bd.x, -bd.y)).rgb + sampleInput(ruv + vec2(-bd.x, bd.y)).rgb;
        vec3 back = vec3(dot(bs / 16.0, vec3(0.299, 0.587, 0.114)));
        // auxSampler2 = pass input 3 ('paper_frame_paper).
        float card = texture2D(auxSampler2, topUv(uv)).a;
        result = mix(result, mix(back, result, card), overlay_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
