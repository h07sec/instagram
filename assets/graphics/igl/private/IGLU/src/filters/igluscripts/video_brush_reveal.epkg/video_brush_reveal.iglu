[Filter VideoBrushReveal]

[Init]
fun init(Filter filter) {
    makeTexture('brushTex);

    filter.parameters = {
        {smoothParam = 0.05, min = 0.0, max = 0.5, description = "Smoothstep edge softness"},
        {outro = 0.0, min = 0.0, max = 1.0, description = "0 = In, 1 = Out"},
        {angle = 330.0, min = 0.0, max = 360.0, description = "Brush UV rotation (degrees)"},
        {framerate = 0.05, min = 0.0, max = 1.0, description = "1 = full framerate, 0 = 1 fps (over 4s)"},
        {maskScale = 1.55 , min = 0.2, max = 3.0, description = "Mask size relative to the image (1 = mask exactly covers the image)"},
        {direction = 0.0, min = 0.0, max = 3.0, description = "Stroke travel direction: 2 = up, 3 = down, below 1.5 = authored (down for In, up for Out)"},
    };

    filter.passes = {
        {
            name = 'pass0,
            inputs = {'default, 'brushTex},
            uniforms = {
                progress = 0.0,
                smoothParam = 0.05,
                outro = 0.0,
                angle = 0.0,
                framerate = 1.0,
                maskScale = 1.55,
                direction = 0.0,
            },
            glslShader = glsl,
        },
    };
}

[PreRender]
fun preRender(Filter filter) {
    f32 framerate = getParameterFloat('framerate);
    setShaderUniform('pass0, 'framerate, framerate);

    f32 angle = getParameterFloat('angle);
    setShaderUniform('pass0, 'angle, angle);

    f32 maskScale = getParameterFloat('maskScale);
    setShaderUniform('pass0, 'maskScale, maskScale);

    f32 direction = getParameterFloat('direction);
    setShaderUniform('pass0, 'direction, direction);
}

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    uniform sampler2D auxSampler1;
    uniform float progress;
    uniform float smoothParam;
    uniform float outro;
    uniform float angle;
    uniform float framerate;
    uniform float maskScale;
    uniform float direction;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec4 color = sampleInput(uv);
        // The authored stroke travels down for In and up for Out. A requested
        // direction (2 = up, 3 = down) that differs mirrors the layout vertically.
        float authoredDirection = mix(3.0, 2.0, outro);
        float mirrorY = step(1.5, direction) * step(0.5, abs(direction - authoredDirection));
        // Screen-space coordinate with y = 1 at the top on every backend.
        // sampleInput() handles the Metal y-flip itself, but the brush lookup
        // does not, so it uses guv (same idiom as video_doodle).
        vec2 guv = vec2(uv.x, 0.5 + (uv.y - 0.5) * UP * (1.0 - 2.0 * mirrorY));

        // Quantize progress to simulate lower framerate.
        // Treat 0-1 progress range as 4 seconds:
        //   framerate = 1 -> 60 fps -> 240 frames (effectively smooth)
        //   framerate = 0 -> 1 fps  -> 4 frames over 4s (step = 0.25)
        float fps = 1.0 + framerate * 59.0;
        float totalFrames = max(floor(fps * 4.0), 1.0);
        float quantizedProgress = floor(clamp(progress, 0.0, 1.0) * totalFrames) / totalFrames;

        float p = mix(quantizedProgress, 1.0 - quantizedProgress, outro);
        p *= 1.2;

        // Rotate brush UV around center by angle degrees
        float rad = angle * 3.14159265 / 180.0;
        float c = cos(rad);
        float s = sin(rad);
        vec2 centered = guv - 0.5;
        vec2 rotated = vec2(c * centered.x - s * centered.y, s * centered.x + c * centered.y);
        // Dividing the centred UV shrinks the sampled window, which scales the
        // brush up relative to the image. maskScale = 1 makes the mask exactly
        // cover the frame; the 1.3 default keeps the historical oversize.
        vec2 brushUV = rotated / max(maskScale, 0.001) + 0.5;

        float brushVal = texture2D(auxSampler1, brushUV).r;
        float mask = smoothstep(brushVal, brushVal + max(smoothParam, 0.00001), p);
        mask *= step(0.00001, p);
        mask = mix(mask, 1.0, step(1.2, p));

        color *= mask;
        gl_FragColor = toOutputFormat(color);
    }
";
