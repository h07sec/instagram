[Filter BadSignalB]
# "Bad Signal-B" ported from the Spark effect (4499155950208848). Single fragment pass, no assets beyond the LUT.
#
#   Grade: 'BaseColor(1)' 8x8 LUT (full strength).
#   Glitch bars: Spark screen-blends a 75-frame 800x800 sequence of soft-edged pure-blue horizontal bars at
#   8 fps (random start). Here they're procedural, matching the measured sequence: per 8 fps frame, 4 bar
#   slots, each on with ~35% chance (so ~1/3 of frames have none); height 1-41% of the frame (median ~10%);
#   half full-width, the rest a random span; soft vertical edges.
#   Spark's own sample is a still photo, so its bars look frozen; in the effect they animate at 8 fps.
#
# Time source: the host's time_sec parameter, so the bars follow scrubbing and export.
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('bad_signal_b_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {bar_opacity = 1.0, min = 0.0, max = 1.0, description = "Blue glitch-bar opacity (screen blend)"},
        {bar_fps = 8.0, min = 1.0, max = 30.0, description = "Glitch frames per second (Spark sequence 8 fps)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'bad_signal_b_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        bar_opacity = 1.0,
        bar_fps = 8.0,
        u_time = 0.0,
      },
      glslShader = glslBadSignalB,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string bad_signal_b_lut_path = "bad_signal_b_lut_path";
string bad_signal_b_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; bad_signal_b_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(bad_signal_b_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != bad_signal_b_lut_filename) {
            bad_signal_b_lut_filename = new_lut;
            loadTexture('bad_signal_b_lut, bad_signal_b_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'bar_opacity, getParameterFloat('bar_opacity));
    setShaderUniform('pass0, 'bar_fps, getParameterFloat('bar_fps));

    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);
}

#### GLSL shader ####

string glslBadSignalB = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'bad_signal_b_lut
    uniform float lut_strength;
    uniform float bar_opacity;
    uniform float bar_fps;
    uniform float u_time;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hash (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }

    // One bar slot: returns its coverage at tuv for glitch frame f.
    float bar(vec2 tuv, float f, float slot) {
      float s = f * 7.0 + slot * 1.37;
      if (hash11(s + 0.11) > 0.35) { return 0.0; }
      float h = mix(0.01, 0.12, pow(hash11(s + 0.23), 1.6));
      if (hash11(s + 0.29) > 0.9) { h = mix(0.15, 0.41, hash11(s + 0.31)); }
      float y0 = hash11(s + 0.37) * (1.0 - h);
      float full = step(0.5, hash11(s + 0.41));
      float x0 = mix(hash11(s + 0.43) * 0.7, 0.0, full);
      float x1 = mix(x0 + mix(0.05, 0.9, hash11(s + 0.47)), 1.0, full);
      float edge = h * 0.25 + 0.004;
      float vy = smoothstep(y0, y0 + edge, tuv.y) * (1.0 - smoothstep(y0 + h - edge, y0 + h, tuv.y));
      float vx = step(x0, tuv.x) * step(tuv.x, x1);
      return vy * vx;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = mix(cam.rgb, lutLookup(cam.rgb), lut_strength * strength);

      vec2 tuv = topUv(uv);
      // Bounded frame index keeps the hash in full f32 precision however long the clip runs.
      float f = mod(floor(u_time * bar_fps), 997.0);
      float cov = max(max(bar(tuv, f, 0.0), bar(tuv, f, 1.0)), max(bar(tuv, f, 2.0), bar(tuv, f, 3.0)));
      vec3 blue = vec3(0.0, 0.03, 1.0) * cov;
      vec3 screened = 1.0 - (1.0 - result) * (1.0 - blue);
      result = mix(result, screened, bar_opacity * strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
