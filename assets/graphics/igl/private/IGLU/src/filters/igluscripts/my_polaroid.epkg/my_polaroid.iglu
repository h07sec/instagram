[Filter MyPolaroid]
# "My Polaroid" ported from the Spark effect (1008376826364137). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Overlay: 'my_polaroid_frame (9:16 page with card and stickers) alpha-blended at 1, contain-fitted with one
#   scale and centred (Spark pins it to a 9:16 screen); its flat pink page edge extends past the fit box.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('my_polaroid_lut);
    makeTexture('my_polaroid_frame);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the frame overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'my_polaroid_lut, 'my_polaroid_frame},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslMyPolaroid,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string my_polaroid_lut_path = "my_polaroid_lut_path";
string my_polaroid_lut_filename = "";
string my_polaroid_frame_path = "my_polaroid_frame_path";
string my_polaroid_frame_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(my_polaroid_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != my_polaroid_lut_filename) {
            my_polaroid_lut_filename = new_lut;
            loadTexture('my_polaroid_lut, my_polaroid_lut_filename);
        }
    }

    string my_polaroid_frame_param = getParameterString(my_polaroid_frame_path);
    if (my_polaroid_frame_param != "") {
        string new_my_polaroid_frame = stringAppend("textureFilePath://", my_polaroid_frame_param);
        if (new_my_polaroid_frame != my_polaroid_frame_filename) {
            my_polaroid_frame_filename = new_my_polaroid_frame;
            loadTexture('my_polaroid_frame, my_polaroid_frame_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Frame size for the aspect-preserving fit. Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslMyPolaroid = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'my_polaroid_lut
    uniform sampler2D auxSampler2;  // 'my_polaroid_frame

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Spark lays everything out on a 9:16 screen: the frame page is pinned to it, and the camera fills it.
      // Use the largest centred 9:16 box that fits the input as that screen, so the stickers and the 3:4
      // window keep their shape on any input; on a 9:16 input the box is the whole frame, as in Spark.
      vec2 frame = vec2(source_size_x, source_size_y);
      float boxH = min(frame.y, frame.x * 1024.0 / 576.0);
      vec2 box = vec2(boxH * 576.0 / 1024.0, boxH);
      vec2 q = (topUv(uv) - 0.5) * frame / box + 0.5;
      // The camera fills the box (the input region under it), then Spark 'LUT0' shrinks it to 65% about the centre.
      // The window shows that camera from 2% to 98% across and 9% to 81% down. The 100% 'LUT' layer lies under
      // the opaque frame, so only the inset is drawn.
      vec2 qi = 0.5 + (q - 0.5) / 0.65;
      vec2 camTop = 0.5 + (qi - 0.5) * box / frame;
      float inInset = step(0.0, qi.x) * step(qi.x, 1.0) * step(0.0, qi.y) * step(qi.y, 1.0);
      vec3 base = mix(src, sampleInput(topUv(camTop)).rgb, inInset * strength);
      vec3 graded = mix(base, lutLookup(base), strength * lut_strength);
      vec3 result = graded;
      // Frame overlay 'my_polaroid_frame (alpha), authored top-origin, sampled in box space. Its outer edge is one flat
      // page pink, so clamping past the box extends the page.
      {
        vec2 ht = 0.5 / vec2(576.0, 1024.0);
        // auxSampler2 = pass input 3 ('my_polaroid_frame).
        vec4 ov = texture2D(auxSampler2, clamp(q, ht, 1.0 - ht));
        result = mix(result, ov.rgb, (overlay_opacity * ov.a) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
