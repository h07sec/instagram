[Filter RosePetals]
# "ROSE PETALS" ported from the Spark effect (754511349101124).
#
#   Pass 'base: soft centre skin smoothing 0.35 (fakes Spark's face retouch).
#   Pass 'particles: 60 vertex-stage quads; procedural pink rose petals fall and spin (Spark: 3 emitters x 3/s, 7 s life, spin pi rad/s, 0.78).
#     Stateless: position is a closed-form function of (particle id, time), so seeking is exact.
#     Respawn cycles feed the hash through mod(), so it stays in full f32 precision for any clip length.
#   Pass 'composite: over-blend of the particle layer over the base.
#
# Time source: the host's time_sec parameter. GLSL only — Metal is generated by shaderc.

[Init]
fun init(Filter filter)
{

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.35, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {particle_opacity = 0.78, min = 0.0, max = 1.0, description = "petal layer opacity"},
        {particle_size = 1.0, min = 0.25, max = 3.0, description = "Particle size multiplier"},
        {particle_speed = 1.0, min = 0.25, max = 3.0, description = "Fall speed multiplier"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {
      {
        name = 'base,
        inputs = {'default},
        uniforms = {
          smooth_strength = 0.5,
          source_size_x = 1024.0,
          source_size_y = 1024.0,
        },
        glslShader = glslBase,
      },
      {
        name = 'particles,
        inputs = {'default},
        geometry = {type = 'quads, count = 60.0},
        blendMode = 'premultiplied,
        clearBeforeDraw = true,
        uniforms = {
          u_time = 0.0,
          u_aspect = 1.0,
          u_size = 1.0,
          u_speed = 1.0,
        },
        glslVertexShader = vsParticles,
        glslShader = fsParticles,
      },
      {
        name = 'composite,
        inputs = {'base, 'particles},
        uniforms = {
          strength = 1.0,
          particle_opacity = 0.78,
        },
        glslShader = glslComposite,
      },
    };
}

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('composite, 'strength, effect_strength);

    vec2 size = getTextureSize('default);
    setShaderUniform('base, 'smooth_strength, getParameterFloat('smooth_strength));
    if (size.x > 0.0) {
        setShaderUniform('base, 'source_size_x, size.x);
        setShaderUniform('base, 'source_size_y, size.y);
    }

    # Time drives the particles.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('particles, 'u_time, time);
    if (size.y > 0.0) {
        setShaderUniform('particles, 'u_aspect, size.x / size.y);
    }
    setShaderUniform('particles, 'u_size, getParameterFloat('particle_size));
    setShaderUniform('particles, 'u_speed, getParameterFloat('particle_speed));
    setShaderUniform('composite, 'particle_opacity, getParameterFloat('particle_opacity));
}

#### GLSL shaders ####

string glslBase = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      gl_FragColor = toOutputFormat(vec4(clamp(src, 0.0, 1.0), cam.a));
    }
    ";

string vsParticles = "
    attribute float a_particleId;
    attribute vec2 a_cornerOffset;

    uniform float u_time;
    uniform float u_aspect;
    uniform float u_size;
    uniform float u_speed;

    varying vec2 vUv;
    varying float vAlpha;

    const float kLifeMin = 5.0;
    const float kLifeMax = 8.0;
    const float kSizeMin = 0.032;
    const float kSizeMax = 0.056;
    const float kDrift = 0.05;
    const float kSpin = 3.14159;

    // Hugo Elias style fract/multiply hash (sin-based hashes lose precision on long clips).
    vec3 hash31(float n) {
      vec3 p3 = fract(vec3(n) * vec3(0.1031, 0.1030, 0.0973));
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.xxy + p3.yzz) * p3.zyx);
    }

    void main() {
      float pid = a_particleId;
      vec3 fixedRnd = hash31(pid + 17.0);
      float life = mix(kLifeMin, kLifeMax, fixedRnd.x) / max(u_speed, 0.01);
      float cycleTime = u_time / life + fixedRnd.y;
      // Bounded respawn index keeps the hash input small however long the clip runs.
      float cycle = mod(floor(cycleTime), 97.0);
      float t = fract(cycleTime);
      vec3 rnd = hash31(pid * 7.13 + cycle * 13.7 + 3.1);

      float x = rnd.x * 2.2 - 1.1 + sin(t * life * (0.6 + rnd.z) + rnd.y * 6.2831) * kDrift;
      // Clip y runs bottom-up in the output, so this travels down the screen.
      float y = -1.1 + t * 2.2;
      float size = mix(kSizeMin, kSizeMax, rnd.y) * 2.0 * u_size;
      float ang = rnd.z * 6.2831 + t * life * kSpin * (rnd.x - 0.5) * 2.0;
      mat2 rot = mat2(cos(ang), sin(ang), -sin(ang), cos(ang));
      vec2 corner = rot * (a_cornerOffset * size);
      gl_Position = vec4(vec2(x, y) + vec2(corner.x / max(u_aspect, 1e-4), corner.y), 0.0, 1.0);
      vUv = a_cornerOffset + 0.5;
      vAlpha = smoothstep(0.0, 0.05, t) * (1.0 - smoothstep(0.92, 1.0, t)) * (0.65 + 0.35 * rnd.z);
    }
    ";

string fsParticles = "
    precision highp float;
    varying vec2 vUv;
    varying float vAlpha;

    void main() {
      // Rose petal: teardrop wider at the tip, darker magenta at the base, lighter pink tip,
      // a soft centre crease (replaces Spark's 472x528 petal PNG).
      vec2 p = vUv - 0.5;
      float t = p.y + 0.5;
      float halfW = 0.30 * (0.55 + 0.6 * t);
      float d = length(vec2(p.x / halfW, p.y / 0.48));
      float shape = smoothstep(1.0, 0.88, d);
      vec3 base = vec3(0.62, 0.06, 0.27);
      vec3 tip = vec3(0.93, 0.36, 0.55);
      vec3 col = mix(base, tip, smoothstep(0.0, 1.0, t));
      col *= 0.85 + 0.15 * smoothstep(0.0, 0.25, abs(p.x) / halfW);
      float alpha = shape * vAlpha;
      gl_FragColor = vec4(col * alpha, alpha);
    }
    ";

string glslComposite = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler1;  // 'particles (premultiplied)
    uniform float particle_opacity;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec4 base = sampleInput(sourceTextureCoordinate);
      vec4 prt = texture2D(auxSampler1, topUv(sourceTextureCoordinate));
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = base.rgb * (1.0 - prt.a * particle_opacity * strength) + prt.rgb * particle_opacity * strength;
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), base.a));
    }
    ";
