[Filter Brownmood]
# "brownmood" ported from the Spark effect (920233392024817). Single fragment pass, no face tracking.
#
#   Spark: a desaturated brown/olive FastColorLUT (clamp low 0.00781 + 0.01), and over it at 0.85 a 25-tap
#   horizontal-only tent blur of the same LUT'd camera, one tap = 1.02 image pixels, over the whole frame
#   (the face is smeared too). The port blends the blur 25% lighter than Spark, at 0.6375, per visual review.
#   Spark's 0.30 skin smoothing only reaches the 0.15 sharp branch; it's faked with a soft centre-weighted
#   edge-aware blur there. Its faint face makeup (blush 0.15, lips 0.10, highlight 0.04, concealer) is dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('brownmood_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.30, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'brownmood_lut},
      uniforms = {
        strength = 1.0,
        smooth_strength = 0.30,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
        blur_step_x = 0.00099609375,
      },
      glslShader = glslBrownmood,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string brownmood_lut_path = "brownmood_lut_path";
string brownmood_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; brownmood_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(brownmood_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != brownmood_lut_filename) {
            brownmood_lut_filename = new_lut;
            loadTexture('brownmood_lut, brownmood_lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
        setShaderUniform('pass0, 'blur_step_x, 1.02 / srcSize.x);
    }
}

#### GLSL shader ####

string glslBrownmood = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'brownmood_lut
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;
    uniform float blur_step_x;

    // Spark's 0.85 smear blend, 25% lighter.
    const float kSmearBlend = 0.85 * 0.75;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT, this effect's clamp low is 0.00781 + 0.01).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.01781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    vec3 lutAt(vec2 uv) {
      return lutLookup(sampleInput(clamp(uv, 0.0, 1.0)).rgb);
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Sharp branch: LUT of the camera with the faked centre skin smoothing.
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float sm = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      vec3 src = cam.rgb;
      if (sm > 0.0) {
        src = mix(src, skinBlur(uv, src), sm);
      }
      vec3 sharp = lutLookup(src);
      // Spark BlurDirectional25: horizontal tent, centre weight 2/25, side weights (13 - k) / 169.
      vec3 smear = lutLookup(cam.rgb) * (2.0 / 25.0);
      for (int k = 1; k <= 12; k++) {
        float w = float(13 - k) / 169.0;
        vec2 o = vec2(float(k) * blur_step_x, 0.0);
        smear += w * (lutAt(uv + o) + lutAt(uv - o));
      }
      vec3 spark = min(mix(sharp, smear, kSmearBlend), 1.0);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
