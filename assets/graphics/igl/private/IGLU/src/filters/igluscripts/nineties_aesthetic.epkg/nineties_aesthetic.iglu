[Filter NinetiesAesthetic]
# "𝟡𝟘𝕤𝕥𝕖𝕥𝕙𝕚𝕔" ported from the Spark effect (193914048505819). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.7.
#   Grade: 8x8 LUT (blends the two nearest blue slices, so a noisy LUT doesn't band) at 1.
#   Overlay: 'nineties_aesthetic_sparkle add-blended full-frame at 1.
#   Spark has no LUT: three flat colour layers over the camera are pointwise in its colour, so they are baked into an 8x8 LUT: an HSL-adjusted camera tinted #EA00FF added at 0.21 (Spark's default blend is Add), the same tinted #64FF49 subtracted at 0.3, and #33A100 added at 0.15. Grey 0.5 maps to 147,106,146, white to 233,203,233.
#   Sparkles: small 4-point glints (Spark's star sprite, tinted #FFC494, added) on bright edges, each twinkling in and out on its own phase.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('nineties_aesthetic_lut);
    makeTexture('nineties_aesthetic_sparkle);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.7, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the sparkle overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'nineties_aesthetic_lut, 'nineties_aesthetic_sparkle},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.7,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslNinetiesAesthetic,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string nineties_aesthetic_lut_path = "nineties_aesthetic_lut_path";
string nineties_aesthetic_lut_filename = "";
string nineties_aesthetic_sparkle_path = "nineties_aesthetic_sparkle_path";
string nineties_aesthetic_sparkle_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; nineties_aesthetic_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(nineties_aesthetic_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != nineties_aesthetic_lut_filename) {
            nineties_aesthetic_lut_filename = new_lut;
            loadTexture('nineties_aesthetic_lut, nineties_aesthetic_lut_filename);
        }
    }

    string nineties_aesthetic_sparkle_param = getParameterString(nineties_aesthetic_sparkle_path);
    if (nineties_aesthetic_sparkle_param != "") {
        string new_nineties_aesthetic_sparkle = stringAppend("textureFilePath://", nineties_aesthetic_sparkle_param);
        if (new_nineties_aesthetic_sparkle != nineties_aesthetic_sparkle_filename) {
            nineties_aesthetic_sparkle_filename = new_nineties_aesthetic_sparkle;
            loadTexture('nineties_aesthetic_sparkle, nineties_aesthetic_sparkle_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslNinetiesAesthetic = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'nineties_aesthetic_lut
    uniform sampler2D auxSampler2;  // 'nineties_aesthetic_sparkle

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices (no banding on noisy LUTs).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Hugo Elias-style hash (no sin, so identical on GL and Metal).
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    float lumaAt(vec2 tuv) {
      return dot(sampleInput(topUv(tuv)).rgb, vec3(0.299, 0.587, 0.114));
    }
    // One glint grid: P cells across, edge taps E px apart, sprite up to M cells wide. Each cell runs
    // its own 0.75 s cycle (random phase); in most cycles it glints: the star grows over
    // 0.3 s, then shrinks away over 0.15 s, as in Spark.
    float kiraCell(vec2 tuv, float ar, vec2 px, float P, float E, float M, float seed) {
      vec2 g = vec2(P, P * ar);
      vec2 cell = floor(tuv * g);
      // Bounded seed: time wraps every 16 cycles (12 s), which moves tc by exactly 16, so the wrap is
      // seamless and the cycle index stays in [0, 16] at full f32 precision.
      float tc = mod(time, 12.0) / 0.75 + hash21(cell + seed + 0.31);
      float cyc = mod(floor(tc), 16.0);
      float tl = fract(tc) * 0.75;
      if (tl > 0.45 || hash21(cell + seed + cyc * 7.17) < 0.15) {
        return 0.0;
      }
      float life = tl < 0.3 ? tl / 0.3 : 1.0 - (tl - 0.3) / 0.15;
      vec2 cc = (cell + 0.5) / g;
      vec2 o = E * px;
      float e = 8.0 * lumaAt(cc)
          - lumaAt(cc + vec2(-o.x, -o.y)) - lumaAt(cc + vec2(0.0, -o.y)) - lumaAt(cc + vec2(o.x, -o.y))
          - lumaAt(cc + vec2(-o.x, 0.0)) - lumaAt(cc + vec2(o.x, 0.0))
          - lumaAt(cc + vec2(-o.x, o.y)) - lumaAt(cc + vec2(0.0, o.y)) - lumaAt(cc + vec2(o.x, o.y));
      e = floor(clamp(e, 0.0, 1.0) * 4.0) / 4.0;
      float sz = M * e * (0.15 + 0.85 * life);
      if (sz <= 0.0) {
        return 0.0;
      }
      vec2 l = (fract(tuv * g) - 0.5) / sz + 0.5;
      if (l.x < 0.0 || l.x > 1.0 || l.y < 0.0 || l.y > 1.0) {
        return 0.0;
      }
      // auxSampler2 = pass input 3 ('nineties_aesthetic_sparkle). l is already top-origin, which is how
      // the sprite is authored, so it is sampled as is (no topUv here).
      float sp = texture2D(auxSampler2, l).r;
      return smoothstep(0.2, 0.3, sp) * sp * (0.4 + 0.6 * life);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'nineties_aesthetic_sparkle (add), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('nineties_aesthetic_sparkle).
        // Spark's Kira Kira glints (three grid sizes), each cell's star growing in and then shrinking out.
        vec2 tuv = topUv(uv);
        float ar = source_size_y / max(source_size_x, 1.0);
        vec2 px = 1.0 / vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
        float a = 0.0;
        a += kiraCell(tuv, ar, px, 2.0, 10.0, 1.3, 0.0);
        a += kiraCell(tuv, ar, px, 3.5, 9.0, 1.2, 17.0);
        a += kiraCell(tuv, ar, px, 4.5, 8.0, 1.0, 41.0);
        a = clamp(a, 0.0, 1.0);
        result = mix(result, vec3(1.0, 0.769, 0.580), a * overlay_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
