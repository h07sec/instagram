[Filter RetroTv]
# "𝗥𝗲𝘁𝗿𝗼 𝗧𝗩 ™" ported from the Spark effect (1183996159029581). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Tv bezel x2 (multiply), then the Spark 23-frame VHS dash sequence (15 fps, add 0.8) with its exact dash table.
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.35.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('retro_tv_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.35, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'retro_tv_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.35,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslRetroTv,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string retro_tv_lut_path = "retro_tv_lut_path";
string retro_tv_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(retro_tv_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != retro_tv_lut_filename) {
            retro_tv_lut_filename = new_lut;
            loadTexture('retro_tv_lut, retro_tv_lut_filename);
        }
    }

    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslRetroTv = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'retro_tv_lut

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // One dropout dash of the Spark VHS sequence: rect r = (x, y, w, h) in 614x360 texels, lit only on frame fr.
    float vhsDash(float k, float fr, vec2 p, vec4 r, float peak) {
      vec2 a = smoothstep(r.xy - 0.5, r.xy + 0.5, p) * (1.0 - smoothstep(r.xy + r.zw - 0.5, r.xy + r.zw + 0.5, p));
      return (1.0 - step(0.5, abs(k - fr))) * a.x * a.y * peak;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // RGB Shift Shader (Amount 0.08): R at uv, G and B zoomed x1.008 / x1.016 about the centre, each through the baked grade.
      vec3 sg = sampleInput((uv - 0.5) * 1.008 + 0.5).rgb;
      vec3 sb = sampleInput((uv - 0.5) * 1.016 + 0.5).rgb;
      vec3 shifted = vec3(lutLookup(src).r, lutLookup(sg).g, lutLookup(sb).b);
      vec3 graded = mix(src, shifted, strength * lut_strength);
      vec3 result = graded;

      // Spark 'Tv' multiplied twice (pixel, pixel0), procedural: rounded CRT bezel + 3-px vertical aperture stripes (576x1024 reference).
      {
        vec2 tp = topUv(uv) * vec2(576.0, 1024.0);
        vec2 q = abs(tp - vec2(288.0, 512.0)) - vec2(232.0, 456.0);           // half-size (280, 504) minus the 48 px corner radius
        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 48.0;       // < 0 inside the screen
        float tv = mix(0.05, 1.0, 1.0 - smoothstep(-4.0, 3.0, d)) * (0.893 + 0.035 * cos(6.2831853 * tp.x / 3.0));
        result = mix(result, result * tv * tv, strength);
      }
      // Spark 23-frame VHS sequence 'animationSequence0' (614x360 frames stretched full-frame, 15 fps = 1.533 s loop,
      // add 0.8, layer1 = drawn after the Tv): flat 18/255 plus the white dropout dashes of each frame, transcribed
      // exactly (frame, x, y, w, h in 614x360 texels, peak). +14 aligns the phase with the Spark sample.
      {
        float k = mod(floor(time * 15.0) + 14.0, 23.0);
        vec2 p = topUv(uv) * vec2(614.0, 360.0);
        float d = 0.0706;
        d = max(d, vhsDash(k, 1.0, p, vec4(444.0, 355.0, 22.0, 2.0), 0.788));
        d = max(d, vhsDash(k, 2.0, p, vec4(286.0, 317.0, 26.0, 2.0), 0.396));
        d = max(d, vhsDash(k, 2.0, p, vec4(156.0, 317.0, 16.0, 2.0), 0.392));
        d = max(d, vhsDash(k, 2.0, p, vec4(454.0, 318.0, 16.0, 2.0), 0.510));
        d = max(d, vhsDash(k, 2.0, p, vec4(548.0, 317.0, 10.0, 3.0), 0.620));
        d = max(d, vhsDash(k, 2.0, p, vec4(589.0, 317.0, 10.0, 2.0), 0.549));
        d = max(d, vhsDash(k, 2.0, p, vec4(22.0, 319.0, 10.0, 1.0), 0.329));
        d = max(d, vhsDash(k, 3.0, p, vec4(190.0, 356.0, 20.0, 2.0), 0.710));
        d = max(d, vhsDash(k, 3.0, p, vec4(518.0, 355.0, 5.0, 2.0), 0.471));
        d = max(d, vhsDash(k, 4.0, p, vec4(128.0, 356.0, 24.0, 2.0), 0.788));
        d = max(d, vhsDash(k, 6.0, p, vec4(310.0, 355.0, 3.0, 1.0), 0.435));
        d = max(d, vhsDash(k, 7.0, p, vec4(313.0, 355.0, 3.0, 2.0), 0.357));
        d = max(d, vhsDash(k, 8.0, p, vec4(287.0, 277.0, 18.0, 2.0), 0.349));
        d = max(d, vhsDash(k, 8.0, p, vec4(23.0, 278.0, 15.0, 2.0), 0.345));
        d = max(d, vhsDash(k, 8.0, p, vec4(547.0, 277.0, 10.0, 3.0), 0.533));
        d = max(d, vhsDash(k, 8.0, p, vec4(456.0, 278.0, 13.0, 2.0), 0.475));
        d = max(d, vhsDash(k, 8.0, p, vec4(158.0, 277.0, 10.0, 2.0), 0.373));
        d = max(d, vhsDash(k, 8.0, p, vec4(589.0, 277.0, 10.0, 2.0), 0.576));
        d = max(d, vhsDash(k, 9.0, p, vec4(118.0, 356.0, 27.0, 3.0), 0.847));
        d = max(d, vhsDash(k, 10.0, p, vec4(176.0, 356.0, 21.0, 2.0), 0.812));
        d = max(d, vhsDash(k, 10.0, p, vec4(364.0, 355.0, 3.0, 2.0), 0.420));
        d = max(d, vhsDash(k, 11.0, p, vec4(483.0, 90.0, 27.0, 2.0), 0.431));
        d = max(d, vhsDash(k, 11.0, p, vec4(482.0, 355.0, 14.0, 2.0), 0.271));
        d = max(d, vhsDash(k, 11.0, p, vec4(444.0, 90.0, 10.0, 2.0), 0.494));
        d = max(d, vhsDash(k, 11.0, p, vec4(157.0, 356.0, 11.0, 1.0), 0.604));
        d = max(d, vhsDash(k, 11.0, p, vec4(470.0, 91.0, 4.0, 1.0), 0.298));
        d = max(d, vhsDash(k, 11.0, p, vec4(428.0, 90.0, 3.0, 2.0), 0.376));
        d = max(d, vhsDash(k, 11.0, p, vec4(523.0, 91.0, 3.0, 1.0), 0.373));
        d = max(d, vhsDash(k, 12.0, p, vec4(141.0, 355.0, 19.0, 2.0), 0.604));
        d = max(d, vhsDash(k, 13.0, p, vec4(131.0, 356.0, 18.0, 2.0), 0.737));
        d = max(d, vhsDash(k, 14.0, p, vec4(129.0, 356.0, 21.0, 2.0), 0.827));
        d = max(d, vhsDash(k, 17.0, p, vec4(313.0, 355.0, 3.0, 2.0), 0.400));
        d = max(d, vhsDash(k, 19.0, p, vec4(118.0, 356.0, 28.0, 3.0), 0.878));
        d = max(d, vhsDash(k, 20.0, p, vec4(176.0, 356.0, 19.0, 2.0), 0.792));
        d = max(d, vhsDash(k, 21.0, p, vec4(480.0, 355.0, 16.0, 2.0), 0.361));
        d = max(d, vhsDash(k, 21.0, p, vec4(160.0, 356.0, 8.0, 2.0), 0.439));
        result = min(result + vec3(d) * 0.8 * strength, vec3(1.0));
      }
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
