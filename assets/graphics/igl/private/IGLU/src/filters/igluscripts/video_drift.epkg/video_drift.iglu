[Filter IgluscriptVideoDriftFilter]

# Soft drift from above with rocking -- exact AE bezier curves from POSITION_DRIFT_IN
# Rotation scaled 1.2x per design feedback

fun mix(f32 a, f32 b, f32 t) f32 {
  return a * (1.0 - t) + b * t;
}

fun smoothStep01(f32 x) f32 {
  f32 t = clamp(x, 0.0, 1.0);
  return t * t * (3.0 - 2.0 * t);
}

fun cssBezier(f32 time, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 t = time;
  f32 i = 0.0;
  while (i < 8.0) {
    f32 u = 1.0 - t;
    f32 xt = 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t;
    f32 dxdt = 3.0 * u * u * x1 + 6.0 * u * t * (x2 - x1) + 3.0 * t * t * (1.0 - x2);
    t = t - (xt - time) / max(dxdt, 0.0001);
    t = clamp(t, 0.0, 1.0);
    i = i + 1.0;
  }
  f32 u = 1.0 - t;
  return 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t;
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {amount = 0.5, min = 0.0, max = 1.0, description = "Drift intensity"},
    {opacity = 0.5, min = 0.0, max = 1.0, description = "Fade-in duration as a fraction of the intro (0 = instant)"},
  };

  filter.passes = {
    {
      name = 'driftFx,
      inputs = {'default},
      uniforms = {
        offsetY = 0.0,
        rotation = 0.0,
        fadeAlpha = 0.0,
        inputSize = {720.0, 1280.0},
      },
      glslShader = glsl,
    },
    {
      name = 'dirBlur,
      inputs = {'driftFx},
      uniforms = {
        ghostSpread = 0.0,
      },
      glslShader = blurGlsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  f32 amount = getParameterFloat('amount);

  f32 pi = 3.14159;
  vec2 size = getTextureSize('default);

  # --- Y Position (5 keyframes, exact AE bezier) ---
  f32 YPT1 = 0.222205;
  f32 YPT2 = 0.469671;
  f32 YPT3 = 0.752534;
  f32 YPT4 = 1.0;
  f32 YPK0 = -0.219601;
  f32 YPK1 = -0.120709;
  f32 YPK2 = -0.047929;
  f32 YPK3 = 0.033255;
  f32 YPK4 = 0.06418;

  f32 posY = YPK4;
  f32 f = 0.0;
  f32 t = 0.0;

  if (p < YPT1) {
    f = p / YPT1;
    t = cssBezier(f, 0.144848, 0.094276, 0.645125, 0.89544);
    posY = mix(YPK0, YPK1, t);
  } else if (p < YPT2) {
    f = (p - YPT1) / (YPT2 - YPT1);
    t = cssBezier(f, 0.364578, 0.18384, 0.66121, 0.768808);
    posY = mix(YPK1, YPK2, t);
  } else if (p < YPT3) {
    f = (p - YPT2) / (YPT3 - YPT2);
    t = cssBezier(f, 0.347476, 0.22233, 0.65484, 0.878476);
    posY = mix(YPK2, YPK3, t);
  } else if (p < YPT4) {
    f = (p - YPT3) / (YPT4 - YPT3);
    t = cssBezier(f, 0.372975, 0.369042, 0.666667, 1.0);
    posY = mix(YPK3, YPK4, t);
  }

  # Offset from final rest position (positive = above, drifting down)
  f32 offsetYRaw = YPK4 - posY;

  # --- Rotation (5 keyframes, exact AE bezier, 1.2x scale, degrees -> radians) ---
  f32 RT1 = 0.222205;
  f32 RT2 = 0.469671;
  f32 RT3 = 0.752534;
  f32 RT4 = 1.0;
  # AE values x 1.2 per design feedback
  f32 RK0 = 22.8;
  f32 RK1 = -30.0;
  f32 RK2 = 22.8;
  f32 RK3 = -20.4;
  f32 RK4 = 0.0;

  f32 rotDeg = RK4;
  f = 0.0;
  t = 0.0;

  if (p < RT1) {
    f = p / RT1;
    t = cssBezier(f, 0.333333, 0.0, 0.666667, 1.0);
    rotDeg = mix(RK0, RK1, t);
  } else if (p < RT2) {
    f = (p - RT1) / (RT2 - RT1);
    t = cssBezier(f, 0.333333, 0.0, 0.666667, 1.0);
    rotDeg = mix(RK1, RK2, t);
  } else if (p < RT3) {
    f = (p - RT2) / (RT3 - RT2);
    t = cssBezier(f, 0.333333, 0.0, 0.666667, 1.0);
    rotDeg = mix(RK2, RK3, t);
  } else if (p < RT4) {
    f = (p - RT3) / (RT4 - RT3);
    t = cssBezier(f, 0.333333, 0.0, 0.833333, 1.0);
    rotDeg = mix(RK3, RK4, t);
  }

  # Apply amount as rotation multiplier and convert to radians
  f32 rotation = rotDeg * amount * 2.0 * pi / 180.0;

  # Normalize the AE curve to half the travel needed to fully hide the frame.
  # At the opening rotation the frame's vertical half-extent is
  # 0.5 * (aspect * |sin| + |cos|), so clearing the viewport takes
  # 0.5 + halfExtentY of travel.
  f32 baseOffsetY = YPK4 - YPK0;
  f32 rot0 = RK0 * amount * 2.0 * pi / 180.0;
  f32 aspect = size.x / size.y;
  f32 halfExtentY = 0.5 * (aspect * abs(sin(rot0)) + abs(cos(rot0)));
  f32 fullHide = 0.5 + halfExtentY;
  f32 posScale = 0.5 * fullHide / baseOffsetY;
  f32 offsetY = offsetYRaw * posScale;

  # Subtle motion blur from vertical drift velocity
  f32 texelSize = 1.0 / size.y;
  f32 ghostSpread = abs(offsetY) * 8.0 * texelSize;

  # Below a quarter texel of spread all nine taps land on the same pixel, so pin
  # the spread to exactly 0 and let the shader take its single-tap path.
  if (abs(offsetY) * 8.0 < 0.25) { ghostSpread = 0.0; }

  # Fade in over `opacity` fraction of the intro; invisible at p=0 either way
  f32 fadeDur = getParameterFloat('opacity);
  f32 fadeAlpha = 1.0;
  if (fadeDur > 0.001) {
    fadeAlpha = smoothStep01(p / fadeDur);
  }
  if (p < 0.001) { fadeAlpha = 0.0; }

  setShaderUniform('driftFx, 'offsetY, offsetY);
  setShaderUniform('driftFx, 'rotation, rotation);
  setShaderUniform('driftFx, 'fadeAlpha, fadeAlpha);
  setShaderUniform('driftFx, 'inputSize, size);
  setShaderUniform('dirBlur, 'ghostSpread, ghostSpread);
}

string blurGlsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float ghostSpread;

void main() {
  vec2 uv = sourceTextureCoordinate;

  // preRender pins ghostSpread to 0 whenever the blur would be sub-texel, so the
  // settled frames cost one tap instead of nine. Uniform branch: every fragment
  // takes the same side.
  if (ghostSpread <= 0.0) {
    gl_FragColor = toOutputFormat(sampleInput(uv));
    return;
  }

  // smoothstep(0,e,v) * smoothstep(0,e,1-v) is exactly smoothstep(0,e,min(v,1-v))
  // while e < 0.5, because whichever side is inside the ramp leaves the other at
  // exactly 1. The kernel only moves along y, so the x half of the feather is the
  // same for all nine taps - hoist it out of the loop.
  float e = 0.005;
  float caX = smoothstep(0.0, e, min(uv.x, 1.0 - uv.x));

  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  // Vertical blur along drift axis. Weighting each ghost by the edge feather drops
  // samples that land outside the frame instead of letting them wrap to the
  // opposite edge, and renormalizing by totalWeight keeps the edge from darkening.
  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    float gy = uv.y + ghostSpread * fi;
    float ca = caX * smoothstep(0.0, e, min(gy, 1.0 - gy));
    float weight = (1.0 / (1.0 + 2.0 * abs(fi))) * ca;
    color += sampleInput(vec2(uv.x, gy)) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(color / max(totalWeight, 0.001));
}
";

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float offsetY;
uniform float rotation;
uniform float fadeAlpha;
uniform vec2 inputSize;

// One-pixel antialiased frame edge. The +0.5 bias puts the ramp entirely outside the
// first interior pixel, so an untransformed frame stays fully opaque. A fixed uv
// epsilon instead fades a fraction of the frame regardless of resolution, which shows
// up as a permanent margin once the animation settles.
float clipAlpha(vec2 uv) {
  vec2 texel = 1.0 / max(inputSize, vec2(1.0));
  vec2 d = min(uv, 1.0 - uv);
  vec2 a = clamp(d / texel + 0.5, 0.0, 1.0);
  return a.x * a.y;
}

void main() {
  vec2 uv = sourceTextureCoordinate;

  // Translate -- shift vertically (drift down from above).
  // UP is +1.0 on OpenGL and -1.0 on Metal, so this leaves the Android/GL path
  // as authored and flips the iOS/Metal path to match it. Swap to DOWN to flip
  // Android instead. Whichever is used must also apply to the rotation below,
  // since mirroring the y axis reverses the sense of a rotation.
  uv.y -= UP * offsetY;

  // Rotate around center with aspect ratio correction
  float aspect = inputSize.x / inputSize.y;
  vec2 center = vec2(0.5);
  uv -= center;
  uv.x *= aspect;
  float rot = UP * rotation;
  float c = cos(rot);
  float s = sin(rot);
  uv = vec2(c * uv.x - s * uv.y, s * uv.x + c * uv.y);
  uv.x /= aspect;
  uv += center;

  // Clip rather than repeat: without this the sampler wraps and tiles the frame
  // once the drift/rotation pushes uv outside [0,1]. Rejecting instead of
  // multiplying by ca skips the fetch, and with it the colour-space conversion
  // that rides along on a YUV or HDR source - ca == 0 already means exactly
  // vec4(0).
  float ca = clipAlpha(uv);
  if (ca <= 0.0) {
    gl_FragColor = toOutputFormat(vec4(0.0));
    return;
  }

  gl_FragColor = toOutputFormat(sampleInput(uv) * ca * fadeAlpha);
}
";
