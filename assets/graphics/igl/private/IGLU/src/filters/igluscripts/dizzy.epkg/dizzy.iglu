[Filter Dizzy]

[Init]
fun init(Filter filter)
{
    makeTexture('dizzy_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {trail_mix = 0.85, min = 0.0, max = 0.95, description = "Share of the previous trail kept each frame (Spark 0.85)"},
    };

    # Spark stores its own output (a Delay Frame) and outputs mathMix(stored, current, 0.15):
    # 85% of the previous trail plus 15% of the new graded frame, a long motion smear.
    makeHistoricalTexture('prev_trail, 'trail);

    filter.passes = {
      {
        name = 'trail,
        inputs = {'default, 'dizzy_lut, 'prev_trail},
        uniforms = {
          strength = 1.0,
          lut_strength = 1.0,
          trail_mix = 0.85,
        },
        glslShader = glslTrail,
      },
      {
        # Required: history is kept from a pass that feeds another pass, never from the last one.
        name = 'output,
        inputs = {'trail},
        glslShader = glslCopy,
      },
    };
}

string lut_path = "lut_path";
string dizzy_lut_path = "dizzy_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('trail, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; dizzy_lut_path is for local testing.

    string lut_filename_parameter = getParameterString(lut_path);

    if (lut_filename_parameter == "") {

        lut_filename_parameter = getParameterString(dizzy_lut_path);

    }
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('dizzy_lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('trail, 'lut_strength, s);
    setShaderUniform('trail, 'trail_mix, getParameterFloat('trail_mix));
}

#### GLSL shader ####

string glslTrail = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform bool hasHistory;
    uniform float lut_strength;
    uniform float trail_mix;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);
      vec3 c = clamp(texel.rgb, 0.00781, 0.98438);

      // Spark FastColorLUT decode (8x8 grid).
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = 'dizzy_lut, auxSampler2 = 'prev_trail (pass inputs bind in order after 'default = auxSampler0).
      vec3 color = texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec4 graded = mix(texel, vec4(color, texel.a), strength * lut_strength);

      // The history reads transparent black until a frame exists, so start the trail from this frame.
      vec4 previous = hasHistory ? texture2D(auxSampler2, sourceTextureCoordinate) : graded;
      gl_FragColor = toOutputFormat(mix(graded, previous, trail_mix * strength));
    }
    ";

string glslCopy = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    void main() {
      gl_FragColor = toOutputFormat(sampleInput(sourceTextureCoordinate));
    }
    ";
