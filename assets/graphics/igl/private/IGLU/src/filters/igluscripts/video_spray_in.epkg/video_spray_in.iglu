[Filter SprayIn]

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {size = 0.25, min = 0.1, max = 1.0, description = "Reveal edge size; 0 = smoothness 0.01, 1 = smoothness 1.0"},
        {amount = 1.0, min = 0.0, max = 1.0, description = "Blur amount; 0 = no blur, 1 = blurSize 6.0"},
        {blendWindow = 0.1, min = 0.001, max = 1.0, description = "blendWindow"},
        {direction = 3.0, min = 2.0, max = 3.0, description = "Wipe travel direction; 2 = up, 3 = down"},
    };

    filter.passes = {{
        name = 'base,
        igid = 'video_spray,
        inputs = {'default},
        uniforms = {
            outro = 0.0,
        }
    }};
}

[PreRender]
fun preRender(Filter filter) {
    f32 size = getParameterFloat('size);
    f32 amount = getParameterFloat('amount);
    f32 blendWindow = getParameterFloat('blendWindow);
    f32 revealSmoothness = max(0.01 + size * 0.99, 0.01);
    f32 blurSize = amount * 6.0;
    setShaderUniform('base, 'blurSize, blurSize);
    setShaderUniform('base, 'revealSmoothness, revealSmoothness);
    setShaderUniform('base, 'blendWindow, blendWindow);
    setShaderUniform('base, 'direction, getParameterFloat('direction));
}
