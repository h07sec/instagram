[Filter BlueFail]
# "blue fail" (Spark 2372105299656482), SCRATCH NO-FACE port of the screen-space layers. Single fragment pass.
#
#   Spark, canvas0 draw order (layer0, 100% x 100% rectangles, unlit):
#     1. LUT, alpha 1: the camera mixed 0.9 with the 8x8 LUT ("Screenshot_..._polarr", 512x512), Professional LUT
#        patch clamp 0.04 / 0.96. Its grayscale branch is switched off (mix with Bool false).
#     2. Dust canvas / falha, Add blend (the DefaultMaterial default): the 50-frame "VIDAnimationSequence"
#        of blue glitch bars, 10 fps, looping (15 of the 50 frames are pure black).
#   Dropped: the face layers (red multiply lip tint 0.22, Retouch block smoothing, under-eye concealer block).
#   FaceLUT samples a texture id that does not exist ("0,00000") so it draws at alpha 0, and the teeth layer
#   is hidden; neither renders in Spark either.
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('blue_fail_lut);
    makeTexture('blue_fail_glitch);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'blue_fail_lut, 'blue_fail_glitch},
      uniforms = {
        strength = 1.0,
        time = 0.0,
      },
      glslShader = glslBlueFail,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string blue_fail_lut_path = "blue_fail_lut_path";
string blue_fail_lut_filename = "";
string blue_fail_glitch_path = "blue_fail_glitch_path";
string blue_fail_glitch_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; blue_fail_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(blue_fail_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != blue_fail_lut_filename) {
            blue_fail_lut_filename = new_lut;
            loadTexture('blue_fail_lut, blue_fail_lut_filename);
        }
    }
    string glitch_param = getParameterString(blue_fail_glitch_path);
    if (glitch_param != "") {
        string new_glitch = stringAppend("textureFilePath://", glitch_param);
        if (new_glitch != blue_fail_glitch_filename) {
            blue_fail_glitch_filename = new_glitch;
            loadTexture('blue_fail_glitch, blue_fail_glitch_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslBlueFail = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'blue_fail_lut (512x512, 8x8 grid)
    uniform sampler2D auxSampler2;  // 'blue_fail_glitch (50 frames, 10x5 cells of 388x690)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;

    const vec2 kCell = vec2(388.0, 690.0);
    const vec2 kAtlas = vec2(3880.0, 3450.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Professional LUT patch: clamp 0.04 / 0.96, 8x8 grid, one bilinear tap.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.04, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 col = mix(cam.rgb, lutLookup(cam.rgb), 0.9);

      // falha: Add blend, glitch frame at 10 fps over 50 frames from frame 0. mod() keeps it bounded.
      float frame = mod(floor(time * 10.0), 50.0);
      vec2 cell = vec2(mod(frame, 10.0), floor(frame / 10.0));
      vec2 inCell = clamp(topUv(uv) * kCell, vec2(0.5), kCell - 0.5);
      col = min(col + texture2D(auxSampler2, (cell * kCell + inCell) / kAtlas).rgb, 1.0);

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
