[Filter CamcorderSpark]
# "𝕔𝕒𝕞𝕔𝕠𝕣𝕕𝕖𝕣" ported from the Spark effect (1268332220208996). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (blends the two nearest blue slices, so a noisy LUT doesn't band) at 1.
#   Overlay: 'camcorder_spark_star screen-blended full-frame at 1.
#   Spark has no LUT: its HSV adjust (hue +0.01, saturation x1.1, +0.1) and #EEEEFF tint are baked into camcorder_spark_lut.png, fed by its 3x3 sharpen.
#   Then two offset colour-subtract copies of the camera at 0.4 (horizontal VHS chroma bleed), faint procedural tape noise at 25 fps, and star glints on bright edges (one grid of Spark's six).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('camcorder_spark_lut);
    makeTexture('camcorder_spark_star);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the star overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'camcorder_spark_lut, 'camcorder_spark_star},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslCamcorderSpark,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string camcorder_spark_lut_path = "camcorder_spark_lut_path";
string camcorder_spark_lut_filename = "";
string camcorder_spark_star_path = "camcorder_spark_star_path";
string camcorder_spark_star_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; camcorder_spark_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(camcorder_spark_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != camcorder_spark_lut_filename) {
            camcorder_spark_lut_filename = new_lut;
            loadTexture('camcorder_spark_lut, camcorder_spark_lut_filename);
        }
    }

    string camcorder_spark_star_param = getParameterString(camcorder_spark_star_path);
    if (camcorder_spark_star_param != "") {
        string new_camcorder_spark_star = stringAppend("textureFilePath://", camcorder_spark_star_param);
        if (new_camcorder_spark_star != camcorder_spark_star_filename) {
            camcorder_spark_star_filename = new_camcorder_spark_star;
            loadTexture('camcorder_spark_star, camcorder_spark_star_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslCamcorderSpark = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'camcorder_spark_lut
    uniform sampler2D auxSampler2;  // 'camcorder_spark_star

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices (no banding on noisy LUTs).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }
    vec3 camAt(vec2 tuv) {
      return sampleInput(topUv(tuv)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec2 tuv = topUv(uv);
      // Spark's (mis-wired) 3x3 sharpen, 2/512 UV taps, feeding the baked colour adjust + tint.
      vec2 o = vec2(2.0 / 512.0);
      vec3 k = 2.5 * src
          - 0.5 * camAt(tuv + vec2(o.x, -o.y)) - 0.5 * camAt(tuv + vec2(-o.x, -o.y))
          - 0.5 * camAt(tuv + vec2(-o.x, o.y)) - 0.5 * camAt(tuv + vec2(0.0, o.y))
          + 0.5 * camAt(tuv + vec2(-o.x, 0.0));
      vec3 graded = mix(src, lutLookup(clamp(k, 0.0, 1.0)), strength * lut_strength);
      vec3 result = graded;
      // VHS chroma bleed: Spark subtracts two slightly wider colour-filtered copies of the camera at 0.4,
      // one shifted 1.28% left (#006EFF) and one centred (#FFA200).
      {
        vec2 uvA = vec2((tuv.x - 0.5 + 0.0128) / 1.0133 + 0.5, tuv.y);
        vec2 uvB = vec2((tuv.x - 0.5) / 1.0133 + 0.5, tuv.y);
        vec3 a = camAt(uvA);
        vec3 b = camAt(uvB);
        vec3 sub = 0.4 * vec3(b.r, 0.431 * a.g + 0.635 * b.g, a.b);
        result = max(result - sub * strength, vec3(0.0));
      }
      // Tape noise (Spark's 12-frame, 25 fps VHS sequence, squared, added): a faint per-row lift and a
      // rare white dropout dash.
      {
        float fv = mod(floor(time * 25.0), 12.0);  // bounded seed: Spark's 12-frame VHS loop
        float row = floor(tuv.y * 375.0);
        float lift = 0.012 + 0.01 * (hash21(vec2(row, fv)) - 0.5);
        vec2 pxp = floor(tuv * vec2(source_size_x, source_size_y));
        vec2 dash = vec2(hash11(fv * 1.7 + 0.3), hash11(fv * 2.9 + 0.7)) * vec2(source_size_x, source_size_y);
        float on = step(0.9167, hash11(fv + 11.0));
        float dropout = on * step(abs(pxp.y - floor(dash.y)), 0.5) * step(pxp.x, dash.x + 8.0) * step(dash.x, pxp.x);
        result = min(result + vec3(lift + dropout) * strength, vec3(1.0));
      }
      // Star glints on bright spots (one 4.5-cell grid of Spark's six): Spark's rainbow star, tinted
      // #FFE8B0, screened in, scaled by how far the cell centre's luma is above 0.85.
      {
        float ar = source_size_y / max(source_size_x, 1.0);
        vec2 g = vec2(4.5, 4.5 * ar);
        vec2 cc = (floor(tuv * g) + 0.5) / g;
        float h = clamp((dot(camAt(cc), vec3(0.299, 0.587, 0.114)) - 0.85) / 0.15, 0.0, 1.0);
        vec2 l = (fract(tuv * g) - 0.5) / 0.6 + 0.5;
        if (h > 0.0 && l.x >= 0.0 && l.x <= 1.0 && l.y >= 0.0 && l.y <= 1.0) {
          // auxSampler2 = pass input 3 ('camcorder_spark_star). l is top-origin, as the sprite is authored.
          vec3 star = texture2D(auxSampler2, l).rgb * vec3(1.0, 0.91, 0.69) * h;
          result = mix(result, 1.0 - (1.0 - result) * (1.0 - star), overlay_opacity * strength);
        }
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
