[Filter DesfoqueRetrato]
# "Desfoque Retrato" ported from the Spark effect (805021830984489). Single fragment pass, no face
# tracking.
#
#   Spark: the camera graded with FastColorLUT ("neutral - desfoque") as the bottom layer, and on top
#   the camera blurred with BlurGaussian5 (5x5 binomial, taps 3/999 UV apart) and graded with the same
#   LUT, drawn with alpha = 1 - person mask. So the person is sharp, the background is blurred and the
#   whole frame gets the grade. The LUT has no intensity control in Spark.
#   Spark's tap-to-toggle of the blur layer is dropped (IGLU hosts don't send taps): this ships the
#   default, blur-on state.
#
#   Segmentation: the person mask is the host-bound 'mask named input (the manifest's iglu.subject
#   block asks the host for it). Coverage is the brightest channel, so SAM3 instance colours and
#   single-channel masks both work. Hosts that bind no mask get the blur on the full frame.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('desfoque_retrato_lut);
    makeTexture('mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'desfoque_retrato_lut, 'mask},
      uniforms = {
        strength = 1.0,
        has_mask = 0.0,
      },
      glslShader = glslDesfoqueRetrato,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string desfoque_retrato_lut_path = "desfoque_retrato_lut_path";
string desfoque_retrato_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; desfoque_retrato_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(desfoque_retrato_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != desfoque_retrato_lut_filename) {
            desfoque_retrato_lut_filename = new_lut;
            loadTexture('desfoque_retrato_lut, desfoque_retrato_lut_filename);
        }
    }

    # A host-bound mask is at least a few px; an unbound slot reports (0, 0) or a 1x1 placeholder.
    vec2 maskSize = getTextureSize('mask);
    f32 hasMask = 0.0;
    if (maskSize.x > 4.0) {
        hasMask = 1.0;
    }
    setShaderUniform('pass0, 'has_mask, hasMask);
}

#### GLSL shader ####

string glslDesfoqueRetrato = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'desfoque_retrato_lut
    uniform sampler2D auxSampler2;  // 'mask (host person segmentation)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float has_mask;

    // Spark BlurGaussian5: Strength 3 at TextureSize 999.
    const float kStep = 3.0 / 999.0;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode, nearest blue slice).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One row of the 5x5 kernel: [1 4 6 4 1] taps at height dy.
    vec3 blurRow(vec2 uv, float dy) {
      vec2 o = vec2(0.0, dy);
      vec2 dx = vec2(kStep, 0.0);
      return sampleInput(uv + o - 2.0 * dx).rgb + 4.0 * sampleInput(uv + o - dx).rgb +
          6.0 * sampleInput(uv + o).rgb + 4.0 * sampleInput(uv + o + dx).rgb +
          sampleInput(uv + o + 2.0 * dx).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Person coverage from the host mask; no mask = the blur on the full frame.
      float cover = 0.0;
      if (has_mask > 0.5) {
        vec4 m = texture2D(auxSampler2, uv);
        cover = clamp(max(m.r, max(m.g, m.b)), 0.0, 1.0);
      }

      // Fully covered pixels show the sharp graded camera, so they skip the blur and its grade.
      vec3 gradedBlur = vec3(0.0);
      if (cover < 1.0) {
        vec3 blur = (blurRow(uv, -2.0 * kStep) + 4.0 * blurRow(uv, -kStep) +
                     6.0 * blurRow(uv, 0.0) + 4.0 * blurRow(uv, kStep) + blurRow(uv, 2.0 * kStep)) /
            256.0;
        gradedBlur = lutLookup(blur);
      }
      vec3 graded = mix(gradedBlur, lutLookup(cam.rgb), cover);
      vec3 result = mix(cam.rgb, graded, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
