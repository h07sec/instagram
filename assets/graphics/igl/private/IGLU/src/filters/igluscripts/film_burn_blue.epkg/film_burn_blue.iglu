[Filter FilmBurnBlue]
# "Film burn blue" ported from the Spark effect (1069802477670885). Single fragment pass,
# no face tracking; the light overlay ships as three frame atlases.
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 0.7.
#   Overlay: Spark 97-frame light sequence (15 fps, 6.467 s loop, add 1.0), Texture Fit cover at 9:16 (never stretched):
#     'film_burn_blue_box = full-res REC box crop per frame (kept upright; top-centre, uniform scale),
#     'film_burn_blue_burn = the rest of each frame at 1/6 res (colour of the blue-violet light leaks),
#     'film_burn_blue_detail = the white part (min channel) of every frame at 1/2 res, 3 frames per RGB texel:
#     the flash mottle and horizontal interference bands, scratches, dust and edge marks.
#   Face approximations without face tracking: a fixed centre ellipse (selfie framing) plus colour
#   gates for lips and skin, so they work in hosts with no face tracker.
#   Lip tint: multiply (0.667, 0, 0) on lip-coloured pixels in the lower face at 0.22.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('film_burn_blue_lut);
    makeTexture('film_burn_blue_box);
    makeTexture('film_burn_blue_burn);
    makeTexture('film_burn_blue_detail);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.7, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {box_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the box overlay"},
        {burn_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the burn overlay"},
        {lip_opacity = 0.22, min = 0.0, max = 1.0, description = "Lip tint (fakes the face-tracked lip layer)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'film_burn_blue_lut, 'film_burn_blue_box, 'film_burn_blue_burn, 'film_burn_blue_detail},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.7,
        box_opacity = 1.0,
        burn_opacity = 1.0,
        lip_opacity = 0.22,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslFilmBurnBlue,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string film_burn_blue_lut_path = "film_burn_blue_lut_path";
string film_burn_blue_lut_filename = "";
string film_burn_blue_box_path = "film_burn_blue_box_path";
string film_burn_blue_box_filename = "";
string film_burn_blue_burn_path = "film_burn_blue_burn_path";
string film_burn_blue_burn_filename = "";
string film_burn_blue_detail_path = "film_burn_blue_detail_path";
string film_burn_blue_detail_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(film_burn_blue_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != film_burn_blue_lut_filename) {
            film_burn_blue_lut_filename = new_lut;
            loadTexture('film_burn_blue_lut, film_burn_blue_lut_filename);
        }
    }

    string film_burn_blue_box_param = getParameterString(film_burn_blue_box_path);
    if (film_burn_blue_box_param != "") {
        string new_film_burn_blue_box = stringAppend("textureFilePath://", film_burn_blue_box_param);
        if (new_film_burn_blue_box != film_burn_blue_box_filename) {
            film_burn_blue_box_filename = new_film_burn_blue_box;
            loadTexture('film_burn_blue_box, film_burn_blue_box_filename);
        }
    }
    string film_burn_blue_burn_param = getParameterString(film_burn_blue_burn_path);
    if (film_burn_blue_burn_param != "") {
        string new_film_burn_blue_burn = stringAppend("textureFilePath://", film_burn_blue_burn_param);
        if (new_film_burn_blue_burn != film_burn_blue_burn_filename) {
            film_burn_blue_burn_filename = new_film_burn_blue_burn;
            loadTexture('film_burn_blue_burn, film_burn_blue_burn_filename);
        }
    }
    string film_burn_blue_detail_param = getParameterString(film_burn_blue_detail_path);
    if (film_burn_blue_detail_param != "") {
        string new_film_burn_blue_detail = stringAppend("textureFilePath://", film_burn_blue_detail_param);
        if (new_film_burn_blue_detail != film_burn_blue_detail_filename) {
            film_burn_blue_detail_filename = new_film_burn_blue_detail;
            loadTexture('film_burn_blue_detail, film_burn_blue_detail_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'box_opacity, getParameterFloat('box_opacity));
    setShaderUniform('pass0, 'burn_opacity, getParameterFloat('burn_opacity));
    setShaderUniform('pass0, 'lip_opacity, getParameterFloat('lip_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslFilmBurnBlue = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'film_burn_blue_lut
    uniform sampler2D auxSampler2;  // 'film_burn_blue_box
    uniform sampler2D auxSampler3;  // 'film_burn_blue_burn
    uniform sampler2D auxSampler4;  // 'film_burn_blue_detail

    uniform float lut_strength;
    uniform float box_opacity;
    uniform float burn_opacity;
    uniform float lip_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const vec3 kLip = vec3(0.667, 0.0, 0.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.04, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Position in the assumed face ellipse (selfie framing): 0 at the centre, 1 at the ellipse edge.
    vec2 faceP(vec2 uv) {
      float aspect = source_size_x / max(source_size_y, 1.0);
      return (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
    }

    // Redness relative to brightness: skin sits around 0.06-0.16, lips above about 0.18.
    float redness(vec3 c) {
      return (c.r - c.g) / (c.r + c.g + c.b + 0.001);
    }

    float lipMask(vec2 uv, vec3 c) {
      vec2 fp = faceP(uv);
      float inFace = 1.0 - smoothstep(0.55, 0.85, length(fp * vec2(1.3, 0.75)));
      // Mouth band: below the nose tip (fp.y ~0.3), above the chin (~1.2).
      float mouth = smoothstep(0.45, 0.65, fp.y) * (1.0 - smoothstep(1.05, 1.3, fp.y));
      float lipColour = smoothstep(0.19, 0.27, redness(c)) * smoothstep(0.08, 0.18, c.r - c.b);
      return inFace * mouth * lipColour;
    }

    float skinMask(vec3 c) {
      float r = redness(c);
      float y = dot(c, vec3(0.299, 0.587, 0.114));
      float order = step(c.b, c.g) * step(c.g, c.r);
      return order * smoothstep(0.03, 0.07, r) * (1.0 - smoothstep(0.17, 0.22, r)) * smoothstep(0.15, 0.3, y);
    }

    float cheekMask(vec2 uv) {
      vec2 fp = faceP(uv);
      vec2 d = vec2(abs(fp.x) - 0.5, fp.y - 0.25) / vec2(0.42, 0.34);
      float m = 1.0 - smoothstep(0.0, 1.0, length(d));
      return m * m;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Light overlay: Spark 97-frame sequence (15 fps, 6.467 s loop, add 1.0) through Texture Fit cover at 9:16.
      // -3 frames aligns the phase with the Spark sample (burn frame 12 at 0.98 s, flash frame 37 at 2.69 s).
      float lf = mod(floor(time * 15.0) + 94.0, 97.0);
      vec2 lcell = vec2(mod(lf, 10.0), floor(lf / 10.0));
      vec2 sz = vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
      vec2 px = topUv(uv) * sz;
      float aspect = sz.x / sz.y;
      // Overlay scale in px per 388x690 overlay texel: cover fit (never stretched). Frames taller than 9:16 fit the
      // height and crop the sides; wider portrait frames fit the width and crop the bottom (top-anchored, so the
      // REC box stays in view); landscape frames fit the width and crop top and bottom evenly.
      float so = aspect < 0.5623 ? sz.y / 690.0 : sz.x / 388.0;
      float oy = aspect > 1.0 ? 0.5 * (sz.y - 690.0 * so) : 0.0;
      vec2 og = (px - vec2(0.5 * sz.x - 194.0 * so, oy)) / so;
      vec2 oq = og / vec2(388.0, 690.0);
      // REC box (x 136..251, y 38..125 of the overlay): in portrait it shares the overlay mapping; in landscape it is
      // anchored top-centre and scaled by the frame height (the shorter side) so it keeps its aspect ratio.
      float sb = aspect > 1.0 ? sz.y / 388.0 : so;
      vec2 bq = (px - vec2(0.5 * sz.x + (136.0 - 194.0) * sb, 38.0 * sb)) / (vec2(116.0, 88.0) * sb);
      float inBox = step(0.0, bq.x) * step(bq.x, 1.0) * step(0.0, bq.y) * step(bq.y, 1.0);
      // In landscape the overlay copy of the box rect is cropped off, so only the anchored box shows.
      vec2 hq = (og - vec2(136.0, 38.0)) / vec2(116.0, 88.0);
      float inHole = step(0.0, hq.x) * step(hq.x, 1.0) * step(0.0, hq.y) * step(hq.y, 1.0);
      // REC box 'film_burn_blue_box (add): full-res crop of every frame, 10x10 atlas of 116x88 cells.
      {
        // auxSampler2 = pass input 3 ('film_burn_blue_box).
        vec4 ov = inBox * texture2D(auxSampler2, (lcell + clamp(bq, 0.006, 0.994)) / 10.0);
        result = mix(result, min(result + ov.rgb, vec3(1.0)), box_opacity * strength);
      }
      // Rest of the overlay (add), split into colour and white so it fits in ~1 MB:
      // 'film_burn_blue_burn = every frame at 1/6 res (10x10 atlas of 64x114 cells), used only for its colour
      // above the min channel (the blue-violet light leaks are soft, so 1/6 res keeps them);
      // 'film_burn_blue_detail = min channel of every frame at 1/2 res (6x6 atlas of 194x345 cells, frame lf in
      // cell floor(lf/3), channel lf mod 3): flash mottle, the horizontal interference bands, scratches, dust.
      {
        float inFrame = step(0.0, oq.x) * step(oq.x, 1.0) * step(0.0, oq.y) * step(oq.y, 1.0) * (1.0 - inHole);
        vec2 cq = clamp(oq, 0.008, 0.992);
        // auxSampler3 = pass input 4 ('film_burn_blue_burn).
        vec3 lo = texture2D(auxSampler3, (lcell + cq) / 10.0).rgb;
        vec3 chroma = lo - vec3(min(lo.r, min(lo.g, lo.b)));
        float dc = floor(lf / 3.0);
        float ch = lf - 3.0 * dc;
        // auxSampler4 = pass input 5 ('film_burn_blue_detail).
        vec3 dt = texture2D(auxSampler4, (vec2(mod(dc, 6.0), floor(dc / 6.0)) + clamp(oq, 0.004, 0.996)) / 6.0).rgb;
        float white = dot(dt, vec3(step(ch, 0.5), step(0.5, ch) * step(ch, 1.5), step(1.5, ch)));
        vec3 ov = inFrame * (chroma + vec3(white));
        result = mix(result, min(result + ov, vec3(1.0)), burn_opacity * strength);
      }
      // Lip tint on lip-coloured pixels in the lower face, judged on the ungraded camera.
      result = mix(result, result * kLip, lip_opacity * strength * lipMask(uv, cam.rgb));

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
