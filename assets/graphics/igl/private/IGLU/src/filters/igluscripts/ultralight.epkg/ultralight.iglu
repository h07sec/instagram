[Filter Ultralight]
# "ultralight" ported from the Spark effect (1190088254834386). Single fragment pass, no face
# tracking and no assets: Spark has no LUT here, only its post-processing block.
#
#   Spark's post-processing block: sharpen 0.727 and glow 0.137 on a blurred copy, i.e.
#   out = I + 1.4545 (I - B) + 0.137 B, then clipped (a wide-radius clarity sharpen + glow lift).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslUltralight,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
}

#### GLSL shader ####

string glslUltralight = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)

    // One row of the 5x5 separable gaussian (taps 0, +-0.00544, +-0.01268 UV; weights 0.22703,
    // 0.31622, 0.07027), unrolled with constant weights.
    vec3 gaussRow(vec2 uv, float oy) {
      return 0.07027 * sampleInput(uv + vec2(-0.01268, oy)).rgb
           + 0.31622 * sampleInput(uv + vec2(-0.00544, oy)).rgb
           + 0.22703 * sampleInput(uv + vec2(0.0, oy)).rgb
           + 0.31622 * sampleInput(uv + vec2(0.00544, oy)).rgb
           + 0.07027 * sampleInput(uv + vec2(0.01268, oy)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 b = 0.07027 * gaussRow(uv, -0.01268) + 0.31622 * gaussRow(uv, -0.00544)
             + 0.22703 * gaussRow(uv, 0.0) + 0.31622 * gaussRow(uv, 0.00544)
             + 0.07027 * gaussRow(uv, 0.01268);
      vec3 clarity = clamp(src + 1.45455 * (src - b) + 0.13699 * b, 0.0, 1.0);
      vec3 result = mix(src, clarity, strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
