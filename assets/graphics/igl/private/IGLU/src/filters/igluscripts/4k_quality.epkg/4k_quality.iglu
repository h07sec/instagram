[Filter Quality4K]
# "4k_quality" ported from the Spark effect (3722318788051842). Single fragment pass, no face tracking. SCRATCH (batch 12, stack E).
#
#   Spark: one full-frame canvas rect `screen` (alpha blend, opacity 1, unlit) over the camera. Its graph (main.json):
#     f(p) = FastColorLUT(clamp(camera(p), 0.04, 0.96)) into `4k Quality - Anastasia_miln` (512x512 8x8 atlas, raw uv,
#            no half-texel inset), mathMix(camera, LUT, 1) = LUT; the desaturate mix has factor false (identity).
#     out  = 5 f(uv) - f(uv + (-o,-o)) - f(uv + (o,-o)) - f(uv + (-o,0)) - f(uv + (-o,o)), divided by 1,
#            o = slider / 512 in uv on both axes, slider initialValue 0.12 (baked). The other four 3x3 taps are wired
#            with weight 0 (as built by the creator: the kernel is not symmetric). alpha sums to 1.
#   Dropped (face tracked, BATCH-DROP): teeth whitening (Clareador block, mouth-open gated), under-eye concealer
#   re-renders olheiras/olheira 0.5, contour 0.027, blush 0.027 x2, face dust 0.19 multiply, smoothing 0.35 x2 fullScreen,
#   same-LUT face copies (face, rosto lut 1).
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('4k_quality_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, '4k_quality_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslQuality4K,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lut_param_name = "4k_quality_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; 4k_quality_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lut_param_name);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lut_filename) {
            lut_filename = new_lut;
            loadTexture('4k_quality_lut, lut_filename);
        }
    }
}

#### GLSL shader ####

string glslQuality4K = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // '4k_quality_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    const float kOffset = 0.12 / 512.0;  // slider / 512, uv units on both axes

    // FastColorLUT patch: clamp 0.04..0.96, blue row/column in an 8x8 atlas, no half-texel inset.
    vec3 grade(vec2 p) {
      vec3 c = clamp(sampleInput(p).rgb, 0.04, 0.96);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row)).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Spark +y is down the image. Metal uv is top-origin (UP == -1); OpenGL is bottom-origin (UP == 1).
      vec2 dx = vec2(kOffset, 0.0);
      vec2 dy = vec2(0.0, UP > 0.0 ? -kOffset : kOffset);
      // The four zero-weight taps are skipped (0 * x adds nothing).
      vec3 conv = 5.0 * grade(uv)
          - grade(uv - dx - dy)
          - grade(uv + dx - dy)
          - grade(uv - dx)
          - grade(uv - dx + dy);
      // UNORM render target in Spark; the rect alpha is 1, so the blend over the camera is the clamped colour.
      vec3 spark = clamp(conv, 0.0, 1.0);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
