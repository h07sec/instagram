[Filter HomeSpark]
# "HOME" ported from the Spark effect (2576819772536860). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Spark feeds its LUT a 4-tap radial chromatic fringe, overlays a near-flat 15 fps grain, adds sparse light dust specks (15 fps) and occasional 0.5 s orange washes along a jittering vertical band; all procedural here.
#   Dropped: the washes' response to phone tilt (no motion input).
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('home_spark_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'home_spark_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslHomeSpark,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string home_spark_lut_path = "home_spark_lut_path";
string home_spark_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; home_spark_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(home_spark_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != home_spark_lut_filename) {
            home_spark_lut_filename = new_lut;
            loadTexture('home_spark_lut, home_spark_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslHomeSpark = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'home_spark_lut

    uniform float lut_strength;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Spark's radial chromatic fringe before the LUT: four taps zoomed 0.6..2.4% from the centre;
      // R, G, B average taps (3,4), (2,3), (1,2).
      vec2 d = uv - vec2(0.5);
      vec3 s1 = sampleInput(vec2(0.5) + d * 1.006).rgb;
      vec3 s2 = sampleInput(vec2(0.5) + d * 1.012).rgb;
      vec3 s3 = sampleInput(vec2(0.5) + d * 1.018).rgb;
      vec3 s4 = sampleInput(vec2(0.5) + d * 1.024).rgb;
      vec3 ca = vec3(0.5 * (s3.r + s4.r), 0.5 * (s2.g + s3.g), 0.5 * (s1.b + s2.b));
      vec3 graded = mix(src, lutLookup(ca), strength * lut_strength);
      vec3 result = graded;
      vec2 tuv = topUv(uv);
      vec2 pxp = floor(tuv * vec2(source_size_x, source_size_y));
      // Grain: Spark overlays an 8-frame, 15 fps near-flat grain (mean 0.495, sd 0.0195).
      {
        float n = hash21(pxp + vec2(mod(floor(time * 15.0), 8.0) * 17.0));
        vec3 gg = vec3(0.495 + (n - 0.5) * 0.0675);
        vec3 ov = mix(2.0 * result * gg, 1.0 - 2.0 * (1.0 - result) * (1.0 - gg), step(0.5, result));
        result = mix(result, ov, strength);
      }
      // Dust: Spark adds a 15 fps sequence of a few tiny light specks (brightness 0.4-0.6).
      {
        float fd = mod(floor(time * 15.0), 16.0);  // bounded seed
        vec2 cell = floor(pxp / 3.0);
        float h = hash21(cell + fd * 13.7);
        float speck = step(0.99993, h) * (0.4 + 0.2 * hash11(h * 91.0));
        result = min(result + vec3(speck) * strength, vec3(1.0));
      }
      // Orange wash: about one 0.5 s flash per 2.5 s slot at a random amplitude (up to 0.5), brightest
      // along a vertical band that jitters every 0.1 s, added at 0.5036.
      {
        // Bounded seed: the wash schedule repeats every 16 slots (40 s).
        float tw = mod(time, 40.0);
        float slot = floor(tw / 2.5);
        float on = tw - slot * 2.5 - hash11(slot + 3.1) * 2.0;
        float k = (on >= 0.0 && on < 0.5) ? hash11(slot + 7.0) * 0.5 : 0.0;
        float x0 = hash11(mod(floor(time * 10.0), 16.0) + 0.37);
        float r = clamp((length(d * 2.0) * 0.7071 - 0.5) / 0.5, 0.0, 1.0);
        vec3 oc = mix(vec3(1.0, 0.317, 0.0), vec3(1.0, 0.067, 0.0), r);
        result = min(result + oc * clamp(1.0 - abs(tuv.x - x0), 0.0, 1.0) * k * 0.5036 * strength, vec3(1.0));
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
