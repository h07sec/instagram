[Filter ClassicNegative]
# "classic negative" — retro film LUT + fine film grain + soft face smoothing.
# Ported from the Spark effect "classic negative" (617977570104112). Single
# fragment pass, no face tracking and no grain asset:
#
#   Layer 1 — Soft skin smoothing: an edge-aware blur weighted by a soft centre
#             ellipse (where a selfie face sits), applied BEFORE the grade so the
#             face stays graded. Fakes Spark's face-tracked retouching material
#             (smoothing 1.0); `smooth_strength` dials it, 0 disables it.
#   Layer 2 — Retro film LUT at full strength (Spark FastColorLUT, "retro film").
#   Layer 3 — Static film grain, normal-blended at 9% (Spark blended material
#             over a grain photo, opacity 0.09). Procedural hash noise matched to
#             the photo's mean (0.38) and spread (0.18) replaces the 1024x768 JPEG.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('classic_negative_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength (Spark FastColorLUT, full strength)"},
        {grain_opacity = 0.09, min = 0.0, max = 0.5, description = "Film grain normal-blend opacity (Spark grain layer opacity 0.09)"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'classic_negative_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        grain_opacity = 0.09,
        smooth_strength = 0.5,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslClassicNegative,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string classic_negative_lut_path = "classic_negative_lut_path";
string classic_negative_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; classic_negative_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(classic_negative_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != classic_negative_lut_filename) {
            classic_negative_lut_filename = new_lut;
            loadTexture('classic_negative_lut, classic_negative_lut_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 go = getParameterFloat('grain_opacity);
    setShaderUniform('pass0, 'grain_opacity, go);

    f32 ss = getParameterFloat('smooth_strength);
    setShaderUniform('pass0, 'smooth_strength, ss);

    # Source resolution for texel offsets, the aspect-correct ellipse and the
    # pixel-locked grain. Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslClassicNegative = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'classic_negative_lut

    uniform float lut_strength;
    uniform float grain_opacity;
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges (eyes, brows, the
    // face outline) get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Layer 1: soft centre-weighted skin smoothing (before the grade).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 p = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float face = 1.0 - smoothstep(0.35, 1.0, length(p));
      float smoothAmount = smooth_strength * face;
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }

      // Layer 2: retro film LUT.
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = mix(src, lutLookup(src), strength * lut_strength);

      // Layer 3: static, pixel-locked grain normal-blended over the grade.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y));
      float n = fract(sin(dot(px, vec2(12.9898, 78.233))) * 43758.5453);
      float grain = clamp(0.384 + (n - 0.5) * 0.61, 0.0, 1.0);
      result = mix(result, vec3(grain), grain_opacity);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
