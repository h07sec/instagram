[Filter FilmBurnBlack]
# "Film burn black" ported from the Spark effect (366022579403397). Single fragment pass, no face tracking.
#
#   Spark: the camera mixed 0.7 with a dark, desaturated LUT (Professional LUT patch: clamp 0.04 / 0.96 into an
#   8x8 FastColorLUT, bilinear), then a 50-frame film-burn sequence added on top at 0.9 (engine default Add
#   blend), 15 fps, looping every 3.33 s from frame 0. The 50 frames ship as one 10x5 atlas of 204x363 cells.
#   Dropped: skin smoothing (covered by the opaque LUT layer), a face LUT with a broken texture, and faint
#   face layers (concealer, teeth, lip tint, face specks). The promo's KONGIRO logo is not part of the effect.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('film_burn_black_lut);
    makeTexture('film_burn_black_burn);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'film_burn_black_lut, 'film_burn_black_burn},
      uniforms = {
        strength = 1.0,
        time = 0.0,
      },
      glslShader = glslFilmBurnBlack,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string film_burn_black_lut_path = "film_burn_black_lut_path";
string film_burn_black_lut_filename = "";
string film_burn_black_burn_path = "film_burn_black_burn_path";
string film_burn_black_burn_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; film_burn_black_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(film_burn_black_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != film_burn_black_lut_filename) {
            film_burn_black_lut_filename = new_lut;
            loadTexture('film_burn_black_lut, film_burn_black_lut_filename);
        }
    }
    string burn_param = getParameterString(film_burn_black_burn_path);
    if (burn_param != "") {
        string new_burn = stringAppend("textureFilePath://", burn_param);
        if (new_burn != film_burn_black_burn_filename) {
            film_burn_black_burn_filename = new_burn;
            loadTexture('film_burn_black_burn, film_burn_black_burn_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

}

#### GLSL shader ####

string glslFilmBurnBlack = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'film_burn_black_lut
    uniform sampler2D auxSampler2;  // 'film_burn_black_burn (10x5 atlas of 204x363 frames)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;

    const vec2 kCell = vec2(204.0, 363.0);
    const vec2 kAtlas = vec2(2040.0, 1815.0);
    const float kFps = 15.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Professional LUT patch: clamp 0.04 / 0.96, 8x8 grid, bilinear.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.04, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 graded = mix(cam.rgb, lutLookup(cam.rgb), 0.7);
      // Burn frame at 15 fps, looping over 50 frames; mod() keeps the index small however long the clip runs.
      float frame = mod(floor(time * kFps), 50.0);
      vec2 cell = vec2(mod(frame, 10.0), floor(frame / 10.0));
      vec2 inCell = clamp(topUv(uv) * kCell, vec2(0.5), kCell - 0.5);
      vec3 burn = texture2D(auxSampler2, (cell * kCell + inCell) / kAtlas).rgb;
      vec3 spark = graded + 0.9 * burn;
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
