[Filter CamcorderV1]
# "ᴄᴀᴍᴄᴏʀᴅᴇʀ ᴠ.1" ported from the Spark effect (498116255036432). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Soft focus: 3x3 gaussian of the camera before the grade (Spark's separable Gaussian Blur, sigma 1.5 px at 720 wide).
#   Overlay: 'camcorder_v1_hud screen-blended full-frame at 1 (the one extra asset).
#   The LUT is Spark's chain baked into one LUT: summery (1.0) + dispo x summery (alpha 0.5) + Oldish (multiply 0.5) + a flat warm screen layer (fdsa).
#   The HUD is frame 1 of Spark's 34-frame 5 fps sequence. The rest of the sequence is procedural at 5 fps:
#   the CH1/CH2 audio meters flicker between 4 and 5 lit segments, and the red REC dot blinks every other frame.
#   On 5 of Spark's 37 frames the whole HUD jumps vertically (-32/+8/-30/+8/-8 px) with a slight RGB split.
#
# Time source: the host's time_sec parameter. GLSL only
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('camcorder_v1_lut);
    makeTexture('camcorder_v1_hud);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {blur_sigma = 1.5, min = 0.0, max = 4.0, description = "Soft-focus blur radius in px at 720 px wide (Spark Gaussian Blur block)"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the hud overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'camcorder_v1_lut, 'camcorder_v1_hud},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        blur_sigma = 1.5,
        overlay_opacity = 1.0,
        u_time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslCamcorderV1,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string camcorder_v1_lut_path = "camcorder_v1_lut_path";
string camcorder_v1_lut_filename = "";
string camcorder_v1_hud_path = "camcorder_v1_hud_path";
string camcorder_v1_hud_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; camcorder_v1_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(camcorder_v1_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != camcorder_v1_lut_filename) {
            camcorder_v1_lut_filename = new_lut;
            loadTexture('camcorder_v1_lut, camcorder_v1_lut_filename);
        }
    }

    string ov_param = getParameterString(camcorder_v1_hud_path);
    if (ov_param != "") {
        string new_ov = stringAppend("textureFilePath://", ov_param);
        if (new_ov != camcorder_v1_hud_filename) {
            camcorder_v1_hud_filename = new_ov;
            loadTexture('camcorder_v1_hud, camcorder_v1_hud_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'blur_sigma, getParameterFloat('blur_sigma));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Time drives the HUD meters and REC dot.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslCamcorderV1 = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'camcorder_v1_lut
    uniform sampler2D auxSampler2;  // 'camcorder_v1_hud

    uniform float lut_strength;
    uniform float blur_sigma;
    uniform float overlay_opacity;
    uniform float u_time;
    uniform float source_size_x;
    uniform float source_size_y;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    float hash11(float n) {
      return fract(sin(n) * 43758.5453);
    }

    // HUD layer in its 376x668 pixel space: frame 1 plus the procedural 5 fps animation.
    vec3 hudLayer(vec2 uv) {
      const vec2 kHudSize = vec2(376.0, 668.0);
      const float kSegPitch = 7.55;
      vec2 px = uv * kHudSize;
      float frame = mod(floor(u_time * 5.0), 997.0);
      // Meter segment 5 (index 4) of each channel is lit in ~75% of Spark's frames; when dark it shows
      // the unlit segment two below it.
      float seg = floor((px.y - 547.0) / kSegPitch);
      bool chA = px.x >= 24.0 && px.x < 38.0;
      bool chB = px.x >= 43.0 && px.x < 57.0;
      if (seg == 4.0 && (chA || chB) && hash11(frame * 1.7 + (chA ? 0.0 : 31.0)) < 0.25) {
        px.y += 2.0 * kSegPitch;
      }
      // Spark's 37-frame loop jumps the whole HUD vertically on 5 frames (with a slight RGB split).
      float loopFrame = mod(frame, 37.0);
      float jump = 0.0;
      if (loopFrame == 8.0) { jump = -32.0; }
      if (loopFrame == 13.0) { jump = 8.0; }
      if (loopFrame == 19.0) { jump = -30.0; }
      if (loopFrame == 24.0) { jump = 8.0; }
      if (loopFrame == 34.0) { jump = -8.0; }
      float split = jump != 0.0 ? 1.5 : 0.0;
      vec2 hp = vec2(px.x, px.y - jump);
      vec3 hud = vec3(texture2D(auxSampler2, (hp + vec2(0.0, split)) / kHudSize).r,
                      texture2D(auxSampler2, hp / kHudSize).g,
                      texture2D(auxSampler2, (hp - vec2(0.0, split)) / kHudSize).b);
      px = hp;
      float recDot = (1.0 - smoothstep(6.5, 7.5, length(px - vec2(352.0, 335.0)))) * mod(frame, 2.0);
      return max(hud, vec3(0.85, 0.12, 0.10) * recDot);
    }

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions and overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft-focus 3x3 gaussian before the grade (Spark's separable Gaussian Blur block).
      if (blur_sigma > 0.0) {
        vec2 bd = vec2(blur_sigma / 720.0, blur_sigma / 720.0 * source_size_x / max(source_size_y, 1.0));
        vec3 bs = src * 4.0;
        bs += (sampleInput(uv + vec2(bd.x, 0.0)).rgb + sampleInput(uv - vec2(bd.x, 0.0)).rgb
             + sampleInput(uv + vec2(0.0, bd.y)).rgb + sampleInput(uv - vec2(0.0, bd.y)).rgb) * 2.0;
        bs += sampleInput(uv + bd).rgb + sampleInput(uv - bd).rgb
            + sampleInput(uv + vec2(bd.x, -bd.y)).rgb + sampleInput(uv + vec2(-bd.x, bd.y)).rgb;
        src = bs / 16.0;
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay (screen).
      // auxSampler2 = third pass input (the overlay).
      vec3 ov = hudLayer(topUv(uv));
      result = mix(result, 1.0 - (1.0 - result) * (1.0 - ov), overlay_opacity);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
