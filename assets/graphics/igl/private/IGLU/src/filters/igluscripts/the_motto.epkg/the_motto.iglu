[Filter TheMotto]

[Init]
fun init(Filter filter)
{
    makeTexture('the_motto_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'the_motto_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
      },
      glslShader = glslLut,
    }};
}

string lut_path = "lut_path";
string the_motto_lut_path = "the_motto_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; the_motto_lut_path is for local testing.

    string lut_filename_parameter = getParameterString(lut_path);

    if (lut_filename_parameter == "") {

        lut_filename_parameter = getParameterString(the_motto_lut_path);

    }
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('the_motto_lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, s);
}

#### GLSL shader ####

string glslLut = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float lut_strength;

    // Spark colorLUTShader decode: nearest blue slice of an 8x8 grid, sampled half a texel
    // inside the cell so bilinear filtering never bleeds into the neighbouring slice.
    // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
    vec3 lut(vec3 c) {
      c = clamp(c, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      return texture2D(auxSampler1, (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) / 512.0).rgb;
    }

    // Spark draws eight copies of the graded camera on top of the base grade, each stretched to
    // 106.67% width and shifted left by |x| / 319.8 (its canvas is 319.8 pt wide), at 18% opacity,
    // in this render order. The copies stay inside the frame, so they never sample off-image.
    const float kStretch = 1.0666657;
    const float kGhostOpacity = 0.18;

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 texel = sampleInput(uv);
      vec3 graded = lut(texel.rgb);

      float offsets[8];
      offsets[0] = 0.066667; offsets[1] = 0.060162; offsets[2] = 0.053658; offsets[3] = 0.014634;
      offsets[4] = 0.021138; offsets[5] = 0.027642; offsets[6] = 0.034146; offsets[7] = 0.047153;
      for (int i = 0; i < 8; i++) {
        vec2 ghostUv = vec2((uv.x + offsets[i]) / kStretch, uv.y);
        graded = mix(graded, lut(sampleInput(ghostUv).rgb), kGhostOpacity);
      }

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      texel = mix(texel, vec4(graded, texel.a), strength * lut_strength);

      gl_FragColor = toOutputFormat(texel);
    }
    ";
