[Filter FilmTones8]
# "8+ film tones" (Spark 458981909014077), SCRATCH port of the screen-space layers. Single fragment pass.
#
#   Spark draw order (one layer, scene order), all unlit:
#     1. canvas Luts / rectangle1..8, alpha, opaque: FastColorLUT (clamp 0.0078125 / 0.98438, 8x8 grid, no camera
#        mix) with one of 8 LUTs; the NativeUI picker index (script default 0) unhides one rect. Here: param tone,
#        LUTs packed 4x2 in '8_film_tones_luts (cells pixel-equal to the sources).
#     2. canvas0 / rectangle0 grain: alpha over at opacity 0.09, diffuse = slider (initial 1) x noise texture, stretched
#        to the frame.
#     3. canvas0 / 2dText0: ${DATE[dateshort]} in d9n.ttf, 15 pt, centre-aligned in a 100% x 100% box at Yoga
#        offset (-175, 268) pt, rotated 90 deg clockwise (reads downward, glyph tops to the right); diffuse =
#        mix(red, orange, horizontal gradient over the box). Glyphs from '8_film_tones_glyphs (0-9 and slash,
#        rendered from d9n.ttf at 100 px/em, cell 75x128 = advance x (ascent + descent)).
#   Dropped: fullScreen skin smoothing 0.5 and the 8 face-mesh copies (0.65) of the smoothed face.
#   The stem starts with a digit, so the [Filter] name is CamelCase (the tokenizer would split "8_...").
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('8_film_tones_luts);
    makeTexture('8_film_tones_grain);
    makeTexture('8_film_tones_glyphs);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {tone = 0.0, min = 0.0, max = 7.0, description = "Film tone 0-7 (Spark picker order: 5-28, fuji, prettypreset-11, prettypreset-2, 5-102, new, 5-23, 5-38); rounded to an integer"},
        {date_ymd = -1.0, min = -1.0, max = 991231.0, description = "Local date as YYMMDD sent by the host (-1 = baked 220704, the Spark sample)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, '8_film_tones_luts, '8_film_tones_grain, '8_film_tones_glyphs},
      uniforms = {
        strength = 1.0,
        tone = 0.0,
        date_ymd = -1.0,
        source_size_x = 1.0,
        source_size_y = 1.0,
      },
      glslShader = glslFilmTones8,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string luts_path = "8_film_tones_luts_path";
string luts_filename = "";
string grain_path = "8_film_tones_grain_path";
string grain_filename = "";
string glyphs_path = "8_film_tones_glyphs_path";
string glyphs_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'tone, getParameterFloat('tone));
    setShaderUniform('pass0, 'date_ymd, getParameterFloat('date_ymd));

    string luts_param = getParameterString(luts_path);
    if (luts_param != "") {
        string new_luts = stringAppend("textureFilePath://", luts_param);
        if (new_luts != luts_filename) {
            luts_filename = new_luts;
            loadTexture('8_film_tones_luts, luts_filename);
        }
    }
    string grain_param = getParameterString(grain_path);
    if (grain_param != "") {
        string new_grain = stringAppend("textureFilePath://", grain_param);
        if (new_grain != grain_filename) {
            grain_filename = new_grain;
            loadTexture('8_film_tones_grain, grain_filename);
        }
    }
    string glyphs_param = getParameterString(glyphs_path);
    if (glyphs_param != "") {
        string new_glyphs = stringAppend("textureFilePath://", glyphs_param);
        if (new_glyphs != glyphs_filename) {
            glyphs_filename = new_glyphs;
            loadTexture('8_film_tones_glyphs, glyphs_filename);
        }
    }

    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslFilmTones8 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // '8_film_tones_luts (2048x1024, 4x2 cells of 512x512 8x8-grid LUTs)
    uniform sampler2D auxSampler2;  // '8_film_tones_grain (1024x1024 noise, opaque)
    uniform sampler2D auxSampler3;  // '8_film_tones_glyphs (825x128: 0-9 then slash, 75x128 per glyph)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float tone;
    uniform float date_ymd;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kGrainOpacity = 0.09;
    // Spark lays the text out in device points. The sample device width in points is not recorded;
    // 448 pt across the frame fits the sample (position and glyph size), see PORT_NOTES.
    const float kCanvasPt = 448.0;
    const vec2 kTextOffsetPt = vec2(-175.0, 268.00006103515625);
    const float kFontPt = 15.0;
    const float kAdvanceEm = 0.75;
    const float kLineEm = 1.28;
    const vec3 kRed = vec3(1.0, 0.0, 0.0);
    const vec3 kOrange = vec3(1.0, 0.6, 0.2);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // FastColorLUT patch on cell (cx, cy) of the 4x2 atlas: clamp, 8x8 grid, one bilinear tap.
    vec3 lut(vec3 rgb, vec2 cell) {
      vec3 c = clamp(rgb, 0.0078125, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      vec2 l = vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY);
      return texture2D(auxSampler1, (cell + l) / vec2(4.0, 2.0)).rgb;
    }

    // Glyph id for slot k of M/D/YY: 0-9 digits, 10 slash.
    float dateGlyph(float k, float m, float d, float y) {
      float mLen = m >= 10.0 ? 2.0 : 1.0;
      float dLen = d >= 10.0 ? 2.0 : 1.0;
      if (k < mLen) { return mLen > 1.0 && k < 1.0 ? floor(m / 10.0) : mod(m, 10.0); }
      k -= mLen;
      if (k < 1.0) { return 10.0; }
      k -= 1.0;
      if (k < dLen) { return dLen > 1.0 && k < 1.0 ? floor(d / 10.0) : mod(d, 10.0); }
      k -= dLen;
      if (k < 1.0) { return 10.0; }
      k -= 1.0;
      return k < 1.0 ? floor(y / 10.0) : mod(y, 10.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamps below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      float t = clamp(floor(tone + 0.5), 0.0, 7.0);
      vec3 col = lut(cam.rgb, vec2(mod(t, 4.0), floor(t / 4.0)));

      vec2 tuv = topUv(uv);
      col = mix(col, texture2D(auxSampler2, tuv).rgb, kGrainOpacity);

      // Date stamp. IGLUScript has no calendar or text API: the host sends the local date as date_ymd.
      float v = date_ymd >= 0.0 ? date_ymd : 220704.0;
      float yy = mod(floor(v / 10000.0), 100.0);
      float mo = floor(mod(v, 10000.0) / 100.0);
      float dd = mod(v, 100.0);
      float n = (mo >= 10.0 ? 2.0 : 1.0) + (dd >= 10.0 ? 2.0 : 1.0) + 4.0;
      float pt = source_size_x / kCanvasPt;
      vec2 pPt = tuv * vec2(source_size_x, source_size_y) / pt;
      vec2 boxPt = vec2(source_size_x, source_size_y) / pt;
      vec2 centre = kTextOffsetPt + 0.5 * boxPt;
      vec2 dPt = pPt - centre;
      // Rotated 90 deg clockwise: reading direction = screen down, glyph up = screen right.
      float along = dPt.y / kFontPt + 0.5 * n * kAdvanceEm;
      float down = 0.5 * kLineEm - dPt.x / kFontPt;
      float k = floor(along / kAdvanceEm);
      if (k >= 0.0 && k < n && down >= 0.0 && down <= kLineEm) {
        float g = dateGlyph(k, mo, dd, yy);
        float gx = clamp((along - k * kAdvanceEm) * 100.0, 0.5, 74.5);
        float gy = clamp(down * 100.0, 0.5, 127.5);
        float cov = texture2D(auxSampler3, vec2((g * 75.0 + gx) / 825.0, gy / 128.0)).r;
        // Horizontal gradient over the text box (local x = reading direction), red at the box start.
        float u = clamp(0.5 + dPt.y / boxPt.x, 0.0, 1.0);
        col = mix(col, mix(kRed, kOrange, u), cov);
      }

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
