[Filter VhsGold]
# "𝐕𝐇𝐒 𝐆𝐎𝐋𝐃 🎞️" ported from the Spark effect (764799798732699). Single fragment pass,
# no face tracking (the faint Spark face kit is dropped).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1, RGB shift x1.3 at 0.55, edge blur at 0.4.
#   Grain: static hash noise on the Spark 1024x768 noise-texture grid stretched to the frame
#   (vertically elongated grain = the faint vertical hairlines), add-blended at 0.045 (30% of Spark, per Richard).
#   Dust: two procedural speck layers (Spark: 2 x 15-frame dust sequence, 25 fps, add 1.0).
#   Leak: 'vhs_gold_leak, the 16 4x4 cells of Spark lu2 at 5 fps (3.2 s loop), add 0.7.
#   Flat #FFE6DC multiply at 0.353 before the leak.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('vhs_gold_lut);
    makeTexture('vhs_gold_leak);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {grain_opacity = 0.045, min = 0.0, max = 0.5, description = "Film grain add-blend opacity"},
        {overlay_opacity = 0.7, min = 0.0, max = 1.0, description = "Opacity of the leak overlay"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {
      {
        name = 'lut_grade,
        inputs = {'default, 'vhs_gold_lut},
        bufferType = 'float16,
        glslShader = glslLutGrade,
      },
      {
        name = 'pass0,
        inputs = {'default, 'vhs_gold_lut, 'vhs_gold_leak, 'lut_grade},
        uniforms = {
          strength = 1.0,
          lut_strength = 1.0,
          grain_opacity = 0.045,
          overlay_opacity = 0.7,
          time = 0.0,
          source_size_x = 1024.0,
          source_size_y = 1024.0,
        },
        glslShader = glslVhsGold,
      },
    };
}

# Custom Parameter strings for sample-app local-loading.
string vhs_gold_lut_path = "vhs_gold_lut_path";
string vhs_gold_lut_filename = "";
string vhs_gold_leak_path = "vhs_gold_leak_path";
string vhs_gold_leak_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(vhs_gold_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != vhs_gold_lut_filename) {
            vhs_gold_lut_filename = new_lut;
            loadTexture('vhs_gold_lut, vhs_gold_lut_filename);
        }
    }

    string vhs_gold_leak_param = getParameterString(vhs_gold_leak_path);
    if (vhs_gold_leak_param != "") {
        string new_vhs_gold_leak = stringAppend("textureFilePath://", vhs_gold_leak_param);
        if (new_vhs_gold_leak != vhs_gold_leak_filename) {
            vhs_gold_leak_filename = new_vhs_gold_leak;
            loadTexture('vhs_gold_leak, vhs_gold_leak_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

# The blur layer and the centre tap read the LUT grade. Every tap lands on a texel centre of a same-size
# target (5 px steps), so grading each pixel once and sampling the graded target reads the per-tap lookup
# values. The target must stay float (float16 is enough); an 8-bit target would re-quantize the grade.
string glslLutGrade = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'vhs_gold_lut

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      gl_FragColor = toOutputFormat(vec4(lutLookup(sampleInput(sourceTextureCoordinate).rgb), 1.0));
    }
    ";

string glslVhsGold = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'vhs_gold_lut
    uniform sampler2D auxSampler2;  // 'vhs_gold_leak
    uniform sampler2D auxSampler3;  // 'lut_grade

    uniform float lut_strength;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    // BlurGaussian5 weights as authored (column x = -2..2, row y = -2..2); the one asymmetric tap (0, +2) = 6 is kept. Sum 284.
    float k5(vec2 o) {
      vec2 a = abs(o);
      if (a.x > 1.5) { return a.y > 1.5 ? 1.0 : (a.y > 0.5 ? 4.0 : 10.0); }
      if (a.x > 0.5) { return a.y > 1.5 ? 4.0 : (a.y > 0.5 ? 16.0 : 30.0); }
      return a.y > 1.5 ? (o.y > 0.0 ? 6.0 : 10.0) : (a.y > 0.5 ? 24.0 : 40.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // canvas0 'rectangle+RGB': LUT, RGB Shift 0.09 (G x1.009, B x1.018 about the centre), x1.3, at 0.55 over the camera.
      vec3 lc = texture2D(auxSampler3, uv).rgb;
      vec3 shifted = vec3(lc.r,
                          lutLookup(sampleInput((uv - 0.5) * 1.009 + 0.5).rgb).g,
                          lutLookup(sampleInput((uv - 0.5) * 1.018 + 0.5).rgb).b);
      vec3 comp = mix(src, min(shifted * 1.3, vec3(1.0)), 0.55);
      // canvas0 'rectangle+blur': BlurGaussian5 of the LUT (5 device px per tap) at 0.4, masked off inside the 'suaviza' oval.
      vec2 bstep = vec2(5.0 / max(source_size_x, 1.0), 5.0 / max(source_size_y, 1.0));
      vec3 bacc = vec3(0.0);
      for (int j = -2; j <= 2; j++) {
        for (int i = -2; i <= 2; i++) {
          vec2 o = vec2(float(i), float(j));
          bacc += k5(o) * texture2D(auxSampler3, uv + o * bstep).rgb;
        }
      }
      vec2 op = (topUv(uv) - vec2(0.51, 0.505)) / vec2(0.34, 0.415);
      float oval = 1.0 - smoothstep(0.75, 1.25, length(op));
      comp = mix(comp, bacc / 284.0, 0.4 * (1.0 - oval));
      vec3 graded = mix(src, comp, strength * lut_strength);
      vec3 result = graded;
      vec2 tu = topUv(uv);
      vec2 sz = vec2(max(source_size_x, 1.0), max(source_size_y, 1.0));
      // Static grain: Spark 'noise' is a 1024x768 grain texture stretched over the frame, so on a portrait frame
      // each grain texel is ~0.7 px wide and ~1.7 px tall. Same grid here, rows blended linearly as the sampler does.
      {
        vec2 gg = tu * vec2(1024.0, 768.0) - vec2(0.0, 0.5);
        float gy = floor(gg.y);
        float gx = floor(gg.x);
        float n0 = hash12(vec2(gx, gy));
        float n1 = hash12(vec2(gx, gy + 1.0));
        float n = mix(n0, n1, gg.y - gy);
        float grain = (n - 0.5) * 0.56;
        result = clamp(result + vec3(grain) * grain_opacity * strength, 0.0, 1.0);
      }
      // Spark dust: the 15-frame 'dust 2' sequence (25 fps) on two add layers with different start frames,
      // ~26 specks per layer per frame (counted on the 15 frames), 1..5 px on the 576-wide dust frame, peak 0.45..0.85.
      // Procedural: one candidate speck per 16x16 cell, scaled by the shorter frame side so specks stay round;
      // radius at least 0.8 output px so specks survive small frames.
      // Per Richard's review: half the specks of Spark's count (cell hit rate 1.13% -> 0.565%) at 65% of their brightness.
      {
        float upx = 576.0 / min(sz.x, sz.y);
        vec2 gp = tu * sz * upx;
        vec2 c = floor(gp / 16.0);
        float speck = 0.0;
        for (int k = 0; k < 2; k++) {
          float fk = float(k);
          float f = mod(floor(time * 25.0) + fk * 7.0, 15.0);
          float h = hash12(c + vec2(f * 13.0 + fk * 101.0, fk * 57.0));
          vec2 ctr = (c + 0.1 + 0.8 * vec2(hash12(c + vec2(f * 3.0, 11.0 + fk)), hash12(c + vec2(f * 5.0, 23.0 + fk)))) * 16.0;
          float r = max(0.6 + 1.9 * fract(h * 131.0), 0.8 * upx);
          float b = (0.45 + 0.4 * fract(h * 71.0)) * 0.65;
          speck += step(0.99435, h) * b * (1.0 - smoothstep(r - 0.5 * upx, r + 0.5 * upx, length(gp - ctr)));
        }
        result = min(result + vec3(speck) * strength, vec3(1.0));
      }
      // Spark 'fakelut': flat #FFE6DC multiplied at 0.353.
      result *= mix(vec3(1.0), vec3(1.0, 0.902, 0.863), 0.353 * strength);
      // Full-frame overlay 'vhs_gold_leak (add), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('vhs_gold_leak).
        // LUZES: the 16 64x64 cells of lu2 (4x4, row-major from the top-left), 5 fps; inset clamp against cell bleed.
        // Order verified on all 435 Spark sample frames (period 96 frames at 30 fps): Spark state s shows cell s + 2.
        float lz = mod(floor(time * 5.0) + 2.0, 16.0);
        vec2 lzc = vec2(mod(lz, 4.0), floor(lz / 4.0));
        vec4 ov = texture2D(auxSampler2, (lzc + clamp(topUv(uv), 0.008, 0.992)) / 4.0);
        result = mix(result, min(result + ov.rgb, vec3(1.0)), (overlay_opacity) * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
