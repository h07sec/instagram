[Filter F1830]
# "1830" ported from the Spark effect (450717432949873). Single fragment pass,
# no face tracking.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.58.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Face approximations without face tracking: a fixed centre ellipse (selfie framing) plus colour
#   gates for lips and skin, so they work in hosts with no face tracker.
#   Blush: multiply (1, 0.58, 0.78) on skin tones in the cheek zones at 0.18.
#   Lip tint: multiply (1, 0.227, 0.365) on lip-coloured pixels in the lower face at 0.27.
#   Then Spark's canvas1 layers in order:
#   Grain: static, pixel-locked hash noise (mean 0.393, spread 0.97), normal-blended at 0.1
#   (replaces the Spark B/W grain texture).
#   Light leak: 16 quarter windows of 'f_1830_leak at 5 fps, added at 0.65.
#   Dust: Spark's 5-frame speck sequence at 8 fps (4 non-empty frames in the 2x2 'f_1830_dust atlas), subtracted.
#   Film: the left-edge sprocket bracket, 4 frames at 15 fps ('f_1830_film), tinted #89CECE, added.
#   Spark's 0.67 face warp is dropped: it needs face tracking.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('f_1830_lut);
    makeTexture('f_1830_leak);
    makeTexture('f_1830_dust);
    makeTexture('f_1830_film);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.58, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {grain_opacity = 0.1, min = 0.0, max = 0.5, description = "Film grain normal-blend opacity"},
        {blush_opacity = 0.18, min = 0.0, max = 1.0, description = "Cheek blush (fakes the face-tracked blush layer)"},
        {lip_opacity = 0.27, min = 0.0, max = 1.0, description = "Lip tint (fakes the face-tracked lip layer)"},
        {leak_opacity = 0.65, min = 0.0, max = 1.0, description = "Opacity of the orange light leak (Spark add layer at 0.65)"},
        {dust_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the dust specks"},
        {film_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the film sprocket bracket"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'f_1830_lut, 'f_1830_leak, 'f_1830_dust, 'f_1830_film},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.58,
        grain_opacity = 0.1,
        blush_opacity = 0.18,
        lip_opacity = 0.27,
        time = 0.0,
        leak_opacity = 0.65,
        dust_opacity = 1.0,
        film_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslF1830,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string f_1830_lut_path = "f_1830_lut_path";
string f_1830_lut_filename = "";
string f_1830_leak_path = "f_1830_leak_path";
string f_1830_leak_filename = "";
string f_1830_dust_path = "f_1830_dust_path";
string f_1830_dust_filename = "";
string f_1830_film_path = "f_1830_film_path";
string f_1830_film_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; f_1830_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(f_1830_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != f_1830_lut_filename) {
            f_1830_lut_filename = new_lut;
            loadTexture('f_1830_lut, f_1830_lut_filename);
        }
    }
    string f_1830_leak_param = getParameterString(f_1830_leak_path);
    if (f_1830_leak_param != "") {
        string new_f_1830_leak = stringAppend("textureFilePath://", f_1830_leak_param);
        if (new_f_1830_leak != f_1830_leak_filename) {
            f_1830_leak_filename = new_f_1830_leak;
            loadTexture('f_1830_leak, f_1830_leak_filename);
        }
    }
    string f_1830_dust_param = getParameterString(f_1830_dust_path);
    if (f_1830_dust_param != "") {
        string new_f_1830_dust = stringAppend("textureFilePath://", f_1830_dust_param);
        if (new_f_1830_dust != f_1830_dust_filename) {
            f_1830_dust_filename = new_f_1830_dust;
            loadTexture('f_1830_dust, f_1830_dust_filename);
        }
    }
    string f_1830_film_param = getParameterString(f_1830_film_path);
    if (f_1830_film_param != "") {
        string new_f_1830_film = stringAppend("textureFilePath://", f_1830_film_param);
        if (new_f_1830_film != f_1830_film_filename) {
            f_1830_film_filename = new_f_1830_film;
            loadTexture('f_1830_film, f_1830_film_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'film_opacity, getParameterFloat('film_opacity));
    setShaderUniform('pass0, 'dust_opacity, getParameterFloat('dust_opacity));
    setShaderUniform('pass0, 'leak_opacity, getParameterFloat('leak_opacity));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    setShaderUniform('pass0, 'blush_opacity, getParameterFloat('blush_opacity));
    setShaderUniform('pass0, 'lip_opacity, getParameterFloat('lip_opacity));
    # Time drives the leak, dust and film frames.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslF1830 = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'f_1830_lut
    uniform sampler2D auxSampler2;  // 'f_1830_leak (16 quarter windows)
    uniform sampler2D auxSampler3;  // 'f_1830_dust (2x2 atlas, premultiplied)
    uniform sampler2D auxSampler4;  // 'f_1830_film (4x1 sprocket atlas)

    uniform float lut_strength;
    uniform float film_opacity;
    uniform float dust_opacity;
    uniform float leak_opacity;
    uniform float smooth_strength;
    uniform float grain_opacity;
    uniform float blush_opacity;
    uniform float lip_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const vec3 kBlush = vec3(1.0, 0.58, 0.78);
    const vec3 kLip = vec3(1.0, 0.227, 0.365);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Position in the assumed face ellipse (selfie framing): 0 at the centre, 1 at the ellipse edge.
    vec2 faceP(vec2 uv) {
      float aspect = source_size_x / max(source_size_y, 1.0);
      return (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
    }

    // Redness relative to brightness: skin sits around 0.06-0.16, lips above about 0.18.
    float redness(vec3 c) {
      return (c.r - c.g) / (c.r + c.g + c.b + 0.001);
    }

    float lipMask(vec2 uv, vec3 c) {
      vec2 fp = faceP(uv);
      float inFace = 1.0 - smoothstep(0.55, 0.85, length(fp * vec2(1.3, 0.75)));
      // Mouth band: below the nose tip (fp.y ~0.3), above the chin (~1.2).
      float mouth = smoothstep(0.45, 0.65, fp.y) * (1.0 - smoothstep(1.05, 1.3, fp.y));
      float lipColour = smoothstep(0.19, 0.27, redness(c)) * smoothstep(0.08, 0.18, c.r - c.b);
      return inFace * mouth * lipColour;
    }

    float skinMask(vec3 c) {
      float r = redness(c);
      float y = dot(c, vec3(0.299, 0.587, 0.114));
      float order = step(c.b, c.g) * step(c.g, c.r);
      return order * smoothstep(0.03, 0.07, r) * (1.0 - smoothstep(0.17, 0.22, r)) * smoothstep(0.15, 0.3, y);
    }

    float cheekMask(vec2 uv) {
      vec2 fp = faceP(uv);
      vec2 d = vec2(abs(fp.x) - 0.5, fp.y - 0.25) / vec2(0.42, 0.34);
      float m = 1.0 - smoothstep(0.0, 1.0, length(d));
      return m * m;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Blush on skin-tone pixels in the cheek zones, judged on the ungraded camera.
      result = mix(result, result * kBlush, blush_opacity * strength * skinMask(cam.rgb) * cheekMask(uv));
      // Lip tint on lip-coloured pixels in the lower face, judged on the ungraded camera.
      result = mix(result, result * kLip, lip_opacity * strength * lipMask(uv, cam.rgb));
      // Static pixel-locked grain (Spark's B/W paint texture at 0.10, the first canvas1 layer).
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y));
      vec3 p3 = fract(vec3(px.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      float n = fract((p3.x + p3.y) * p3.z);
      float grain = clamp(0.393 + (n - 0.5) * 0.97, 0.0, 1.0);
      result = mix(result, vec3(grain), grain_opacity * strength);
      vec2 tuv = topUv(uv);
      // Light leak: 16 quarter-size windows of one soft leak image at 5 fps (Spark subTexture sequence), added.
      {
        float i = mod(floor(time * 5.0), 16.0);
        vec2 luv = (vec2(mod(i, 4.0), floor(i / 4.0)) + clamp(tuv, 0.004, 0.996)) * 0.25;
        result = min(result + texture2D(auxSampler2, luv).rgb * leak_opacity * strength, vec3(1.0));
      }
      // Dust specks: 5 frames at 8 fps, frame 2 is empty; subtract the premultiplied texture.
      {
        float f = mod(floor(time * 8.0), 5.0);
        if (f != 2.0) {
          float c = f > 2.0 ? f - 1.0 : f;
          vec2 inCell = clamp(tuv, vec2(0.5 / 288.0, 0.5 / 512.0), vec2(1.0 - 0.5 / 288.0, 1.0 - 0.5 / 512.0));
          vec2 duv = (vec2(mod(c, 2.0), floor(c / 2.0)) + inCell) * 0.5;
          result = max(result - texture2D(auxSampler3, duv).rgb * dust_opacity * strength, vec3(0.0));
        }
      }
      // Film sprocket bracket: 4 frames at 15 fps, left-edge strip only (Spark image 101.33% wide at -0.67%), tinted #89CECE, added.
      {
        float ux = (tuv.x + 0.00667) / 1.01333;
        vec2 s = vec2(ux * 576.0 / 96.0, (tuv.y * 1024.0 - 400.0) / 224.0);
        if (s.x >= 0.0 && s.x < 1.0 && s.y >= 0.0 && s.y < 1.0) {
          float k = mod(floor(time * 15.0), 4.0);
          vec2 fuv = vec2((k + clamp(s.x, 0.5 / 96.0, 1.0 - 0.5 / 96.0)) / 4.0, clamp(s.y, 0.5 / 224.0, 1.0 - 0.5 / 224.0));
          vec3 fb = texture2D(auxSampler4, fuv).rgb;
          result = min(result + fb * vec3(0.537, 0.808, 0.808) * film_opacity * strength, vec3(1.0));
        }
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
