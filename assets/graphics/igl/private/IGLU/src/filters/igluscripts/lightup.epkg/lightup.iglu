[Filter Lightup]
# "lightup" ported from the Spark effect (1198932477588004). Single fragment pass, no face tracking. SCRATCH (batch 12, stack B).
#
#   Spark: full-frame canvas rect `lut` (main_layer, renderingOrder 1), alpha blend, opacity 1, unlit: FastColorLUT with
#   the camera clamped to 0.00781 + 0.02 = 0.02781 .. 0.98438, looked up in the 1024x1024 8x8 atlas IMG_5394 (9596672c...PNG, sha256 dc7ad09578ff...)
#   (linear filter, no half-texel inset), mixed 0.8 from the unclamped camera; src alpha = camera alpha.
#   Then rect `rectangle0` (occluder layer, renderingOrder 2, 100% x 100%), untextured, unlit, multiply, opacity 0.1,
#   diffuseFactor 0xFFFF9C75 (BGRX) = rgb (255, 156, 117): dst * (0.9 + 0.1 * colour).
#   Dropped (face tracked, BATCH-DROP): eyeball-tracked iris tint eyeball_mat 0.288, makeup multiply 0.30 (texture make), mask paints maskMaterial0 0.082 and maskMaterial1 0.027, PBR glow 0.041, retouch smoothing 0.48 fullScreen, the facelut 1.0 same-LUT face copy; freckles is hidden and occluder_mat is opacity 0.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lightup_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lightup_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslLightup,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lightup_lut_path = "lightup_lut_path";
string lightup_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; lightup_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lightup_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lightup_lut_filename) {
            lightup_lut_filename = new_lut;
            loadTexture('lightup_lut, lightup_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslLightup = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lightup_lut (1024x1024, 8x8 atlas, linear)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.00781 + 0.02 .. 0.98438, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.02781, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = mix(cam.rgb, L.rgb, 0.8);  // mathMix(camera rgb, LUT rgb, 0.8)
      // Rect lut alpha-blended over the camera: src alpha = cam.a.
      vec3 spark = mix(cam.rgb, g, clamp(cam.a, 0.0, 1.0));
      // Rect rectangle0: multiply, opacity 0.1, colour (255, 156, 117)/255, premultiplied: dst * (0.9 + 0.1 * colour).
      spark = spark * (0.9 + 0.1 * vec3(1.0, 0.6117647059, 0.4588235294));
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
