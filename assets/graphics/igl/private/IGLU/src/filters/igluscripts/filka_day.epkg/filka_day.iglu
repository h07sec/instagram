[Filter FilkaDay]
# "Filka Day" ported from the Spark effect (658512602926549). Single fragment pass,
# no face tracking.
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.18.
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1, input clamp 0.04..0.98438.
#   Stamp: Spark's tap option 2 (the sample state): a white weekday over a wide-tracked time,
#   drawn from 'filka_day_atlas (weekdays in Sacramento, OFL, in place of Spark's personal-use
#   font; digits in Noto Sans Bold, OFL). Spanish weekday names, as in the sample.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('filka_day_lut);
    makeTexture('filka_day_atlas);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.18, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {text_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the weekday and time stamp"},
        {date_ymd = -1.0, min = -1.0, max = 99991231.0, description = "Date as YYMMDD sent by the host (-1 = baked Sunday)"},
        {time_hm = -1.0, min = -1.0, max = 2359.0, description = "Local time as HHMM sent by the host (-1 = baked 3:00 P.M.)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'filka_day_lut, 'filka_day_atlas},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        smooth_strength = 0.18,
        text_opacity = 1.0,
        date_ymd = -1.0,
        time_hm = -1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslFilkaDay,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string filka_day_lut_path = "filka_day_lut_path";
string filka_day_lut_filename = "";
string filka_day_atlas_path = "filka_day_atlas_path";
string filka_day_atlas_filename = "";

[PreRender]
fun preRender(Filter filter){
    # iOS passes the remote LUT under the generic 'lut_path; filka_day_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(filka_day_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != filka_day_lut_filename) {
            filka_day_lut_filename = new_lut;
            loadTexture('filka_day_lut, filka_day_lut_filename);
        }
    }

    string filka_day_atlas_param = getParameterString(filka_day_atlas_path);
    if (filka_day_atlas_param != "") {
        string new_filka_day_atlas = stringAppend("textureFilePath://", filka_day_atlas_param);
        if (new_filka_day_atlas != filka_day_atlas_filename) {
            filka_day_atlas_filename = new_filka_day_atlas;
            loadTexture('filka_day_atlas, filka_day_atlas_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'text_opacity, getParameterFloat('text_opacity));
    setShaderUniform('pass0, 'date_ymd, getParameterFloat('date_ymd));
    setShaderUniform('pass0, 'time_hm, getParameterFloat('time_hm));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslFilkaDay = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'filka_day_lut
    uniform sampler2D auxSampler2;  // 'filka_day_atlas

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float text_opacity;
    uniform float date_ymd;
    uniform float time_hm;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kPitch = 0.049;  // time glyph pitch, frame-width units (35.3 px at 720)

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.04, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    // Coverage of one atlas cell drawn into a box (frame-width units, top-left origin).
    float atlasCover(vec2 p, vec2 centre, vec2 size, vec2 cellOrigin, vec2 cellSize) {
      vec2 q = (p - centre) / size + 0.5;
      if (q.x < 0.0 || q.x > 1.0 || q.y < 0.0 || q.y > 1.0) { return 0.0; }
      return texture2D(auxSampler2, (cellOrigin + q * cellSize) / vec2(1024.0, 768.0)).r;
    }

    // Atlas glyph for slot s of h:mm P.M. (lead = 1 for a two-digit hour).
    // Glyph ids: 0-9 digits, 10 colon, 11 dot, 12 A, 13 P, 14 M, 15 blank.
    float timeGlyph(float s, float lead, float h12, float mi, float pm) {
      float k = s - lead;
      if (k < 0.0) { return 1.0; }
      if (k < 1.0) { return mod(h12, 10.0); }
      if (k < 2.0) { return 10.0; }
      if (k < 3.0) { return floor(mi / 10.0); }
      if (k < 4.0) { return mod(mi, 10.0); }
      if (k < 5.0) { return 15.0; }
      if (k < 6.0) { return pm > 0.5 ? 13.0 : 12.0; }
      if (k < 7.0) { return 11.0; }
      if (k < 8.0) { return 14.0; }
      return 11.0;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      {
        // Static date: IGLUScript has no calendar/text API. For a live date, the host sends date_ymd
        // (YYMMDD float, exact in f32; YYYYMMDD is accepted but odd days round in f32) and time_hm
        // (HHMM); this pass already draws from the glyph atlas and falls back to the baked date when
        // date_ymd is -1.
        vec2 t = topUv(uv);
        float hw = source_size_y / max(source_size_x, 1.0);
        vec2 p = vec2(t.x, t.y * hw);
        float dow = 0.0;
        if (date_ymd >= 0.0) {
          float v = date_ymd >= 1.0e7 ? date_ymd - 2.0e7 : date_ymd;
          float y = 2000.0 + floor(v / 10000.0);
          float m = floor(mod(v, 10000.0) / 100.0);
          float d = mod(v, 100.0);
          float a = floor((14.0 - m) / 12.0);
          float yy = y - a;
          float mm = m + 12.0 * a - 2.0;
          dow = mod(d + yy + floor(yy / 4.0) - floor(yy / 100.0) + floor(yy / 400.0) + floor(31.0 * mm / 12.0), 7.0);
        }
        vec2 wcell = vec2(mod(dow, 2.0), floor(dow / 2.0)) * vec2(512.0, 192.0);
        float cov = atlasCover(p, vec2(0.488, 0.489 * hw), vec2(0.5038, 0.1889), wcell, vec2(512.0, 192.0));
        float hm = time_hm >= 0.0 ? time_hm : 1500.0;
        float hh = floor(hm / 100.0);
        float mi = mod(hm, 100.0);
        float h12 = mod(hh + 11.0, 12.0) + 1.0;
        float lead = h12 >= 10.0 ? 1.0 : 0.0;
        float n = 9.0 + lead;
        float x0 = 0.496 - 0.5 * n * kPitch;
        float s = floor((p.x - x0) / kPitch);
        if (s >= 0.0 && s < n) {
          float g = timeGlyph(s, lead, h12, mi, hh >= 12.0 ? 1.0 : 0.0);
          vec2 gcell = vec2(512.0 + mod(g, 8.0) * 64.0, 576.0 + floor(g / 8.0) * 96.0);
          cov = max(cov, atlasCover(p, vec2(x0 + (s + 0.5) * kPitch, 0.556 * hw), vec2(0.0381, 0.0571), gcell, vec2(64.0, 96.0)));
        }
        result = mix(result, vec3(1.0), clamp(cov, 0.0, 1.0) * text_opacity * strength);
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
