[Filter Fujifilm]
# "Fujifilm ✧" ported from the Spark effect (316403454375068). Single fragment pass, no face tracking.
#
#   Spark, bottom to top:
#     1. the camera through a 5x5 binomial blur (1 px), then FastColorLUT ("neutral-lut-72", a bright, slightly
#        cool film grade);
#     2. 2-frame grain at 3.4% (alpha 0.1644 * 53/255), flipping at 25 fps: procedural here (same mean/sigma,
#        576x1024 cells);
#     3. 40-frame film dust, screen, 10 fps: an 8-frame premultiplied-grey cut (4x2 atlas) here;
#     4. a static light-leak scan, screen at 0.5068.
#   The face tracker only drives a full-screen skin smoothing that the opaque LUT layer covers, so nothing is
#   faked. The "Tap to change" hint has no tap patch, so it's dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('fujifilm_lut);
    makeTexture('fujifilm_dust);
    makeTexture('fujifilm_leak);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'fujifilm_lut, 'fujifilm_dust, 'fujifilm_leak},
      uniforms = {
        strength = 1.0,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslFujifilm,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string fujifilm_lut_path = "fujifilm_lut_path";
string fujifilm_lut_filename = "";
string fujifilm_dust_path = "fujifilm_dust_path";
string fujifilm_dust_filename = "";
string fujifilm_leak_path = "fujifilm_leak_path";
string fujifilm_leak_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; fujifilm_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(fujifilm_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != fujifilm_lut_filename) {
            fujifilm_lut_filename = new_lut;
            loadTexture('fujifilm_lut, fujifilm_lut_filename);
        }
    }
    string dust_param = getParameterString(fujifilm_dust_path);
    if (dust_param != "") {
        string new_dust = stringAppend("textureFilePath://", dust_param);
        if (new_dust != fujifilm_dust_filename) {
            fujifilm_dust_filename = new_dust;
            loadTexture('fujifilm_dust, fujifilm_dust_filename);
        }
    }
    string leak_param = getParameterString(fujifilm_leak_path);
    if (leak_param != "") {
        string new_leak = stringAppend("textureFilePath://", leak_param);
        if (new_leak != fujifilm_leak_filename) {
            fujifilm_leak_filename = new_leak;
            loadTexture('fujifilm_leak, fujifilm_leak_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslFujifilm = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'fujifilm_lut
    uniform sampler2D auxSampler2;  // 'fujifilm_dust (4x2 atlas of 360x640 frames, premultiplied grey)
    uniform sampler2D auxSampler3;  // 'fujifilm_leak
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kGrainAlpha = 0.034166;
    const float kGrainMean = 0.48961;
    const float kGrainSpread = 0.5571;
    const float kLeak = 0.5068493;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Spark BlurGaussian5: 5x5 binomial, 1 output px apart.
      vec2 px = vec2(1.0 / max(source_size_x, 1.0), 1.0 / max(source_size_y, 1.0));
      vec3 b = vec3(0.0);
      for (int j = -2; j <= 2; j++) {
        float wj = j == 0 ? 6.0 : (j == 1 || j == -1 ? 4.0 : 1.0);
        for (int i = -2; i <= 2; i++) {
          float wi = i == 0 ? 6.0 : (i == 1 || i == -1 ? 4.0 : 1.0);
          b += wi * wj * sampleInput(clamp(uv + vec2(float(i), float(j)) * px, 0.0, 1.0)).rgb;
        }
      }
      vec3 col = lutLookup(b / 256.0);

      vec2 p = topUv(uv);
      // Grain: 576x1024 cells, 2 frames at 25 fps. mod() keeps the seed small however long the clip runs.
      float grainFrame = mod(floor(time * 25.0), 2.0);
      float n = hash12(floor(p * vec2(576.0, 1024.0)) + vec2(grainFrame * 17.0));
      col = mix(col, vec3(clamp(kGrainMean + (n - 0.5) * kGrainSpread, 0.0, 1.0)), kGrainAlpha);

      // Dust: 8 frames at 10 fps, screen.
      float dustFrame = mod(floor(time * 10.0), 8.0);
      vec2 tile = vec2(mod(dustFrame, 4.0), floor(dustFrame / 4.0));
      vec2 inset = vec2(0.5 / 360.0, 0.5 / 640.0);
      float d = texture2D(auxSampler2, (tile + clamp(p, inset, 1.0 - inset)) / vec2(4.0, 2.0)).r;
      col = d + col * (1.0 - d);

      // Light leak: screen at 0.5068, stretched over the frame as in Spark.
      vec3 leak = texture2D(auxSampler3, p).rgb * kLeak;
      col = leak + col * (1.0 - leak);

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
