[Filter StarryNight]
# "Starry Night" ported from the Spark effect (1234843673353269). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Skin smoothing: edge-aware centre-ellipse blur before the grade (fakes Spark's face retouch), 0.5.
#   Grade: 8x8 LUT (blends the two nearest blue slices, so a noisy LUT doesn't band) at 0.85.
#   Overlay: 'starry_night_sky add-blended full-frame at 1.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('starry_night_lut);
    makeTexture('starry_night_sky);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.85, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {smooth_strength = 0.5, min = 0.0, max = 1.0, description = "Soft skin smoothing in the centre of the frame (fakes the face-tracked retouch)"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the sky overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'starry_night_lut, 'starry_night_sky},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.85,
        smooth_strength = 0.5,
        overlay_opacity = 1.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslStarryNight,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string starry_night_lut_path = "starry_night_lut_path";
string starry_night_lut_filename = "";
string starry_night_sky_path = "starry_night_sky_path";
string starry_night_sky_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_param = getParameterString(starry_night_lut_path);
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != starry_night_lut_filename) {
            starry_night_lut_filename = new_lut;
            loadTexture('starry_night_lut, starry_night_lut_filename);
        }
    }

    string starry_night_sky_param = getParameterString(starry_night_sky_path);
    if (starry_night_sky_param != "") {
        string new_starry_night_sky = stringAppend("textureFilePath://", starry_night_sky_param);
        if (new_starry_night_sky != starry_night_sky_filename) {
            starry_night_sky_filename = new_starry_night_sky;
            loadTexture('starry_night_sky, starry_night_sky_filename);
        }
    }
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslStarryNight = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'starry_night_lut
    uniform sampler2D auxSampler2;  // 'starry_night_sky

    uniform float lut_strength;
    uniform float smooth_strength;
    uniform float overlay_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices (no banding on noisy LUTs).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat skin is softened.
    vec4 skinTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    // 8-tap ring blur at a fixed fraction of the frame height (resolution independent).
    vec3 skinBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += skinTap(uv + d * vec2(1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += skinTap(uv + d * vec2(0.0, 1.0), y0);
      acc += skinTap(uv + d * vec2(0.0, -1.0), y0);
      acc += skinTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += skinTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += skinTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft centre-weighted skin smoothing before the grade (fakes the face-tracked retouch).
      float aspect = source_size_x / max(source_size_y, 1.0);
      vec2 fp = (topUv(uv) - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      float smoothAmount = strength * smooth_strength * (1.0 - smoothstep(0.35, 1.0, length(fp)));
      if (smoothAmount > 0.0) {
        src = mix(src, skinBlur(uv, src), smoothAmount);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      // Spark preProcessor. The LUT texture already holds mix(sc, LUT32(sc), 0.85) of the input.
      vec3 sc = mix(src, smoothstep(0.0, 1.0, src), 0.25);
      vec3 lut1 = lutLookup(src);
      vec2 tuv = topUv(uv);
      vec2 sfp = (tuv - vec2(0.5, 0.42)) * vec2(aspect, 1.0) / vec2(0.30, 0.26);
      // Face pull-back (Spark lut_mask G x 0.55), on the fixed selfie ellipse instead of the tracked face plane.
      lut1 = mix(lut1, src, 0.55 * (1.0 - smoothstep(0.6, 1.0, length(sfp))));
      // Spark vignette: smoothstep(0.68, 0.15, d), written with ordered edges (reversed edges are undefined in GLSL).
      vec2 vr = vec2(aspect, 0.85);
      lut1 *= 1.0 - smoothstep(0.15, 0.68, distance(tuv * vr, 0.5 * vr));
      vec3 graded = mix(src, mix(sc, lut1, lut_strength), strength);
      vec3 result = graded;
      // Spark postProcessor: stars (R) and nebula (B), coloured by two rotated gradients, added, faded to the bottom, kept off the face.
      {
        // auxSampler2 = pass input 3 ('starry_night_sky).
        vec4 sky = texture2D(auxSampler2, tuv);
        vec2 q = tuv - 0.5;
        float sg = smoothstep(-0.1, 0.65, 0.5735764 * q.x - 0.8191520 * q.y + 0.5);
        float ng = smoothstep(0.0, 1.0, 0.7071068 * (q.x + q.y) + 0.5);
        vec3 stars = sky.r * mix(vec3(0.4863, 1.0, 1.0), vec3(0.9412, 0.4471, 0.0), sg);
        vec3 nebula = sky.b * mix(vec3(0.8471, 0.3725, 0.1137), vec3(0.1922, 0.4510, 0.3412), ng) * 2.0;
        vec3 starSystem = mix(stars, nebula, sky.b) * smoothstep(0.2, 0.8, 1.0 - tuv.y);
        result += starSystem * smoothstep(0.4, 1.0, length(sfp)) * overlay_opacity * strength;
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
