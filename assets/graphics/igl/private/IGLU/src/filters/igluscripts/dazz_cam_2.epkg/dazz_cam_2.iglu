[Filter DazzCam2]
# "Dazz cam 2" ported from the Spark effect (917290659183848). Five passes, no face tracking.
#
#   Spark: an Instax-style instant-photo frame. The camera is uniformly centre-cropped to the portrait
#   rectangle, shrunk to 78% and graded with the
#   "dazzcam" FastColorLUT, sits in the frame's window, cropped to a horizontal band; faint dust specks are
#   screen-blended over it. That scene then goes through Spark's "filters" block: 0.65 * scene + 0.37 *
#   blurred scene (soft focus + glow), an HSV value clamp and a 0.2 circular vignette, mixed at 0.9.
#   The blur is Spark's: scene at 1/2 res, then a 5-tap horizontal and a 5-tap vertical Gaussian at 1/4
#   res, offsets in UV. The chain's TV / symbols / tilt-shift / glitch / lens-flare blocks are inactive in
#   Spark and not ported. The window band mask is analytic (no texture). No time, no UI.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('dazz_cam_2_lut);
    makeTexture('dazz_cam_2_frame);
    makeTexture('dazz_cam_2_dust);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'scene,
      inputs = {'default, 'dazz_cam_2_lut, 'dazz_cam_2_frame, 'dazz_cam_2_dust},
      glslShader = glslScene,
    }, {
      name = 'half,
      inputs = {'scene},
      scale = {0.5, 0.5},
      glslShader = glslCopy,
    }, {
      name = 'blurH,
      inputs = {'half},
      scale = {0.25, 0.25},
      uniforms = {
        blur_dir_x = 1.0,
        blur_dir_y = 0.0,
      },
      glslShader = glslBlur,
    }, {
      name = 'blurV,
      inputs = {'blurH},
      scale = {0.25, 0.25},
      uniforms = {
        blur_dir_x = 0.0,
        blur_dir_y = 1.0,
      },
      glslShader = glslBlur,
    }, {
      name = 'pass0,
      inputs = {'default, 'scene, 'blurV},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslFinal,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string dazz_cam_2_lut_path = "dazz_cam_2_lut_path";
string dazz_cam_2_lut_filename = "";
string dazz_cam_2_frame_path = "dazz_cam_2_frame_path";
string dazz_cam_2_frame_filename = "";
string dazz_cam_2_dust_path = "dazz_cam_2_dust_path";
string dazz_cam_2_dust_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; dazz_cam_2_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(dazz_cam_2_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != dazz_cam_2_lut_filename) {
            dazz_cam_2_lut_filename = new_lut;
            loadTexture('dazz_cam_2_lut, dazz_cam_2_lut_filename);
        }
    }
    string frame_param = getParameterString(dazz_cam_2_frame_path);
    if (frame_param != "") {
        string new_frame = stringAppend("textureFilePath://", frame_param);
        if (new_frame != dazz_cam_2_frame_filename) {
            dazz_cam_2_frame_filename = new_frame;
            loadTexture('dazz_cam_2_frame, dazz_cam_2_frame_filename);
        }
    }
    string dust_param = getParameterString(dazz_cam_2_dust_path);
    if (dust_param != "") {
        string new_dust = stringAppend("textureFilePath://", dust_param);
        if (new_dust != dazz_cam_2_dust_filename) {
            dazz_cam_2_dust_filename = new_dust;
            loadTexture('dazz_cam_2_dust, dazz_cam_2_dust_filename);
        }
    }

}

#### GLSL shaders ####

string glslScene = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'dazz_cam_2_lut (510x510, 8x8 tiles)
    uniform sampler2D auxSampler2;  // 'dazz_cam_2_frame
    uniform sampler2D auxSampler3;  // 'dazz_cam_2_dust
    // Set by the runtime for this pass: the photo it reads and the target it renders into.
    // The canvas is laid out in target pixels and the photo cropped in its own pixels, so a
    // target shaped differently from the photo cannot stretch it.
    uniform vec2 inputSize;
    uniform vec2 outputSize;

    // Spark canvas 375x667, height-fit and centred; the window rect is 78% at (41.5, 51).
    const float kCanvasAspect = 375.0 / 667.0;
    const vec4 kWindow = vec4(41.5 / 375.0, 51.0 / 667.0, 292.5 / 375.0, 520.26 / 667.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Spark's window mask (1024 rows): 0 above row 128, 206/255 on it, 1 to row 895, 146/255 on 896.
    float bandMask(float v) {
      float row = floor(v * 1024.0);
      if (row < 128.0 || row > 896.0) { return 0.0; }
      if (row < 129.0) { return 206.0 / 255.0; }
      if (row > 895.0) { return 146.0 / 255.0; }
      return 1.0;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 p = topUv(uv);
      float targetAspect = outputSize.x / outputSize.y;
      float photoAspect = inputSize.x / inputSize.y;
      vec2 cuv = vec2(0.5 + (p.x - 0.5) * targetAspect / kCanvasAspect, p.y);
      if (cuv.x < 0.0 || cuv.x > 1.0) {
        // Outside the frame: the photo centre-cropped to fill the target, never stretched.
        vec2 fill = vec2(min(1.0, targetAspect / photoAspect), min(1.0, photoAspect / targetAspect));
        gl_FragColor = toOutputFormat(vec4(sampleInput(0.5 + (uv - 0.5) * fill).rgb, 1.0));
        return;
      }
      vec3 s = texture2D(auxSampler2, cuv).rgb;
      vec2 w = (cuv - kWindow.xy) / kWindow.zw;
      if (w.x >= 0.0 && w.x <= 1.0 && w.y >= 0.0 && w.y <= 1.0) {
        // Uniform centre crop fills the authored rectangle without stretching the source photo.
        float photoRatio = kCanvasAspect / photoAspect;
        vec2 photoUv = 0.5 + (w - 0.5) * vec2(min(1.0, photoRatio), min(1.0, 1.0 / photoRatio));
        s = mix(s, lutLookup(sampleInput(topUv(photoUv)).rgb), bandMask(w.y));
        vec3 d = texture2D(auxSampler3, w).rgb;
        s = 1.0 - (1.0 - s) * (1.0 - d);
      }
      gl_FragColor = toOutputFormat(vec4(s, 1.0));
    }
    ";

string glslCopy = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    void main() {
      gl_FragColor = toOutputFormat(vec4(sampleInput(sourceTextureCoordinate).rgb, 1.0));
    }
    ";

string glslBlur = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float blur_dir_x;
    uniform float blur_dir_y;

    // Spark's linear-sampled 9-tap Gaussian, offsets in UV (0.00136 * 4, 0.00317 * 4).
    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec2 dir = vec2(blur_dir_x, blur_dir_y);
      vec2 o1 = dir * 0.00544;
      vec2 o2 = dir * 0.01268;
      vec3 c = 0.22703 * sampleInput(uv).rgb +
          0.31622 * (sampleInput(uv + o1).rgb + sampleInput(uv - o1).rgb) +
          0.07027 * (sampleInput(uv + o2).rgb + sampleInput(uv - o2).rgb);
      gl_FragColor = toOutputFormat(vec4(c, 1.0));
    }
    ";

string glslFinal = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'scene
    uniform sampler2D auxSampler2;  // 'blurV
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = texture2D(auxSampler1, uv).rgb;
      vec3 b = texture2D(auxSampler2, uv).rgb;
      // Spark filters block: Blur 0.35 + Glow 0.02, then the HSV value clamp (max channel <= 1).
      vec3 m = 0.65 * s + 0.37 * b;
      m /= max(1.0, max(m.r, max(m.g, m.b)));
      // Circular UV vignette 0.2 (no aspect fix), mixed with the scene at opacity 0.9.
      float g = 2.0 * length(uv - 0.5);
      vec3 c = clamp(m * (1.0 - 0.2 * g), 0.0, 1.0);
      vec3 spark = mix(s, c, 0.9);
      gl_FragColor = toOutputFormat(vec4(mix(cam.rgb, spark, strength), cam.a));
    }
    ";
