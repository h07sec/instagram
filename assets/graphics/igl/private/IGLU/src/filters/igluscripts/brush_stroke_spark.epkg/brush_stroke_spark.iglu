[Filter BrushStrokeSpark]
# "Brush Stroke" ported from the Spark effect (431660161377481). Single fragment pass.
#
#   Grade: camera -> Spark colorLUTShader('joker') feeding both the background and the brush layer.
#   Layers (Spark render order): graded camera background; 'text113' dusty grunge texture added on top
#   (blend mode 0, additive); the graded camera again through the painterly 'Brush v(1)' alpha mask, so the
#   brush area is clean and the grunge only shows outside it.
#   Assets: the LUT, the grunge (resized 1000 -> 720 px) and the brush mask (alpha as an RGB PNG, 32 levels).
#
# Time source: none (static). GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('brush_stroke_spark_lut);
    makeTexture('brush_stroke_spark_grunge);
    makeTexture('brush_stroke_spark_mask);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "Joker LUT mix strength"},
        {grunge_opacity = 1.0, min = 0.0, max = 1.0, description = "Grunge texture opacity outside the brush"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'brush_stroke_spark_lut, 'brush_stroke_spark_grunge, 'brush_stroke_spark_mask},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        grunge_opacity = 1.0,
      },
      glslShader = glslBrushStrokeSpark,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string brush_stroke_spark_lut_path = "brush_stroke_spark_lut_path";
string brush_stroke_spark_lut_filename = "";
string brush_stroke_spark_grunge_path = "brush_stroke_spark_grunge_path";
string brush_stroke_spark_grunge_filename = "";
string brush_stroke_spark_mask_path = "brush_stroke_spark_mask_path";
string brush_stroke_spark_mask_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the first remote image under the generic 'lut_path; the *_path strings are for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(brush_stroke_spark_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != brush_stroke_spark_lut_filename) {
            brush_stroke_spark_lut_filename = new_lut;
            loadTexture('brush_stroke_spark_lut, brush_stroke_spark_lut_filename);
        }
    }
    string grunge_param = getParameterString(brush_stroke_spark_grunge_path);
    if (grunge_param != "") {
        string new_grunge = stringAppend("textureFilePath://", grunge_param);
        if (new_grunge != brush_stroke_spark_grunge_filename) {
            brush_stroke_spark_grunge_filename = new_grunge;
            loadTexture('brush_stroke_spark_grunge, brush_stroke_spark_grunge_filename);
        }
    }
    string mask_param = getParameterString(brush_stroke_spark_mask_path);
    if (mask_param != "") {
        string new_mask = stringAppend("textureFilePath://", mask_param);
        if (new_mask != brush_stroke_spark_mask_filename) {
            brush_stroke_spark_mask_filename = new_mask;
            loadTexture('brush_stroke_spark_mask, brush_stroke_spark_mask_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'grunge_opacity, getParameterFloat('grunge_opacity));
}

#### GLSL shader ####

string glslBrushStrokeSpark = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'brush_stroke_spark_lut
    uniform sampler2D auxSampler2;  // 'brush_stroke_spark_grunge
    uniform sampler2D auxSampler3;  // 'brush_stroke_spark_mask
    uniform float lut_strength;
    uniform float grunge_opacity;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for overlay lookups; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Spark colorLUTShader decode: nearest blue slice of an 8x8 grid, sampled half a texel
    // inside the cell so bilinear filtering never bleeds into the neighbouring slice.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      return texture2D(auxSampler1, (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) / 512.0).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(cam.rgb, lutLookup(cam.rgb), lut_strength * strength);
      vec2 tuv = topUv(uv);
      vec3 grunge = texture2D(auxSampler2, tuv).rgb;
      float brush = texture2D(auxSampler3, tuv).r;
      // Grunge added on top, then the clean graded camera through the brush mask.
      vec3 outside = graded + grunge * grunge_opacity;
      vec3 result = mix(outside, graded, brush);
      result = mix(cam.rgb, result, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
