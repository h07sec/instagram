[Filter ShowyBlue]
# "showy_blue" ported from the Spark effect (7794438773902958). Single fragment pass, no face tracking. SCRATCH (batch 12, stack C).
#
#   Spark: one full-frame canvas rect `LUT` (alpha blend, opacity 1) over the camera whose shader is a
#   FastColorLUT patch: camera clamped to 0.04781..0.98438, looked up in the 512x512 8x8 atlas
#   exquisite @Salsaaay (378fcd60...jpeg) (no half-texel inset), mixed 0.75 from the unclamped camera towards the LUT colour.
#   The material is unlit.
#   Dropped (face tracked, BATCH-DROP): face smoothing retouch 0.5, the face-mesh copy facelut 0.2 of the same 0.75 LUT; Blush 0.35 and lips 0.5 are hidden in Spark, glow PBR is opacity 0.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('showy_blue_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'showy_blue_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslShowyBlue,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string showy_blue_lut_path = "showy_blue_lut_path";
string showy_blue_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; showy_blue_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(showy_blue_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != showy_blue_lut_filename) {
            showy_blue_lut_filename = new_lut;
            loadTexture('showy_blue_lut, showy_blue_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslShowyBlue = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'showy_blue_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.04781..0.98438, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.04781, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = mix(cam.rgb, L.rgb, 0.75);  // mathMix(camera rgb, LUT rgb, 0.75)
      // Spark alpha blend of the rect over the camera: src alpha = cam.a.
      float a = clamp(cam.a, 0.0, 1.0);
      vec3 spark = mix(cam.rgb, g, a);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
