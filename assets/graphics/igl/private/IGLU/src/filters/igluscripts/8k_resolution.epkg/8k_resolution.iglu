[Filter Resolution8K]
# "8k resolution" (Spark 1043101933014456), SCRATCH NO-FACE port of the screen-space layer. Single fragment pass.
#
#   Spark: canvas0 / rectangle0 (full frame, alpha 1, unlit) runs one shader graph:
#     Adjust Colors patch on the camera (hue +0, saturation x1, lightness x1, invert off: an identity),
#     -> Convolve patch, taps 1.2 / renderTargetSize apart, kernel rows (top to bottom, Spark rect uv is top-left)
#        [0 -1 0; -1 4 -1; 0 -1 1]  (weights sum to 1; the +1 is the bottom-right tap, as authored),
#     -> colorLUTShader (proj/shaders/colorLUTShader.sca; SPIR-V names/constants match: 255/256, 0.5 px inset)
#        with "novo 8k" (512x512, 8x8 grid) at Intensity 0.5.
#   Everything is evaluated inside one material shader, so there is no 8-bit intermediate.
#   Dropped: the face layers, i.e. the same LUT at 0.5 on the UNSHARPENED face texture redrawn at opacity 0.54
#   through faceMeshMask (softens the sharpening on the face), and skin smoothing 0.082.
#   The stem starts with a digit, so the [Filter] name is CamelCase (the tokenizer would split "8k...").
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('8k_resolution_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, '8k_resolution_lut},
      uniforms = {
        strength = 1.0,
        step_x = 0.0011111111,
        step_y = 0.000625,
      },
      glslShader = glslResolution8K,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lut_param_name = "8k_resolution_lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; 8k_resolution_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lut_param_name);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lut_filename) {
            lut_filename = new_lut;
            loadTexture('8k_resolution_lut, lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'step_x, 1.2 / srcSize.x);
        setShaderUniform('pass0, 'step_y, 1.2 / srcSize.y);
    }
}

#### GLSL shader ####

string glslResolution8K = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // '8k_resolution_lut (novo 8k, 512x512, 8x8 grid)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float step_x;
    uniform float step_y;

    // colorLUTShader.sca getLutColor/applyColorLut: slice from b * 64 * 255/256, half-texel inset per slice.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.0, 1.0);
      float sliceNo = floor(64.0 * (255.0 / 256.0) * c.b);
      float row = floor(sliceNo / 8.0);
      float col = sliceNo - row * 8.0;
      vec2 coords = (vec2(col, row) + c.rg) / 8.0 + (0.5 - c.rg) / 512.0;
      return texture2D(auxSampler1, coords).rgb;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // Spark +y is down the image. Metal uv is top-origin (UP == -1); OpenGL is bottom-origin (UP == 1).
      vec2 dx = vec2(step_x, 0.0);
      vec2 dy = vec2(0.0, UP > 0.0 ? -step_y : step_y);
      // The kernel's three zero-weight corner taps are skipped (0 * x adds nothing).
      vec3 conv = 4.0 * cam.rgb
          - sampleInput(uv - dx).rgb
          - sampleInput(uv + dx).rgb
          - sampleInput(uv - dy).rgb
          - sampleInput(uv + dy).rgb
          + sampleInput(uv + dx + dy).rgb;
      vec3 s = clamp(conv, 0.0, 1.0);
      vec3 spark = mix(s, lutLookup(s), 0.5);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
