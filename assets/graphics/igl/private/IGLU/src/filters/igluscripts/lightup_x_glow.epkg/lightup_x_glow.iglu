[Filter LightupXGlow]
# "lightup_x_glow" ported from the Spark effect (863981561258875). Single fragment pass, no face tracking. SCRATCH (batch 12, stack C).
#
#   Spark: one full-frame canvas rect `lut` (alpha blend, opacity 1) over the camera whose shader is a
#   FastColorLUT patch: camera clamped to 0.00781..0.98438, looked up in the 512x512 8x8 atlas
#   indie kid (1) (da784415...jpg) (no half-texel inset), mixed 1.0 from the unclamped camera towards the LUT colour.
#   The material is unlit.
#   Dropped (face tracked, BATCH-DROP): full-frame smoothing 0.5 (face retuch), lips 0.04 multiply, blush 0, and the face-mesh copy (facemae for lut) of the same LUT whose alpha carries the sdfEllipse/smoothStep 0.05..0.16 term (that ellipse is in face-mesh UV space, so it is part of the dropped face layer, not a screen vignette).
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lightup_x_glow_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lightup_x_glow_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslLightupXGlow,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lightup_x_glow_lut_path = "lightup_x_glow_lut_path";
string lightup_x_glow_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; lightup_x_glow_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(lightup_x_glow_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != lightup_x_glow_lut_filename) {
            lightup_x_glow_lut_filename = new_lut;
            loadTexture('lightup_x_glow_lut, lightup_x_glow_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslLightupXGlow = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lightup_x_glow_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.00781..0.98438, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.00781, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = mix(cam.rgb, L.rgb, 1.0);  // mathMix(camera rgb, LUT rgb, 1.0)
      // Spark alpha blend of the rect over the camera: src alpha = cam.a.
      float a = clamp(cam.a, 0.0, 1.0);
      vec3 spark = mix(cam.rgb, g, a);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
