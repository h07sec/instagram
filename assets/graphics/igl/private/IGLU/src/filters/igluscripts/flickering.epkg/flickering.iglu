[Filter Flickering]
# "Flickering" ported from the Spark effect (2459907154147154). Single fragment pass, no assets.
#
#   Spark shows a full-screen solid-black image ('videocam_black') on/off, measured from its sample video:
#   2.5 Hz, 50% duty (on for 0.2 s, black for 0.2 s), hard cut. Here: a time_sec-driven hard blackout.
#   Dropped: 5 empty face trackers (no children).
#
# Time source: the host's time_sec parameter, so the flicker follows scrubbing and export.
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {flicker_hz = 2.5, min = 0.5, max = 12.0, description = "Blackout cycles per second (Spark 2.5)"},
        {duty = 0.5, min = 0.0, max = 1.0, description = "Fraction of each cycle the image is visible (Spark 0.5)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        strength = 1.0,
        flicker_hz = 2.5,
        duty = 0.5,
        u_time = 0.0,
      },
      glslShader = glslFlickering,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'flicker_hz, getParameterFloat('flicker_hz));
    setShaderUniform('pass0, 'duty, getParameterFloat('duty));
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);
}

#### GLSL shader ####

string glslFlickering = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float flicker_hz;
    uniform float duty;
    uniform float u_time;

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);
      // Bounded phase keeps full f32 precision however long the clip runs.
      float phase = fract(mod(u_time, 1000.0) * flicker_hz);
      float visible = 1.0 - step(duty, phase);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = cam.rgb * mix(1.0, visible, strength);
      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
