[Filter FilmBurn]
# "Film Burn" (Spark 746751314171293), SCRATCH NO-FACE port of the screen-space layers. Single fragment pass.
#
#   Spark draw order (layer renderingOrder ascending, then canvas order), all unlit:
#     1. layer0 canvas0 / person 1, alpha 1: the camera mixed 0.9 with LUT "tone up2" (8x8 grid, 1024 JPEG).
#     2. layer3 canvas1 / rectangle0, alpha 0.6: the RAW camera mixed 0.9 with LUT "Base LUT image (21)".
#     3. layer3 canvas1 / rectangle1, screen 1: a 42-frame film-burn / light-leak sequence, 12 fps, looping.
#   Both LUTs use the same patch: clamp (0.00781 + 0.02) / 0.98438, 8x8 grid, one bilinear tap.
#   Dropped: the face layers on both trackers (skin smoothing 1.0, red multiply lipstick 0.5, blush 0.15, nose
#   contour/glow 0.1, PBR glow 0.02, 3D eyelash blocks 0.45 / 0.35, the face LUT redraw).
#
# GLSL only. Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('film_burn_lut_tone);
    makeTexture('film_burn_lut_base);
    makeTexture('film_burn_burn_a);
    makeTexture('film_burn_burn_b);

    filter.parameters = {
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"},
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'film_burn_lut_tone, 'film_burn_lut_base, 'film_burn_burn_a, 'film_burn_burn_b},
      uniforms = {
        strength = 1.0,
        time = 0.0,
      },
      glslShader = glslFilmBurn,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string film_burn_lut_tone_path = "film_burn_lut_tone_path";
string film_burn_lut_tone_filename = "";
string film_burn_lut_base_path = "film_burn_lut_base_path";
string film_burn_lut_base_filename = "";
string film_burn_burn_a_path = "film_burn_burn_a_path";
string film_burn_burn_a_filename = "";
string film_burn_burn_b_path = "film_burn_burn_b_path";
string film_burn_burn_b_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; film_burn_lut_tone_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(film_burn_lut_tone_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != film_burn_lut_tone_filename) {
            film_burn_lut_tone_filename = new_lut;
            loadTexture('film_burn_lut_tone, film_burn_lut_tone_filename);
        }
    }
    string base_param = getParameterString(film_burn_lut_base_path);
    if (base_param != "") {
        string new_base = stringAppend("textureFilePath://", base_param);
        if (new_base != film_burn_lut_base_filename) {
            film_burn_lut_base_filename = new_base;
            loadTexture('film_burn_lut_base, film_burn_lut_base_filename);
        }
    }
    string burn_a_param = getParameterString(film_burn_burn_a_path);
    if (burn_a_param != "") {
        string new_burn_a = stringAppend("textureFilePath://", burn_a_param);
        if (new_burn_a != film_burn_burn_a_filename) {
            film_burn_burn_a_filename = new_burn_a;
            loadTexture('film_burn_burn_a, film_burn_burn_a_filename);
        }
    }
    string burn_b_param = getParameterString(film_burn_burn_b_path);
    if (burn_b_param != "") {
        string new_burn_b = stringAppend("textureFilePath://", burn_b_param);
        if (new_burn_b != film_burn_burn_b_filename) {
            film_burn_burn_b_filename = new_burn_b;
            loadTexture('film_burn_burn_b, film_burn_burn_b_filename);
        }
    }

    # See Time Source pattern in .llms/skills/igluscript-patterns.md.
    f32 t = getParameterFloat('time_sec);
    if (t < 0.0) {
        t = getLocalTime();
    }
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslFilmBurn = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'film_burn_lut_tone (tone up2, 1024x1024, 8x8 grid)
    uniform sampler2D auxSampler2;  // 'film_burn_lut_base (Base LUT image (21), 512x512, 8x8 grid)
    uniform sampler2D auxSampler3;  // 'film_burn_burn_a (frames 0-20, 7x3 cells of 480x853)
    uniform sampler2D auxSampler4;  // 'film_burn_burn_b (frames 21-41, 7x3 cells of 480x853)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float time;

    const vec2 kCell = vec2(480.0, 853.0);
    const vec2 kAtlas = vec2(3360.0, 2559.0);

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // The LUT patch: clamp (0.00781 + 0.02) / 0.98438, 8x8 grid, one bilinear tap.
    vec2 lutUv(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781 + 0.02, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec2 l = lutUv(cam.rgb);
      vec3 col = mix(cam.rgb, texture2D(auxSampler1, l).rgb, 0.9);
      // rectangle0: alpha 0.6 over the result, built from the raw camera again (not chained).
      col = mix(col, mix(cam.rgb, texture2D(auxSampler2, l).rgb, 0.9), 0.6);

      // rectangle1: screen, burn frame at 12 fps over 42 frames from frame 0. mod() keeps it bounded.
      float frame = mod(floor(time * 12.0), 42.0);
      float local = frame < 21.0 ? frame : frame - 21.0;
      vec2 cell = vec2(mod(local, 7.0), floor(local / 7.0));
      vec2 inCell = clamp(topUv(uv) * kCell, vec2(0.5), kCell - 0.5);
      vec2 burnUv = (cell * kCell + inCell) / kAtlas;
      vec3 burn = frame < 21.0 ? texture2D(auxSampler3, burnUv).rgb : texture2D(auxSampler4, burnUv).rgb;
      col = burn + col * (1.0 - burn);

      vec3 result = mix(cam.rgb, col, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
