[Filter OldDust]
# "OLD+DUST" ported from the Spark effect (1217042425477439). Single fragment pass, no assets beyond the LUT.
#
#   Grade: camera -> FastColorLUT('BaseColor (5)') at 1.0.
#   Old-film damage: Spark subtracts a 25 fps sequence at 0.64 (sparse specks, one thin full-height
#   vertical scratch at a different x each frame, and a slight per-frame grey level). Here it is procedural
#   at the same 25 fps, so no image sequence ships: black specks, one faint rough-edged dark vertical
#   line that drifts and jumps across frames, a faint hairline scratch, and a slight flicker.
#   Dropped: Spark's white dust layer is nearly empty, and its letterbox sequence never shows in its output.
#
# Time source: the host's time_sec parameter, else the filter clock (TS1).
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('old_dust_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {dark_dust_opacity = 0.64, min = 0.0, max = 1.0, description = "Black specks and scratches (Spark subtract layer at 0.64)"},
        {line_opacity = 0.3, min = 0.0, max = 1.0, description = "The moving dark vertical line (0 = off)"},
        {overlay_fps = 25.0, min = 1.0, max = 30.0, description = "Dust frames per second (Spark sequences 25 fps)"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'old_dust_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        dark_dust_opacity = 0.64,
        line_opacity = 0.3,
        overlay_fps = 25.0,
        u_time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslOldDust,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string old_dust_lut_path = "old_dust_lut_path";
string old_dust_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; old_dust_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(old_dust_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != old_dust_lut_filename) {
            old_dust_lut_filename = new_lut;
            loadTexture('old_dust_lut, old_dust_lut_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'dark_dust_opacity, getParameterFloat('dark_dust_opacity));
    setShaderUniform('pass0, 'line_opacity, getParameterFloat('line_opacity));
    setShaderUniform('pass0, 'overlay_fps, getParameterFloat('overlay_fps));

    # Time drives the dust.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslOldDust = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'old_dust_lut
    uniform float lut_strength;
    uniform float dark_dust_opacity;
    uniform float line_opacity;
    uniform float overlay_fps;
    uniform float u_time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }
    vec2 hash22(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.xx + p3.yz) * p3.zy);
    }

    // Sparse round specks on an aspect-correct cell grid. density = share of cells with a speck,
    // seed decorrelates the two layers.
    float specks(vec2 p, float f, float cells, float density, float seed) {
      vec2 off = vec2(f * 13.7 + seed, f * 7.3 - seed);
      vec2 g = floor(p * cells + off);
      vec2 cell = fract(p * cells + off);
      float has = step(1.0 - density, hash21(g + f * 1.31 + seed));
      vec2 rp = 0.2 + 0.6 * hash22(g + 0.7 + seed);
      float sz = 0.04 + 0.08 * hash21(g + 1.7 + seed);
      return has * smoothstep(sz, sz * 0.3, distance(cell, rp));
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 result = mix(cam.rgb, lutLookup(cam.rgb), lut_strength * strength);

      vec2 tuv = topUv(uv);
      // Bounded frame index keeps the hashes in full f32 precision however long the clip runs.
      float f = mod(floor(u_time * overlay_fps), 997.0);
      vec2 p = vec2(tuv.x * source_size_x / max(source_size_y, 1.0), tuv.y);
      float px = 1.0 / max(source_size_x, 1.0);

      // Black specks: sparse and small, re-scattered every frame.
      float dark = specks(p, f, 34.0, 0.018, 0.0);

      // One faint rough-edged vertical line (thin, 0.3 opacity): it drifts slowly within a 1 s shot and jumps to a new
      // x between shots; its width wobbles along its length so the edge looks scratched, not ruled.
      float shot = floor(u_time * 1.0);
      float lx = 0.12 + 0.76 * hash11(shot * 3.7 + 1.3) + 0.01 * sin(u_time * 7.0 + shot);
      lx += (hash11(f * 1.9 + 0.7) - 0.5) * 6.0 * px;
      float rough = 0.6 + 0.8 * hash11(floor(tuv.y * 180.0) + f * 13.0);
      float lw = (1.25 + 1.25 * hash11(shot + 9.1)) * px * rough;
      float line = (1.0 - smoothstep(lw * 0.5, lw, abs(tuv.x - lx)));
      line *= 0.75 + 0.25 * hash11(floor(tuv.y * 40.0) + shot * 5.0);

      // A faint hairline scratch elsewhere, flickering frame to frame.
      float hx = hash11(f * 0.61 + 4.2);
      float hair = step(0.5, hash11(f + 2.9)) * (1.0 - smoothstep(0.5 * px, 1.2 * px, abs(tuv.x - hx))) * 0.5;

      float damage = max(max(dark * dark_dust_opacity, hair * dark_dust_opacity), line * line_opacity);
      // Slight per-frame flicker, like the grey level that changes between Spark's frames.
      float flicker = 1.0 - 0.04 * hash11(f * 0.37 + 8.8);
      result = result * mix(1.0, flicker, strength);
      result = max(result - vec3(damage * strength), vec3(0.0));
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
