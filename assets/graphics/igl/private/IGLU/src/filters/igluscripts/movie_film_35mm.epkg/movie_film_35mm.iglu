[Filter MovieFilm35mm]
# "❐ 35mm movie film" ported from the Spark effect (1308344206164647). Single fragment pass, no assets.
#
#   Spark's Shader Render Pass: Adjust Colors (saturation -0.67, contrast +0.3, brightness -0.2), a film grain
#   group, a small random 2D jitter of the frame (scale 0.7-1.4 of a tiny offset, re-rolled by 0.05-0.15 s
#   loop animations), and a Delay Frame stutter.
#   Here: the same colour adjustments, a stepped gate weave on time_sec, and fine animated grain.
#   Dropped: the Delay Frame stutter (needs frame history) and the faint film-strip texture inside the grain
#   group (procedural grain instead).
#
# Time source: the host's time_sec parameter, so the weave follows scrubbing and export.
# GLSL only; Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {saturation = -0.67, min = -1.0, max = 1.0, description = "Saturation adjust (Spark -0.67)"},
        {contrast = 0.3, min = -1.0, max = 1.0, description = "Contrast adjust (Spark 0.3)"},
        {brightness = -0.2, min = -1.0, max = 1.0, description = "Brightness adjust (Spark -0.2)"},
        {weave_px = 2.0, min = 0.0, max = 10.0, description = "Gate weave in px at 720 wide"},
        {grain_opacity = 0.06, min = 0.0, max = 0.3, description = "Film grain amplitude"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        strength = 1.0,
        saturation = -0.67,
        contrast = 0.3,
        brightness = -0.2,
        weave_px = 2.0,
        grain_opacity = 0.06,
        u_time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslMovieFilm35mm,
    }};
}

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'saturation, getParameterFloat('saturation));
    setShaderUniform('pass0, 'contrast, getParameterFloat('contrast));
    setShaderUniform('pass0, 'brightness, getParameterFloat('brightness));
    setShaderUniform('pass0, 'weave_px, getParameterFloat('weave_px));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));

    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'u_time, time);

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslMovieFilm35mm = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform float saturation;
    uniform float contrast;
    uniform float brightness;
    uniform float weave_px;
    uniform float grain_opacity;
    uniform float u_time;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      // Bounded time keeps the hashes in full f32 precision however long the clip runs.
      float t = mod(u_time, 997.0);
      // Stepped gate weave: a new tiny offset every 0.15 s (Spark's loop animations), scaled 0.7-1.4.
      float k = floor(t / 0.15);
      vec2 jit = (vec2(hash11(k + 0.3), hash11(k + 7.1)) - 0.5) * mix(0.7, 1.4, hash11(k + 3.7));
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec2 off = jit * weave_px * strength / vec2(720.0, 720.0 * source_size_y / max(source_size_x, 1.0));
      // The weave is authored top-origin; map back to native coordinates before sampling.
      vec4 cam = sampleInput(topUv(topUv(uv) + off));
      vec3 c = cam.rgb;

      // Spark Adjust Colors: saturation, then contrast around mid-grey, then brightness.
      float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
      c = mix(vec3(luma), c, 1.0 + saturation);
      c = (c - 0.5) * (1.0 + contrast) + 0.5;
      c = c + brightness * 0.5;

      // Fine animated grain at 24 fps, seeded top-origin so it matches across platforms.
      float gf = mod(floor(t * 24.0), 97.0);
      float g = hash21(floor(topUv(uv) * vec2(source_size_x, source_size_y)) + gf * 17.0) - 0.5;
      c += vec3(g * grain_opacity * strength);

      vec3 result = mix(sampleInput(uv).rgb, clamp(c, 0.0, 1.0), strength);
      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
