[Filter MinimalVintageLove]
# "Minimal Vintage Love" ported from the Spark effect (292795443680440). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 0.532.
#   Overlay: 'minimal_vintage_love_dust add-blended full-frame at 0.6305.
#   Overlay: 'minimal_vintage_love_heart add-blended full-frame at 0.4648.
#   Spark adds a full-frame dust layer at 0.63 and a small hand-drawn heart at 0.46 (both additive). The heart is drawn as a sprite at its own aspect ratio (8% of the frame width, centred at x 0.5, y 0.786), so it never stretches. Its LUT clamps the input to 0.04..0.96.
#   Dropped: the face LUT, iris and makeup layers (face tracking). The frame sequence and spare textures in the project aren't wired to anything.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('minimal_vintage_love_lut);
    makeTexture('minimal_vintage_love_dust);
    makeTexture('minimal_vintage_love_heart);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.532, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {dust_opacity = 0.6305, min = 0.0, max = 1.0, description = "Opacity of the dust overlay"},
        {heart_opacity = 0.4648, min = 0.0, max = 1.0, description = "Opacity of the heart overlay"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'minimal_vintage_love_lut, 'minimal_vintage_love_dust, 'minimal_vintage_love_heart},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.532,
        dust_opacity = 0.6305,
        heart_opacity = 0.4648,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslMinimalVintageLove,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string minimal_vintage_love_lut_path = "minimal_vintage_love_lut_path";
string minimal_vintage_love_lut_filename = "";
string minimal_vintage_love_dust_path = "minimal_vintage_love_dust_path";
string minimal_vintage_love_dust_filename = "";
string minimal_vintage_love_heart_path = "minimal_vintage_love_heart_path";
string minimal_vintage_love_heart_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; minimal_vintage_love_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(minimal_vintage_love_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != minimal_vintage_love_lut_filename) {
            minimal_vintage_love_lut_filename = new_lut;
            loadTexture('minimal_vintage_love_lut, minimal_vintage_love_lut_filename);
        }
    }

    string minimal_vintage_love_dust_param = getParameterString(minimal_vintage_love_dust_path);
    if (minimal_vintage_love_dust_param != "") {
        string new_minimal_vintage_love_dust = stringAppend("textureFilePath://", minimal_vintage_love_dust_param);
        if (new_minimal_vintage_love_dust != minimal_vintage_love_dust_filename) {
            minimal_vintage_love_dust_filename = new_minimal_vintage_love_dust;
            loadTexture('minimal_vintage_love_dust, minimal_vintage_love_dust_filename);
        }
    }
    string minimal_vintage_love_heart_param = getParameterString(minimal_vintage_love_heart_path);
    if (minimal_vintage_love_heart_param != "") {
        string new_minimal_vintage_love_heart = stringAppend("textureFilePath://", minimal_vintage_love_heart_param);
        if (new_minimal_vintage_love_heart != minimal_vintage_love_heart_filename) {
            minimal_vintage_love_heart_filename = new_minimal_vintage_love_heart;
            loadTexture('minimal_vintage_love_heart, minimal_vintage_love_heart_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'dust_opacity, getParameterFloat('dust_opacity));
    setShaderUniform('pass0, 'heart_opacity, getParameterFloat('heart_opacity));

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslMinimalVintageLove = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'minimal_vintage_love_lut
    uniform sampler2D auxSampler2;  // 'minimal_vintage_love_dust
    uniform sampler2D auxSampler3;  // 'minimal_vintage_love_heart

    uniform float lut_strength;
    uniform float dust_opacity;
    uniform float heart_opacity;
    uniform float source_size_x;
    uniform float source_size_y;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.04, 0.96);  // Spark's Professional LUT clamp
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Full-frame overlay 'minimal_vintage_love_dust (add), authored top-origin.
      {
        // auxSampler2 = pass input 3 ('minimal_vintage_love_dust).
        vec4 ov = texture2D(auxSampler2, topUv(uv));
        result = mix(result, min(result + ov.rgb, vec3(1.0)), (dust_opacity) * strength);
      }
      // Full-frame overlay 'minimal_vintage_love_heart (add), authored top-origin.
      {
        // auxSampler3 = pass input 4 ('minimal_vintage_love_heart).
        // The heart is a sprite at its own aspect ratio (56x65), 8% of the frame width, centred at
        // (0.5, 0.786) top-origin, so it keeps its shape on any frame size.
        vec2 tuv = topUv(uv);
        float hw = 0.08;
        float hh = hw * (65.0 / 56.0) * source_size_x / max(source_size_y, 1.0);
        vec2 l = (tuv - vec2(0.5, 0.786)) / vec2(hw, hh) + 0.5;
        if (l.x >= 0.0 && l.x <= 1.0 && l.y >= 0.0 && l.y <= 1.0) {
          // l is top-origin, as the sprite is authored.
          vec4 ov = texture2D(auxSampler3, l);
          result = mix(result, min(result + ov.rgb, vec3(1.0)), (heart_opacity) * strength);
        }
      }

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
