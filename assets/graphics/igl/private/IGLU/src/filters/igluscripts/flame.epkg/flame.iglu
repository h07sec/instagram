[Filter Flame]
# "Flame" ported from the Spark effect (1583474962054097). Single fragment pass, no face tracking.
#
#   Grade: Spark's 8x8 colorLUT shader ('flame_lut) alpha-blended over the camera at 0.536.
#   Then Spark's 172-frame fire sequence multiplied over everything at full opacity, so the fire only
#   shows where the image is bright and a backlit subject stays a dark silhouette. Shipped as every
#   other frame (86) in one 10x9 atlas of 64x115 cells ('flame_fire), played at 15 fps (Spark's 30 fps
#   loop length). Spark's light skin smoothing (0.3) is dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('flame_lut);
    makeTexture('flame_fire);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {overlay_opacity = 1.0, min = 0.0, max = 1.0, description = "Opacity of the fire"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'flame_lut, 'flame_fire},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        overlay_opacity = 1.0,
        time = 0.0,
      },
      glslShader = glslFlame,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string flame_lut_path = "flame_lut_path";
string flame_lut_filename = "";
string flame_fire_path = "flame_fire_path";
string flame_fire_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; flame_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(flame_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != flame_lut_filename) {
            flame_lut_filename = new_lut;
            loadTexture('flame_lut, flame_lut_filename);
        }
    }

    string fire_param = getParameterString(flame_fire_path);
    if (fire_param != "") {
        string new_fire = stringAppend("textureFilePath://", fire_param);
        if (new_fire != flame_fire_filename) {
            flame_fire_filename = new_fire;
            loadTexture('flame_fire, flame_fire_filename);
        }
    }
    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'overlay_opacity, getParameterFloat('overlay_opacity));

    # Time picks the fire frame.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslFlame = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'flame_lut
    uniform sampler2D auxSampler2;  // 'flame_fire (10x9 atlas, 86 frames)

    uniform float lut_strength;
    uniform float overlay_opacity;
    uniform float time;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup that blends the two nearest blue slices.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blue = c.b * 63.0;
      float s0 = floor(blue);
      float s1 = min(s0 + 1.0, 63.0);
      vec2 o0 = vec2(mod(s0, 8.0), floor(s0 / 8.0)) / 8.0;
      vec2 o1 = vec2(mod(s1, 8.0), floor(s1 / 8.0)) / 8.0;
      vec2 rg = (0.5 + c.rg * 63.0) / 512.0;
      return mix(texture2D(auxSampler1, o0 + rg).xyz, texture2D(auxSampler1, o1 + rg).xyz, blue - s0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // strength: global effect-strength uniform declared by BaseUniformsOpenGL; it scales every layer,
      // so 0 is an exact passthrough.
      vec3 result = mix(src, lutLookup(src), 0.536 * strength * lut_strength);

      // Spark's fire sequence, multiplied over the stack at full opacity.
      float frame = mod(floor(time * 15.0), 86.0);  // bounded seed: the 86-frame loop
      vec2 cell = vec2(mod(frame, 10.0), floor(frame / 10.0));
      // Inset half a texel per cell so bilinear taps never read the neighbouring frame.
      vec2 inCell = clamp(topUv(uv), vec2(0.5 / 64.0, 0.5 / 115.0), vec2(1.0 - 0.5 / 64.0, 1.0 - 0.5 / 115.0));
      vec3 fire = texture2D(auxSampler2, (cell + inCell) / vec2(10.0, 9.0)).rgb;
      result = mix(result, result * fire, overlay_opacity * strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
