[Filter Pump]
# "PUMP" ported from the Spark effect (341669634866752). Single fragment pass,
# no face tracking; no assets beyond the LUT.
#
#   Grade: 8x8 LUT (Spark FastColorLUT, input clamp 0.04..0.96) at 0.5, then Spark's 5x5 binomial
#   unsharp mask of that grade (2*G - blur(G), taps 3.5/512 UV apart), as in the Spark graph.
#   Spark's face layers (a no-op redraw of the same chain and a 0.21 under-eye concealer) are dropped.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('pump_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 0.5, min = 0.0, max = 1.0, description = "LUT mix strength"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'pump_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 0.5,
      },
      glslShader = glslPump,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string pump_lut_path = "pump_lut_path";
string pump_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; pump_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(pump_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != pump_lut_filename) {
            pump_lut_filename = new_lut;
            loadTexture('pump_lut, pump_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
}

#### GLSL shader ####

string glslPump = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'pump_lut

    uniform float lut_strength;

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      // Spark LUT patch clamp.
      vec3 c = clamp(inRgb, 0.04, 0.96);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    const vec2 kSharpStep = vec2(0.0068359);  // Spark 3.5/512 UV per tap, same in x and y

    float binom(float o) {
      float a = abs(o);
      return a < 0.5 ? 6.0 : (a < 1.5 ? 4.0 : 1.0);
    }

    vec3 gradeP(vec3 c) {
      return mix(c, lutLookup(c), lut_strength);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Spark 5x5 binomial unsharp mask of the half-strength grade: 2*G - blur(G). The kernel is
      // symmetric, so UV orientation does not matter.
      vec3 g0 = gradeP(src);
      // The centre tap (weight 6*6) is g0, already graded above.
      vec3 acc = 36.0 * g0;
      for (int j = -2; j <= 2; j++) {
        for (int i = -2; i <= 2; i++) {
          if (i == 0 && j == 0) { continue; }
          vec2 o = vec2(float(i), float(j));
          acc += binom(o.x) * binom(o.y) * gradeP(sampleInput(uv + o * kSharpStep).rgb);
        }
      }
      vec3 sharp = clamp(2.0 * g0 - acc / 256.0, 0.0, 1.0);
      // strength: global effect-strength uniform; 0 returns the camera exactly.
      vec3 result = mix(src, sharp, strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
