[Filter Natural]
# "natural" ported from the Spark effect (517730056194021). Single fragment pass, no face tracking. SCRATCH (batch 11b).
#
#   Spark: one full-frame canvas rect (lut, unlit, alpha blend, opacity 1) whose shader is a FastColorLUT patch:
#   camera clamped to 0.05..0.98, looked up in the 512x512 8x8 atlas IMG_9773 (no half-texel inset), then
#   mixed 0.4 from the UNCLAMPED camera towards the LUT colour, camera alpha kept. Under it the retouching
#   processor applies full-frame skin smoothing at 0.3972602739726027.
#   Faked: the smoothing (light edge-aware ring blur, smooth_strength).
#   Dropped (face tracked, judged not signature): contour 0.507 multiply, brows 0.110, lower lip 0.096,
#   nose contour 0.082, nose highlight 0.164, eye concealer 0.5, tracked 3D lashes 0.548 multiply, and the
#   nose/lip blendshape reshapes (0.23/0.16/0.19). The face re-draw layers use the same 0.4 LUT, so their
#   colour already matches this pass.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('natural_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {smooth_strength = 0.3972602739726027, min = 0.0, max = 1.0, description = "Soft full-frame smoothing (fakes the Spark skin retouch)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'natural_lut},
      uniforms = {
        strength = 1.0,
        smooth_strength = 0.3972602739726027,
        source_size_x = 1080.0,
        source_size_y = 1920.0,
      },
      glslShader = glslNatural,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string natural_lut_path = "natural_lut_path";
string natural_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));
    setShaderUniform('pass0, 'smooth_strength, getParameterFloat('smooth_strength));

    # iOS passes the remote LUT under the generic 'lut_path; natural_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(natural_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != natural_lut_filename) {
            natural_lut_filename = new_lut;
            loadTexture('natural_lut, natural_lut_filename);
        }
    }

    # Guarded because getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0 and srcSize.y > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslNatural = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'natural_lut (IMG_9773, 512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.
    uniform float smooth_strength;
    uniform float source_size_x;
    uniform float source_size_y;

    // One luma-similarity-weighted tap: (rgb * w, w). Edges get low weight, so only flat areas soften.
    vec4 smoothTap(vec2 uv, float y0) {
      vec3 s = sampleInput(uv).rgb;
      float w = clamp(1.0 - abs(dot(s, vec3(0.299, 0.587, 0.114)) - y0) * 8.0, 0.0, 1.0);
      return vec4(s * w, w);
    }

    vec3 smoothBlur(vec2 uv, vec3 c) {
      float y0 = dot(c, vec3(0.299, 0.587, 0.114));
      vec2 d = vec2(source_size_y / max(source_size_x, 1.0), 1.0) * 0.004;
      vec4 acc = vec4(c, 1.0);
      acc += smoothTap(uv + d * vec2(1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(-1.0, 0.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, 1.0), y0);
      acc += smoothTap(uv + d * vec2(0.0, -1.0), y0);
      acc += smoothTap(uv + d * vec2(0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, 0.7071), y0);
      acc += smoothTap(uv + d * vec2(0.7071, -0.7071), y0);
      acc += smoothTap(uv + d * vec2(-0.7071, -0.7071), y0);
      return acc.rgb / acc.a;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      vec3 s = cam.rgb;
      if (smooth_strength > 0.0) {
        s = mix(s, smoothBlur(uv, s), smooth_strength);
      }
      // Graph components 541..564: clamp 0.05..0.98, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(s, 0.05, 0.98);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec2 lutUv = vec2(c.r / 8.0 + col, c.g / 8.0 + row);
      // Component 575: mix(unclamped camera, LUT, 0.4).
      vec3 spark = mix(s, texture2D(auxSampler1, lutUv).rgb, 0.4);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
