[Filter IndieKid]
# "indie_kid" ported from the Spark effect (1550655788627043). Single fragment pass, no face tracking. SCRATCH (batch 12, stack C).
#
#   Spark: one full-frame canvas rect `LUT` (alpha blend, opacity 0.6986301369863014) over the camera whose shader is a
#   FastColorLUT patch: camera clamped to 0.05..0.98438, looked up in the 512x512 8x8 atlas
#   Base LUT image_polarr_34 (c46d8fb2...jpg) (no half-texel inset), the LUT colour used directly.
#   The material is lit (lightingEnabled true): rgb x K = 0.45945945382118225 + 0.800000011920929 * 0.70441603 = 1.0229922833.
#   Dropped (face tracked, BATCH-DROP): full-frame skin smoothing SOFT1 1.0 + face smoothing SOFT2 0.658, lips layer LIPS 0.137 (Lips B); the GRAIN rect is opacity 0 (invisible in Spark) and is not ported.
#   Nothing is faked.
#
# GLSL only - Metal is generated by the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('indie_kid_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'indie_kid_lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslIndieKid,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string indie_kid_lut_path = "indie_kid_lut_path";
string indie_kid_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    setShaderUniform('pass0, 'strength, getParameterFloat('strength));

    # iOS passes the remote LUT under the generic 'lut_path; indie_kid_lut_path is for local testing.
    string lut_param = getParameterString(lut_path);
    if (lut_param == "") {
        lut_param = getParameterString(indie_kid_lut_path);
    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != indie_kid_lut_filename) {
            indie_kid_lut_filename = new_lut;
            loadTexture('indie_kid_lut, indie_kid_lut_filename);
        }
    }
}

#### GLSL shader ####

string glslIndieKid = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'indie_kid_lut (512x512, 8x8 atlas)
    // strength: global effect-strength uniform declared by BaseUniformsOpenGL.

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      // Strength 0 returns the camera untouched (the clamp below would clip extended-range input).
      if (strength <= 0.0) {
        gl_FragColor = toOutputFormat(cam);
        return;
      }
      // FastColorLUT: clamp 0.05..0.98438, blue row/column in an 8x8 atlas, no half-texel inset.
      vec3 c = clamp(cam.rgb, 0.05, 0.98438);
      float row = floor(c.b * 8.0) / 8.0;
      float col = floor((c.b - row) * 64.0) / 8.0;
      vec4 L = texture2D(auxSampler1, vec2(c.r / 8.0 + col, c.g / 8.0 + row));
      vec3 g = L.rgb;
      g = clamp(g * 1.0229922833, 0.0, 1.0);  // lit material: K = ambient + directional * L.N; UNORM clamp
      // Spark alpha blend of the rect over the camera: src alpha = cam.a * L.a * 0.6986301369863014.
      float a = clamp(cam.a * L.a * 0.6986301369863014, 0.0, 1.0);
      vec3 spark = mix(cam.rgb, g, a);
      vec3 result = mix(cam.rgb, spark, strength);
      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
