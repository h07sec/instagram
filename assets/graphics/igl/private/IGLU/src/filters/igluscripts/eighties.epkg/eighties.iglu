[Filter Eighties]
# "80's" ported from the Spark effect (241860440200431). Single fragment pass,
# no face tracking; every extra layer is procedural (no assets beyond the LUT).
#
#   Grade: 8x8 LUT (Spark FastColorLUT) at 1.
#   Soft focus: 3x3 gaussian of the camera before the grade (Spark's separable Gaussian Blur, sigma 2.5 px at 720 wide).
#   Grain: static, pixel-locked hash noise (mean 0.34, spread 0.53), normal-blended at 0.12
#   (replaces the Spark grain texture).
#   Grain animation: re-seeded at 25 fps, looping every 4 frames like Spark's grain sequence
#   (bounded seed keeps the hash in full f32 precision however long the clip runs).
#   Spark grades a 3x3 binomial blur of the camera, then paints a 4-frame glitter noise at 0.12 (25 fps), a 25-frame dust/scratch sequence at 0.08 (24 fps) and a 20-frame flat-grey flicker at 0.2 (25 fps). All procedural here; the flicker is Spark's 20 grey levels as a table.
#
# GLSL only — Metal is generated by the runtime shaderc compiler.
#   Time source: the host's time_sec parameter, else the filter clock (TS1).

[Init]
fun init(Filter filter)
{
    makeTexture('eighties_lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "Mix of the effect over the original image (1.0 = full effect)"},
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {blur_sigma = 2.5, min = 0.0, max = 4.0, description = "Soft-focus blur radius in px at 720 px wide (Spark Gaussian Blur block)"},
        {grain_opacity = 0.12, min = 0.0, max = 0.5, description = "Film grain normal-blend opacity"},
        {time_sec = -1.0, description = "Elapsed time in seconds, sent by the host app (-1 = not sent: fall back to the filter clock)"}
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'eighties_lut},
      uniforms = {
        strength = 1.0,
        lut_strength = 1.0,
        blur_sigma = 2.5,
        grain_opacity = 0.12,
        time = 0.0,
        source_size_x = 1024.0,
        source_size_y = 1024.0,
      },
      glslShader = glslEighties,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string eighties_lut_path = "eighties_lut_path";
string eighties_lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    f32 effect_strength = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, effect_strength);

    # iOS passes the remote LUT under the generic 'lut_path; eighties_lut_path is for local testing.

    string lut_param = getParameterString(lut_path);

    if (lut_param == "") {

        lut_param = getParameterString(eighties_lut_path);

    }
    if (lut_param != "") {
        string new_lut = stringAppend("textureFilePath://", lut_param);
        if (new_lut != eighties_lut_filename) {
            eighties_lut_filename = new_lut;
            loadTexture('eighties_lut, eighties_lut_filename);
        }
    }

    setShaderUniform('pass0, 'lut_strength, getParameterFloat('lut_strength));
    setShaderUniform('pass0, 'blur_sigma, getParameterFloat('blur_sigma));
    setShaderUniform('pass0, 'grain_opacity, getParameterFloat('grain_opacity));
    # Time drives the grain.
    f32 time = getParameterFloat('time_sec);
    # Hosts that never send time_sec (IG camera) leave the -1 default: use the filter clock.
    if (time < 0.0) {
        time = getLocalTime();
    }
    setShaderUniform('pass0, 'time, time);

    # Source resolution for texel offsets and the pixel-locked grain. Guarded because
    # getTextureSize() can return (0, 0) before bind.
    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('pass0, 'source_size_x, srcSize.x);
        setShaderUniform('pass0, 'source_size_y, srcSize.y);
    }
}

#### GLSL shader ####

string glslEighties = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'eighties_lut

    uniform float lut_strength;
    uniform float blur_sigma;
    uniform float grain_opacity;
    uniform float time;
    uniform float source_size_x;
    uniform float source_size_y;

    const float kGrainFps = 25.0;
    const float kGrainFrames = 4.0;

    // Layout is top-origin, as on Metal (UP == -1). OpenGL frames arrive bottom row first (UP == 1),
    // so flip into top-origin for positions; the flip is its own inverse.
    vec2 topUv(vec2 uv) {
      if (UP > 0.0) { uv.y = 1.0 - uv.y; }
      return uv;
    }

    // 8x8 grid LUT lookup (Spark FastColorLUT decode).
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float blueY = floor(c.b * 8.0) / 8.0;
      float blueX = floor((c.b - blueY) * 64.0) / 8.0;
      // auxSampler1 = second pass input (the LUT); pass inputs bind in order after 'default, which is auxSampler0.
      return texture2D(auxSampler1, vec2(c.r / 8.0 + blueX, c.g / 8.0 + blueY)).xyz;
    }

    // Hugo Elias-style hashes (no sin, so identical on GL and Metal).
    float hash11(float p) {
      p = fract(p * 0.1031);
      p *= p + 33.33;
      p *= p + p;
      return fract(p);
    }
    float hash21(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }
    // Spark's 20 flat-grey flicker frames (25 fps loop).
    float flickerLevel(float i) {
      float g = 0.2745;
      if (i > 0.5) { g = 0.2784; }
      if (i > 1.5) { g = 0.2235; }
      if (i > 2.5) { g = 0.2783; }
      if (i > 3.5) { g = 0.2196; }
      if (i > 4.5) { g = 0.2784; }
      if (i > 5.5) { g = 0.2863; }
      if (i > 6.5) { g = 0.2118; }
      if (i > 7.5) { g = 0.2824; }
      if (i > 8.5) { g = 0.2784; }
      if (i > 9.5) { g = 0.2863; }
      if (i > 10.5) { g = 0.2392; }
      if (i > 11.5) { g = 0.2039; }
      if (i > 12.5) { g = 0.2706; }
      if (i > 13.5) { g = 0.2196; }
      if (i > 14.5) { g = 0.2157; }
      if (i > 15.5) { g = 0.2196; }
      if (i > 16.5) { g = 0.2980; }
      if (i > 17.5) { g = 0.2118; }
      if (i > 18.5) { g = 0.2941; }
      return g;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;
      vec4 cam = sampleInput(uv);
      vec3 src = cam.rgb;

      // Soft-focus 3x3 gaussian before the grade (Spark's separable Gaussian Blur block).
      if (blur_sigma > 0.0 && strength > 0.0) {
        vec2 bd = vec2(blur_sigma / 720.0, blur_sigma / 720.0 * source_size_x / max(source_size_y, 1.0));
        vec3 bs = src * 4.0;
        bs += (sampleInput(uv + vec2(bd.x, 0.0)).rgb + sampleInput(uv - vec2(bd.x, 0.0)).rgb
             + sampleInput(uv + vec2(0.0, bd.y)).rgb + sampleInput(uv - vec2(0.0, bd.y)).rgb) * 2.0;
        bs += sampleInput(uv + bd).rgb + sampleInput(uv - bd).rgb
            + sampleInput(uv + vec2(bd.x, -bd.y)).rgb + sampleInput(uv + vec2(-bd.x, bd.y)).rgb;
        src = mix(src, bs / 16.0, strength);
      }
      // strength: global effect-strength uniform declared by BaseUniformsOpenGL (IGLUScript/igluscript/UniformsMacros.h:10).
      vec3 graded = mix(src, lutLookup(src), strength * lut_strength);
      vec3 result = graded;
      // Static pixel-locked grain.
      vec2 px = floor(topUv(uv) * vec2(source_size_x, source_size_y)) + vec2(mod(floor(time * kGrainFps), kGrainFrames) * 17.0);
      float n = hash21(px);
      float grain = clamp(0.34 + (n - 0.5) * 0.53, 0.0, 1.0);
      result = mix(result, vec3(grain), grain_opacity * strength);
      // Spark paints its layers scaled by the raw camera luma (Colour Paint: tex x 2.857 x luma).
      float camL = dot(cam.rgb, vec3(0.299, 0.587, 0.114));
      // Dust and scratches (Spark's 24 fps sequence at 0.08): sparse 1x3 px specks and one thin
      // vertical scratch whose x jumps every few frames.
      {
        vec2 tuv = topUv(uv);
        vec2 pxp = floor(tuv * vec2(source_size_x, source_size_y));
        float fd = mod(floor(time * 24.0), 16.0);  // bounded seed
        float speck = step(0.99985, hash21(floor(pxp / vec2(1.0, 3.0)) + fd * 7.13));
        float shot = floor(fd / (2.0 + 4.0 * hash11(floor(fd / 4.0))));
        float sx = hash11(shot * 3.7 + 0.9);
        float scratch = step(abs(tuv.x - sx), 0.6 / max(source_size_x, 1.0)) * step(0.4, hash11(shot + 5.1));
        float dust = 0.9 * max(speck, scratch);
        result = mix(result, vec3(dust * 2.857 * camL), 0.08 * strength);
      }
      // Brightness flicker: Spark's 20 grey levels at 25 fps, painted at 0.2.
      result = mix(result, vec3(flickerLevel(mod(floor(time * 25.0), 20.0)) * 2.857 * camL), 0.2 * strength);

      gl_FragColor = toOutputFormat(vec4(clamp(result, 0.0, 1.0), cam.a));
    }
    ";
