# IGLUSCRIPTCOLLISION_BYPASS: Intentional replacement of C++ native effect - IGLUScript takes precedence on Android/iOS; C++ filter retained as fallback for direct C++ callers (sample app, server tools).

[Filter VideoZoomBounce]
# Zoom in with an overshooting bounce, a two-stage blur that fades as the zoom settles, and a
# vignette composite. Port of VideoZoomBounceFilter, which is VideoPushZoomFilter with
# `bounce = true`. The four passes and all constants match VideoPushZoomFilter.cpp.
#
# With `useBeats` true the curve position replaces the intro clock, so the same gesture replays
# on every beat instead of once at the start, and `amount` additionally sets how deep the zoom
# starts. Everything else is shared between the two modes.

# VideoPushZoomFilter.cpp:21-22.
f32 kZoomStart = 0.4;
f32 kZoomEnd = 1.0;

# Shallowest beat-mode zoom start, at `amount` 0. Deliberately not kZoomEnd: the effect should
# still read as a bounce at the bottom of the slider.
f32 kBeatZoomStartMin = 0.8;

# Overshoot passed to interpolation::easeOutBack (VideoPushZoomFilter.cpp:177).
f32 kOvershoot = 7.0;

# `amount` maps to this blur range (VideoPushZoomFilter.cpp:187).
f32 kBlurMax = 0.45;

# interpolation::easeOutBack, Interpolation.h:40-43. Written with explicit multiplies rather
# than pow() so the cubic and square terms stay exact.
fun easeOutBack(f32 x) f32 {
  f32 c3 = kOvershoot + 1.0;
  f32 d = x - 1.0;
  f32 dSq = d * d;
  return 1.0 + c3 * dSq * d + kOvershoot * dSq;
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {amount = 0.5, min = 0.0, max = 1.0, description = "Zoom blur strength; also sets the zoom depth in beat mode"},
    {beatProgress = 0.0, min = 0.0, max = 1.0, description = "Curve position, replaces the intro clock"},
    {useBeats = false, description = "True while the beat system is driving this effect"},
  };

  filter.passes = {
    {
      name = 'zoom_in,
      inputs = {'default},
      uniforms = {
        scale = 1.0,
      },
      glslShader = glslZoomIn,
    },
    {
      name = 'box_blur_half,
      inputs = {'zoom_in},
      uniforms = {
        sourceSize = {1080.0, 1920.0},
      },
      scale = {0.5, 0.5},
      glslShader = glslBoxBlur,
    },
    {
      name = 'zoom_blur,
      inputs = {'box_blur_half},
      uniforms = {
        sourceSize = {1080.0, 1920.0},
        blurAmount = 0.0,
        blurDirection = 1.0,
        centerOffset = {0.0, 0.0},
      },
      scale = {0.25, 0.25},
      glslShader = glslZoomBlur,
    },
    {
      name = 'vignette,
      inputs = {'default, 'zoom_blur},
      uniforms = {
        sourceSize = {1080.0, 1920.0},
        progress = 0.0,
      },
      glslShader = glslVignette,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  boolean useBeats = getParameterBoolean('useBeats);

  f32 amount = getParameterFloat('amount);

  f32 progress = getParameterFloat('progress);
  f32 zoomStart = kZoomStart;
  if (useBeats) {
    progress = clamp(getParameterFloat('beatProgress), 0.0, 1.0);
    # Beat mode only: the base path must stay byte-identical to VideoPushZoomFilter, which the
    # pixel-parity goldens enforce.
    zoomStart = kBeatZoomStartMin + (kZoomStart - kBeatZoomStartMin) * amount;
  }

  # VideoPushZoomFilter.cpp:177-179, the `bounce` branch.
  f32 scale = zoomStart + (kZoomEnd - zoomStart) * easeOutBack(progress);
  setShaderUniform('zoom_in, 'scale, scale);

  # VideoPushZoomFilter.cpp:187.
  f32 blurAmount = kBlurMax * amount * max(0.0, 1.0 - progress);
  setShaderUniform('zoom_blur, 'blurAmount, blurAmount);

  setShaderUniform('vignette, 'progress, progress);

  # onInputSizeChangedImpl gives every pass the FULL input size, including the two that render
  # scaled down, so the blur steps stay in full-resolution units. Writing the scaled size here
  # would widen both blurs. vec2 uniforms also do not pick up their [Init] defaults.
  vec2 size = getTextureSize('default);
  setShaderUniform('box_blur_half, 'sourceSize, size);
  setShaderUniform('zoom_blur, 'sourceSize, size);
  setShaderUniform('vignette, 'sourceSize, size);
}

#### Pass 1: zoom in, mirrored at the edges ####

string glslZoomIn = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;

  uniform float scale;

  vec2 mirrorUV(vec2 uv) {
    uv = fract(uv * 0.5) * 2.0;
    return 1.0 - abs(1.0 - uv);
  }

  void main() {
    vec2 center = vec2(0.5, 0.5);
    vec2 uv = (sourceTextureCoordinate - center) / scale + center;
    uv = mirrorUV(uv);
    gl_FragColor = toOutputFormat(sampleInput(uv));
  }
";

#### Pass 2: box blur at half resolution ####

string glslBoxBlur = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform vec2 sourceSize;

  vec4 boxFilter(vec2 uv, vec2 duv) {
    vec4 color;
    color = sampleInput(uv + vec2(-duv.x, -duv.y));
    color += sampleInput(uv + vec2(duv.x, -duv.y));
    color += sampleInput(uv + vec2(-duv.x, duv.y));
    color += sampleInput(uv + vec2(duv.x, duv.y));
    return 0.25 * color;
  }

  void main() {
    if (sourceSize.x == 0.0 || sourceSize.y == 0.0) {
      gl_FragColor = toOutputFormat(sampleInput(sourceTextureCoordinate));
      return;
    }
    gl_FragColor = toOutputFormat(boxFilter(sourceTextureCoordinate, 1.0 / sourceSize));
  }
";

#### Pass 3: radial zoom blur at quarter resolution ####

string glslZoomBlur = "
  precision highp float;

  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform vec2 sourceSize;
  uniform float blurAmount;
  uniform float blurDirection;
  uniform vec2 centerOffset;

  float ramp(float edge0, float edge1, float x) {
    return clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
  }

  float sCurve(float x) {
    x = x * 2.0 - 1.0;
    return -x * abs(x) * 0.5 + x + 0.5;
  }

  vec4 blurDir(vec2 duv, vec2 uv, float fradius, float direction) {
    int radius = int(fradius);
    if (fradius >= 1.0) {
      vec4 A = vec4(0.0);
      vec4 C = vec4(0.0);
      float divisor = 0.0;
      float weight = 1.0;
      float rad = 1.0 / fradius;

      for (int xi = 0; xi <= radius; xi++) {
        float x = float(xi);
        vec2 st = uv + x * duv * direction;
        A = sampleInput(st);
        weight = sCurve(1.0 - (abs(x) * rad));
        C += A * weight;
        divisor += weight;
      }
      return C / divisor;
    }
    return sampleInput(uv);
  }

  vec4 blur_zoom_shader(vec2 uv,
                        float blurRatio,
                        float blurDirection,
                        vec2 centerOffset,
                        vec2 size) {
    vec2 res = size / size.y;
    vec2 center = vec2(0.5) + centerOffset * .5;

    vec3 dir;
    dir.xy = (center - uv) * res;
    dir.z = dot(dir.xy, dir.xy);

    dir.z = max(dir.z, 0.00001);
    dir *= inversesqrt(dir.z);

    float weight = ramp(0.0, 0.25, dir.z);
    vec2 duv = 1.0 / size;
    duv *= weight * dir.xy * 2.0;

    float minSize = min(size.x, size.y);
    float radius = minSize / 2.;
    float amt = blurRatio * length(vec2(radius, radius));

    vec4 color = blurDir(duv, uv, amt, blurDirection);
    return color;
  }

  void main() {
    vec2 uv = sourceTextureCoordinate;
    vec4 color = blur_zoom_shader(uv, blurAmount, blurDirection, centerOffset, sourceSize);
    gl_FragColor = toOutputFormat(color);
  }
";

#### Pass 4: vignette the blurred copy, then fade back to the sharp zoom ####

string glslVignette = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform vec2 sourceSize;
  uniform float progress;

  // Pass input 1, 'zoom_blur. Aux inputs bind by position in `inputs`, not by name.
  uniform sampler2D auxSampler1;

  void main() {
    vec2 uv = sourceTextureCoordinate;

    float ratioMax = min(sourceSize.x, sourceSize.y) * 2.0;
    vec2 ratio = sourceSize.xy / ratioMax *
                 (sourceSize.x > sourceSize.y ? vec2(1.5, 0.85) : vec2(0.85, 1.5));

    vec2 d = (uv - 0.5) * ratio * vec2(1.5, 0.85);
    float dist = length(d);
    float vignette = 1.0 - smoothstep(0.4, 0.8, dist * (1.0 - progress));

    vec4 blurredColor = texture2D(auxSampler1, uv);
    blurredColor.rgb *= vignette;

    float mixFactor = smoothstep(0.995, 1.0, progress);
    vec4 baseColor = sampleInput(uv);

    vec4 finalColor = mix(blurredColor, baseColor, mixFactor);
    gl_FragColor = toOutputFormat(finalColor);
  }
";
