# IGLUSCRIPTCOLLISION_BYPASS: IGLUScript port of transition_pixel, QE-selectable for A/B vs TransitionPixelFilter.
[Filter TransitionPixel]

[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.passes = {{
    name = 'single_pass,
    inputs = {'default, 'transition},
    shaderInputNames = {'default, 's_texture1},
    uniforms = {
      outputSize = {1024.0, 1024.0},
      blockSize = 1.0,
      blend = 0.0,
    },
    glslShader = glsl,
  }};

  filter.parameters = {
    {pixelScale = 2.0, min = 0.0, max = 8.0, description = "Max block size multiplier"},
  };
}

# GLSL smoothstep(edge0, edge1, x) with the interpolant precomputed by the caller.
# IGLUScript only registers smoothstep for vector types, not f32.
fun smoothstep01(f32 t) f32 {
  f32 v = clamp(t, 0.0, 1.0);
  return v * v * (3.0 - 2.0 * v);
}

[PreRender]
fun preRender(Filter filter) {
  f32 progress = getParameterFloat('progress);
  vec2 size = getTextureSize('default);
  setShaderUniform('single_pass, 'outputSize, size);

  # parabola(progress, 0.5)
  f32 t = pow(4.0 * progress * (1.0 - progress), 0.5);
  f32 maxBlockSize = 32.0 * getParameterFloat('pixelScale);
  f32 blockSize = 1.0 * (1.0 - t) + maxBlockSize * t;
  setShaderUniform('single_pass, 'blockSize, blockSize * (size.y / 1920.0));

  setShaderUniform('single_pass, 'blend, smoothstep01((progress - 0.4) / (0.6 - 0.4)));
}

string glsl = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform sampler2D s_texture1;
  uniform vec2 outputSize;
  uniform float blockSize;
  uniform float blend;
  void main() {
    vec2 uv = sourceTextureCoordinate;
    vec2 st = (uv - 0.5) * outputSize;
    vec2 pixelatedST = floor(st / blockSize) * blockSize + blockSize * 0.5;
    vec2 pixelatedUV = pixelatedST / outputSize + 0.5;
    vec4 a = sampleInput(pixelatedUV);
    vec4 b = texture2D(s_texture1, pixelatedUV);
    vec4 color = mix(a, b, blend);
    gl_FragColor = toOutputFormat(color);
  }
";
