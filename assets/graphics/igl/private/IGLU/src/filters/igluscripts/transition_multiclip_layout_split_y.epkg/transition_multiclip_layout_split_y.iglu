[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.parameters = {
    {duration = 3.0, min = 0.1, max = 5.0, description = "Duration"},
  };
  filter.passes = {{
    name = 'layout,
    inputs = {'default, 'transition},
    shaderInputNames = {'default, 's_texture1},
    uniforms = {
      edgeScale = {720.0, 1280.0},
      progress = 0.0,
      m2 = {0.0, 0.0, 1.0, 1.0},
      matteActive2 = 0.0,
      m3 = {0.0, 0.0, 1.0, 1.0},
      matteActive3 = 0.0,
      m4 = {0.0, 0.0, 1.0, 1.0},
      matteActive4 = 0.0,
      m5 = {0.0, 0.0, 1.0, 1.0},
      matteActive5 = 0.0,
      m6 = {0.0, 0.0, 1.0, 1.0},
      matteActive6 = 0.0,
      m7 = {0.0, 0.0, 1.0, 1.0},
      matteActive7 = 0.0,
      o16 = {0.0, 0.0},
      active16 = 0.0,
      active15 = 0.0,
      active14 = 0.0,
      o12 = {0.0, 0.0},
      active12 = 0.0,
      active11 = 0.0,
      active10 = 0.0,
      active9 = 0.0,
    },
    glslShader = glsl,
  }};
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = max(getParameterFloat('progress), getParameterFloat('transition_progress));
  f32 t = clamp(p, 0.0, 1.0) * 3.0;
  vec2 size = getTextureSize('default);
  setShaderUniform('layout, 'edgeScale, size);
  setShaderUniform('layout, 'progress, p);
  vec4 m2 = {((l2_2(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l2_3(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l2_2(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l2_3(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm2, m2);
  f32 matteActive2 = 0.0;
  if (t >= 1.96666666667 and t < 5.63333333333) { matteActive2 = 1.0; }
  setShaderUniform('layout, 'matteActive2, matteActive2);
  vec4 m3 = {((l3_4(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l3_5(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l3_4(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l3_5(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm3, m3);
  f32 matteActive3 = 0.0;
  if (t >= 1.96666666667 and t < 5.63333333333) { matteActive3 = 1.0; }
  setShaderUniform('layout, 'matteActive3, matteActive3);
  vec4 m4 = {((l3_4(t) + (((l4_6(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l3_5(t) + (((l4_7(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l3_4(t) + (((l4_6(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l3_5(t) + (((l4_7(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm4, m4);
  f32 matteActive4 = 0.0;
  if (t >= 1.96666666667 and t < 3.66666666667) { matteActive4 = 1.0; }
  setShaderUniform('layout, 'matteActive4, matteActive4);
  vec4 m5 = {((l6_10(t) + (((l5_8(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l6_11(t) + (((l5_9(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l6_10(t) + (((l5_8(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l6_11(t) + (((l5_9(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm5, m5);
  f32 matteActive5 = 0.0;
  if (t >= 0.0 and t < 1.96666666667) { matteActive5 = 1.0; }
  setShaderUniform('layout, 'matteActive5, matteActive5);
  vec4 m6 = {((l6_10(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l6_11(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l6_10(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l6_11(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm6, m6);
  f32 matteActive6 = 0.0;
  if (t >= 0.0 and t < 1.96666666667) { matteActive6 = 1.0; }
  setShaderUniform('layout, 'matteActive6, matteActive6);
  vec4 m7 = {((l7_12(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) - 360.0) / 720.0, ((l7_13(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) - 320.0) / 1280.0, ((l7_12(t) + (((0.0 - 2.26171875)) - (0.0 - 2.26171875)) * 1.0) + 360.0) / 720.0, ((l7_13(t) + (((0.0 - 0.9921875)) - (0.0 - 0.9921875)) * 1.0) + 320.0) / 1280.0};
  setShaderUniform('layout, 'm7, m7);
  f32 matteActive7 = 0.0;
  if (t >= 0.0 and t < 1.96666666667) { matteActive7 = 1.0; }
  setShaderUniform('layout, 'matteActive7, matteActive7);
  vec2 o16 = {((l13_24(t) + (((l16_30(t) + ((360.0) - 360.0) * 1.0)) - 0.0) * 1.0) - 360.0) / 720.0, ((l13_25(t) + (((l16_31(t) + ((640.0) - 640.0) * 1.0)) - 0.0) * 1.0) - 640.0) / 1280.0};
  setShaderUniform('layout, 'o16, o16);
  f32 active16 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active16 = 1.0; }
  setShaderUniform('layout, 'active16, active16);
  f32 active15 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active15 = 1.0; }
  setShaderUniform('layout, 'active15, active15);
  f32 active14 = 0.0;
  if (t >= 0.0 and t < 4.51316956528) { active14 = 1.0; }
  setShaderUniform('layout, 'active14, active14);
  vec2 o12 = {((l8_14(t) + (((l12_22(t) + ((1080.0) - 1080.0) * 0.333333333333)) - 0.0) * 1.0) - 360.0) / 720.0, ((l8_15(t) + (((l12_23(t) + ((1920.0) - 1920.0) * 0.333333333333)) - 0.0) * 1.0) - 640.0) / 1280.0};
  setShaderUniform('layout, 'o12, o12);
  f32 active12 = 0.0;
  if (t >= 0.0 and t < 5.01666666667) { active12 = 1.0; }
  setShaderUniform('layout, 'active12, active12);
  f32 active11 = 0.0;
  if (t >= 0.0 and t < 5.01666666667) { active11 = 1.0; }
