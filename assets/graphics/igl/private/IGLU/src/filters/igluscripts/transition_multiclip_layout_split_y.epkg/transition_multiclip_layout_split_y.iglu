fun l8_15(f32 t) f32 {
  f32 v = 640.0;
  if (t < 1.0) {
    f32 u = clamp((t - 0.0) / 1.0, 0.0, 1.0);
    v = 640.0 + 260.0 * aeEase(u, 0.346943366348, 0.0, 0.0, 1.0);
  }
  else if (t < 2.0) {
    v = 900.0;
  }
  else if (t < 2.96666666667) {
    f32 u = clamp((t - 2.0) / 0.966666666667, 0.0, 1.0);
    v = 900.0 + 260.0 * aeEase(u, 0.341538062044, 0.0, 0.0, 1.0);
  }
  else { v = 1160.0; }
  return v;
}
