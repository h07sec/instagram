[Filter TransitionMulticlipLayoutSplitY]

fun bez(f32 a, f32 b, f32 s) f32 {
  f32 r = 1.0 - s;
  return 3.0 * r * r * s * a + 3.0 * r * s * s * b + s * s * s;
}
fun aeEase(f32 u, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 lo = 0.0;
  f32 hi = 1.0;
  f32 s = 0.0;
  f32 i = 0.0;
  while (i < 24.0) {
    s = (lo + hi) * 0.5;
    if (bez(x1, x2, s) < u) { lo = s; } else { hi = s; }
    i = i + 1.0;
  }
  return bez(y1, y2, s);
}

fun l1_0(f32 t) f32 { f32 v = 1080.0; return v; }
fun l1_1(f32 t) f32 { f32 v = 1920.0; return v; }
fun l2_2(f32 t) f32 { f32 v = 360.0; return v; }
fun l2_3(f32 t) f32 { f32 v = 320.0; return v; }
fun l3_4(f32 t) f32 { f32 v = 360.0; return v; }
fun l3_5(f32 t) f32 {
  f32 v = 320.0;
  if (t < 2.96666666667) {
    f32 u = clamp((t - 1.96666666667) / 1.0, 0.0, 1.0);
    v = 320.0 + 640.0 * aeEase(u, 0.33333333, 0.0, 0.0, 1.0);
  }
  else { v = 960.0; }
  return v;
}
fun l4_6(f32 t) f32 { f32 v = (0.0 - 2.26171875); return v; }
fun l4_7(f32 t) f32 { f32 v = 634.0078125; return v; }
fun l5_8(f32 t) f32 { f32 v = (0.0 - 2.26171875); return v; }
fun l5_9(f32 t) f32 {
  f32 v = (0.0 - 644.0);
  if (t < 1.0) {
    f32 u = clamp((t - 0.0) / 1.0, 0.0, 1.0);
    v = (0.0 - 644.0) + 4.0 * u;
  }
  else { v = (0.0 - 640.0); }
  return v;
}
fun l6_10(f32 t) f32 { f32 v = 360.0; return v; }
