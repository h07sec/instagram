}

string glsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;
uniform sampler2D s_texture1;
uniform vec2 edgeScale;
uniform float progress;
uniform vec4 m2;
uniform float matteActive2;
uniform vec4 m3;
uniform float matteActive3;
uniform vec4 m4;
uniform float matteActive4;
uniform vec4 m5;
uniform float matteActive5;
uniform vec4 m6;
uniform float matteActive6;
uniform vec4 m7;
uniform float matteActive7;
uniform vec2 o16;
uniform float active16;
uniform float active15;
uniform float active14;
uniform vec2 o12;
uniform float active12;
uniform float active11;
uniform float active10;
uniform float active9;

// Exact area coverage of an axis-aligned rectangle, at the output resolution.
float rectCoverage(vec2 xy, vec4 r) {
  vec2 d = min(xy - r.xy, r.zw - xy) * edgeScale;
  vec2 cov = clamp(d + 0.5, 0.0, 1.0);
  return cov.x * cov.y;
}
void main() {
  vec2 uv = sourceTextureCoordinate;
  if (progress < 0.0) { gl_FragColor = toOutputFormat(sampleInput(uv)); return; }
  if (progress >= 1.0) { gl_FragColor = toOutputFormat(texture2D(s_texture1, uv)); return; }
  // AE uses top-down coordinates; UP keeps this native on OpenGL and Metal.
  vec2 xy = vec2(uv.x, 0.5 - UP * (uv.y - 0.5));
  vec3 col = vec3(0.0);
  // Duplicate layers share one offset and sample; each keeps its own matte and normal-over step.
  float coverA = rectCoverage(xy - o16, vec4(0.0, 0.0, 1.0, 1.0));
  vec4 cA = sampleInput(uv + vec2(-o16.x, UP * o16.y));
  float coverB = rectCoverage(xy - o12, vec4(0.0, 0.0, 1.0, 1.0));
  vec4 cB = texture2D(s_texture1, uv + vec2(-o12.x, UP * o12.y));
  // AE layer 16: PRE_A, matte 7, 5013.
  float a16 = active16 * coverA * (matteActive7 * rectCoverage(xy, m7));
  col = cA.rgb * a16 + col * (1.0 - a16 * cA.a);
  // AE layer 15: PRE_A, matte 6, 5013.
  float a15 = active15 * coverA * (matteActive6 * rectCoverage(xy, m6));
  col = cA.rgb * a15 + col * (1.0 - a15 * cA.a);
  // AE layer 14: PRE_A, matte 4, 5013.
  float a14 = active14 * coverA * (matteActive4 * rectCoverage(xy, m4));
  col = cA.rgb * a14 + col * (1.0 - a14 * cA.a);
  // AE layer 12: PRE_B, matte 5, 5013.
  float a12 = active12 * coverB * (matteActive5 * rectCoverage(xy, m5));
  col = cB.rgb * a12 + col * (1.0 - a12 * cB.a);
  // AE layer 11: PRE_B, matte 3, 5013.
  float a11 = active11 * coverB * (matteActive3 * rectCoverage(xy, m3));
  col = cB.rgb * a11 + col * (1.0 - a11 * cB.a);
  // AE layer 10: PRE_B, matte 2, 5013.
  float a10 = active10 * coverB * (matteActive2 * rectCoverage(xy, m2));
  col = cB.rgb * a10 + col * (1.0 - a10 * cB.a);
  // AE layer 9: PRE_B, matte None, 5013.
  float a9 = active9 * coverB * 1.0;
  col = cB.rgb * a9 + col * (1.0 - a9 * cB.a);
  gl_FragColor = toOutputFormat(vec4(col, 1.0));
}
";
