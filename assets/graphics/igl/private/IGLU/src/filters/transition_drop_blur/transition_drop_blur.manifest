{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "identifier": "transition_drop_blur",
  "displayName": "Ishift",
  "description": "Video transition selection. Chooses to apply drop blur transition.",
  "attribution": "@ishanimitraa",
  "iglu": {
    "behavior": {
      "type": "transition",
      "durationMs": 500,
      "curve": "linear"
    },
    "customization": [
      {
        "name": "duration",
        "default": 0.5,
        "min": 0.1,
        "max": 5.0,
        "displayName": "Duration",
        "displayMethod": "time"
      }
    ]
  }
}
