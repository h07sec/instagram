{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "identifier": "transition_glitch",
  "displayName": "Glitch",
  "description": "[IG Edits] Video effect name. With \"Glitch\", the creator can imitate the effect of square pixels and low quality in their video.",
  "iglu": {
    "behavior": {
      "type": "transition",
      "durationMs": 500,
      "curve": "linear"
    },
    "customization": [
      {
        "name": "duration",
        "default": 0.5,
        "min": 0.1,
        "max": 5.0,
        "displayName": "Duration",
        "displayMethod": "time"
      }
    ]
  }
}
